  "lines": [
    {
      "text": "今日までの記憶の",
      "romaji": "kyou made no kioku no"
    },
    {
      "text": "全部を消してしまう時まで眠れない",
      "romaji": "zenbu o keshite shimau toki made nemurenai"
    },
    {
      "text": "あしたから生きていく",
      "romaji": "ashita kara ikite iku"
    },
    {
      "text": "自分の身代わりが欲しくて堪らない",
      "romaji": "jibun no migawari ga hoshikute tamaranai"
    },
    {
      "text": "大丈夫と言わせて",
      "romaji": "daijoubu to iwasete"
    },
    {
      "text": "後から君のせいにさせてはくれないか",
      "romaji": "ato kara kimi no sei ni sasete wa kurenai ka"
    },
    {
      "text": "今更意味ないから",
      "romaji": "imasara imi nai kara"
    },
    {
      "text": "出来ない約束を",
      "romaji": "dekinai yakusoku o"
    },
    {
      "text": "とうとうと溢れる一言",
      "romaji": "toutou to afureru hitokoto"
    },
    {
      "text": "一言ばかりに",
      "romaji": "hitokoto bakari ni"
    },
    {
      "text": "脳を奪われるくらい",
      "romaji": "nou o ubawareru kurai"
    },
    {
      "text": "意味を成せない 何も出来ない",
      "romaji": "imi o nasenai nani mo dekinai"
    },
    {
      "text": "見えない 逃げたい 飛びたい",
      "romaji": "mienai nigetai tobitai"
    },
    {
      "text": "やめたい 逸らせない",
      "romaji": "yametai sorasenai"
    },
    {
      "text": "だから 沈め 沈め",
      "romaji": "dakara shizume shizume"
    },
    {
      "text": "這い上がれないほどまで",
      "romaji": "hai agarenai hodo made"
    },
    {
      "text": "飽きるまで落とせ 落とせ",
      "romaji": "akiru made otose otose"
    },
    {
      "text": "救い垂らす時まで",
      "romaji": "sukui tarasu toki made"
    },
    {
      "text": "どうせなら奪え 奪え",
      "romaji": "douse nara ubae ubae"
    },
    {
      "text": "飼い慣らした嘘暴いて",
      "romaji": "kainarashita uso abaite"
    },
    {
      "text": "煮え滾る頭に過ぎった",
      "romaji": "nietagiru atama ni yogitta"
    },
    {
      "text": "虚像を見ていた",
      "romaji": "kyozou o mite ita"
    },
    {
      "text": "自分を見ていた",
      "romaji": "jibun o mite ita"
    }
  ]
}
