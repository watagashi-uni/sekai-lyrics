  "lines": [
    {
      "text": "よう うな垂れてるその兄ちゃん",
      "romaji": "you unatareteru sono nii-chan"
    },
    {
      "text": "何か辛い事あったんか？",
      "romaji": "nan ka tsurai koto atta nka?"
    },
    {
      "text": "力になるぜ",
      "romaji": "chikara ni naruze"
    },
    {
      "text": "一体どんなことがあった？",
      "romaji": "ittai donna koto ga atta?"
    },
    {
      "text": "そりゃ酷え話だ兄弟",
      "romaji": "sorya hidoe hanashi da kyoudai"
    },
    {
      "text": "これをやるから元気出しな",
      "romaji": "kore o yaru kara genki dashi na"
    },
    {
      "text": "金ならまた今度でいいさ",
      "romaji": "kane nara mata nando de ii sa"
    },
    {
      "text": "眠らない夜のチャイナタウン",
      "romaji": "nemuranai yoru no chaina taun"
    },
    {
      "text": "その全てが縄張り",
      "romaji": "sono subete ga nawabari"
    },
    {
      "text": "老若男女問わずお客",
      "romaji": "rounakunannyo towazu okyaku"
    },
    {
      "text": "使い終わったら捨てりゃいい",
      "romaji": "tsukai owattara suterya ii"
    },
    {
      "text": "今夜も来たのかい",
      "romaji": "konya mo kita no kai"
    },
    {
      "text": "代金はこれくらい",
      "romaji": "daikin wa kore kurai"
    },
    {
      "text": "え？ え？ え？",
      "romaji": "e? e? e?"
    },
    {
      "text": "払えないのかい",
      "romaji": "haraenai no kai"
    },
    {
      "text": "ならばしょうがない",
      "romaji": "naraba shouganai"
    },
    {
      "text": "君にぴったりの仕事があるから こっちに付いてきな",
      "romaji": "kimi ni pittari no shigoto ga aru kara kocchi ni tsuite ki na"
    },
    {
      "text": "こっちに付いてきな",
      "romaji": "kocchi ni tsuite ki na"
    },
    {
      "text": "焼かれた酒場か剥がれた女",
      "romaji": "yakareta sakaba ka hagareta onna"
    },
    {
      "text": "しゃがれた看板掲げたオーナー",
      "romaji": "shagareta kanban kakageta oonaa"
    },
    {
      "text": "たかだかナイフで刺されたようじゃ",
      "romaji": "takadaka naifu de sasareta you ja"
    },
    {
      "text": "端からアイツの思惑通りだ",
      "romaji": "hana kara aitsu no omowaku doori da"
    },
    {
      "text": "気 狂ってる目 散歩中",
      "romaji": "ki kurutteru me sanpochuu"
    },
    {
      "text": "血 売るってお前 納得",
      "romaji": "chi urutte omae nattoku"
    },
    {
      "text": "提灯と竜胆咲かせた果て",
      "romaji": "chouchin to rindou sakaseta hate"
    },
    {
      "text": "盲信の真を奏でたまへ",
      "romaji": "moushin no shin o kanade tamae"
    },
    {
      "text": "黙れ 座れ 黙れ",
      "romaji": "damare suware damare"
    },
    {
      "text": "殴れ 殴れ 殴れ",
      "romaji": "nagure nagure nagure"
    },
    {
      "text": "縛れ 縛れ 縛れ",
      "romaji": "shibare shibare shibare"
    },
    {
      "text": "バラせ バラせ バラせ",
      "romaji": "barase barase barase"
    },
    {
      "text": "今夜のはどうだい？",
      "romaji": "konya no wa doudai?"
    },
    {
      "text": "生きてればお客",
      "romaji": "ikitereba okyaku"
    },
    {
      "text": "死んでれば商材",
      "romaji": "shindereba shouzai"
    },
    {
      "text": "卒なく 無駄なく 転がすビジネス",
      "romaji": "sotsu naku muda naku korogasu bijinesu"
    },
    {
      "text": "どっちを向いてんだ",
      "romaji": "docchi o muite nda"
    },
    {
      "text": "やあ うな垂れてるその嬢ちゃん",
      "romaji": "yaa unatareteru sono jou-chan"
    }
  ]
}
