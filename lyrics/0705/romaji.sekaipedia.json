  "lines": [
    {
      "text": "中指立てて絶好調",
      "romaji": "nakayubi tatete zekkouchou"
    },
    {
      "text": "AM6:00目覚まし時計を起こして",
      "romaji": "AM shikkusu mezamashidokei o okoshite"
    },
    {
      "text": "ボリューム全開ロックで",
      "romaji": "boryuumu zenkai rokku de"
    },
    {
      "text": "愛と愛が苦手です隠れたいよ",
      "romaji": "me to me ga nigate desu kakuretai yo"
    },
    {
      "text": "仮想が現実です？",
      "romaji": "dochira ga kochira desu?"
    },
    {
      "text": "わかんないよ",
      "romaji": "wakannai yo!"
    },
    {
      "text": "ラズベリーモンスター",
      "romaji": "razuberii*monsutaa"
    },
    {
      "text": "何方が味方です？",
      "romaji": "donata ga mikata desu?"
    },
    {
      "text": "近づきたいんだ赤い少女",
      "romaji": "chikazukitai nda akai shoujo"
    }
  ]
}
