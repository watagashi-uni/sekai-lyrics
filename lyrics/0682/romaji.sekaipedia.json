  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "きっと運命の寵児",
      "romaji": "kitto unmei no chouji"
    },
    {
      "text": "まるで魔性の物語",
      "romaji": "marude mashou no sutoorii"
    },
    {
      "text": "誰もが釘付けの一等星",
      "romaji": "dare mo ga kugizuke no ittousei"
    },
    {
      "text": "でもね",
      "romaji": "demo ne"
    },
    {
      "text": "あなたも知らないあなたを",
      "romaji": "anata mo shiranai anata o"
    },
    {
      "text": "わたしは知っている",
      "romaji": "watashi wa shitte iru"
    },
    {
      "text": "なのに",
      "romaji": "nano ni"
    },
    {
      "text": "みんな好きだから",
      "romaji": "minna suki dakara"
    },
    {
      "text": "あけらかん",
      "romaji": "akerakan"
    },
    {
      "text": "あなたは手をひらひら",
      "romaji": "anata wa te o hirahira"
    },
    {
      "text": "見えない壁",
      "romaji": "mienai kabe"
    },
    {
      "text": "冷たい汗",
      "romaji": "tsumetai ase"
    },
    {
      "text": "首筋伝う",
      "romaji": "kubisuji tsutau"
    },
    {
      "text": "あなたしか見えないの（見えないの）",
      "romaji": "anata shika mienai no (mienai no)"
    },
    {
      "text": "有象無象の世迷言？",
      "romaji": "uzoumuzou no yomaigoto?"
    },
    {
      "text": "一人、また一人蕩かして",
      "romaji": "hitori, mata hitori torokashite"
    },
    {
      "text": "嗚呼、茹っていく",
      "romaji": "aa, udatte iku"
    },
    {
      "text": "クセになっちゃうわ",
      "romaji": "kuse ni nacchau wa"
    },
    {
      "text": "あなたしか見えないの",
      "romaji": "anata shika mienai no"
    },
    {
      "text": "なんであなたしか見えないの？",
      "romaji": "nande anata shika mienai no?"
    },
    {
      "text": "有象無象のひとりなら",
      "romaji": "uzoumuzou no hitori nara"
    },
    {
      "text": "あなたの「特別」に成れたのね！",
      "romaji": "anata no \"tokubetsu\" ni nareta no ne!"
    },
    {
      "text": "嗚呼、素敵だわ",
      "romaji": "aa, suteki da wa"
    },
    {
      "text": "目も当てられないわ",
      "romaji": "me mo aterarenai wa"
    }
  ]
}
