  "lines": [
    {
      "text": "ラヴィラヴィチュウ",
      "romaji": "ravi ravi chuu"
    },
    {
      "text": "ご褒美ラヴィチュウ",
      "romaji": "gohoubi ravi chuu"
    },
    {
      "text": "噛み付いて骨まで",
      "romaji": "kamitsuite hone made"
    },
    {
      "text": "チュッチュッチュッ",
      "romaji": "chucchucchu"
    },
    {
      "text": "Bat 煽ってないの?え?",
      "romaji": "Bat aottenai no? e?"
    },
    {
      "text": "おつかれ今日もノーダメージ",
      "romaji": "otsukare kyou mo noo dameeji"
    },
    {
      "text": "ズバッと威張ってたいのね?",
      "romaji": "zubatto ibattetai no! ne?"
    },
    {
      "text": "笑えるほどに弱虫よ",
      "romaji": "waraeru hodo ni yowamushi yo"
    },
    {
      "text": "踊るばぁかばぁか",
      "romaji": "odoru baaka baaka"
    },
    {
      "text": "無駄ねほらほら",
      "romaji": "muda ne hora hora"
    },
    {
      "text": "ごめんちょっとタンマ",
      "romaji": "gomen chotto tanma"
    },
    {
      "text": "大草原",
      "romaji": "daisougen"
    },
    {
      "text": "やばめドッキドキ",
      "romaji": "yabame dokkidoki"
    },
    {
      "text": "本音ラッキラッキー",
      "romaji": "honne rakkirakkii"
    },
    {
      "text": "マネジメントナンバー",
      "romaji": "manejimento nanbaa"
    },
    {
      "text": "無能無能無能",
      "romaji": "munou munou munou"
    },
    {
      "text": "意思のアンマッチ",
      "romaji": "ishi no anmacchi"
    },
    {
      "text": "過度に反対",
      "romaji": "kado ni hantai"
    },
    {
      "text": "ゴミも同然",
      "romaji": "gomi mo douzen"
    },
    {
      "text": "ワンパン",
      "romaji": "wanpan"
    },
    {
      "text": "あなたじゃ話にならん平凡",
      "romaji": "anata ja hanashi ni naran heibon"
    },
    {
      "text": "下等ねラヴィチュウ",
      "romaji": "katou ne ravi chuu"
    },
    {
      "text": "声を頂戴 涙頂戴",
      "romaji": "koe o choudai namida choudai"
    },
    {
      "text": "ヤミーヤミーヤミー",
      "romaji": "yamii yamii yamii"
    },
    {
      "text": "ラヴィラヴィラヴィ",
      "romaji": "ravi ravi ravi"
    },
    {
      "text": "弱音吐いて悶えたって",
      "romaji": "yowane haite modaeta tte"
    },
    {
      "text": "無駄で無駄で愚かさすら気付けないよね",
      "romaji": "muda de muda de orokasa sura kizukenai yo ne"
    },
    {
      "text": "喉渇いて血を含んで",
      "romaji": "nodo kawaite chi o fukunde"
    },
    {
      "text": "悪い悪い顔で笑う逃げちゃダメダメ",
      "romaji": "warui warui kao de warau nigecha damedame"
    },
    {
      "text": "手に入れろ生出して",
      "romaji": "te ni irero sei dashite"
    },
    {
      "text": "馬鹿だろお前まじで",
      "romaji": "baka daro omae maji de"
    },
    {
      "text": "この傷倍貸しね",
      "romaji": "kono kizu baikashi ne"
    },
    {
      "text": "恐怖から這いつくばって",
      "romaji": "kyoufu kara haitsukubatte"
    },
    {
      "text": "ヤミーヤミーラヴィ",
      "romaji": "yamii yamii ravi"
    }
  ]
}
