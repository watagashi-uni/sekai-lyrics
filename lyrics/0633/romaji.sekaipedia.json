  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "あっ みつけちゃった?",
      "romaji": "aa! mitsukechatta?"
    },
    {
      "text": "なにかおかしいこと",
      "romaji": "nanika okashii koto!"
    },
    {
      "text": "ふらふらふらあるいて",
      "romaji": "furafurafura aruite"
    },
    {
      "text": "すぎてくじかんは",
      "romaji": "sugiteku jikan wa"
    },
    {
      "text": "もとにはもどらないね",
      "romaji": "moto ni wa modoranai ne"
    },
    {
      "text": "だんだんとねむくなって",
      "romaji": "dandan to nemuku natte"
    },
    {
      "text": "わすれてしまう",
      "romaji": "wasurete shimau"
    },
    {
      "text": "じゃあ何千回も思い出そ",
      "romaji": "jaa! nanzenkai mo omoidasou"
    },
    {
      "text": "忘れちゃう前に",
      "romaji": "wasurechau mae ni"
    },
    {
      "text": "いっそどうにでもなれ",
      "romaji": "isso dou ni demo nare"
    },
    {
      "text": "時間が 過ぎてく 落ちてく",
      "romaji": "jikan ga sugiteku ochiteku"
    },
    {
      "text": "あっ いきとまった",
      "romaji": "aa iki tomatta"
    },
    {
      "text": "いつかさよならね",
      "romaji": "itsuka sayonara ne"
    },
    {
      "text": "ぐわぐわぐわきしんで",
      "romaji": "guwaguwaguwa kishinde"
    },
    {
      "text": "なにかおちたおと",
      "romaji": "nanika ochita oto"
    },
    {
      "text": "こわれてきえてったよ",
      "romaji": "kowarete kiete tta yo"
    },
    {
      "text": "さいごのおもいでを",
      "romaji": "saigo no omoide o"
    },
    {
      "text": "もうおもいだせない",
      "romaji": "mou omoidasenai"
    },
    {
      "text": "このゲームも終わる",
      "romaji": "kono geemu mo owaru"
    },
    {
      "text": "その時笑顔でいれるように",
      "romaji": "sono toki egao de ireru you ni"
    },
    {
      "text": "そうわたしがいたことは",
      "romaji": "sou! watashi ga ita koto wa"
    },
    {
      "text": "ここに存在している",
      "romaji": "koko ni sonzai shite iru!"
    },
    {
      "text": "ばかでかい海をみたら",
      "romaji": "baka dekai umi o mitara"
    },
    {
      "text": "もうしねるね",
      "romaji": "mou shineru ne!"
    }
  ]
}
