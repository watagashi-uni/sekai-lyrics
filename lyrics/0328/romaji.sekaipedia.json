{
  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/SEKAI-chan_to_KAFU-chan_no_Otsukai_Gassoukyoku",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "急かさんといて",
      "romaji": "sekasan toite"
    },
    {
      "text": "せかせかせかせか",
      "romaji": "sekaseka sekaseka"
    },
    {
      "text": "急かさんといてよ",
      "romaji": "sekasan toite yo"
    },
    {
      "text": "せかせかせんといて",
      "romaji": "sekaseka sen toite"
    },
    {
      "text": "今日は17時過ぎから",
      "romaji": "kyou wa juushichi-ji sugi kara"
    },
    {
      "text": "降水確率が90パー",
      "romaji": "kousui kakuritsu ga kyuujuu paa"
    },
    {
      "text": "まあ、晩御飯は",
      "romaji": "maa, ban gohan wa"
    },
    {
      "text": "ありもので済ませましょうか",
      "romaji": "ari mono de sumase mashou ka"
    },
    {
      "text": "オイラ夜はカレーうどんな気分なのだ",
      "romaji": "oira yoru wa karee udon na kibun na no da"
    },
    {
      "text": "具材もないし今度じゃダメかな？",
      "romaji": "guzai mo naishi kondo ja dame ka na?"
    },
    {
      "text": "ダメだYO!!! ダメかぁ",
      "romaji": "dame da YO!!! dame kaa"
    },
    {
      "text": "そしたらそしたらジャンケンで決めようYO!!! YO!!!",
      "romaji": "soshitara soshitara janken de kime you YO!!! YO!!!"
    },
    {
      "text": "おつかいジャンケンジャンケンポン",
      "romaji": "otsukai janken-jankenpon"
    },
    {
      "text": "俺はパーを出したぞ",
      "romaji": "ore wa paa o dashita zo"
    },
    {
      "text": "(負けました...)",
      "romaji": "(makemashita...)"
    },
    {
      "text": "勝っても負けてもまあ",
      "romaji": "katte mo makete mo maa"
    },
    {
      "text": "楽しかったらいいじゃないか",
      "romaji": "tanoshikattara ii janai ka"
    },
    {
      "text": "かふちゃん、ありがとうございました",
      "romaji": "KAFU-chan, arigatou gozaimashita"
    },
    {
      "text": "ではではではでは",
      "romaji": "de wa de wa de wa de wa"
    },
    {
      "text": "小雨降ってるけど知らんがなっ！",
      "romaji": "kosame futteru kedo shiran ga na!"
    },
    {
      "text": "走りゃどうにかなるやろがいっ！",
      "romaji": "hashirya dou ni ka naru yarogai!"
    },
    {
      "text": "せかせかせんと",
      "romaji": "sekaseka sento"
    },
    {
      "text": "せかせかしないと",
      "romaji": "sekaseka shinai to"
    },
    {
      "text": "こんな具材だけで大丈夫か",
      "romaji": "konna guzai dake de daijoubu ka"
    },
    {
      "text": "大丈夫だ問題ない",
      "romaji": "daijoubu da mondai nai"
    },
    {
      "text": "やっぱり気づいたの　買い忘れた",
      "romaji": "yappari kizuita no kai wasureta"
    },
    {
      "text": "(カレー固形タイプ)",
      "romaji": "(karee kokei taipu)"
    },
    {
      "text": "どうしてどうしては繰り返す",
      "romaji": "doushite doushite wa kurikaesu"
    },
    {
      "text": "(急がば回れ)",
      "romaji": "(iso ga bamaware)"
    },
    {
      "text": "明日の天気は晴れだからね",
      "romaji": "ashita no tenki wa hare dakara ne"
    },
    {
      "text": "(今日はひとまず)",
      "romaji": "(kyou wa hitomazu)"
    },
    {
      "text": "ナポリタンなら作れるから",
      "romaji": "naporitan nara tsukureru kara"
    },
    {
      "text": "我慢してね",
      "romaji": "gaman shite ne"
    },
    {
      "text": "ナポリタンなんかねぇYO うるせぇYO",
      "romaji": "naporitan nanka nee YO urusee YO"
    },
    {
      "text": "黙れYO  ナポリタンなんかねぇYO",
      "romaji": "damare YO naporitan nanka nee YO"
    },
    {
      "text": "カレーうどんこそが正義 ",
      "romaji": "karee udon koso ga seigi"
    },
    {
      "text": "ナポリタンねぇYO",
      "romaji": "naporitan nee YO"
    },
    {
      "text": "正しいのは私",
      "romaji": "tadashii no wa watashi"
    },
    {
      "text": "おつかいジャンケン",
      "romaji": "otsukai janken"
    },
    {
      "text": "俺の勝ち",
      "romaji": "ore no kachi"
    },
    {
      "text": "(えぇ～～～～)",
      "romaji": "(ee~~~~)"
    },
    {
      "text": "我慢ばっかでいつの間にやら",
      "romaji": "gaman bakka de itsu no mani yara"
    },
    {
      "text": "ヨボヨボだなんて嫌なのじゃ！",
      "romaji": "yoboyobo da nante iya na no ja!"
    },
    {
      "text": "ぐしょりぐしょりと濡れて濡れて",
      "romaji": "gushori gushori to nurete nurete"
    },
    {
      "text": "お願いだから",
      "romaji": "onegai dakara"
    }
  ]
}
