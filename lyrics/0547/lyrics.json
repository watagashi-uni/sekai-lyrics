{"musicId":547,"duration":108.96,"vocalId":1566,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-01","name":"星乃一歌"},{"performerId":"歌唱者-02","name":"天馬咲希"},{"performerId":"歌唱者-03","name":"望月穂波"},{"performerId":"歌唱者-04","name":"日野森志歩"},{"performerId":"歌唱者-24","name":"巡音ルカ"}],"lines":[{"start":22.5015,"end":25.3365,"text":"終夜ノ摩天楼は","translation":"彻夜不眠的摩天大楼","segments":[{"text":"終夜ノ摩天楼は","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":25.3365,"end":28.5695,"text":"月の裏の鴻鵠模様","translation":"是月之暗面的鸿鹄图纹","segments":[{"text":"月の裏の鴻鵠模様","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":28.7575,"end":30.3275,"text":"解 = 闘争？ 逃走？","translation":"解 = 斗争？逃走？","segments":[{"text":"解 = ","performerIds":["歌唱者-24"]},{"text":"闘争？ 逃走？","performerIds":["歌唱者-04"]}],"performerIds":[],"words":[{"from":0,"to":1,"start":28.7575,"end":28.9875},{"from":4,"to":5,"start":29.0875,"end":29.3925},{"from":5,"to":6,"start":29.3925,"end":29.6975},{"from":8,"to":9,"start":29.7175,"end":30.0225},{"from":9,"to":10,"start":30.0225,"end":30.3275}]},{"start":30.5375,"end":31.8875,"text":"奈落を絡で移動","translation":"缠绕着深渊深处移动","segments":[{"text":"奈落を絡で移動","performerIds":["歌唱者-03"]}],"performerIds":[]},{"start":31.7305,"end":42.5975,"text":"勢い侭、走り抜けよ。","translation":"顺着这股势头，径直冲破吧。","segments":[{"text":"勢い侭、走り抜けよ。","performerIds":["歌唱者-02"]}],"performerIds":[]},{"start":42.5975,"end":45.1345,"text":"青ノ印を結う時は","translation":"结下苍蓝印记之时","segments":[{"text":"青ノ印を結う時は","performerIds":["歌唱者-24"]}],"performerIds":[]},{"start":45.1345,"end":48.5805,"text":"呼吸を深く、両の眼は閉じて。","translation":"深深吸一口气，紧闭双眼。","segments":[{"text":"呼吸を深く、両の眼は閉じて。","performerIds":["歌唱者-24"]}],"performerIds":[]},{"start":48.6875,"end":49.7975,"text":"強制≠共生","translation":"强制≠共生","segments":[{"text":"強制≠共生","performerIds":["歌唱者-02"]}],"performerIds":[],"words":[{"from":0,"to":1,"start":48.6875,"end":48.9875},{"from":1,"to":2,"start":48.9875,"end":49.2875},{"from":3,"to":4,"start":49.2875,"end":49.5425},{"from":4,"to":5,"start":49.5425,"end":49.7975}]},{"start":50.1175,"end":51.4675,"text":"堕落を搾で試行 ","translation":"榨取堕落尝试前行","segments":[{"text":"堕落を搾で試行 ","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":51.5375,"end":55.5205,"text":"勢い侭、斬り捨てていけよ。","translation":"顺着这股势头，尽情斩断舍弃吧。","segments":[{"text":"勢い侭、斬り捨てていけよ。","performerIds":["歌唱者-03"]}],"performerIds":[]},{"start":55.5205,"end":58.0715,"text":"祈って 只待って居れば ","translation":"若只是祈祷 静静等待","segments":[{"text":"祈って 只待って居れば ","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":58.0715,"end":62.2215,"text":"何か変わるか？ 救われた気にでもなるか？","translation":"就会有所改变吗？就能自以为得到拯救了吗？","segments":[{"text":"何か変わるか？ 救われた気にでもなるか？","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":62.2215,"end":65.0435,"text":"依然 「労いは糧になる」と","translation":"依然说着「慰劳能化作食粮」","segments":[{"text":"依然 「労いは糧になる」と","performerIds":["歌唱者-24"]}],"performerIds":[]},{"start":65.0435,"end":67.7905,"text":"吐き捨てて言った。","translation":"啐了一口吐露而出。","segments":[{"text":"吐き捨てて言った。","performerIds":["歌唱者-24"]}],"performerIds":[]},{"start":67.7905,"end":70.3325,"text":"刃、風を斬る様。","translation":"刀刃如斩断疾风之姿。","segments":[{"text":"刃、風を斬る様。","performerIds":["歌唱者-02","歌唱者-04","歌唱者-24"]}],"performerIds":[]},{"start":70.3325,"end":74.3055,"text":"泡沫に酔う音の渦を。","translation":"斩断沉醉于泡沫的音之漩涡。","segments":[{"text":"泡沫に酔う音の渦を。","performerIds":["歌唱者-02","歌唱者-04","歌唱者-24"]}],"performerIds":[]},{"start":74.3055,"end":77.9955,"text":"明鏡振るう因果をも「陶然」と","translation":"将挥动明镜的因果也视作「陶然自得」","segments":[{"text":"明鏡振るう因果をも「陶然」と","performerIds":["歌唱者-01","歌唱者-03"]}],"performerIds":[]},{"start":77.9955,"end":81.3155,"text":"見切って逸そ、逃げてしまえたら。","translation":"若能看破这一切索性逃之夭夭。","segments":[{"text":"見切って逸そ、逃げてしまえたら。","performerIds":["歌唱者-01","歌唱者-03"]}],"performerIds":[]},{"start":81.3155,"end":84.2675,"text":"花霞と刹那の街","translation":"笼罩花霞的刹那街市","segments":[{"text":"花霞と刹那の街","performerIds":["歌唱者-02","歌唱者-24"]}],"performerIds":[]},{"start":84.2675,"end":87.8175,"text":"—さあ、峡谷ノ都市へと急ごう！","translation":"——来吧，快赶往峡谷都市！","segments":[{"text":"—さあ、峡谷ノ都市へと急ごう！","performerIds":["歌唱者-02","歌唱者-24"]}],"performerIds":[]},{"start":87.8175,"end":90.6615,"text":"数は約二百京里","translation":"距离约有两百京里","segments":[{"text":"数は約二百京里","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":90.6615,"end":92.7945,"text":"—足は、動く。","translation":"——脚步，迈动着。","segments":[{"text":"—足は、動く。","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":92.7945,"end":95.7215,"text":"雨音、十六夜の月","translation":"雨声，十六夜之月","segments":[{"text":"雨音、十六夜の月","performerIds":["歌唱者-01","歌唱者-24"]}],"performerIds":[]},{"start":95.7215,"end":99.3075,"text":"—不途 此の時を待ち侘びていた","translation":"——不知不觉间苦苦期盼着此时此刻","segments":[{"text":"—不途 此の時を待ち侘びていた","performerIds":["歌唱者-01","歌唱者-24"]}],"performerIds":[]},{"start":99.3075,"end":102.4565,"text":"余す事無く願いは","translation":"毫无保留的心愿","segments":[{"text":"余す事無く願いは","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":102.4565,"end":103.3125,"text":"—叶う、今。","translation":"——就在此刻，实现。","segments":[{"text":"—叶う、今。","performerIds":["歌唱者-01"]}],"performerIds":[]}],"credits":{"translation":"雪莹ちゃん"},"sources":[["https://www.sekaipedia.org/wiki/Shuuen_Touhikou?oldid=330631","CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}