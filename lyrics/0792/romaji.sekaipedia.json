  "lines": [
    {
      "text": "もしも僕がうそつきなら",
      "romaji": "moshimo boku ga usotsuki nara"
    },
    {
      "text": "そんなたくさんの「もしも話が」",
      "romaji": "sonna takusan no \"moshimo banashi ga\""
    },
    {
      "text": "僕の部屋にさ浮かんで行くんだよ",
      "romaji": "boku no heya ni sa ukande iku nda yo."
    },
    {
      "text": "何も無い日々から",
      "romaji": "nani mo nai hibi kara"
    },
    {
      "text": "罅が入ってそっから",
      "romaji": "hibi ga haitte sokkara"
    },
    {
      "text": "たくさんの「もしも」が漏れ出して",
      "romaji": "takusan no \"moshimo\" ga moredashite"
    },
    {
      "text": "行くんだ",
      "romaji": "iku nda."
    },
    {
      "text": "今目をつむって",
      "romaji": "ima me o tsumutte"
    },
    {
      "text": "耳をふさいで歩き出したよ",
      "romaji": "mimi o fusaide arukidashita yo"
    },
    {
      "text": "君の声も君の笑顔も",
      "romaji": "kimi no koe mo kimi no egao mo"
    }
  ]
}
