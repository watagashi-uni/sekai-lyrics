  "lines": [
    {
      "text": "Lazy Rainy My Soulは",
      "romaji": "Lazy Rainy My Soul wa"
    },
    {
      "text": "ご機嫌ななめ",
      "romaji": "gokigen na name"
    },
    {
      "text": "関係整理整頓が",
      "romaji": "kankei seiri seiton ga"
    },
    {
      "text": "道で交錯",
      "romaji": "michi de kousaku"
    },
    {
      "text": "Rhythmばかりが",
      "romaji": "Rhythm bakari ga"
    },
    {
      "text": "先走るの",
      "romaji": "saki bashiru no"
    },
    {
      "text": "情熱のままTry",
      "romaji": "jounetsu no mama Try"
    },
    {
      "text": "君が悪い訳じゃない",
      "romaji": "kimi ga warui wake janai"
    },
    {
      "text": "Trip Step重ねたいよ",
      "romaji": "Trip Step kasanetai yo"
    },
    {
      "text": "いつまでも夜を",
      "romaji": "itsumademo yoru o"
    },
    {
      "text": "共に明せるなら",
      "romaji": "tomo ni akaseru nara"
    },
    {
      "text": "空へと羽を広げた",
      "romaji": "sora e to hane o hirogeta"
    },
    {
      "text": "音を愛して",
      "romaji": "oto o aishite"
    },
    {
      "text": "夢の花が溢れ出す",
      "romaji": "yume no hana ga afuredasu"
    },
    {
      "text": "気高く綺麗に",
      "romaji": "kedakaku kirei ni"
    },
    {
      "text": "咲かせるからさ",
      "romaji": "sakaseru kara sa"
    },
    {
      "text": "傍にいると忘れないでね",
      "romaji": "soba ni iru to wasurenai de ne"
    },
    {
      "text": "ただ素直に 椅子を近付けて",
      "romaji": "tada sunao ni isu o chikazukete"
    },
    {
      "text": "指を結びたいと踏み出した",
      "romaji": "yubi o musubitai to fumidashita"
    },
    {
      "text": "歩幅の差を気にも留めないまま",
      "romaji": "hohaba no sa o ki ni mo tomodemenai mama"
    },
    {
      "text": "歌っても良いかい?",
      "romaji": "utatte mo iikai?"
    },
    {
      "text": "背中合わせが崩れても",
      "romaji": "senaka awase ga kuzurete mo"
    },
    {
      "text": "憧れでは終わらない",
      "romaji": "akogare de wa owaranai"
    }
  ]
}
