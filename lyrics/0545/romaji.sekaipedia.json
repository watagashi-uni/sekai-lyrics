  "lines": [
    {
      "text": "苦しみだけが奥に滞在",
      "romaji": "kurushimi dake ga oku ni taizai"
    },
    {
      "text": "忘れたいならこれを調剤して",
      "romaji": "wasuretai nara kore o chouzai shite"
    },
    {
      "text": "再会求めてるようなら最下位",
      "romaji": "saikai motometeru you nara saikai"
    },
    {
      "text": "重ねた音をまだ聴きたい？",
      "romaji": "kasaneta oto o mada kikitai?"
    },
    {
      "text": "鎮めてほしいだけ",
      "romaji": "shizumete hoshii dake"
    },
    {
      "text": "ホント最低だ",
      "romaji": "honto saitei da"
    },
    {
      "text": "歌え歌え骨になって",
      "romaji": "utae utae hone ni natte"
    },
    {
      "text": "歌え歌え歌え！",
      "romaji": "utae utae utae!"
    },
    {
      "text": "きっと殴られたい殴られたいの？",
      "romaji": "kitto naguraretai naguraretai no?"
    },
    {
      "text": "折ってしまうよその声を",
      "romaji": "oritte shimau yo sono koe o"
    },
    {
      "text": "終わらせたい",
      "romaji": "owarasetai"
    },
    {
      "text": "終わらせたいよ",
      "romaji": "owarasetai yo"
    },
    {
      "text": "脳天、バットで",
      "romaji": "nouten, batto de"
    },
    {
      "text": "殴りたいぶん殴りたいの",
      "romaji": "naguritai bunnaguritai no"
    },
    {
      "text": "奪ってしまうよその肥を",
      "romaji": "ubatte shimau yo sono koe o"
    },
    {
      "text": "あぁ、つまらない",
      "romaji": "aa, tsumaranai"
    },
    {
      "text": "あぁ、つまらないな",
      "romaji": "aa, tsumaranai na"
    }
  ]
}
