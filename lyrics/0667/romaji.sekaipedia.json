  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/Musekinin_Shuugoutai",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "おれは　しらない　なにも　しらない",
      "romaji": "ore wa shiranai nani mo shiranai"
    },
    {
      "text": "なにも　みてない　だれも　みてない",
      "romaji": "nani mo mitenai dare mo mitenai"
    },
    {
      "text": "そらを　みても　みえない　よるの",
      "romaji": "sora o mite mo mienai yoru no"
    },
    {
      "text": "かけた　つきに　うさぎ",
      "romaji": "kaketa tsuki ni usagi"
    },
    {
      "text": "これは　なんだ　それが　なにか？",
      "romaji": "kore wa nanda sore ga nanika?"
    },
    {
      "text": "ここは　たのし　それで　よろし",
      "romaji": "koko wa tanoshi sore de yoroshi"
    },
    {
      "text": "はしる　にげる　にがす　そらす",
      "romaji": "hashiru nigeru nigasu sorasu"
    },
    {
      "text": "月の　欠けた　場所へ",
      "romaji": "tsuki no kaketa basho e"
    },
    {
      "text": "あらら　あらら　あらら　あらら　あらら",
      "romaji": "arara arara arara arara arara"
    },
    {
      "text": "妄想　止め処なく",
      "romaji": "mousou tomedonaku"
    },
    {
      "text": "創造　咎めなく",
      "romaji": "souzou togamenaku"
    },
    {
      "text": "衝動　収まらず",
      "romaji": "shoudou osamarazu"
    },
    {
      "text": "なぜか　なぜか　なぜか　なぜかしら？",
      "romaji": "nazeka nazeka nazeka nazekashira?"
    },
    {
      "text": "最高だ！",
      "romaji": "saikou da!"
    },
    {
      "text": "脳が硬化してんだ",
      "romaji": "nou ga kouka shite nda"
    },
    {
      "text": "ぶっ壊して叫べ！",
      "romaji": "bukkowashite sakebe!"
    },
    {
      "text": "なんでなんでつって",
      "romaji": "nande nande tsutte"
    },
    {
      "text": "跋扈跋扈跳ねちゃって",
      "romaji": "bakko bakko hanechatte"
    },
    {
      "text": "愚行奇行で結構",
      "romaji": "gukou kikou de kekkou"
    },
    {
      "text": "勝手に生きたれ！",
      "romaji": "katte ni ikitare!"
    },
    {
      "text": "いやーもうほんと",
      "romaji": "iyaa mou honto"
    },
    {
      "text": "最高だだだだだ",
      "romaji": "saikou da! da! da! da! da!"
    },
    {
      "text": "イエッサー",
      "romaji": "iessaa!!"
    },
    {
      "text": "むかしむかしのおもいつき",
      "romaji": "mukashi mukashi no omoitsuki"
    },
    {
      "text": "むいぎむいみのひとだかり",
      "romaji": "muigi muimi no hitodakari"
    },
    {
      "text": "むじゃきむてきのうまれつき",
      "romaji": "mujaki muteki no umaretsuki"
    },
    {
      "text": "それが",
      "romaji": "sore ga"
    },
    {
      "text": "㋰責任集合体",
      "romaji": "musekinin shuugoutai"
    },
    {
      "text": "アンタもワタシも関係ない",
      "romaji": "anta mo watashi mo kankeinai"
    },
    {
      "text": "楽しくやってりゃ無問題",
      "romaji": "tanoshiku yatterya moumantai"
    },
    {
      "text": "勝手にやってりゃ問題ナシ",
      "romaji": "katte ni yatterya mondai nashi"
    },
    {
      "text": "俺は　知らない　何も　知らない",
      "romaji": "ore wa shiranai nani mo shiranai"
    },
    {
      "text": "何も　見てない　誰も　見てない",
      "romaji": "nani mo mitenai dare mo mitenai"
    },
    {
      "text": "記憶　違い　夢の　話",
      "romaji": "kioku chigai yume no hanashi"
    },
    {
      "text": "そういう　ことで　それじゃ",
      "romaji": "sou iu koto de sore ja"
    }
  ]
}
