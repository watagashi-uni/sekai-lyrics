  "lines": [
    {
      "text": "みんなハンドサインで",
      "romaji": "minna hando sain de"
    },
    {
      "text": "テレパシー受けとってね",
      "romaji": "terepashii uketotte ne"
    },
    {
      "text": "チャンネル39にあわせて",
      "romaji": "channeru \"39 (sankyuu)\" ni awasete"
    },
    {
      "text": "一同全裸になって待機セヨ",
      "romaji": "ichidou zenra ni natte taiki se yo"
    },
    {
      "text": "感情が一つになって",
      "romaji": "kanjou ga hitotsu ni natte"
    },
    {
      "text": "そう海越えて",
      "romaji": "sou umi koete"
    },
    {
      "text": "空を越えて",
      "romaji": "sora o koete"
    },
    {
      "text": "君の中へ",
      "romaji": "kimi no naka e..."
    },
    {
      "text": "39みゅーじっく",
      "romaji": "39 (sankyuu) myuujikku!"
    },
    {
      "text": "さぁ日は出づるぞ",
      "romaji": "saa hi wa izuru zo"
    },
    {
      "text": "準備OK？Yes",
      "romaji": "junbi OK? Yes!"
    },
    {
      "text": "満場一致だ",
      "romaji": "manjou icchi da!"
    }
  ]
}
