  "lines": [
    {
      "text": "人生相談があります",
      "romaji": "jinsei soudan ga arimasu"
    },
    {
      "text": "聞いてくれますか先生",
      "romaji": "kiite kuremasu ka sensei"
    },
    {
      "text": "大概病んでる生活",
      "romaji": "taigai yanderu seikatsu"
    },
    {
      "text": "退会させてよ先生",
      "romaji": "taikai sasete yo sensei"
    },
    {
      "text": "人生辛抱わかって",
      "romaji": "jinsei shinbou wakatte"
    },
    {
      "text": "気付いてくれますか先生",
      "romaji": "kizuite kuremasu ka sensei"
    },
    {
      "text": "早退させてよ先生",
      "romaji": "soutai sasete yo sensei"
    },
    {
      "text": "オレンジ色に染まる君は",
      "romaji": "orenji iro ni somaru kimi wa"
    },
    {
      "text": "やがて暗闇に染まる溶ける",
      "romaji": "yagate kurayami ni somaru tokeru"
    },
    {
      "text": "月日が経っても消えない苦しみ",
      "romaji": "tsukihi ga tatte mo kienai kurushimi"
    },
    {
      "text": "不気味な夜を君と共に<",
      "romaji": "bukimi na yoru o kimi to tomo ni"
    },
    {
      "text": "おやすみ おやすみ",
      "romaji": "oyasumi oyasumi"
    },
    {
      "text": "おやすみ おかえり",
      "romaji": "oyasumi okaeri"
    },
    {
      "text": "感情的になってバイバイだ",
      "romaji": "kanjouteki ni natte baibai da"
    },
    {
      "text": "誰よりも速く遠くへ行けよ",
      "romaji": "dare yori mo hayaku tooku e yuke yo"
    },
    {
      "text": "後戻りはしないよ",
      "romaji": "atomodori wa shinai yo"
    },
    {
      "text": "後先なんてないから",
      "romaji": "atosaki nante nai kara"
    },
    {
      "text": "衝動的になって正解だ",
      "romaji": "shoudouteki ni natte seikai da"
    },
    {
      "text": "誰よりも夜を越えて行けよ",
      "romaji": "dare yori mo yoru o koete yuke yo"
    },
    {
      "text": "嫌い",
      "romaji": "kirai"
    },
    {
      "text": "辛い",
      "romaji": "tsurai"
    },
    {
      "text": "有象無象",
      "romaji": "uzou muzou"
    },
    {
      "text": "不承不承",
      "romaji": "fushou bushou"
    }
  ]
}
