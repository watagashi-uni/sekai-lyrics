  "lines": [
    {
      "text": "考えすぎのメッセージ",
      "romaji": "kangaesugi no messeiji"
    },
    {
      "text": "誰に届くかも知らないで",
      "romaji": "dare ni mo todoku kamo shirenai de"
    },
    {
      "text": "きっと私はいつでもそう",
      "romaji": "kitto watashi wa itsudemo sou"
    },
    {
      "text": "継ぎ接ぎ狂ったマトリョシカ",
      "romaji": "tsugihagi kurutta matoryoshika"
    },
    {
      "text": "頭痛が歌うパッケージ",
      "romaji": "zutsuu ga utau pakkeiji"
    },
    {
      "text": "いつまで経っても針は四時",
      "romaji": "itsumade hatte mo hari wa yoji"
    },
    {
      "text": "誰も教えてくれないで",
      "romaji": "daremo oshiete kurenaide"
    },
    {
      "text": "世界は逆さに回り出す",
      "romaji": "sekai wa sakasa ni mawaridasu"
    },
    {
      "text": "あぁ、割れそうだ",
      "romaji": "aa, waresou da"
    },
    {
      "text": "記憶も全部投げ出して",
      "romaji": "kioku mo zenbu nagedashite"
    },
    {
      "text": "あぁ、知りたいな",
      "romaji": "aa, shiritai na"
    },
    {
      "text": "深くまで",
      "romaji": "fukaku made"
    },
    {
      "text": "あのね、もっといっぱい舞って頂戴",
      "romaji": "ano ne, motto ippai matte choudai"
    },
    {
      "text": "カリンカ？マリンカ？ 弦を弾いて",
      "romaji": "karinka? marinka? gen o hajiite"
    },
    {
      "text": "こんな感情どうしようか？",
      "romaji": "konna kanjou doushiyou ka?"
    },
    {
      "text": "ちょっと教えてくれないか？",
      "romaji": "chotto oshiete kurenai ka?"
    },
    {
      "text": "感度良好　５２４",
      "romaji": "kandoryoukou 524"
    },
    {
      "text": "フロイト？ケロイド？ 鍵を叩いて",
      "romaji": "furoito? keroido? ken o hataite"
    },
    {
      "text": "全部全部笑っちゃおうぜ",
      "romaji": "zenbu zenbu waracchaou ze"
    },
    {
      "text": "さっさと踊れ　馬鹿溜まり",
      "romaji": "sassato odore baka tamari"
    },
    {
      "text": "てんで幼稚な手を叩こう",
      "romaji": "tende youchi na te o tatakou"
    },
    {
      "text": "わざと狂った調子でほら",
      "romaji": "waza to kurutta choushi de hora"
    },
    {
      "text": "きっと私はどうでもいい",
      "romaji": "kitto watashi wa dou demo ii"
    },
    {
      "text": "世界の温度が溶けて行く",
      "romaji": "sekai no ondo ga toketeiku"
    },
    {
      "text": "あなたと私でランデブー？",
      "romaji": "anata to watashi de randebuu?"
    },
    {
      "text": "ランデブー？ランデブー？",
      "romaji": "randebuu? randebuu?"
    },
    {
      "text": "あらま飛んでったアバンチュール？",
      "romaji": "ara ma tondetta abanchuuru?"
    },
    {
      "text": "足取り歪んで　１、２　１、２",
      "romaji": "ashidori yugande 1-2 1-2"
    },
    {
      "text": "あぁ、吐きそうだ",
      "romaji": "aa, hakisou da"
    },
    {
      "text": "私の全部受けとめて",
      "romaji": "watashi no zenbu uketomete"
    },
    {
      "text": "あぁ、その両手で",
      "romaji": "aa, sono ryoute de"
    },
    {
      "text": "受けとめて",
      "romaji": "uketomete"
    }
  ]
}
