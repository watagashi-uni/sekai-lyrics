  "lines": [
    {
      "text": "人生は酸っぱくて",
      "romaji": "jinsei wa suppakute"
    },
    {
      "text": "人生は甘い味",
      "romaji": "jinsei wa amai aji"
    },
    {
      "text": "どっちでも変わらない",
      "romaji": "docchi demo kawaranai"
    },
    {
      "text": "人生の味",
      "romaji": "jinsei no aji"
    },
    {
      "text": "(確かに)",
      "romaji": "(tashika ni)"
    },
    {
      "text": "君の手で直接作ってほしい",
      "romaji": "kimi no te de chokusetsu tsukutte hoshii"
    },
    {
      "text": "結果なんか忘れちゃって",
      "romaji": "kekka nanka wasurechatte"
    },
    {
      "text": "もちもちに",
      "romaji": "mochimochi ni"
    },
    {
      "text": "爽やかに",
      "romaji": "sawayaka ni"
    },
    {
      "text": "僕の",
      "romaji": "boku no"
    },
    {
      "text": "レモン・メロン",
      "romaji": "remon meron"
    },
    {
      "text": "クッキー",
      "romaji": "kukkii"
    },
    {
      "text": "クッキー・クッキー",
      "romaji": "kukkii kukkii"
    },
    {
      "text": "全部僕のもの",
      "romaji": "zenbu boku no mono"
    },
    {
      "text": "君と一緒にいられた時間は",
      "romaji": "kimi to issho ni irareta jikan wa"
    },
    {
      "text": "まるで",
      "romaji": "marude"
    },
    {
      "text": "酸っぱくって甘い味",
      "romaji": "suppakutte amai aji"
    },
    {
      "text": "君と僕のレモンメロンクッキーみたいに",
      "romaji": "kimi to boku no remon meron kukkii mitai ni"
    },
    {
      "text": "僕の中で君を組み立てて",
      "romaji": "boku no naka de kimi o kumitatete"
    },
    {
      "text": "特に特別な",
      "romaji": "toku ni tokubetsu na"
    },
    {
      "text": "最高のレシピ",
      "romaji": "saikou no reshipi"
    },
    {
      "text": "あのねさー一口",
      "romaji": "ano ne saa hitoguchi"
    },
    {
      "text": "かじってみてよ",
      "romaji": "kajitte mite yo"
    },
    {
      "text": "君のピッスをピースをピースをピースを",
      "romaji": "kimi no pissu o piisu o piisu o piisu o"
    },
    {
      "text": "さくさく集めて",
      "romaji": "sakusaku atsumete"
    },
    {
      "text": "まるでキラリキラリ不思議なハモリ",
      "romaji": "marude kirari kirari fushigi na hamori"
    },
    {
      "text": "(永遠に一緒だよ)",
      "romaji": "(eien ni issho da yo)"
    },
    {
      "text": "君を傍に傍に傍に",
      "romaji": "kimi o soba ni soba ni soba ni"
    },
    {
      "text": "飾って大切にして",
      "romaji": "kazatte taisetsu ni shite"
    },
    {
      "text": "ドキドキズキズキレモンメロンクッキー",
      "romaji": "dokidoki zukizuki remon meron kukkii"
    },
    {
      "text": "心が痛いよ",
      "romaji": "kokoro ga itai yo"
    },
    {
      "text": "君の",
      "romaji": "kimi no"
    },
    {
      "text": "(食べてよ)",
      "romaji": "(tabete yo)"
    },
    {
      "text": "さよなら、寂しいクッキー",
      "romaji": "sayonara, sabishii kukkii"
    },
    {
      "text": "トゥルル ディ ラ",
      "romaji": "tururu di ra"
    },
    {
      "text": "ラッ ティラリ ドゥラ",
      "romaji": "ra ttirari dura"
    },
    {
      "text": "(レモンメロンクッキークッキー)",
      "romaji": "(remon meron kukkii kukkii)"
    }
  ]
}
