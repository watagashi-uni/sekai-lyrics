  "lines": [
    {
      "text": "実際の感情はNo Think!",
      "romaji": "jissai no kanjou wa No Think!"
    },
    {
      "text": "気付かないフリ...？",
      "romaji": "kizukanai furi...?"
    },
    {
      "text": "絶対的な虚実と心中",
      "romaji": "zettaiteki na kyojitsu to shinchuu"
    },
    {
      "text": "そうやって減っていく安置",
      "romaji": "sou yatte hette iku anchi"
    },
    {
      "text": "傷の切り売り",
      "romaji": "kizu no kiriuri"
    },
    {
      "text": "脆く叫ぶ、醜態",
      "romaji": "moroku sakebu, shuutai"
    },
    {
      "text": "そんなあなたにオススメ！",
      "romaji": "sonna anata ni osusume!"
    },
    {
      "text": "最高級の逃避行",
      "romaji": "saikoukyuu no touhikou"
    },
    {
      "text": "やがて、甘美な罠に",
      "romaji": "yagate, kanbi na wana ni"
    },
    {
      "text": "釣られたものから救われる？",
      "romaji": "tsurareta mono kara sukuwareru?"
    },
    {
      "text": "もはや正気の沙汰では",
      "romaji": "mohaya shouki no sata de wa"
    },
    {
      "text": "やっていけないこの娑婆じゃ",
      "romaji": "yatte ikenai kono shaba ja"
    },
    {
      "text": "敢えて素知らぬ顔で",
      "romaji": "aete soshiranu kao de"
    },
    {
      "text": "身を任せるのが最適解？",
      "romaji": "mi wo makaseru no ga saitekikai?"
    },
    {
      "text": "言葉で飾った花束も",
      "romaji": "kotoba de kazatta hanataba mo"
    },
    {
      "text": "心を奪えば、本物か？",
      "romaji": "kokoro wo ubaeba, honmono ka?"
    },
    {
      "text": "全てが染まっていくような",
      "romaji": "subete ga somatte iku you na"
    },
    {
      "text": "事象にご招",
      "romaji": "jishou ni goshoutai"
    },
    {
      "text": "さらば！",
      "romaji": "saraba!"
    },
    {
      "text": "こんな時代に誂えた",
      "romaji": "konna jidai ni atsuraeta"
    },
    {
      "text": "見て呉れの脆弱性",
      "romaji": "mitekure no kijakusei"
    },
    {
      "text": "本当の芝居で騙される",
      "romaji": "hontou no shibai de damasareru"
    },
    {
      "text": "矢鱈と煩い心臓の鼓動",
      "romaji": "yatara to urusai shinzou no kodou"
    },
    {
      "text": "残機は疾うにないなっている；；",
      "romaji": "ttzangi wa tou ni nai natte iru ;-;"
    },
    {
      "text": "擦り減る耐久性",
      "romaji": "suriheru taikyuusei"
    },
    {
      "text": "目の前の事象を躱しつつ",
      "romaji": "me no mae no jishou wo kawashi tsutsu"
    },
    {
      "text": "生きるので手一杯！",
      "romaji": "ikiru no de teippai!"
    },
    {
      "text": "誰か、助けてね(^^♪",
      "romaji": "dareka, tasukete ne (^^♪"
    },
    {
      "text": "「あなた段々眠くなる」",
      "romaji": "\"anata dandan nemuku naru\""
    },
    {
      "text": "浅はかな催眠術",
      "romaji": "asahaka na mezumaraizu"
    },
    {
      "text": "頭、身体、煙に巻く",
      "romaji": "atama, karada, kemu ni maku"
    },
    {
      "text": "まさか、数多誑かす！？",
      "romaji": "masaka, amata taburakasu!?"
    },
    {
      "text": "目の前で揺らぐ硬貨",
      "romaji": "me no mae de yuragu kouka"
    },
    {
      "text": "動かなくなる彼方...",
      "romaji": "ugokanaku naru kanata..."
    },
    {
      "text": "どんなに今日を生き抜いても",
      "romaji": "donna ni kyou wo ikinuite mo"
    },
    {
      "text": "報われぬEveryday",
      "romaji": "mukuwarenu Everyday"
    },
    {
      "text": "もうBotみたいなサイクルで",
      "romaji": "mou Bot mitai na saikuru de"
    },
    {
      "text": "惰性の瞬間を続けているのだ",
      "romaji": "dasei no shunkan wo tsuzukete iru no da"
    },
    {
      "text": "運も希望も無いならば",
      "romaji": "un mo kibou mo nai naraba"
    },
    {
      "text": "尚更しょうがねえ",
      "romaji": "naosara shou ga nee"
    },
    {
      "text": "無いもんは無いで、諦めて",
      "romaji": "nai mon wa nai de, akiramete"
    },
    {
      "text": "余物で勝負するのが運命",
      "romaji": "amari mon de shoubu suru no ga sadame"
    },
    {
      "text": "賛美はもう意味ないなっている；；",
      "romaji": "sanbi wa mou imi nai natte iru ;-;"
    },
    {
      "text": "偽のカリスマ性",
      "romaji": "nise no karisumasei"
    },
    {
      "text": "現実を直視しすぎると",
      "romaji": "genjitsu wo chokushi shi sugiru to"
    },
    {
      "text": "失明しちゃうんだ！",
      "romaji": "shitsumei shichau nda!"
    },
    {
      "text": "だから、適度にね(^^♪",
      "romaji": "dakara, tekido ni ne (^^♪"
    }
  ]
}
