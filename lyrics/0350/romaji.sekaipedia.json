  "lines": [
    {
      "text": "「さあ、 眠りなさい」",
      "romaji": "\"saa, nemurinasai...\""
    },
    {
      "text": "眠りなさいこのgiftで",
      "romaji": "nemurinasai kono gift de"
    },
    {
      "text": "よく眠れるこのgiftで",
      "romaji": "yoku nemureru kono gift de"
    },
    {
      "text": "私はそう眠らせ姫",
      "romaji": "watashi wa sou nemurase hime"
    },
    {
      "text": "貴方の幸せの為に",
      "romaji": "anata no shiawase no tame ni..."
    },
    {
      "text": "政略の果て決められた婚姻",
      "romaji": "seiryaku no hate kimerareta kon'in"
    },
    {
      "text": "それでも貴方を愛した",
      "romaji": "soredemo anata o aishita"
    },
    {
      "text": "欲に溺れる無能な遊び人",
      "romaji": "yoku ni oboreru munou na asobinin"
    },
    {
      "text": "だけど前から好きだった",
      "romaji": "dakedo mae kara suki datta"
    },
    {
      "text": "医者の娘の財産だけ目当て",
      "romaji": "isha no musume no zaisan dake meate"
    },
    {
      "text": "別にそれでも幸せよ",
      "romaji": "betsu ni soredemo shiawase yo"
    },
    {
      "text": "幼い頃の約束も忘れて",
      "romaji": "osanai koro no yakusoku mo wasurete"
    },
    {
      "text": "いいのあなたのそばにいられれば",
      "romaji": "ii no anata no soba ni irarereba"
    },
    {
      "text": "不安な情緒悩む貴方に",
      "romaji": "fuan na joucho nayamu anata ni"
    },
    {
      "text": "とてもいい薬があるのよ",
      "romaji": "totemo ii kusuri ga aru no yo"
    },
    {
      "text": "私からのプレゼント",
      "romaji": "watashi kara no purezento"
    },
    {
      "text": "眠りなさいこの薬で",
      "romaji": "nemurinasai kono gift de"
    },
    {
      "text": "よく眠れるこの薬で",
      "romaji": "yoku nemureru kono gift de"
    }
  ]
}
