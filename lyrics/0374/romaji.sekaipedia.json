  "lines": [
    {
      "text": "挑みたい　叶えたい",
      "romaji": "idomitai kanaetai"
    },
    {
      "text": "不安すら楽しもう",
      "romaji": "fuan sura tanoshimou"
    },
    {
      "text": "大丈夫　離さない",
      "romaji": "daijoubu hanasanai"
    },
    {
      "text": "僕らの結び目はほどけない",
      "romaji": "bokura no musubime wa hodokenai"
    },
    {
      "text": "あの時ああしていれば",
      "romaji": "ano toki aa shite ireba"
    },
    {
      "text": "あの時こうしていれば",
      "romaji": "ano toki koushite ireba"
    },
    {
      "text": "きっとこの先も後悔はあって",
      "romaji": "kitto kono saki mo koukai wa atte"
    },
    {
      "text": "それでも僕らは決める",
      "romaji": "soredemo bokura wa kimeru"
    },
    {
      "text": "悩みながら生きていく",
      "romaji": "nayami nagara ikite iku"
    },
    {
      "text": "でもね傷つくことには慣れないね",
      "romaji": "demo ne kizutsuku koto ni wa narenai ne"
    },
    {
      "text": "一人きりじゃ　笑えていない",
      "romaji": "hitorikiri ja waraete inai"
    },
    {
      "text": "喜びさえも　分かち合えない",
      "romaji": "yorokobi sae mo wakachiaenai"
    },
    {
      "text": "君といたい　初めてだった",
      "romaji": "kimi to itai hajimete datta"
    },
    {
      "text": "痛みさえも　分かち合いたい　なんて",
      "romaji": "itami sae mo wakachiaitai nante"
    },
    {
      "text": "歌いたい　踊りたい",
      "romaji": "utaitai odoritai"
    },
    {
      "text": "明日すら　待てない",
      "romaji": "ashita sura matenai"
    },
    {
      "text": "”好き”だけじゃ　伝わらない",
      "romaji": "\"suki\" dake ja tsutawaranai"
    },
    {
      "text": "この想いは何？",
      "romaji": "kono omoi wa nani?"
    },
    {
      "text": "不安すら楽しめ",
      "romaji": "fuan sura tanoshime"
    }
  ]
}
