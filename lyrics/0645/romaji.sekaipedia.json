  "lines": [
    {
      "text": "仇花すっかり舞い散る季節",
      "romaji": "adabana sukkari maichiru kisetsu"
    },
    {
      "text": "踏み切りの向こう側で泣いてる",
      "romaji": "fumikiri no mukougawa de naiteru"
    },
    {
      "text": "プラスチックベルゼブブの羽音",
      "romaji": "purasuchikku beruzebubu no haoto"
    },
    {
      "text": "愛想笑いで今日もやりすごす",
      "romaji": "aisowarai de kyou mo yarisugosu"
    },
    {
      "text": "この薄汚れた街角の果て",
      "romaji": "kono usuyogoreta machikado no hate"
    },
    {
      "text": "埴輪シンドロームに侵された",
      "romaji": "haniwa shindoroomu ni okasareta"
    },
    {
      "text": "汽笛の音色をちょっとずらして",
      "romaji": "kiteki no neiro o chotto zurashite"
    },
    {
      "text": "外野からすかしてガム噛んでた",
      "romaji": "gaiya kara sukashite gamu kandeta"
    },
    {
      "text": "真夜中の４時にみつけた",
      "romaji": "mayonaka no yoji ni mitsuketa"
    },
    {
      "text": "四ツ葉のクローバー焼きついた",
      "romaji": "yotsuba no kuroobaa yakitsuita"
    },
    {
      "text": "三ツ足のカラス",
      "romaji": "mitsuashi no karasu"
    },
    {
      "text": "屋根の上で不気味に見つめる",
      "romaji": "yane no ue de bukimi ni mitsumeru"
    },
    {
      "text": "双子はいつまでも石油で体を清めて",
      "romaji": "futago wa itsumademo sekiyu de karada o kiyomete"
    },
    {
      "text": "ほのかに香る",
      "romaji": "honoka ni kaoru"
    },
    {
      "text": "有機モノソミー　ひとりきり",
      "romaji": "yuuki monosomii hitorikiri"
    },
    {
      "text": "此処は　深海シティアンダーグラウンド",
      "romaji": "koko wa shinkai shiti andaaguraundo"
    },
    {
      "text": "最果ての島　蝦の楽園",
      "romaji": "saihate no shima ebi no rakuen"
    },
    {
      "text": "深海シティアンダーグラウンド",
      "romaji": "shinkai shiti andaaguraundo"
    },
    {
      "text": "嘘吐きスキゾフレニア",
      "romaji": "usotsuki sukizofurenia"
    },
    {
      "text": "ノイズまみれの　ルビーの言葉",
      "romaji": "noizu mamire no rubii no kotoba"
    },
    {
      "text": "ナイトメアの　独り言",
      "romaji": "naitomea no hitorigoto"
    },
    {
      "text": "煌めくダイオードの星の下",
      "romaji": "kirameku daioodo no hoshi no shita"
    }
  ]
}
