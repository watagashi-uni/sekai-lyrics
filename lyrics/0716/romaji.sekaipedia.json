  "lines": [
    {
      "text": "優柔不断な昨日は笑って",
      "romaji": "yuujuu fudan na kinou wa waratte"
    },
    {
      "text": "見えない表情に不安定",
      "romaji": "mienai hyoujou ni fuantei"
    },
    {
      "text": "無力感のような言葉だって",
      "romaji": "muryokukan no youna kotoba datte"
    },
    {
      "text": "深く深く刺さってく",
      "romaji": "fukaku fukaku sasatteku"
    },
    {
      "text": "ただ曖昧感情ラインを",
      "romaji": "tada aimai kanjou rain o"
    },
    {
      "text": "今はふらふら進んでいく",
      "romaji": "ima wa furafura susunde iku"
    },
    {
      "text": "君を待ってるんだ",
      "romaji": "kimi o matteru nda"
    },
    {
      "text": "声を待ってるんだ",
      "romaji": "koe o matteru nda"
    },
    {
      "text": "淡い温度で揺蕩って",
      "romaji": "awai ondo de tayutatte"
    },
    {
      "text": "きっと同じ方向へ",
      "romaji": "kitto onaji houkou e"
    },
    {
      "text": "感情は向かっていくんだ",
      "romaji": "kanjou wa mukatte ikunda"
    },
    {
      "text": "眩しかった視界は和らいで",
      "romaji": "mabushikatta shikai wa yawaraide"
    },
    {
      "text": "もっと君のことを",
      "romaji": "motto kimi no koto mo"
    },
    {
      "text": "わかりそうな気がした",
      "romaji": "wakarisou na ki ga shita"
    },
    {
      "text": "「君のため」なんて",
      "romaji": "\"kimi no tame\" nante"
    },
    {
      "text": "言えやしない衝動があるよ",
      "romaji": "ieyashinai shoudou ga aru yo"
    },
    {
      "text": "ただ言葉じゃ",
      "romaji": "tada kotoba ja"
    },
    {
      "text": "薄っぺらい本当があるの",
      "romaji": "usupperai hontou ga aru no"
    },
    {
      "text": "まだ届かない",
      "romaji": "mada todokanai"
    },
    {
      "text": "独善的かもしれないけどさ",
      "romaji": "dokuzendeki kamo shirenai kedo sa"
    },
    {
      "text": "君の心に寄り添ってたいのです",
      "romaji": "kimi no kokoro ni yorisottetai no desu"
    },
    {
      "text": "共鳴してく　シンパシー",
      "romaji": "kyoumei shiteku shinpashii"
    },
    {
      "text": "ねえ今日もしたい　振り返り",
      "romaji": "nee kyou mo shitai furikaeri"
    },
    {
      "text": "繰り返し　ほどいてこう",
      "romaji": "kurikaeshi hodoitekou"
    },
    {
      "text": "君とのパズルを",
      "romaji": "kimi to no pazuru o"
    },
    {
      "text": "まだ見えない　いいじゃない",
      "romaji": "mada mienai ii janai"
    },
    {
      "text": "目的地まで　スキップとジャンプで",
      "romaji": "mokutekichi made sukippu to janpu de"
    },
    {
      "text": "揃えて進んでこうよ",
      "romaji": "soroete susundekou yo"
    },
    {
      "text": "その時まで。",
      "romaji": "sono toki made."
    }
  ]
}
