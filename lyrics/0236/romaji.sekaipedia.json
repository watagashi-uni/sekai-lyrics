  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "ずっと変わらないよ",
      "romaji": "zutto kawaranai yo"
    },
    {
      "text": "この願いは",
      "romaji": "kono negai wa"
    },
    {
      "text": "回り出した歯車は止まらない",
      "romaji": "mawaridashita haguruma wa tomaranai"
    },
    {
      "text": "心を焚きつけた本能",
      "romaji": "kokoro o takitsuketa honnou"
    },
    {
      "text": "６つの景色を響せた",
      "romaji": "muttsu no keshiki wo hibikaseta"
    },
    {
      "text": "右手で跳ね除ける逆境",
      "romaji": "migite de hanenokeru gyakkou"
    },
    {
      "text": "夢や理想",
      "romaji": "yume ya risou"
    },
    {
      "text": "鳴らした音に重ねて",
      "romaji": "narashita oto ni kasanete"
    },
    {
      "text": "明快な希望",
      "romaji": "meikai na kibou"
    },
    {
      "text": "刻む日々へ",
      "romaji": "kizamu hibi e"
    },
    {
      "text": "飛び込んでいく",
      "romaji": "tobikonde iku"
    },
    {
      "text": "溢れ出す''''声''''に(''''声''''に)、想いに(想いに)",
      "romaji": "afuredasu ''''koe'''' ni (''''koe'''' ni), omoi ni (omoi ni)"
    },
    {
      "text": "託したカリソメじゃ無い憧れ",
      "romaji": "takushita karisome janai akogare"
    },
    {
      "text": "ありふれた涙(涙)、痛みも(痛みも)",
      "romaji": "arifureta namida (namida), itami mo (itami mo)"
    },
    {
      "text": "この１６小節の上なら",
      "romaji": "kono juuroku shousetsu no ue nara"
    },
    {
      "text": "強さになる",
      "romaji": "tsuyosa ni naru"
    },
    {
      "text": "ずっと鳴り響いてる",
      "romaji": "zutto nari hibiiteru"
    },
    {
      "text": "この''''セカイ''''で",
      "romaji": "kono ''''sekai'''' de"
    },
    {
      "text": "全て賭けろ",
      "romaji": "subete kakero"
    },
    {
      "text": "二度と来ない",
      "romaji": "nidoto konai"
    },
    {
      "text": "この一瞬に",
      "romaji": "kono isshun ni"
    },
    {
      "text": "溢れ出す''''声''''に、想いに",
      "romaji": "afuredasu ''''koe'''' ni, omoi ni"
    }
  ]
}
