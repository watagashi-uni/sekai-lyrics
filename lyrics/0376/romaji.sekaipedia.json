  "lines": [
    {
      "text": "らんらんらん〜",
      "romaji": "ranranran~"
    },
    {
      "text": "わん、つー、すりぃ",
      "romaji": "wan, tsuu, surii"
    },
    {
      "text": "不思議なステップで踊りだすBeat",
      "romaji": "fushigi na suteppu de odoridasu Beat"
    },
    {
      "text": "今宵輝くネオンの下で光るわたし",
      "romaji": "koyoi kagayaku neon no shita de hikaru watashi"
    },
    {
      "text": "かわいいKawaii召使いたち",
      "romaji": "kawaii Kawaii meshitsukaitachi"
    },
    {
      "text": "あの子はどこに？",
      "romaji": "ano ko wa doko ni?"
    },
    {
      "text": "うだうだごろごろだらだらにゃんにゃん",
      "romaji": "udauda gorogoro daradara nyannyan"
    },
    {
      "text": "何もしたくない！",
      "romaji": "nani mo shitakunai!"
    },
    {
      "text": "甘い甘いチョコが食べたい",
      "romaji": "amai amai choko ga tabetai"
    },
    {
      "text": "アツいアツいラテが飲みたい",
      "romaji": "atsui atsui rate ga nomitai"
    },
    {
      "text": "ほくほくのパン食べたいの",
      "romaji": "hokuhoku no pan tabetai no"
    },
    {
      "text": "トロットロのチーズが食べたい",
      "romaji": "torottoro no chiizu ga tabetai"
    },
    {
      "text": "ふかふかのベットで寝たい",
      "romaji": "fukafuka no betto de netai"
    },
    {
      "text": "うとうとおやすみなさいzzz",
      "romaji": "utouto oyasuminasai zzz"
    },
    {
      "text": "わがまま　らんらんらん",
      "romaji": "wagamama ranranran"
    },
    {
      "text": "誰も逆らわないで",
      "romaji": "dare mo sakarawanaide"
    },
    {
      "text": "ワタシかわいそうでしょ？",
      "romaji": "watashi kawai sou desho?"
    },
    {
      "text": "お願いGive Give Me!",
      "romaji": "onegai Give Give Me!"
    },
    {
      "text": "全て与え続けて",
      "romaji": "subete ataetsuzukete"
    },
    {
      "text": "何もかも許される",
      "romaji": "nani mo kamo yurusareru"
    },
    {
      "text": "だって私が1番可愛いんだから♥",
      "romaji": "datte watashi ga ichiban kawaii ndakara♥"
    },
    {
      "text": "わがままな私のこと愛してくれる",
      "romaji": "wagamama na watashi no koto aishite kureru"
    },
    {
      "text": "誰かを待っているの",
      "romaji": "dareka o matte iru no"
    },
    {
      "text": "孤独な夜に一人枕濡らして",
      "romaji": "kodoku na yoru ni hitori makura nurashite"
    },
    {
      "text": "秒針を眺めてる",
      "romaji": "byoushin o nagameteru"
    },
    {
      "text": "だって私が、ね？",
      "romaji": "datte watashi ga, ne?"
    },
    {
      "text": "誰も怖がらないで",
      "romaji": "dare mo kowagaranaide"
    },
    {
      "text": "やっぱ私が1番可愛いんだから♥",
      "romaji": "yappa watashi ga ichiban kawaii ndakara♥"
    }
  ]
}
