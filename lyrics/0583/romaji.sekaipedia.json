  "lines": [
    {
      "text": "栄冠の先まで",
      "romaji": "eikan no saki made"
    },
    {
      "text": "全開で羽ばたけ",
      "romaji": "zenkai de habatake"
    },
    {
      "text": "いざ行こう！",
      "romaji": "iza yukou!"
    },
    {
      "text": "歌声響かせれば No doubt",
      "romaji": "utagoe hibikasereba No doubt"
    },
    {
      "text": "扉は放たれた",
      "romaji": "tobira wa hanatareta"
    },
    {
      "text": "焦燥感だって時に乗りこなして",
      "romaji": "shousoukan datte tokini norikonashite"
    },
    {
      "text": "楽しむのも悪くはないようだ",
      "romaji": "tanoshimu no mo waruku wa nai you da"
    },
    {
      "text": "逆らわないで ",
      "romaji": "sakarawanaide"
    },
    {
      "text": "足を止めないで",
      "romaji": "ashi wo tomenaide"
    },
    {
      "text": "僅かなチャンスを 狙え",
      "romaji": "wazukana chansu wo nerae!"
    },
    {
      "text": "鳴り 響くサイレン",
      "romaji": "nari hibiku sairen"
    },
    {
      "text": "掻き 消せる雷鳴を",
      "romaji": "kaki keseru raimei wo"
    },
    {
      "text": "この手で呼び起こせるまでは",
      "romaji": "kono te de yobi okoseru made wa"
    },
    {
      "text": "諦めることはしないさ",
      "romaji": "akirameru koto wa shinaisa"
    },
    {
      "text": "目指した未来への",
      "romaji": "mezashita mirai e no"
    },
    {
      "text": "道標はもう",
      "romaji": "michi shirube wa mou"
    },
    {
      "text": "掴んでるんだよ",
      "romaji": "tsukandeiru ndayo"
    },
    {
      "text": "見逃さないで！",
      "romaji": "minogasa nai de!"
    },
    {
      "text": "晴天だけ描いた ",
      "romaji": "seiten dake egaita"
    },
    {
      "text": "祈っていたんだ",
      "romaji": "inotteita nda"
    },
    {
      "text": "加速を続け 全て乗り越えてきた",
      "romaji": "kasoku wo tsuzuke subete norikoete kita"
    },
    {
      "text": "の覚めるような このセカイを",
      "romaji": "me no sameru youna kono sekai wo"
    },
    {
      "text": "さぁ もっともっともっともっと拓け！",
      "romaji": "saa motto,motto motto motto hirake!"
    },
    {
      "text": "加減なんて 必要ないさ",
      "romaji": "kagen nante hitsuyou nai sa"
    },
    {
      "text": "夢もリアルも つまらなくなっちゃうから！",
      "romaji": "yume mo riaru mo tsumaranaku nacchaukara!"
    }
  ]
}
