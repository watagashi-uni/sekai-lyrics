  "lines": [
    {
      "text": "あーあ、シケっ面晒してんな兄弟",
      "romaji": "aa a, shikezzura sarashiten na kyoudai"
    },
    {
      "text": "裁いてやった気分はどうだい",
      "romaji": "sabaite yatta kibun wa doudai"
    },
    {
      "text": "吐きそうだ 不快 深い 土の底",
      "romaji": "hakisou da fukai fukai tsuchi no soko"
    },
    {
      "text": "杯分の数奇を頂戴",
      "romaji": "sakazukibun no suuki o choudai"
    },
    {
      "text": "隠せど余る罪も公開",
      "romaji": "kakusedo amaru tsumi mo koukai"
    },
    {
      "text": "藻掻きあってんだ 見苦しく",
      "romaji": "mogakiattenda migurushiku"
    },
    {
      "text": "眩んじゃってんだ 情けなく",
      "romaji": "kuranjattenda nasakenaku"
    },
    {
      "text": "抜かしちゃってんだ 淀みなく",
      "romaji": "nukashichattenda yodomi naku"
    },
    {
      "text": "どうにもならない",
      "romaji": "dou ni mo naranai"
    },
    {
      "text": "腐り落ったんだ とめどなく",
      "romaji": "kusariottanda tomedonaku"
    },
    {
      "text": "奪い取ったんだ それとなく",
      "romaji": "ubaitottanda soretonaku"
    },
    {
      "text": "恨みあってんだ どの口で",
      "romaji": "uramiattenda dono kuchi de"
    },
    {
      "text": "縋りあってんだ その指で",
      "romaji": "sugariattenda sono yubi de"
    },
    {
      "text": "愛しい愛しい愛しい主よ（憎い憎い憎いジーザス）",
      "romaji": "nikui nikui nikui jiizasu"
    }
  ]
}
