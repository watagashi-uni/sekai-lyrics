{"musicId":237,"duration":129.410625,"vocalId":596,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-17","name":"宵崎奏"},{"performerId":"歌唱者-18","name":"朝比奈まふゆ"},{"performerId":"歌唱者-19","name":"東雲絵名"},{"performerId":"歌唱者-20","name":"暁山瑞希"},{"performerId":"歌唱者-24","name":"巡音ルカ"}],"lines":[{"start":9.781,"end":15.908,"text":"ずっと話したかった。","translation":"一直都好想与你倾诉。","segments":[{"text":"ずっと話したかった。","performerIds":["歌唱者-20"]}],"performerIds":[],"ruby":[{"from":3,"to":4,"reading":"はな"}],"romaji":"zutto hanashi takatta","romajiSource":"sekaipedia"},{"start":15.928,"end":22.116,"text":"無くしてしまった夜のことを","translation":"关于那早已遗失的黑夜之事","segments":[{"text":"無くしてしまった夜のことを","performerIds":["歌唱者-20"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"な"},{"from":8,"to":9,"reading":"よる"}],"romaji":"naku shite shimatta yoru no koto o","romajiSource":"sekaipedia"},{"start":22.12,"end":25.362,"text":"哀しい話じゃない","translation":"并不是什么令人伤感的故事","segments":[{"text":"哀しい話じゃない","performerIds":["歌唱者-20","歌唱者-24"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"かな"},{"from":3,"to":4,"reading":"はなし"}],"romaji":"kanashii hanashi janai","romajiSource":"sekaipedia"},{"start":25.371,"end":32.69,"text":"寂しくなるけど、いいんだ。","translation":"虽然不免感到寂寞，但也无妨。","segments":[{"text":"寂しくなるけど、","performerIds":["歌唱者-20","歌唱者-24"]},{"text":"いいんだ。","performerIds":["歌唱者-20"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"さび"}],"romaji":"sabishiku naru kedo, ii nda","romajiSource":"sekaipedia"},{"start":44.662,"end":50.248,"text":"灯りをずっと消したままで眠れない日は、","translation":"在始终熄着灯难以入眠的日子里，","segments":[{"text":"灯りをずっと消したままで眠れない日は、","performerIds":["歌唱者-19"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"あか"},{"from":6,"to":7,"reading":"け"},{"from":12,"to":13,"reading":"ねむ"},{"from":16,"to":17,"reading":"ひ"}],"romaji":"akari o zutto keshita mama de nemurenai hi wa,","romajiSource":"sekaipedia"},{"start":50.241,"end":56.488,"text":"冷めてしまった珈琲に逃げ込んでみる。","translation":"试着逃避躲进早已放凉的咖啡之中。","segments":[{"text":"冷めてしまった珈琲に逃げ込んでみる。","performerIds":["歌唱者-18"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"さ"},{"from":7,"to":9,"reading":"こおひい"},{"from":10,"to":11,"reading":"に"},{"from":12,"to":13,"reading":"こ"}],"romaji":"samete shimatta koohii ni nigekonde miru","romajiSource":"sekaipedia"},{"start":56.481,"end":62.227,"text":"借りたままだったレコードに針を落したら、","translation":"只要将唱针落在一直借来未还的黑胶唱片上，","segments":[{"text":"借りたままだったレコードに針を落したら、","performerIds":["歌唱者-17","歌唱者-24"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"か"},{"from":13,"to":14,"reading":"はり"},{"from":15,"to":16,"reading":"おと"}],"romaji":"karita mama datta rekoodo ni hari o otoshitara","romajiSource":"sekaipedia"},{"start":62.241,"end":67.887,"text":"情けないステップで踊りだせる！","translation":"便能踩着笨拙狼狈的舞步翩然起舞！","segments":[{"text":"情けないステップで踊りだせる！","performerIds":["歌唱者-20"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"なさ"},{"from":9,"to":10,"reading":"おど"}],"romaji":"nasakenai suteppu de odori daseru!","romajiSource":"sekaipedia"},{"start":68.368,"end":73.513,"text":"ずっとずっと待ち焦がれた","translation":"曾经一直一直苦苦渴求等待的","segments":[{"text":"ずっとずっと","performerIds":["歌唱者-17","歌唱者-24"]},{"text":"待ち焦がれた","performerIds":["歌唱者-24"]}],"performerIds":[],"ruby":[{"from":6,"to":7,"reading":"ま"},{"from":8,"to":9,"reading":"こ"}],"romaji":"zutto zutto machikogareta","romajiSource":"sekaipedia"},{"start":73.521,"end":79.165,"text":"明け方の陽も、消えない今日も。","translation":"无论是拂晓的朝阳，还是不会褪去的今天。","segments":[{"text":"明け方の陽も、","performerIds":["歌唱者-19","歌唱者-24"]},{"text":"消えない今日も。","performerIds":["歌唱者-18"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"あ"},{"from":2,"to":3,"reading":"がた"},{"from":4,"to":5,"reading":"ひ"},{"from":7,"to":8,"reading":"き"},{"from":11,"to":13,"reading":"きょう"}],"romaji":"akegata no hi mo, kienai kyou mo","romajiSource":"sekaipedia"},{"start":79.881,"end":89.528,"text":"今夜、今日のこの夜に沈んでしまっても、","translation":"纵使今夜，彻底沉没在今天的这个黑夜之中，","segments":[{"text":"今夜、今日のこの夜に","performerIds":["歌唱者-17","歌唱者-24"]},{"text":"沈んでしまっても、","performerIds":["歌唱者-20"]}],"performerIds":[],"ruby":[{"from":0,"to":2,"reading":"こんや"},{"from":3,"to":5,"reading":"きょう"},{"from":8,"to":9,"reading":"よる"},{"from":10,"to":11,"reading":"しず"}],"romaji":"konya, kyou no kono yoru ni shizunde shimatte mo,","romajiSource":"sekaipedia"},{"start":91.141,"end":97.667,"text":"きっと街の影を照らす灯りが","translation":"想必那照亮街角暗影的微弱灯火","segments":[{"text":"きっと","performerIds":["歌唱者-20"]},{"text":"街の影を照らす灯りが","performerIds":["歌唱者-20","歌唱者-24"]}],"performerIds":[],"ruby":[{"from":3,"to":4,"reading":"まち"},{"from":5,"to":6,"reading":"かげ"},{"from":7,"to":8,"reading":"て"},{"from":10,"to":11,"reading":"あか"}],"romaji":"kitto machi no kage o terasu akari ga","romajiSource":"sekaipedia"},{"start":97.667,"end":104.654,"text":"昨日と違って柔らかく見えたから","translation":"也会因与昨日不同而显得格外柔和","segments":[{"text":"昨日と違って","performerIds":["歌唱者-24"]},{"text":"柔らかく見えたから","performerIds":["歌唱者-17","歌唱者-24"]}],"performerIds":[],"ruby":[{"from":0,"to":2,"reading":"きのう"},{"from":3,"to":4,"reading":"ちが"},{"from":6,"to":7,"reading":"やわ"},{"from":10,"to":11,"reading":"み"}],"romaji":"kinou to chigatte yawarakaku mietakara","romajiSource":"sekaipedia"},{"start":103.84,"end":109.851,"text":"目を閉じるよ。眠りにつくよ。","translation":"闭上双眼吧。沉沉睡去吧。","segments":[{"text":"目を閉じるよ。","performerIds":["歌唱者-18"]},{"text":"眠りにつくよ。","performerIds":["歌唱者-19","歌唱者-24"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"め"},{"from":2,"to":3,"reading":"と"},{"from":7,"to":8,"reading":"ねむ"}],"romaji":"me o tojire yo nemuri ni tsuku yo","romajiSource":"sekaipedia"},{"start":109.854,"end":114.74,"text":"君の夜をくれ。","translation":"把你的黑夜分给我吧。","segments":[{"text":"君の夜をくれ。","performerIds":["歌唱者-20"]}],"performerIds":[],"ruby":[{"from":0,"to":1,"reading":"きみ"},{"from":2,"to":3,"reading":"よる"}],"romaji":"kimi no yoru o kure","romajiSource":"sekaipedia"}],"credits":{"translation":"雪莹ちゃん"},"sources":[["https://www.sekaipedia.org/wiki/Kimi_no_Yoru_o_Kure?oldid=329787","CC BY-SA 4.0","https://