  "lines": [
    {
      "text": "憎たらしくて",
      "romaji": "nikutarashikute"
    },
    {
      "text": "そっぽ向いた",
      "romaji": "soppo muita"
    },
    {
      "text": "あたし何度も",
      "romaji": "atashi nando mo"
    },
    {
      "text": "騙されてる",
      "romaji": "damasareteru"
    },
    {
      "text": "悩ましい心はどうして",
      "romaji": "nayamashii kokoro wa doushite"
    },
    {
      "text": "飼い慣らすことが難しい",
      "romaji": "kainarasu koto ga muzukashii"
    },
    {
      "text": "痛ましい心をどうして",
      "romaji": "itamashii kokoro o doushite"
    },
    {
      "text": "見て見ぬふりをする",
      "romaji": "mite minu furi o suru"
    },
    {
      "text": "行かないで（ないで！）",
      "romaji": "ikanaide! (naide!)"
    },
    {
      "text": "先なんて見据えないで",
      "romaji": "saki nante misuenaide"
    },
    {
      "text": "今すぐに",
      "romaji": "ima sugu ni"
    },
    {
      "text": "誰も居ない街を抜けて",
      "romaji": "dare mo inai machi o nukete"
    },
    {
      "text": "呼吸は荒いまま",
      "romaji": "kokyuu wa arai mama"
    },
    {
      "text": "知らないで！（ないで！）",
      "romaji": "shiranaide! (naide!)"
    },
    {
      "text": "他なんてどうだっていいのさ",
      "romaji": "hoka nante dou datte ii no sa"
    },
    {
      "text": "わかるかしら",
      "romaji": "wakaru kashira"
    },
    {
      "text": "独り善がりの愛でもいい",
      "romaji": "hitoriyogari no ai demo ii"
    },
    {
      "text": "暗い方へ行こうぜ",
      "romaji": "kurai hou e ikou ze"
    },
    {
      "text": "どうでもいいどうでもいいどうでもいい事ばっか",
      "romaji": "dou demo ii dou demo ii dou demo ii koto bakka"
    },
    {
      "text": "思い出して考えてしまうんだ",
      "romaji": "omoidashite kangaete shimau nda"
    },
    {
      "text": "もうやってらんないよな",
      "romaji": "mou yatterannai yo na"
    },
    {
      "text": "悲しいは嫌いですか",
      "romaji": "kanashii wa kirai desu ka"
    },
    {
      "text": "本当にそうですか",
      "romaji": "hontou ni sou desu ka"
    }
  ]
}
