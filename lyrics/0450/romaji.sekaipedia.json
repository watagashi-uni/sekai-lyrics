  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "遥か 彼方の銀河から",
      "romaji": "haruka kanata no ginga kara"
    },
    {
      "text": "君に届け スペースオペラ！（ハイ！）",
      "romaji": "kimi ni todoke speesu opera! (hai!)"
    },
    {
      "text": "ガラクタで作った スペースシップ",
      "romaji": "garakuta de tsukutta supeesushippu"
    },
    {
      "text": "あふれそうなハートごと 載せて",
      "romaji": "afuresou na haato goto nosete"
    },
    {
      "text": "君のシグナル 探索中",
      "romaji": "kimi no shigunaru tansakuchuu"
    },
    {
      "text": "いまだ！この惑星をとぶのだ！",
      "romaji": "imada! kono hoshi o tobu no da!"
    },
    {
      "text": "チェック チェック！進路だいじょぶ？",
      "romaji": "chekku chekku! shinro daijobu?"
    },
    {
      "text": "行けば進路になるからだいじょぶ！",
      "romaji": "ikeba shinro ni naru kara daijobu!"
    },
    {
      "text": "さあ ジャック ジャック！電波ジャックだ！",
      "romaji": "saa jakku jakku! denpa jakku da!"
    },
    {
      "text": "あった！君の受信アンテナ",
      "romaji": "atta! kimi no jushin antena"
    },
    {
      "text": "やっと 出逢えたね",
      "romaji": "yatto deaeta ne"
    },
    {
      "text": "どこにいても見つけるよ",
      "romaji": "doko ni itemo mitsukeru yo"
    },
    {
      "text": "振れた 気持ちを（オーオーオーオーオー）",
      "romaji": "fureta kimochi o (oooooooooo)"
    },
    {
      "text": "歌に乗せて",
      "romaji": "uta ni nosete"
    },
    {
      "text": "この宇宙すべてに わんだほーい！",
      "romaji": "kono uchuu subete ni wandahooi!"
    },
    {
      "text": "君に！届いてアリア",
      "romaji": "kimi ni! todoite aria"
    },
    {
      "text": "想いが（ハイ！）ラブが（ハイ！）",
      "romaji": "omoi ga (hai!) rabu ga (hai!)"
    },
    {
      "text": "壮大すぎて 伝えきれない",
      "romaji": "soudai sugite tsutae kirenai"
    },
    {
      "text": "オ！ペ！ラ！それでもいいや",
      "romaji": "o! pe! ra! sore demo ii ya"
    },
    {
      "text": "その笑顔も 涙も",
      "romaji": "sono egao mo namida mo"
    },
    {
      "text": "不器用な 愛情も",
      "romaji": "bukiyo na aijou mo"
    },
    {
      "text": "ぜんぶ乗せて",
      "romaji": "zenbu nosete"
    },
    {
      "text": "さあ ラタタタタタタタ タラッタ",
      "romaji": "saa ratatatatatatata taratta"
    },
    {
      "text": "歌え ルトゥトゥトゥトゥトゥトゥ トゥルットゥ",
      "romaji": "utae rututututututu turuttu"
    },
    {
      "text": "ちいさな星からみれば悲劇も",
      "romaji": "chiisana hoshi kara mireba higeki mo"
    },
    {
      "text": "宇宙からみれば喜劇だ！いえい！",
      "romaji": "uchuu kara mireba kigeki da! iei!"
    },
    {
      "text": "ラタタタタタタタ タラッタ",
      "romaji": "ratatatatatatata taratta"
    },
    {
      "text": "遥か 彼方で恋をした",
      "romaji": "haruka kanata de koi o shita"
    },
    {
      "text": "これは ドラマじゃなくて",
      "romaji": "kore wa dorama ja nakute"
    },
    {
      "text": "君と（ハイ！）僕は（ハイ！）",
      "romaji": "kimi to (hai!) boku wa (hai!)"
    },
    {
      "text": "この宇宙でいま生きてる！",
      "romaji": "kono uchuu de ima ikiteru!"
    },
    {
      "text": "オ！ペ！ラ！そんな奇跡に！",
      "romaji": "o! pe! ra! sonna kiseki ni!"
    },
    {
      "text": "この喜劇も 悲劇も",
      "romaji": "kono kigeki mo higeki mo"
    },
    {
      "text": "君と逢えた 感動も",
      "romaji": "kimi to aeta kandou mo"
    },
    {
      "text": "ぜんぶ乗せたい！",
      "romaji": "zenbu nosetai!"
    },
    {
      "text": "遥か 彼方の銀河ごと",
      "romaji": "haruka kanata no ginga goto"
    },
    {
      "text": "君と謳え スペースオペラ！（ハイ！）",
      "romaji": "kimi to utae speesu opera! (hai!)"
    },
    {
      "text": "君と作る スペースオペラ！",
      "romaji": "kimi to tsukuru speesu opera!"
    }
  ]
}
