  "lines": [
    {
      "text": "キミってホント単純ね",
      "romaji": "kimi tte honto tanjun ne"
    },
    {
      "text": "壊したい衝動　抑え込む",
      "romaji": "kowashitai shoudou osaekomu"
    },
    {
      "text": "くだらないシャウトは耳障り",
      "romaji": "kudaranai shauto wa mimizawari"
    },
    {
      "text": "いい加減にしてよね！",
      "romaji": "iikagen ni shite yo ne!"
    },
    {
      "text": "暴力的で猟奇的",
      "romaji": "bouryokuteki de ryoukiteki"
    },
    {
      "text": "歪な銃声　鳴り響く",
      "romaji": "ibitsu na juusei narihibiku"
    },
    {
      "text": "3分間の断末魔",
      "romaji": "sanfunkan no danmatsuma"
    },
    {
      "text": "キミのレクイエムを聞かせて",
      "romaji": "kimi no rekuiemu o kikasete"
    },
    {
      "text": "ねぇ　痛みがわからないの",
      "romaji": "nee itami ga wakaranai no"
    },
    {
      "text": "狂気に満ちたダンスを",
      "romaji": "kyouki ni michita dansu o"
    },
    {
      "text": "一緒に踊ってね♥",
      "romaji": "issho ni odotte ne"
    },
    {
      "text": "めちゃくちゃにしたいの　全部",
      "romaji": "mechakucha ni shitai no zenbu"
    },
    {
      "text": "キミの身体　心も",
      "romaji": "kimi no karada kokoro mo"
    },
    {
      "text": "なぶりつくしたいの　全部",
      "romaji": "naburitsukushitai no zenbu"
    },
    {
      "text": "キミの蜜をちょうだい",
      "romaji": "kimi no mitsu o choudai"
    },
    {
      "text": "あぁ　なんて醜くて",
      "romaji": "aa nante minikukute"
    },
    {
      "text": "あぁ　すごくキレイでしょ？",
      "romaji": "aa sugoku kirei desho?"
    },
    {
      "text": "毒占的な愛で愛でて",
      "romaji": "dokusenteki na ai de medete"
    },
    {
      "text": "満たして撃ち抜くの",
      "romaji": "mitashite uchinuku no"
    },
    {
      "text": "（嗚呼）",
      "romaji": "(aa)"
    },
    {
      "text": "ぐちゃぐちゃにしたいの　全部",
      "romaji": "guchagucha ni shitai no zenbu"
    },
    {
      "text": "過去も今も未来も",
      "romaji": "kako mo ima mo mirai mo"
    },
    {
      "text": "バラバラにしたいの　全部",
      "romaji": "barabara ni shitai no zenbu"
    },
    {
      "text": "キミをさらけ出して",
      "romaji": "kimi o sarakedashite"
    },
    {
      "text": "満たして抱きしめて",
      "romaji": "mitashite dakishimete"
    }
  ]
}
