  "lines": [
    {
      "text": "ちゅーにゅーモヤモヤ わはは",
      "romaji": "chuunyuu moyamoya (wahaha)"
    },
    {
      "text": "ジグザグ低気圧が↓ぐん 丸まる",
      "romaji": "jiguzagu teikiatsu ga↓gun marumaru"
    },
    {
      "text": "天気はモクモク わはは",
      "romaji": "tenki wa mokumoku (wahaha)"
    },
    {
      "text": "発汗クマクマ なんちゅー面相",
      "romaji": "hakkan kumakuma nanchuu mensou"
    },
    {
      "text": "愛想フリフリ わはは",
      "romaji": "aiso furifuri (wahaha)"
    },
    {
      "text": "年中 檻 檻 わはは",
      "romaji": "nenjuu ori ori (wahaha)"
    },
    {
      "text": "ねーねーネガティブ",
      "romaji": "nee nee negatibu"
    },
    {
      "text": "ネガネガ年々 寝込み",
      "romaji": "nega nega nennen nekomi"
    },
    {
      "text": "涙 涙 ネガティブ",
      "romaji": "een een negatibu"
    },
    {
      "text": "ララララ ララララ ラ",
      "romaji": "ra ra ra ra (ra ra ra ra) ra"
    },
    {
      "text": "や や や や や やーだ",
      "romaji": "yayayayaya yaada!"
    },
    {
      "text": "いい子の真似して がう がう がう",
      "romaji": "ii ko no mane shite gaugaugau"
    },
    {
      "text": "たいへんよくできました",
      "romaji": "taihen yoku dekimashita"
    },
    {
      "text": "ちゅー ちゅちゅ ちゅちゅ 宙 宙 宙",
      "romaji": "chuu chuchu chuchu chuuchuuchuu"
    },
    {
      "text": "乞うご期待の視線 痛い",
      "romaji": "kougo kitai no shisen itai"
    },
    {
      "text": "ポイってされちゃう がう がう がう",
      "romaji": "poitte sarechau gaugaugau"
    },
    {
      "text": "ちゅー ちゅちゅ ちゅちゅ ちゅ やーだ",
      "romaji": "chuu chuchu chuchu chu yaada!"
    },
    {
      "text": "寝ん寝 ごろりん",
      "romaji": "nenne gororin"
    },
    {
      "text": "メンタルめそめそ 枕に",
      "romaji": "mentaru mesomeso makura ni"
    },
    {
      "text": "逆転ちゅー夜 ちゅー夜 わはは",
      "romaji": "gyakuten chuuya chuuya (wahaha)"
    },
    {
      "text": "どんどんネクラくらくらに",
      "romaji": "dondon nekura kurakura ni"
    },
    {
      "text": "なって有耶無耶 わはは",
      "romaji": "natte uyamuya (wahaha)"
    },
    {
      "text": "白ちゅー堂々 吸い込まれ迷子",
      "romaji": "hakuchuu doudou suikomare maigo"
    },
    {
      "text": "はい もう注目",
      "romaji": "hai! mou chuumoku!"
    },
    {
      "text": "いっぱい無理して がう がう がう",
      "romaji": "ippai muri shite gaugaugau"
    },
    {
      "text": "大体よくできました",
      "romaji": "daitai yoku dekimashita"
    },
    {
      "text": "逆さになった意見 怖い",
      "romaji": "sakasa ni natta iken kowai"
    }
  ]
}
