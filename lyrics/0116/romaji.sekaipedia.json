  "lines": [
    {
      "text": "交わる 線と線",
      "romaji": "majiwaru sen to sen"
    },
    {
      "text": "着飾る 大好きな アレコレソレ",
      "romaji": "kikazaru daisuki na are kore sore"
    },
    {
      "text": "そう いつだって",
      "romaji": "sou itsu datte"
    },
    {
      "text": "譲れないアイデンティティ",
      "romaji": "yuzurenai aidentiti"
    },
    {
      "text": "手探り 手繰り寄せても",
      "romaji": "tesaguri taguriyosete mo"
    },
    {
      "text": "繰り返し 絡まるの 気持ちの糸",
      "romaji": "kurikaeshi karamaru no kimochi no ito"
    },
    {
      "text": "ねえ いつだって",
      "romaji": "nee itsu datte"
    },
    {
      "text": "諦めたままのディスタンス",
      "romaji": "akirameta mama no disutansu"
    },
    {
      "text": "繋いでたいなら ",
      "romaji": "tsunaidetai nara"
    },
    {
      "text": "外さない 秘め事 (ああ)",
      "romaji": "hazusanai himegoto (aa)"
    },
    {
      "text": "ねぇこのままで ままで (ああ) ",
      "romaji": "nee kono mama de mama de (aa)"
    },
    {
      "text": "いられるかな",
      "romaji": "irareru kana (aa)"
    },
    {
      "text": "淡い期待に通せんぼ (ああ)",
      "romaji": "awai kitai ni toosenbo (aa)"
    },
    {
      "text": "塞いで曖昧 知らん顔 (ああ)",
      "romaji": "fusaide aimai shirankao (aa)"
    },
    {
      "text": "こうやって繋いでいられたなら (ああ)",
      "romaji": "kouyatte tsunaide irareta nara (aa)"
    },
    {
      "text": "縫い合わせて 編み合わせて",
      "romaji": "nuiawasete amiawasete"
    },
    {
      "text": "繕ってさ 何が出来るだろう",
      "romaji": "tsukurotte sa nani ga dekiru darou"
    },
    {
      "text": "切り取って 笑って 距離とって",
      "romaji": "kiritotte waratte kyoritotte"
    },
    {
      "text": "笑えるけど 笑えてるけど",
      "romaji": "waraeru kedo waraeteru kedo"
    },
    {
      "text": "滲みだした境界 ",
      "romaji": "nijimidashita kyoukai"
    },
    {
      "text": "揺らぐ未来伝えたなら ",
      "romaji": "yuragu mirai tsutaeta nara"
    },
    {
      "text": "もうこのままじゃ ままじゃ",
      "romaji": "mou kono mama ja mama ja"
    },
    {
      "text": "共鳴ならせたなら (ああ)",
      "romaji": "naraseta nara (aa)"
    },
    {
      "text": "いたいいたいのどっちだ",
      "romaji": "itai itai no docchi da"
    }
  ]
}
