  "lines": [
    {
      "text": "百三十五番目のステージに",
      "romaji": "hyakusanjuugo banme no suteeji ni"
    },
    {
      "text": "立っていた。僕は、今。",
      "romaji": "tatteita. boku wa, ima."
    },
    {
      "text": "幾度とない不安感を拭っていき、",
      "romaji": "ikudo to nai fuankan o nugutte iki,"
    },
    {
      "text": "繰り返した理想論が迫っている。",
      "romaji": "kurikaeshita risouron ga sematte iru."
    },
    {
      "text": "紛れもなく、少しずつ。",
      "romaji": "magire mo naku, sukoshizutsu."
    },
    {
      "text": "より遠くの高みを目指すには",
      "romaji": "yori tooku no takami o mezasu ni wa"
    },
    {
      "text": "衝動、全然収まんない。",
      "romaji": "shoudou, zenzen osamannai."
    },
    {
      "text": "現在地点じゃ、満足できない、",
      "romaji": "genzai chiten ja, manzoku dekinai,"
    },
    {
      "text": "日進月歩！",
      "romaji": "nisshingeppo!"
    },
    {
      "text": "氾濫している",
      "romaji": "hanran shite iru"
    },
    {
      "text": "感情を解き放ち",
      "romaji": "kanjou o tokihanachi"
    },
    {
      "text": "今、幕が上がりだす！",
      "romaji": "ima, maku ga agari dasu!"
    },
    {
      "text": "叶わない、と思っていた。",
      "romaji": "kanawanai, to omotteita."
    },
    {
      "text": "あのスポットライト。",
      "romaji": "ano supottoraito."
    },
    {
      "text": "速まっていく鼓動のBPM。",
      "romaji": "hayamatte iku kodou no BPM."
    },
    {
      "text": "でも、怖くない。",
      "romaji": "demo, kowakunai."
    },
    {
      "text": "飛び出してみたい。",
      "romaji": "tobidashite mitai."
    },
    {
      "text": "胸の高鳴りとともに！",
      "romaji": "mune no takanari to tomo ni!"
    },
    {
      "text": "歌う声は、意志を持った覚悟によって、",
      "romaji": "utau koe wa, ishi o motta kakugo ni yotte,"
    },
    {
      "text": "憧れのその先へと向かう。",
      "romaji": "akogare no sono saki e to mukau."
    },
    {
      "text": "夢だった日が実像を持ち、",
      "romaji": "yume datta hi ga jitsuzou o mochi,"
    },
    {
      "text": "確かに触れられる証明。",
      "romaji": "tashika ni furerareru shoumei."
    },
    {
      "text": "受け継がれて、",
      "romaji": "uketsugarete,"
    },
    {
      "text": "絶やすことなく、",
      "romaji": "tayasu koto naku,"
    },
    {
      "text": "また、託していく。",
      "romaji": "mata, takushite iku."
    },
    {
      "text": "そうした末に紡がれていく旋律。",
      "romaji": "sou shita sue ni tsumugarete iku merodi."
    },
    {
      "text": "もう、戻らない。",
      "romaji": "mou, modoranai."
    },
    {
      "text": "振り返らない。",
      "romaji": "furikaeranai."
    },
    {
      "text": "歩き出せた足が",
      "romaji": "arukidaseta ashi ga"
    },
    {
      "text": "まだ、覚束なくとも。",
      "romaji": "mada, obotsukanaku tomo."
    }
  ]
}
