{"musicId":608,"duration":131.909375,"vocalId":1165,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-21","name":"初音ミク"}],"lines":[{"start":10.113,"end":12.784,"text":"At the Speed Of Light","translation":"At the Speed Of Light","segments":[{"text":"At the Speed Of Light","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":12.784,"end":19.843,"text":"あなたと夢の続きを","translation":"与你一同续写未完的美梦","segments":[{"text":"あなたと夢の続きを","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":19.843,"end":23.107,"text":"At the Speed Of Light","translation":"At the Speed Of Light","segments":[{"text":"At the Speed Of Light","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":23.107,"end":27.655,"text":"このまま流星のように","translation":"就这样宛如流星一般","segments":[{"text":"このまま流星のように","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":27.655,"end":59.664,"text":"声がまた届くまで","translation":"直到声音再次传达至彼方","segments":[{"text":"声がまた届くまで","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":59.664,"end":63.292,"text":"ふたつの月廻る星","translation":"两轮明月环绕运转的星球","segments":[{"text":"ふたつの月廻る星","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":63.292,"end":65.836,"text":"指先で描く空に","translation":"在指尖描绘的长空之中","segments":[{"text":"指先で描く空に","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":65.836,"end":69.43,"text":"放物線宇宙なぞるように","translation":"仿佛描摹着抛物线宇宙一般","segments":[{"text":"放物線宇宙なぞるように","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":69.43,"end":73.09,"text":"ふたり歩く帰り道","translation":"两人并肩走过的归途","segments":[{"text":"ふたり歩く帰り道","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":73.09,"end":76.484,"text":"昼と夜が交わるように","translation":"宛如白昼与黑夜在此交汇","segments":[{"text":"昼と夜が交わるように","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":76.484,"end":79.951,"text":"奇跡たどる","translation":"追寻奇迹","segments":[{"text":"奇跡たどる","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":79.951,"end":86.252,"text":"取り残された僕らは","translation":"被抛下的我们","segments":[{"text":"