  "lines": [
    {
      "text": "はるか遠い遠い昔",
      "romaji": "haruka tooi tooi mukashi"
    },
    {
      "text": "巻かれた首輪",
      "romaji": "makareta kubiwa"
    },
    {
      "text": "人が欲しい人が欲しい",
      "romaji": "hito ga hoshii hito ga hoshii to"
    },
    {
      "text": "と叫ぶ呪いの首輪",
      "romaji": "sakebu noroi no kubiwa"
    },
    {
      "text": "怒らないで見捨てないで",
      "romaji": "okoranaide misutenaide"
    },
    {
      "text": "どこもいかないで（ねえ）",
      "romaji": "dokomo ikanaide (nee)"
    },
    {
      "text": "強く絞める吐くまで絞める",
      "romaji": "tsuyoku shimeru haku made shimeru"
    },
    {
      "text": "人がいないいないと",
      "romaji": "hito ga inai inai to"
    },
    {
      "text": "いい成績でしょ",
      "romaji": "ii seiseki desho"
    },
    {
      "text": "ねえ　ねえ いい子でしょ",
      "romaji": "nee nee ii ko desho"
    },
    {
      "text": "かわいい子でしょ",
      "romaji": "kawaii ko desho"
    },
    {
      "text": "ねえ　ねえ良い子でしょう",
      "romaji": "nee nee ii ko deshou"
    },
    {
      "text": "苦しい　ねえ",
      "romaji": "kurushii nee"
    },
    {
      "text": "愛して　愛して　愛して　",
      "romaji": "aishite aishite aishite"
    },
    {
      "text": "もっともっと",
      "romaji": "motto motto"
    },
    {
      "text": "愛して　愛して　狂おしいほどに",
      "romaji": "aishite aishite kuruoshii hodo ni"
    },
    {
      "text": "苦しい　苦しい　",
      "romaji": "kurushii kurushii"
    },
    {
      "text": "呪縛を　解いて解いてねえ　",
      "romaji": "jubaku o toite toite nee"
    },
    {
      "text": "止められない嗚呼",
      "romaji": "tomerarenai aa"
    },
    {
      "text": "幸せなの　嗚呼",
      "romaji": "shiawase na no aa"
    }
  ]
}
