  "lines": [
    {
      "text": "浮かんだんだ　",
      "romaji": "ukanda nda"
    },
    {
      "text": "昨日の朝　早くに",
      "romaji": "kinou no asa hayaku ni"
    },
    {
      "text": "割れたグラス　",
      "romaji": "wareta gurasu"
    },
    {
      "text": "かき集めるような",
      "romaji": "kakiatsumeru you na"
    },
    {
      "text": "これは一体なんだろう",
      "romaji": "kore wa ittai nan darou"
    },
    {
      "text": "切った指からしたたる滴",
      "romaji": "kitta yubi kara shitataru shizuku"
    },
    {
      "text": "僕らはこんなことしたかったのかな",
      "romaji": "bokura wa konna koto shitakatta no kana"
    },
    {
      "text": "緩やかに朽ちてゆくこの世界で　 ",
      "romaji": "yuruyaka ni kuchite yuku kono sekai de"
    },
    {
      "text": "色褪せた君の　",
      "romaji": "iroaseta kimi no"
    },
    {
      "text": "微笑み刻んで ",
      "romaji": "hohoemi kizande"
    },
    {
      "text": "栓を抜いた",
      "romaji": "sen o nuita"
    },
    {
      "text": "声を枯らして叫んだ",
      "romaji": "koe o karashite sakenda"
    },
    {
      "text": "反響　残響　空しく響く",
      "romaji": "hankyou zankyou munashiku hibiku"
    },
    {
      "text": "外された鎖の　その先は",
      "romaji": "hazusareta kusari no sono saki wa"
    },
    {
      "text": "なにひとつ残ってやしないけど",
      "romaji": "nanihitotsu nokotte ya shinai kedo"
    },
    {
      "text": "ふたりを重ねてた偶然",
      "romaji": "futari o kasaneteta guuzen"
    },
    {
      "text": "所詮こんなものさ　呟いた",
      "romaji": "shosen konna mono sa tsubuyaita"
    },
    {
      "text": "枯れた頬に伝う誰かの涙",
      "romaji": "kareta hoho ni tsutau dareka no namida"
    },
    {
      "text": "これでおしまいさ",
      "romaji": "kore de oshimai sa"
    }
  ]
}
