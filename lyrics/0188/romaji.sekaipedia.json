  "lines": [
    {
      "text": "浮つく甘い街の喧騒",
      "romaji": "uwatsuku amai machi no kensou"
    },
    {
      "text": "故に感情線は渋滞",
      "romaji": "yue ni kanjousen wa jutai"
    },
    {
      "text": "「僕に関係ない」とか言って",
      "romaji": "\"boku ni kankeinai\" toka itte"
    },
    {
      "text": "心模様 白く染まって",
      "romaji": "kokoro moyou shiroku somatte"
    },
    {
      "text": "だけどどうやったって釣り合わない",
      "romaji": "dakedo dou yattatte tsuriawanai"
    },
    {
      "text": "いたずらに笑う横顔に乾杯",
      "romaji": "itazura ni warau yokogao ni kanpai"
    },
    {
      "text": "酸いも甘いもわからないの",
      "romaji": "sui mo amai mo wakaranai no"
    },
    {
      "text": "きっと君の前では迷子",
      "romaji": "kitto kimi no mae de wa maigo"
    },
    {
      "text": "溶かしてはランデブー",
      "romaji": "tokashite wa randebuu"
    },
    {
      "text": "プラトニックになってく",
      "romaji": "puratonikku ni natteku"
    },
    {
      "text": "ほろ苦い期待 張り裂けてしまいそう",
      "romaji": "horo nigai kitai harisakete shimai sou"
    },
    {
      "text": "だから",
      "romaji": "dakara"
    },
    {
      "text": "夢惑う  想いならば",
      "romaji": "yume madou omoi naraba"
    },
    {
      "text": "聞かせて その声を",
      "romaji": "kikasete sono koe o"
    },
    {
      "text": "君に",
      "romaji": "kimi ni"
    },
    {
      "text": "染まってしまえば 染まってしまえば",
      "romaji": "somatte shimaeba somatte shimaeba"
    },
    {
      "text": "心遊ばせ  余所見してないで",
      "romaji": "kokoro asobase yosomi shitenaide"
    },
    {
      "text": "想っていたいな  想っていたいな",
      "romaji": "omotteitai na omotteitai na"
    },
    {
      "text": "桃色の心予報",
      "romaji": "momoiro no kokoroyohou"
    },
    {
      "text": "今",
      "romaji": "ima"
    },
    {
      "text": "混ざってしまえば 混ざってしまえば",
      "romaji": "mazatte shimaeba mazatte shimaeba"
    },
    {
      "text": "君と重なって 視線が愛相まって",
      "romaji": "kimi to kasanatte shisen ga ai aimatte"
    },
    {
      "text": "ロマンス は止まらない",
      "romaji": "romansu wa tomaranai"
    },
    {
      "text": "失敗したらグッバイステップ",
      "romaji": "shippai shitara gubbai suteppu"
    },
    {
      "text": "神さまどうか今日は味方して",
      "romaji": "kamisama douka kyou wa mikata shite"
    },
    {
      "text": "伝えてしまえ 伝えてしまえば",
      "romaji": "tsutaete shimae tsutaete shimaeba"
    }
  ]
}
