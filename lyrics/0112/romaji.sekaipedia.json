  "lines": [
    {
      "text": "やっほー！ 準備はOK ",
      "romaji": "yahhoo! junbi wa OK"
    },
    {
      "text": "今日は何処まで歩こう",
      "romaji": "kyou wa doko made arukou"
    },
    {
      "text": "しゅっと背伸びをしたら ",
      "romaji": "shutto senobi o shitara"
    },
    {
      "text": "もっと近づけるかな",
      "romaji": "motto chikazukeru kana"
    },
    {
      "text": "勇気を出して 踏み出してみたって",
      "romaji": "yuuki o dashite fumidashite mita tte"
    },
    {
      "text": "次の壁にぶち当たる日々",
      "romaji": "tsugi no kabe ni buchiataru hibi"
    },
    {
      "text": "頼りなくても 不器用な愛でも",
      "romaji": "tayorinakute mo bukiyou na ai demo"
    },
    {
      "text": "誰かに届けたい！",
      "romaji": "dareka ni todoketai!"
    },
    {
      "text": "この翼が折れてしまっても",
      "romaji": "kono tsubasa ga orete shimatte mo"
    },
    {
      "text": "君が居ればまた",
      "romaji": "kimi ga ireba mata"
    },
    {
      "text": "また頑張れるよ",
      "romaji": "mata ganbareru yo"
    },
    {
      "text": "百年先も思いは消えずに",
      "romaji": "hyakunen saki mo omoi wa kiezu ni"
    },
    {
      "text": "今炎を纏って舞い降りた",
      "romaji": "ima honoo o matotte maiorita"
    },
    {
      "text": "いつかのステージ",
      "romaji": "itsuka no suteeji"
    },
    {
      "text": "もっと！腕を振って",
      "romaji": "motto! ude o futte"
    },
    {
      "text": "もっと！応えて",
      "romaji": "motto! kotaete"
    },
    {
      "text": "皆で集めた全力届け",
      "romaji": "mina de atsumeta zenryoku todoke"
    },
    {
      "text": "もっと！愛を見せて ",
      "romaji": "motto! ai o misete"
    },
    {
      "text": "ぎゅっと握りしめた",
      "romaji": "gyutto nigirishimeta"
    },
    {
      "text": "天使のクローバー",
      "romaji": "tenshi no kuroobaa"
    },
    {
      "text": "（全身全霊！MORE MORE JUMP!!）",
      "romaji": "(zenshinzenrei! MORE MORE JUMP!!)"
    },
    {
      "text": "突き進むから",
      "romaji": "tsukisusumu kara"
    }
  ]
}
