  "lines": [
    {
      "text": "XとかYとか",
      "romaji": "X toka Y toka"
    },
    {
      "text": "べき論者様は善悪多頭飼い",
      "romaji": "beki ronja-sama wa zen'aku tatougai"
    },
    {
      "text": "ヴィラン ヴィラン",
      "romaji": "viran viran"
    },
    {
      "text": "蛇蝎ライフ 蛇蝎ライフ",
      "romaji": "dakatsu raifu dakatsu raifu"
    },
    {
      "text": "挙句の糜爛",
      "romaji": "ageku no biran"
    },
    {
      "text": "素晴らしき悪党共に捧げる唄",
      "romaji": "subarashiki akutou-domo ni sasageru uta"
    },
    {
      "text": "骨まで演じ切ってやれ悪辣に",
      "romaji": "hone made enjikitte yare akuratsu ni"
    },
    {
      "text": "残酷な町ほど綺麗な虹が立つ",
      "romaji": "zankoku na machi hodo kirei na niji ga tatsu"
    },
    {
      "text": "猥雑広告に踊るポップ体の愛",
      "romaji": "waizatsu koukoku ni odoru popputai no ai"
    },
    {
      "text": "挙句の果ての糜爛",
      "romaji": "ageku no hate no biran"
    }
  ]
}
