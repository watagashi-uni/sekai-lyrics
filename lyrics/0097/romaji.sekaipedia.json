  "lines": [
    {
      "text": "また緩い風",
      "romaji": "mata yurui kaze"
    },
    {
      "text": "ただ一瞬の",
      "romaji": "tada isshun no"
    },
    {
      "text": "霽れを待つ君",
      "romaji": "hare wo matsu kimi"
    },
    {
      "text": "指先離れ合う度",
      "romaji": "yubisaki hanareau tabi"
    },
    {
      "text": "見つけた自分は弱いのに",
      "romaji": "mitsuketa jibun wa yowai no ni"
    },
    {
      "text": "飽きもせず",
      "romaji": "aki mo sezu"
    },
    {
      "text": "期待した明日の",
      "romaji": "kitai shita asu no"
    },
    {
      "text": "それは幽かに",
      "romaji": "sore wa kasuka ni"
    },
    {
      "text": "心悲しそうに笑ったり",
      "romaji": "uraganashisou ni warattari"
    },
    {
      "text": "忘れてしまえと願ったり",
      "romaji": "wasurete shimae to negattari"
    },
    {
      "text": "眠れない魔法",
      "romaji": "nemurenai mahou"
    },
    {
      "text": "辛い過去",
      "romaji": "tsurai kako"
    },
    {
      "text": "キリはないから",
      "romaji": "kiri wa nai kara"
    },
    {
      "text": "朝焼け歌を歌ったり",
      "romaji": "asayake ni uta wo utattari"
    },
    {
      "text": "忘れてしまえば終わるのに",
      "romaji": "wasurete shimaeba owaru no ni"
    },
    {
      "text": "譲れないものただ一つ",
      "romaji": "yuzurenai mono tada hitotsu"
    },
    {
      "text": "理由は知らぬまま",
      "romaji": "riyuu wa shiranu mama"
    },
    {
      "text": "生きて行く今も",
      "romaji": "ikite iku ima mo"
    },
    {
      "text": "守りたい夢もないから",
      "romaji": "mamoritai yume mo nai kara"
    },
    {
      "text": "答えのない日々 でもそれは",
      "romaji": "kotae no nai hibi demo sore wa"
    },
    {
      "text": "優しさではないんだろう？ なぁ",
      "romaji": "yasashisa de wa naindarou? naa"
    },
    {
      "text": "何も痛くなんてないから",
      "romaji": "nani mo itaku nante nai kara"
    },
    {
      "text": "大丈夫だよ まだ っていつか",
      "romaji": "daijoubu da yo mada tte itsuka"
    },
    {
      "text": "君がいなくなったら あぁ",
      "romaji": "kimi ga inaku nattara aa"
    },
    {
      "text": "私だけ生きて行くの？",
      "romaji": "watashi dake ikite iku no?"
    }
  ]
}
