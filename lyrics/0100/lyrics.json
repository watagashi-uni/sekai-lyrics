{"musicId":100,"duration":108.741375,"vocalId":192,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-10","name":"白石杏"},{"performerId":"歌唱者-11","name":"東雲彰人"}],"lines":[{"start":15.14425,"end":18.87025,"text":"The clock stopped ticking forever ago","translation":"时钟早在很久以前便停止了走动","segments":[{"text":"The clock stopped ticking forever ago","performerIds":["歌唱者-11"]}],"performerIds":[]},{"start":18.87025,"end":22.18925,"text":"How long have I been up? I don't know","translation":"我已经清醒了多久？ 我早已记不清","segments":[{"text":"How long have I been up? I don't know","performerIds":["歌唱者-11"]}],"performerIds":[]},{"start":22.18925,"end":25.85025,"text":"I can't get a grip, but I can't let go","translation":"我无法掌控一切 却也无法轻易放手","segments":[{"text":"I can't get a grip, but I can't let go","performerIds":["歌唱者-11"]}],"performerIds":[]},{"start":25.85025,"end":29.50725,"text":"There wasn't anything to hold onto, though","translation":"尽管本就没有什么能让我抓住","segments":[{"text":"There wasn't anything to hold onto, though","performerIds":["歌唱者-11"]}],"performerIds":[]},{"start":29.50725,"end":32.97125,"text":"Why can't I see,","translation":"为什么我无法看见","segments":[{"text":"Why ","performerIds":["歌唱者-11"]},{"text":"can't I see,","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":29.50725,"end":32.97125,"text":"Why can't I see","translation":"为什么我无法看见","segments":[{"text":"Why ","performerIds":["歌唱者-11"]},{"text":"can't I see","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":32.97125,"end":36.30025,"text":"All the colors","translation":"那所有的斑斓色彩","segments":[{"text":"All ","performerIds":["歌唱者-11"]},{"text":"the colors","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":32.97125,"end":36.30025,"text":"That you see?","translation":"那些你能看见的？","segments":[{"text":"That you see?","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":36.30025,"end":39.61625,"text":"Please can I be,","translation":"求求你 能否让我也变得","segments":[{"text":"Please ","performerIds":["歌唱者-11"]},{"text":"can I be,","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":36.30025,"end":39.61625,"text":"Please can I be","translation":"能否让我也变得","segments":[{"text":"Please ","performerIds":["歌唱者-11"]},{"text":"can I be","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":39.61625,"end":42.82725,"text":"Colorful and free?","translation":"色彩缤纷而又自由自在？","segments":[{"text":"Colorful and free?","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":42.82725,"end":46.53725,"text":"What the hell's going on?","translation":"这到底是怎么回事？","segments":[{"text":"What the hell's going on?","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":42.82725,"end":46.53725,"text":"Can someone tell me please","translation":"有没有人能告诉我","segments":[{"text":"Can someone tell me please","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":46.53725,"end":49.50125,"text":"Why I'm switching faster than the channels on TV","translation":"为什么我的心境转换得比电视换台还要快","segments":[{"text":"Why I'm switching faster than the channels on TV","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":49.50125,"end":51.19525,"text":"I'm black, then I'm white","translation":"一会儿漆黑 一会儿雪白","segments":[{"text":"I'm black, then I'm white","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":51.19525,"end":53.04825,"text":"No! Something isn't right!","translation":"不！ 一定有哪里不对劲！","segments":[{"text":"No! Something isn't right!","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":53.04825,"end":56.70225,"text":"My enemy's invisible,","translation":"我的敌人隐匿无形","segments":[{"text":"My enemy's invisible,","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":53.04825,"end":56.70225,"text":"I don't know how to fight","translation":"我根本不知该如何与之战斗","segments":[{"text":"I don't know how to fight","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":56.70225,"end":60.27825,"text":"The trembling fear","translation":"那止不住颤抖的恐惧","segments":[{"text":"The trembling fear","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":56.70225,"end":60.27825,"text":"Is more than I can take","translation":"早已超出我能承受的极限","segments":[{"text":"Is more than I can take","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":60.27825,"end":63.74125,"text":"When I'm up against","translation":"当我不得不去直面","segments":[{"text":"When I'm up against","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":60.27825,"end":63.74125,"text":"The echo in the mirror","translation":"镜中映照出的回声","segments":[{"text":"The echo in the mirror","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":63.74125,"end":70.83362,"text":"ECHO...","translation":"回声……","segments":[{"text":"ECHO...","performerIds":["歌唱者-10"]}],"performerIds":[]},{"start":70.83362,"end":74.0145,"text":"The trembling fear","translation":"那止不住颤抖的恐惧","segments":[{"text":"The trembling fear","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":70.83362,"end":74.0145,"text":"Is more than I can take","translation":"早已超出我能承受的极限","segments":[{"text":"Is more than I can take","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":74.0145,"end":77.3425,"text":"When I'm up against","translation":"当我不得不去直面","segments":[{"text":"When I'm up against","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":74.0145,"end":77.3425,"text":"The echo in the mirror","translation":"镜中映照出的回声","segments":[{"text":"The echo in the mirror","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":77.3425,"end":80.8445,"text":"The trembling fear","translation":"那止不住颤抖的恐惧","segments":[{"text":"The trembling fear","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":77.3425,"end":80.8445,"text":"Is more than I can take","translation":"早已超出我能承受的极限","segments":[{"text":"Is more than I can take","performerIds":["歌唱者-10","歌唱者-11"]}],"performerIds":[]},{"start":80.8445,"end":107.72125,"text":"When I'm up against","translation":"当我不得不去直面","segments":[{"tex