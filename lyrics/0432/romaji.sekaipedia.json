  "lines": [
    {
      "text": "外出た瞬間　終わったわ",
      "romaji": "soto deta shunkan owatta wa"
    },
    {
      "text": "天気は良いのに　進めない",
      "romaji": "tenki wa ii no ni susumenai"
    },
    {
      "text": "風　強すぎて　お亡くなり",
      "romaji": "kaze tsuyosugite onakunari"
    },
    {
      "text": "定期　定期　的にオールバック",
      "romaji": "teiki teiki teki ni oorubakku"
    },
    {
      "text": "地下に潜りたいな　って　思いました",
      "romaji": "chika ni moguritai na tte omoimashita"
    },
    {
      "text": "風さえなくなれば　あったかいのに",
      "romaji": "kaze sae naku nareba attakai no ni"
    },
    {
      "text": "ずっと座りたいな　って　思いました",
      "romaji": "zutto suwaritai na tte omoimashita"
    },
    {
      "text": "いやいや　と　外でたら",
      "romaji": "iyaiya to soto detara"
    },
    {
      "text": "ハト　ハト　ハト　ハト　大乱闘",
      "romaji": "hato hato hato hato dairantou"
    },
    {
      "text": "そっ　と出た瞬間　終わったわ",
      "romaji": "sotto deta shunkan owatta wa"
    },
    {
      "text": "髪の毛　強風オールバック",
      "romaji": "kaminoke kyoufuu oorubakku"
    }
  ]
}
