  "lines": [
    {
      "text": "今日も布団を出られない",
      "romaji": "kyou mo futon o derarenai"
    },
    {
      "text": "アラームを5つかける",
      "romaji": "araamu o itsutsu kakeru"
    },
    {
      "text": "らんらら 欲望には逆らえない",
      "romaji": "ranrara yokubou ni wa sakaraenai"
    },
    {
      "text": "まるでちっともお金が貯まらない",
      "romaji": "marude chittomo okane ga tamaranai"
    },
    {
      "text": "口ではいつも謝る",
      "romaji": "kuchi de wa itsumo ayamaru"
    },
    {
      "text": "けど心じゃ知らん顔",
      "romaji": "kedo kokoro ja shirankao"
    },
    {
      "text": "らんらら 僕の気持ちが分かんない奴に",
      "romaji": "ranrara boku no kimochi ga wakannai yatsu ni"
    },
    {
      "text": "説教食らっても効かない",
      "romaji": "sekkyou kuratte mo kikanai"
    },
    {
      "text": "ああ　だめになっていく　罪の意識薄れていく",
      "romaji": "aa dame ni natteiku tsumi no ishiki usureteiku"
    },
    {
      "text": "図太いくせメンタルは",
      "romaji": "zubutoi kuse mentaru wa"
    },
    {
      "text": "弱い",
      "romaji": "yowai"
    },
    {
      "text": "だだだ　だだだ　だめにんげんだから",
      "romaji": "dadada dadada dame ningen dakara"
    },
    {
      "text": "君の気持ち　分からない　知らない",
      "romaji": "kimi no kimochi wakaranai shiranai"
    },
    {
      "text": "だだだ　ダ・ヴィンチもびっくり",
      "romaji": "dadada da vinchi mo bikkurino"
    },
    {
      "text": "の凡人っぷりさ",
      "romaji": "bonjinppuri sa"
    },
    {
      "text": "だだだ　だだだ　だめみたい　ごめんね",
      "romaji": "dadada dadada dame mitai gomen ne"
    },
    {
      "text": "だだだ　誰でも構わない",
      "romaji": "dadada dare demo kamawanai"
    },
    {
      "text": "承認をちょうだい",
      "romaji": "shounin o choudai"
    },
    {
      "text": "騙すつもりはなかった",
      "romaji": "damasu tsumori wa nakatta"
    },
    {
      "text": "だだだ　だめにんげん!",
      "romaji": "dadada dame ningen!"
    },
    {
      "text": "だだだ　だめにんげんだから",
      "romaji": "dadada dame ningen dakara"
    },
    {
      "text": "生き方さえ分からない　知らない",
      "romaji": "ikikata sae wakaranai shiranai"
    },
    {
      "text": "だだだ　大事ならやらなきゃ ",
      "romaji": "dadada daiji nara yaranakya"
    },
    {
      "text": "だめになる前に",
      "romaji": "dame ni naru mae ni"
    },
    {
      "text": "だだだ　誰でも構わない　承認をちょうだい",
      "romaji": "dadada dare demo kamawanai shounin o choudai"
    },
    {
      "text": "こうなるはずじゃなかった",
      "romaji": "kou naru hazu ja nakatta"
    },
    {
      "text": "だだだ　だめだめ!",
      "romaji": "dadada dame dame!"
    }
  ]
}
