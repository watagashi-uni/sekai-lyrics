  "lines": [
    {
      "text": "町を　よるが包むとき",
      "romaji": "machi o yoru ga tsutsumu toki"
    },
    {
      "text": "出店並ぶこの道で",
      "romaji": "demise narabu kono michi de"
    },
    {
      "text": "夜空の住み人たちの",
      "romaji": "yozora no sumi hitotachi no"
    },
    {
      "text": "宴が始まる",
      "romaji": "utage ga hajimaru"
    },
    {
      "text": "光の三原色の",
      "romaji": "hikari no sangenshoku no"
    },
    {
      "text": "ネオンが眩しくて",
      "romaji": "neon ga mabushikute"
    },
    {
      "text": "星のあかりより強く",
      "romaji": "hoshi no akari yori tsuyoku"
    },
    {
      "text": "グルーヴを響かせて",
      "romaji": "guruuvu o hibikasete"
    },
    {
      "text": "おどロボたちの夏祭り",
      "romaji": "odorobotachi no natsumatsuri"
    },
    {
      "text": "今宵の供物を捧げて",
      "romaji": "koyoi no kumotsu o sasagete"
    },
    {
      "text": "フレデリックの歌詞みたいに",
      "romaji": "furederikku no kashi mitai ni"
    },
    {
      "text": "踊れ夜が明けるまで",
      "romaji": "odore yo ga akeru made"
    },
    {
      "text": "23時を彩る",
      "romaji": "nijuusanji o irodoru"
    },
    {
      "text": "ラムネ瓶に ずんだ　かき氷",
      "romaji": "ramunebin ni zunda kakigoori"
    },
    {
      "text": "このよるは終わらない",
      "romaji": "kono yoru wa owaranai"
    },
    {
      "text": "アマテラスは閉じ込めて",
      "romaji": "amaterasu wa tojikomete"
    },
    {
      "text": "天岩戸にステイ",
      "romaji": "amanoiwato ni sutei"
    },
    {
      "text": "ホームステイしテイてね",
      "romaji": "hoomu sutei shite ite ne"
    },
    {
      "text": "バッテリーの切れる日まで",
      "romaji": "batterii no kireru hi made"
    },
    {
      "text": "自動人形のようにダンス",
      "romaji": "ootomata no you ni dansu"
    },
    {
      "text": "ロボットダンス踊り明かせ！",
      "romaji": "robotto dansu odoriakase!"
    },
    {
      "text": "「そろそろ飽きてきた」だって？",
      "romaji": "\"sorosoro akite kita\" datte?"
    },
    {
      "text": "言葉をつつしめよ！",
      "romaji": "kotoba o tsutsushime yo!"
    },
    {
      "text": "今宵の供物はおあずけ",
      "romaji": "koyoi no kumotsu wa oazuke"
    },
    {
      "text": "踊ろう　夜は明けねども",
      "romaji": "odorou yo wa akenedo mo"
    },
    {
      "text": "午前６時も鮮やかに",
      "romaji": "gozen rokuji mo azayaka ni"
    },
    {
      "text": "このよるはまだ続く",
      "romaji": "kono yoru wa mada tsuzuku"
    },
    {
      "text": "月は満ちも欠けもせず",
      "romaji": "tsuki wa michi mo kake mo sezu"
    }
  ]
}
