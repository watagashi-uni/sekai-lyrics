{"musicId":698,"duration":139.376375,"vocalId":1748,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-17","name":"宵崎奏"},{"performerId":"歌唱者-18","name":"朝比奈まふゆ"},{"performerId":"歌唱者-19","name":"東雲絵名"},{"performerId":"歌唱者-20","name":"暁山瑞希"},{"performerId":"歌唱者-21","name":"初音ミク"}],"lines":[{"start":8.79625,"end":13.67925,"text":"もう何もかも嫌になる前に","translation":"在对一切感到厌倦之前","segments":[{"text":"もう何もかも嫌になる前に","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":13.67925,"end":36.69525,"text":"ホントウノ愛ヲクダサ…","translation":"请给我真正的爱……","segments":[{"text":"ホントウノ愛ヲクダサ…","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":36.69525,"end":43.74325,"text":"今日は少し下がった","translation":"今天又下滑了一些","segments":[{"text":"今日は少し下がった","performerIds":["歌唱者-18"]}],"performerIds":[]},{"start":36.69525,"end":43.74325,"text":"破り捨てたい評価","translation":"想要撕碎撕烂的评价","segments":[{"text":"破り捨てたい評価","performerIds":["歌唱者-18"]}],"performerIds":[]},{"start":43.74325,"end":50.05125,"text":"期待を超えられず","translation":"无法跨越期望","segments":[{"text":"期待を超えられず","performerIds":["歌唱者-18"]}],"performerIds":[]},{"start":43.74325,"end":50.05125,"text":"傷が増えてく","translation":"伤痕又在不断增加","segments":[{"text":"傷が増えてく","performerIds":["歌唱者-18"]}],"performerIds":[]},{"start":50.05125,"end":57.78925,"text":"ココロを鎖で縛られた　あやつり人形","translation":"心灵被锁链紧紧束缚的 提线木偶","segments":[{"text":"ココロを鎖で縛られた　あやつり人形","performerIds":["歌唱者-17"]}],"performerIds":[]},{"start":57.78925,"end":61.13725,"text":"わたしはアナタの装飾品","translation":"我只是属于你的装饰品","segments":[{"text":"わたしはアナタの装飾品","performerIds":["歌唱者-20"]}],"performerIds":[]},{"start":61.13725,"end":65.89625,"text":"もっと輝ケリクルケリクルケ","translation":"更加闪耀吧闪亮吧闪耀闪耀","segments":[{"text":"もっと輝ケリクルケリクルケ","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":65.89625,"end":70.35625,"text":"誰ノ為ニ生きているのでしょうか","translation":"到底是为了谁而活下去呢","segments":[{"text":"誰ノ為ニ生きているのでしょうか","performerIds":["歌唱者-17"]}],"performerIds":[]},{"start":70.35625,"end":73.96725,"text":"”ジブン”と言えないままで","translation":"连「自我」都无法说出口","segments":[{"text":"”ジブン”と言えないままで","performerIds":["歌唱者-20"]}],"performerIds":[]},{"start":73.96725,"end":77.73025,"text":"もう何もかも嫌になる前に","translation":"在对一切感到厌倦之前","segments":[{"text":"もう何もかも嫌になる前に","performerIds":["歌唱者-19"]}],"performerIds":[]},{"start":77.73025,"end":96.29325,"text":"ホントノ愛ヲクダサイ","translation":"请给我真正的爱","segments":[{"text":"ホントノ愛ヲクダサイ","performerIds":["歌唱者-18"]}],"performerIds":[]},{"start":96.29325,"end":100.77525,"text":"誰のために生きているのでしょうか","translation":"到底是为了谁而活着呢","segments":[{"text":"誰のために生きているのでしょうか","performerIds":["歌唱者-18","歌唱者-21"]}],"performerIds":[]},{"start":100.77525,"end":104.12425,"text":"コタエは目の前にある","translation":"答案就在眼前","segments":[{"text":"コタエは","performerIds":["歌唱者-17"]},{"text":"目の前にある","performerIds":["歌唱者-17","歌唱者-21"]}],"performerIds":[]},{"start":104.12425,"end":107.68925,"text":"わたしの未来を奪うなんて","translation":"胆敢剥夺属于我的未来","segments":[{"text":"わたしの未来を奪うなんて","performerIds":["歌唱者-19","歌唱者-21"]}],"performerIds":[]},{"start":107.68925,"end":111.40025,"text":"そんなの許さないから","translation":"这种事我绝不原谅","segments":[{"text":"そんなの","performerIds":["歌唱者-19"]},{"text":"許さないから","performerIds":["歌唱者-19","歌唱者-21"]}],"performerIds":[]},{"start":111.40025,"end":114.95825,"text":"もう何もかも嫌になる前に","translation":"在对一切感到厌倦之前","segments":[{"text":"もう何もかも嫌になる前に","performerIds":["歌唱者-20"]}],"performerIds":[]},{"start":114.95825,"end":139.37637,"text":"鎖の鍵を解いて","translation":"解开这锁链的锁扣吧","segments":[{"text":"鎖の鍵を解いて","performerIds":["歌唱者-21"]}],"performerIds":[]}],"credits":{"translation":"雪莹ちゃん"},"sources":[["https://www.sekaipedia.org/wiki/Kusari_no_Shoujo_-Re_Alive-?oldid=329771","CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}