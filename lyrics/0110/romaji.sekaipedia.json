  "lines": [
    {
      "text": "大胆不敵にハイカラ革命",
      "romaji": "daitan-futeki ni haikara kakumei"
    },
    {
      "text": "磊々落々反戦国家",
      "romaji": "rairai-rakuraku hansen kokka"
    },
    {
      "text": "日の丸印の二輪車転がし",
      "romaji": "hinomaru-jirushi no nirinsha korogashi"
    },
    {
      "text": "悪霊退散　ICBM",
      "romaji": "akuryou-taisan ICBM"
    },
    {
      "text": "環状線を走り抜けて",
      "romaji": "kanjousen o hashirinukete"
    },
    {
      "text": "東奔西走なんのその",
      "romaji": "touhon-seisou nan no sono"
    },
    {
      "text": "少年少女戦国無双",
      "romaji": "shounen shoujo sengoku-musou"
    },
    {
      "text": "浮世の 随に",
      "romaji": "ukiyo no manima ni"
    },
    {
      "text": "千本桜　夜ニ紛レ",
      "romaji": "senbonzakura yoru ni magire"
    },
    {
      "text": "君ノ声モ届カナイヨ",
      "romaji": "kimi no koe mo todokanai yo"
    },
    {
      "text": "此処は宴　鋼の檻",
      "romaji": "koko wa utage hagane no ori"
    },
    {
      "text": "その断頭台で見下ろして",
      "romaji": "sono dantoudai de mioroshite"
    },
    {
      "text": "三千世界　 常世之闇",
      "romaji": "sanzen sekai tokoyo no yami"
    },
    {
      "text": "嘆ク唄モ聞コエナイヨ",
      "romaji": "nageku uta mo kikoenai yo"
    },
    {
      "text": "青藍の空　遥か彼方",
      "romaji": "seiran no sora haruka kanata"
    },
    {
      "text": "その光線銃で打ち抜いて",
      "romaji": "sono kousenjuu de uchinuite"
    },
    {
      "text": "その断頭台を飛び降りて",
      "romaji": "sono dantoudai o tobiorite"
    },
    {
      "text": "君が歌い僕は踊る",
      "romaji": "kimi ga utai boku wa odoru"
    },
    {
      "text": "さあ光線銃を撃ちまくれ",
      "romaji": "saa kousenjuu o uchimakure"
    }
  ]
}
