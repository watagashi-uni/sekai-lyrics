  "lines": [
    {
      "text": "これから辞めるわ 『もう一回』",
      "romaji": "kore kara yameru wa \"mou ikkai\""
    },
    {
      "text": "ただ飽きたら捨てるわ 『もう一回』",
      "romaji": "tada akitara suteru wa \"mou ikkai\""
    },
    {
      "text": "でもこれだけ試して 『もう一回』",
      "romaji": "demo kore dake tameshite \"mou ikkai\""
    },
    {
      "text": "気を引きたいだけの人",
      "romaji": "ki wo hikitai dake no hito"
    },
    {
      "text": "月夜を切裂く 赤い雑音(ノイズ",
      "romaji": "tsukiyo wo kirisaku akai noizu"
    },
    {
      "text": "叫んで 響いて 『もう一回』",
      "romaji": "sakende hibiite \"mou ikkai\""
    },
    {
      "text": "ほら冷たい唇差し出して",
      "romaji": "hora tsumetai kuchibiru sashidashite"
    },
    {
      "text": "嘘こぼれ出ちゃうかもね",
      "romaji": "uso kobore dechau kamo ne"
    },
    {
      "text": "全て壊して 狂いましょう",
      "romaji": "subete kowashite kuruimashou"
    },
    {
      "text": "制約の犬に 今ナイフを突き刺して",
      "romaji": "seiyaku no inu ni ima naifu wo tsukisashite"
    },
    {
      "text": "現実を睨む手前 『もう一回』",
      "romaji": "genjitsu wo niramu temae \"mou ikkai\""
    },
    {
      "text": "二十一の感情をただ吐き出しただけの",
      "romaji": "nijuuichi no kanjou wo tada hakidashita dake no"
    },
    {
      "text": "這いずるだけの唄",
      "romaji": "haizuru dake no uta"
    },
    {
      "text": "全て失くして",
      "romaji": "subete nakushite"
    },
    {
      "text": "追いすぎた理想に 今刃物で切り裂かれ",
      "romaji": "oisugita risou ni ima hamono de kirisakare"
    },
    {
      "text": "競争に沈む手前 『もう一回』",
      "romaji": "kyousou ni shizumu temae \"mou ikkai\""
    },
    {
      "text": "二十二の現実にただ押し潰されただけの",
      "romaji": "nijuuni no genjitsu ni tada oshitsubusareta dake no"
    },
    {
      "text": "敗北者の為の唄",
      "romaji": "haibokusha no tame no uta"
    }
  ]
}
