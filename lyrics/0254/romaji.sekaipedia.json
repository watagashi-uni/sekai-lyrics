  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "当て所もない道を僕らは進む",
      "romaji": "ate domonai michi o bokura wa susumu"
    },
    {
      "text": "救いなんてない",
      "romaji": "sukui nante nai"
    },
    {
      "text": "終わりなんてない",
      "romaji": "owari nante nai"
    },
    {
      "text": "曇り切った視界に",
      "romaji": "kumori kitta shikai ni"
    },
    {
      "text": "一筋の愛を",
      "romaji": "hitotsuji no ai o"
    },
    {
      "text": "僕らの未完成で不完全な声が",
      "romaji": "bokura no mikansei de fukanzen na koe ga"
    },
    {
      "text": "世界を貫く",
      "romaji": "sekai o tsuranuku"
    },
    {
      "text": "焦がれた未来像を機械音を",
      "romaji": "kogareta miraizou o kikaion o"
    },
    {
      "text": "今掻き鳴らしていく",
      "romaji": "ima kaki narashite iku"
    },
    {
      "text": "役を終えた舞台の光は",
      "romaji": "yaku o oeta butai no hikari wa"
    },
    {
      "text": "泡のように弾けて消えてしまう",
      "romaji": "awa no you ni hajikete kieteshimau"
    },
    {
      "text": "それなら描いた未来だけは",
      "romaji": "sore nara egaita mirai dake wa"
    },
    {
      "text": "このまま未完成で不完全なまま",
      "romaji": "kono mama mikansei de fukanzen na mama"
    },
    {
      "text": "変わらないでいて",
      "romaji": "kawaranai de ite"
    },
    {
      "text": "届きそうもない",
      "romaji": "todoki sou mo na"
    },
    {
      "text": "誰も待ってない",
      "romaji": "dare mo matte nai"
    },
    {
      "text": "それでも構わない",
      "romaji": "sore demo kamawanai"
    },
    {
      "text": "二人の理想を",
      "romaji": "futari no risou o"
    },
    {
      "text": "僕らは未完成でこんなに不完全で",
      "romaji": "bokura wa mikansei de konna ni fukanzen de"
    },
    {
      "text": "だからこそ何回も何回も",
      "romaji": "dakara koso nankai mo nankai mo"
    },
    {
      "text": "高みを目指していく",
      "romaji": "takami o mezashiteiku"
    },
    {
      "text": "君と繋いだこの",
      "romaji": "kimi to tsunaida kono"
    },
    {
      "text": "フィクションを綴る",
      "romaji": "fikushon o tsuzuru"
    }
  ]
}
