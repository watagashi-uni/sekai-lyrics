  "lines": [
    {
      "text": "朝　目が覚めて",
      "romaji": "asa me ga samete"
    },
    {
      "text": "真っ先に思い浮かぶ 君のこと",
      "romaji": "massaki ni omoi ukabu kimi no koto"
    },
    {
      "text": "思い切って 前髪を切った",
      "romaji": "omoikitte maegami o kitta"
    },
    {
      "text": "「どうしたの?」って 聞かれたくて",
      "romaji": "\"doushita no?\" tte kikaretakute"
    },
    {
      "text": "さして　出かけるの",
      "romaji": "sashite dekakeru no"
    },
    {
      "text": "今日の私はかわいいのよ！",
      "romaji": "kyou no watashi wa kawaii no yo!"
    },
    {
      "text": "メルト　溶けてしまいそう",
      "romaji": "meruto tokete shimaisou"
    },
    {
      "text": "恋に恋なんてしないわ　わたし",
      "romaji": "koi ni koi nante shinai wa watashi"
    },
    {
      "text": "でも嬉しくて　死んでしまうわ！",
      "romaji": "demo ureshikute shinde shimau wa!"
    },
    {
      "text": "メルト　駅に着いてしまう…",
      "romaji": "meruto eki ni tsuite shimau..."
    },
    {
      "text": "メルト　手をつないで歩きたい！",
      "romaji": "meruto te o tsunaide arukitai!"
    },
    {
      "text": "もうバイバイしなくちゃいけないの？",
      "romaji": "mou baibai shinakucha ikenai no?"
    },
    {
      "text": "今すぐ　わたしを抱きしめて！",
      "romaji": "ima sugu watashi o dakishimete!"
    },
    {
      "text": "…なんてね",
      "romaji": "... nante ne"
    }
  ]
}
