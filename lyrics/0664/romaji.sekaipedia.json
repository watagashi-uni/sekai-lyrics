  "lines": [
    {
      "text": "（わー！）",
      "romaji": "(waa!)"
    },
    {
      "text": "興奮してきた 人様の業で",
      "romaji": "koufun shite kita hitosama no gou de"
    },
    {
      "text": "センター分けの つむじ刺す",
      "romaji": "sentaa wake no tsumuji sasu"
    },
    {
      "text": "アホの 吐血見てると",
      "romaji": "aho no toketsu miteru to"
    },
    {
      "text": "チョキで 勝てる気すんな",
      "romaji": "choki de kateru ki sun na"
    },
    {
      "text": "手抜くぞ (why?)",
      "romaji": "tenuku zo (why?)"
    },
    {
      "text": "すぐ抜くぞ",
      "romaji": "sugu nuku zo"
    },
    {
      "text": "スポーツ スポーツ",
      "romaji": "supootsu supootsu"
    },
    {
      "text": "腰抜けよ",
      "romaji": "koshinuke yo"
    },
    {
      "text": "子供の前で",
      "romaji": "kodomo no mae de"
    },
    {
      "text": "着ぐるみを脱ぐ",
      "romaji": "kigurumi o nugu"
    },
    {
      "text": "『な～～んだ？』",
      "romaji": "“na~~nda?”"
    },
    {
      "text": "A．私",
      "romaji": "A. watashi"
    },
    {
      "text": "ビバ良くない！",
      "romaji": "biba yokunai!"
    },
    {
      "text": "ただ物足りない！",
      "romaji": "tada monotarinai!"
    },
    {
      "text": "うん、小さくなってく器で",
      "romaji": "un, chiisaku natteku utsuwa de"
    },
    {
      "text": "トびたい！",
      "romaji": "tobitai!"
    },
    {
      "text": "トびたい！　トびたい！",
      "romaji": "tobitai! tobitai!"
    },
    {
      "text": "（きゃ〜！）",
      "romaji": "(kya~!)"
    },
    {
      "text": "ポリエステル仕事はムリか",
      "romaji": "poriesuteru shigoto wa muri ka"
    },
    {
      "text": "金で殺して 愛を買うね。",
      "romaji": "kane de koroshite ai o kau ne."
    },
    {
      "text": "すまんね。",
      "romaji": "suman ne."
    },
    {
      "text": "晩年",
      "romaji": "bannen"
    },
    {
      "text": "あ…消した。環境の為に。",
      "romaji": "a... keshita. kankyou no tame ni."
    },
    {
      "text": "Xだけの ”人マニア”",
      "romaji": "tsuittaa dake no ”hito mania”"
    },
    {
      "text": "罠の 墓穴見てると",
      "romaji": "wana no boketsu miteru to"
    },
    {
      "text": "塩を かける傷！",
      "romaji": "shio o kakeru kizu!"
    },
    {
      "text": "恋人の前で",
      "romaji": "koibito no mae de"
    },
    {
      "text": "血まみれになる",
      "romaji": "chimamire ni naru"
    },
    {
      "text": "A．お前",
      "romaji": "A. omae"
    },
    {
      "text": "ただ??????",
      "romaji": "tada monotarinai!"
    },
    {
      "text": "（あー！）",
      "romaji": "(aa!)"
    },
    {
      "text": "ああ…すまんね。",
      "romaji": "aa... suman ne."
    },
    {
      "text": "最高だよ　本当！　本当！",
      "romaji": "saikou da yo hontou! hontou!"
    },
    {
      "text": "小さく成ってく冠婚葬祭",
      "romaji": "chiisaku natteku kankonsousai"
    },
    {
      "text": "蹴りたい！",
      "romaji": "keritai!"
    },
    {
      "text": "蹴りたい！　蹴りたい！",
      "romaji": "keritai! keritai!"
    },
    {
      "text": "生きろ。悪意も　恥も　償いも",
      "romaji": "ikiro. akui mo haji mo tsugunai mo"
    },
    {
      "text": "全毒　背負って　くたばらにゃ",
      "romaji": "zendoku seotte kutabara nya"
    },
    {
      "text": "いかんね。",
      "romaji": "ikan ne."
    }
  ]
}
