    {
      "text": "だんだん早くなる",
      "romaji": "dandan hayaku naru"
    },
    {
      "text": "だんだん忙しくなる",
      "romaji": "dandan isogashiku naru"
    },
    {
      "text": "だんだん難しくなる",
      "romaji": "dandan muzukashiku naru"
    },
    {
      "text": "だんだん楽しくなる",
      "romaji": "dandan tanoshiku naru"
    },
    {
      "text": "だんだん笑顔になる",
      "romaji": "dandan egao ni naru"
    },
    {
      "text": "マイペースでいいんだって",
      "romaji": "mai peesu de ii nda tte"
    },
    {
      "text": "だんだん遅くなる",
