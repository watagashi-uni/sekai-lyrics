  "lines": [
    {
      "text": "ぶっ飛んだアイデアにはNo No",
      "romaji": "buttonda aidea ni wa No No"
    },
    {
      "text": "なんてやってられんな",
      "romaji": "nante yatterarenna"
    },
    {
      "text": "平凡なんじゃカッコ悪いぜ",
      "romaji": "heibon nan ja kakko warui ze"
    },
    {
      "text": "大言吐いていたって",
      "romaji": "taigen haite ita tte"
    },
    {
      "text": "ゆるりゆるり",
      "romaji": "yururi yururi"
    },
    {
      "text": "イージーゲーム GGです",
      "romaji": "iiji geemu GG desu"
    },
    {
      "text": "やり過ごして",
      "romaji": "yarisugoshite"
    },
    {
      "text": "「期待」「愛」「未来」無い",
      "romaji": "\"kitai\" \"ai\" \"mirai\" nai"
    },
    {
      "text": "薄明かりのもと",
      "romaji": "usuakari no moto"
    },
    {
      "text": "ぷかぷかぷか",
      "romaji": "pukapukapuka"
    },
    {
      "text": "夜の間に間に",
      "romaji": "yoru no ma ni ma ni"
    },
    {
      "text": "真っ逆さまだ",
      "romaji": "massakasama da"
    },
    {
      "text": "夢の間に間に",
      "romaji": "yume no ma ni ma ni"
    },
    {
      "text": "ただ踊っていたいだけなんだ",
      "romaji": "tada odotte itai dake nan da"
    },
    {
      "text": "黙っていたって",
      "romaji": "damatte ita tte"
    },
    {
      "text": "ぶわっは",
      "romaji": "buwahha"
    },
    {
      "text": "明日にはきっと何か見つかんだろう",
      "romaji": "asu ni wa kitto nanika mitsukan darou"
    },
    {
      "text": "昨日もそんなこと思ってたっけな",
      "romaji": "kinou mo sonna koto omotteta kke na"
    },
    {
      "text": "ピーキーで PPです",
      "romaji": "piikii de PP desu"
    },
    {
      "text": "のらりくらり",
      "romaji": "norarikurari"
    },
    {
      "text": "たゆたうように",
      "romaji": "tayutau you ni"
    },
    {
      "text": "考えすぎて",
      "romaji": "kangaesugite"
    },
    {
      "text": "馬鹿にだってなるでしょう",
      "romaji": "baka ni datte naru deshou"
    }
  ]
}
