  "795": {
    "bilingualChanges": [
      {
        "index": 0,
        "japanese": "寝癖のままで",
        "old": "带着乱蓬蓬的睡发",
        "new": "顶着睡乱翘起的头发"
      },
      {
        "index": 1,
        "japanese": "散歩しちゃうんだ",
        "old": "就这样去散步了",
        "new": "径直出门散散步"
      },
      {
        "index": 2,
        "japanese": "友達は気づいたら",
        "old": "等回过神来的时候",
        "new": "朋友们等回过神来"
      },
      {
        "index": 3,
        "japanese": "いないね",
        "old": "朋友们都不见了",
        "new": "一个都不在了呢"
      },
      {
        "index": 4,
        "japanese": "言葉が見つかんない",
        "old": "话语也找不到",
        "new": "找寻不到言语"
      },
      {
        "index": 5,
        "japanese": "煙を焚いた",
        "old": "就这样点燃了烟",
        "new": "点燃了缕缕轻烟"
      },
      {
        "index": 6,
        "japanese": "これで何回目かも",
        "old": "这已经是第几次了呢",
        "new": "这到底是第几次"
      },
      {
        "index": 7,
        "japanese": "わからない",
        "old": "还真是不知道",
        "new": "也早已无从知晓"
      },
      {
        "index": 9,
        "japanese": "ひとつ",
        "old": "一个人",
        "new": "稍稍"
      },
      {
        "index": 10,
        "japanese": "手を合わせてみよう",
        "old": "双手合十试试吧",
        "new": "双手合十祈祷看看吧"
      },
      {
        "index": 12,
        "japanese": "このまま私も",
        "old": "就请这样把我",
        "new": "就这样把我也"
      },
      {
        "index": 13,
        "japanese": "連れてって",
        "old": "带走吧",
        "new": "一起带走吧"
      },
      {
        "index": 14,
        "japanese": "今度またラーメンでも",
        "old": "下次再去吃拉面什么的",
        "new": "下次再去吃碗拉面什么的"
      },
      {
        "index": 15,
        "japanese": "叶いはしないけれど",
        "old": "虽然这种愿望不会实现",
        "new": "虽说根本无法实现"
      },
      {
        "index": 16,
        "japanese": "まあ！",
        "old": "算了！",
        "new": "嘛！"
      },
      {
        "index": 17,
        "japanese": "この先もずっと",
        "old": "往后也将一直",
        "new": "今后也一直一直"
      },
      {
        "index": 18,
        "japanese": "愛してるから",
        "old": "深爱着你啊",
        "new": "深爱着你"
      },
      {
        "index": 19,
        "japanese": "飽きてはないけど",
        "old": "虽然还不会厌倦",
        "new": "虽然并未厌倦"
      },
      {
        "index": 20,
        "japanese": "ずっとずっと生きてる",
        "old": "一直一直生活了很久",
        "new": "却一直一直活着"
      },
      {
        "index": 47,
        "japanese": "ああ！このまま私も連れてって",
        "old": "啊啊！就请这样把我带走吧",
        "new": "啊啊！就这样把我也一起带走吧"
      },
      {
        "index": 48,
        "japanese": "今度またラーメンでも",
        "old": "下次再去吃拉面什么的",
        "new": "下次再去吃碗拉面什么的"
      },
      {
        "index": 49,
        "japanese": "叶いはしないけれど",
        "old": "虽然这种愿望不会实现",
        "new": "虽说根本无法实现"
      },
      {
        "index": 51,
        "japanese": "味気ないほどに",
        "old": "有些索然无味了",
        "new": "甚至显得索然无味地"
      },
      {
        "index": 52,
        "japanese": "恋してる！",
        "old": "对于爱情！",
        "new": "深深恋慕着你！"
      },
      {
        "index": 53,
        "japanese": "まあどこか知らない",
        "old": "也好 那就去往某个",
        "new": "嘛 无论去往何处"
      },
      {
        "index": 54,
        "japanese": "ところまで行こうよ",
        "old": "不为人知的地方吧",
        "new": "一起去未知的彼方吧"
      },
      {
        "index": 55,
        "japanese": "もう誰もいないけれど笑",
        "old": "反正谁都已经不在了 笑",
        "new": "虽然那里早就空无一人了 笑"
      },
      {
        "index": 56,
        "japanese": "ちょっとだけ待って！",
        "old": "稍微等一下呀！",
        "new": "稍微等一下！"
      },
      {
        "index": 57,
        "japanese": "時間が過ぎていく",
        "old": "时间如同白驹过隙",
        "new": "时间正在悄然流逝"
      },
      {
        "index": 58,
        "japanese": "ちょっとだけ待って！",
        "old": "稍微等一下呀！",
        "new": "稍微等一下！"
      },
      {
        "index": 59,
        "japanese": "私は邪魔みたい",
        "old": "我好像变成了累赘一样",
        "new": "我似乎是个碍事的家伙"
      },
      {
        "index": 60,
        "japanese": "今日をぎゅっと抱いて！",
        "old": "紧紧拥抱着今天！",
        "new": "紧紧拥抱住今天吧！"
      },
      {
        "index": 61,
        "japanese": "星に願ってんの！",
        "old": "向星星许下愿望！",
        "new": "向着繁星许下心愿！"
      },
      {
        "index": 62,
        "japanese": "そっとぎゅっと抱いて！",
        "old": "悄悄的紧紧拥抱！",
        "new": "轻轻地紧紧拥入怀中！"
      },
      {
        "index": 63,
        "japanese": "これからも生きる",
        "old": "从现在开始也要接着活下去",
        "new": "今后也会继续活下去"
      },
      {
        "index": 64,
        "japanese": "またきてね！",
        "old": "要再来啊！",
        "new": "记得再来找我玩哦！"
      }
