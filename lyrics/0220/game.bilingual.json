{
  "music_id": 220,
  "time_origin": "selected_game_recording_start_including_pre_roll",
  "performers": [],
  "lines": [
    {
      "index": 0,
      "start": 17.009,
      "end": 18.811,
      "japanese": "いつからこんなに大きな",
      "zh-CN": "究竟是从何时起拥有了",
      "shared_interval": false
    },
    {
      "index": 1,
      "start": 18.811,
      "end": 20.772,
      "japanese": "思い出せない記憶があったか",
      "zh-CN": "如此庞大再也无法忆起的记忆呢",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 20.772,
      "end": 22.582,
      "japanese": "どうにも憶えてないのを",
      "zh-CN": "唯独无论如何都记不起来这件事",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 22.582,
      "end": 24.612,
      "japanese": "ひとつ確かに憶えてるんだな",
      "zh-CN": "却格外确凿真切地牢牢记在心里呢",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 24.612,
      "end": 26.722,
      "japanese": "もう一回何回やったって",
      "zh-CN": "无论再重来多少次",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 26.722,
      "end": 28.372,
      "japanese": "思い出すのはその顔だ",
      "zh-CN": "脑海中浮现的唯有那张面庞",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 28.372,
      "end": 30.241,
      "japanese": "それでもあなたがなんだか",
      "zh-CN": "即使如此关于你的一切",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 29.76,
      "end": 32.629,
      "japanese": "思い出せないままでいるんだな",
      "zh-CN": "却依然什么都想不起来呢",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 32.629,
      "end": 33.893,
      "japanese": "環状線は地球儀を",
      "zh-CN": "环状线在地球仪上",
      "shared_interval": false
    },
    {
      "index": 9,
      "start": 33.2,
      "end": 36.048,
      "japanese": "巡り巡って朝日を追うのに",
      "zh-CN": "辗转循环追逐着朝阳",
      "shared_interval": false
    },
    {
      "index": 10,
      "start": 36.048,
      "end": 37.732,
      "japanese": "レールの要らない僕らは",
      "zh-CN": "无需轨道的我们",
      "shared_interval": false
    },
    {
      "index": 11,
      "start": 37.721,
      "end": 39.927,
      "japanese": "望み好んで夜を追うんだな",
      "zh-CN": "却偏偏甘愿追逐黑夜呢",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 39.922,
      "end": 41.93,
      "japanese": "もう一回何万回やって",
      "zh-CN": "无论再重来几万次",
      "shared_interval": false
    },
    {
      "index": 13,
      "start": 41.22,
      "end": 43.667,
      "japanese": "思い出すのはその顔だ",
      "zh-CN": "脑海中浮现的唯有那张面庞",
      "shared_interval": false
    },
    {
      "index": 14,
      "start": 42.96,
      "end": 45.325,
      "japanese": "瞼に乗った淡い雨",
      "zh-CN": "落在眼睑上的微弱细雨",
      "shared_interval": false
    },
    {
      "index": 15,
      "start": 45.34,
      "end": 47.58,
      "japanese": "聞こえないまま死んだ暗い声",
      "zh-CN": "未能听见便死去的昏暗声音",
      "shared_interval": false
    },
    {
      "index": 16,
      "start": 48.36,
      "end": 51.7,
      "japanese": "何も知らないままでいるのが",
      "zh-CN": "保持一无所知的状态",
      "shared_interval": false
    },
    {
      "index": 17,
      "start": 50.9,
      "end": 53.143,
      "japanese": "あなたを傷つけてはしないか",
      "zh-CN": "是否会深深伤害到了你呢",
      "shared_interval": false
    },
    {
      "id": "full-000019",
      "order": 18,
      "index": 18,
      "start": 55.397,
      "end": 59.007,
      "japanese": "それで今も眠れないのを",
      "zh-CN": "导致我现在依然无法入眠这件事",
      "segments": [
        {
          "text": "それで今も眠れないのを",
          "performerIds": [],
          "ruby": [
            {
              "text": "それで"
