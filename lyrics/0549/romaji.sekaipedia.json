  "lines": [
    {
      "text": "なにその目やっぱその目",
      "romaji": "nani sono me yappa sono me"
    },
    {
      "text": "はじめましてじゃないね",
      "romaji": "hajimemashite janai ne"
    },
    {
      "text": "なにその目もうやめて",
      "romaji": "nani sono me mou yamete"
    },
    {
      "text": "可愛いだけ なのに罪の味",
      "romaji": "kawaii dake nanoni tsumi no aji"
    },
    {
      "text": "ずれる ずれる 崩れる",
      "romaji": "zureru zureru kuzureru"
    },
    {
      "text": "ずれる気が触れる",
      "romaji": "zureru ki ga fureru"
    },
    {
      "text": "秘密ひとつで崩れる",
      "romaji": "himitsu hitotsu de kuzureru"
    },
    {
      "text": "壊れる、ごめん",
      "romaji": "kowareru, gomen"
    },
    {
      "text": "見ないで 理解出来ないでしょう?",
      "romaji": "minaide rikai dekinai deshou?"
    },
    {
      "text": "まるで咲いてしまった 化けの花",
      "romaji": "marude saite shimatta bake no hana"
    },
    {
      "text": "なにも言えない かき消せない",
      "romaji": "nani mo ienai kakikesenai"
    },
    {
      "text": "どんなに醜く映る化粧",
      "romaji": "donna ni minikuku utsuru keshou"
    },
    {
      "text": "つぼみにはもう戻れない",
      "romaji": "tsubomi ni wa mou modorenai"
    },
    {
      "text": "だったら消えて みーんないなくなれ",
      "romaji": "dattara kiete minna inakunare"
    },
    {
      "text": "いなくなれ いなくなれ",
      "romaji": "inakunare inakunare"
    },
    {
      "text": "いなくなれ そばに居て",
      "romaji": "inakunare soba ni ite"
    },
    {
      "text": "未来で 理解されないなら",
      "romaji": "mirai de rikai sarenai nara"
    },
    {
      "text": "此処でさっさと消えて 化けの花",
      "romaji": "koko de sassato kiete bake no hana"
    },
    {
      "text": "生まれた罰を終わらすように",
      "romaji": "umareta batsu o owarasu you ni"
    },
    {
      "text": "呼吸を止めて",
      "romaji": "kokyuu o tomete"
    },
    {
      "text": "あーもういいや",
      "romaji": "aa mou ii ya"
    }
  ]
}
