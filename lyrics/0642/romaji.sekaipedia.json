  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "前だけを向いて走ってきたけど",
      "romaji": "mae dake o muite hashitte kitakedo"
    },
    {
      "text": "どきどき心は靴擦れする",
      "romaji": "dokidoki kokoro wa kutsudzure suru"
    },
    {
      "text": "それでも憧れは握りしめたまま",
      "romaji": "soredemo akogare wa nigirishimeta mama"
    },
    {
      "text": "くしゃくしゃになっても",
      "romaji": "kusha kusha ni nattemo"
    },
    {
      "text": "捨てられないでいる",
      "romaji": "suterare naide iru"
    },
    {
      "text": "見た夢の全部が",
      "romaji": "mita yume no zenbu ga"
    },
    {
      "text": "叶うわけじゃないけど",
      "romaji": "kanau wake janai kedo"
    },
    {
      "text": "「信じてるから」じゃなくて",
      "romaji": "\"shinjiteru kara\" janakute"
    },
    {
      "text": "「信じたい」と思えるから",
      "romaji": "\"shinjitai\" to omoeru kara"
    },
    {
      "text": "「もうダメだ」って思えた夜の数だけ",
      "romaji": "\"mou dameda\" tte omoeta yoru no kazu dake"
    },
    {
      "text": "僕たち朝に出会えた",
      "romaji": "bokutachi wa asa ni deaeta"
    },
    {
      "text": "きっとかかとを",
      "romaji": "kitto kakato o"
    },
    {
      "text": "すり減らした分だけ",
      "romaji": "suri herashita bun dake"
    },
    {
      "text": "足あとはちゃんと増えるよ",
      "romaji": "ashi ato wa chanto fueruyo"
    },
    {
      "text": "どうせ長く なる旅路さ",
      "romaji": "douse nagaku naru tabiji sa"
    },
    {
      "text": "それじゃ焦ることをないだろう",
      "romaji": "soreja aseru koto o nai darou"
    },
    {
      "text": "じゃ、とりあえず",
      "romaji": "ja, toriaezu"
    },
    {
      "text": "このまんまでいこう",
      "romaji": "kono manma de ikou"
    },
    {
      "text": "まあ、大丈夫",
      "romaji": "maa, daijoubu"
    }
  ]
}
