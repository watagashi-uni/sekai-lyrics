  "lines": [
    {
      "text": "理論的には party people",
      "romaji": "rironteki ni wa party people"
    },
    {
      "text": "「いや そんな事はないか」",
      "romaji": "\"iya, sonna koto wa nai ka...\""
    },
    {
      "text": "電波に絡まるアイデアが",
      "romaji": "denpa ni karamaru aidea ga"
    },
    {
      "text": "イデアの波に乗って侵略中",
      "romaji": "idea no nami ni notte shinryakuchuu"
    },
    {
      "text": "毎時毎分毎秒誰かが",
      "romaji": "maiji maifun maibyou dareka ga"
    },
    {
      "text": "一撃放ったり食らったり",
      "romaji": "ichigeki houttari kurattari"
    },
    {
      "text": "踊れるときに踊っとけ",
      "romaji": "odoreru toki ni odottoke"
    },
    {
      "text": "ついでに叫べる時に叫んどけ",
      "romaji": "tsuide ni sakeberu toki ni sakendoke"
    },
    {
      "text": "ここは",
      "romaji": "koko wa"
    },
    {
      "text": "バカどもの巣窟",
      "romaji": "baka-domo no soukutsu"
    },
    {
      "text": "あるならあるに越したことはない",
      "romaji": "aru nara aru ni koshita koto wa nai"
    },
    {
      "text": "笑っていたり笑われたり",
      "romaji": "waratte itari warawaretari"
    },
    {
      "text": "ほんで煽れる時に煽っとけ",
      "romaji": "honde aoreru toki ni aottoke"
    },
    {
      "text": "アホどもの巣窟",
      "romaji": "aho-domo no soukutsu"
    },
    {
      "text": "全て空虚な 愛おしい馬鹿騒ぎさ",
      "romaji": "subete kuukyo na itooshii bakasawagi sa"
    }
  ]
}
