  "lines": [
    {
      "index": 0,
      "start": 11.449277,
      "end": 15.779919,
      "japanese": "何かまた思いつきで",
      "zh-CN": "脑海中忽然又灵光一闪",
      "shared_interval": false
    },
    {
      "index": 1,
      "start": 16.12773,
      "end": 20.151539,
      "japanese": "宙に浮かんだ言葉",
      "zh-CN": "悬在半空中的那些话语",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 20.84616,
      "end": 25.105841,
      "japanese": "確かめた矢先に",
      "zh-CN": "刚想要仔细确认究竟",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 25.546601,
      "end": 29.539427,
      "japanese": "お洒落して出かけましょ",
      "zh-CN": "就好好打扮一番出门去吧",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 30.317004,
      "end": 34.630655,
      "japanese": "振り回されるのも悪くない",
      "zh-CN": "被你耍得团团转也挺不错的嘛",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 35.028438,
      "end": 39.692899,
      "japanese": "あなたと手を繋ぐきっかけになるから",
      "zh-CN": "因为这正好能成为与你牵手的契机",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 38.88,
      "end": 41.966,
      "japanese": "ねえねえねえねえ ちょっと！",
      "zh-CN": "喂喂喂喂 等等啦！",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 41.701805,
      "end": 43.76768,
      "japanese": "こっちもちゃんと見てて",
      "zh-CN": "也好好看着我这边嘛",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 43.972569,
      "end": 47.402701,
      "japanese": "私まだまだ話し足りないよ だから",
      "zh-CN": "我还有好多好多话没说完呢 所以",
      "shared_interval": false
    },
    {
      "index": 9,
      "start": 48.509098,
      "end": 51.695364,
      "japanese": "次は 映画 買い物 水族館",
      "zh-CN": "下次要去 电影 购物 水族馆",
      "shared_interval": false
    },
    {
      "index": 10,
      "start": 51.879263,
      "end": 54.041086,
      "japanese": "イタリアンと海と遊園地",
      "zh-CN": "意大利餐和海边还有游乐园",
      "shared_interval": false
    },
    {
      "index": 11,
      "start": 54.325931,
      "end": 56.51474,
      "japanese": "誰かと行きたいところに全部",
      "zh-CN": "那些想和某个人一同前往的地方",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 56.745614,
      "end": 59.092336,
      "japanese": "私はあなたと行ってみたい",
      "zh-CN": "我全都想和你一起去看看",
      "shared_interval": false
    },
    {
      "index": 13,
      "start": 59.537094,
      "end": 63.650854,
      "japanese": "あまねく写真におさめたら",
      "zh-CN": "将所有风景全都拍进照片里",
      "shared_interval": false
    },
    {
      "index": 14,
      "start": 63.916709,
      "end": 67.474772,
      "japanese": "今度はどこに行きましょうね",
      "zh-CN": "下一次我们又该去哪里呢",
      "shared_interval": false
    },
    {
      "index": 15,
      "start": 68.349296,
      "end": 71.349662,
      "japanese": "来週は 京都 九州 北海道",
      "zh-CN": "下周要去 京都 九州 北海道",
      "shared_interval": false
    },
    {
      "index": 16,
      "start": 71.349662,
      "end": 73.70538,
      "japanese": "ヨーロッパと月と太陽系",
      "zh-CN": "欧洲与月球还有太阳系",
      "shared_interval": false
    },
    {
      "index": 17,
      "start": 73.987226,
      "end": 76.098077,
      "japanese": "いつかは行きたいところに全部",
      "zh-CN": "那些终有一天想去看看的地方",
      "shared_interval": false
    },
    {
