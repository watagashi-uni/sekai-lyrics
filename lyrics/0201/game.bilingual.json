  "performers": [],
  "lines": [
    {
      "index": 0,
      "start": 31.840733,
      "end": 34.987759,
      "japanese": "思い通りにいかないことだらけ",
      "zh-CN": "尽是些无法尽如人意的事情",
      "shared_interval": false
    },
    {
      "index": 1,
      "start": 35.740482,
      "end": 38.624255,
      "japanese": "どうしようもなく自己嫌悪",
      "zh-CN": "无可奈何地陷入自我厌恶",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 38.82745,
      "end": 42.125621,
      "japanese": "八百万の痛みや悲しみから",
      "zh-CN": "正寻觅着能够从八百万种痛苦与悲伤中",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 42.293783,
      "end": 45.641001,
      "japanese": "逃げ込める場所を探してる",
      "zh-CN": "逃避躲藏进去的容身之处",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 45.842194,
      "end": 49.164388,
      "japanese": "いっそ岩の隙間に引きこもって",
      "zh-CN": "索性彻底闭门躲在岩石缝隙里",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 49.365581,
      "end": 52.560653,
      "japanese": "月も太陽も無視して眠ろう",
      "zh-CN": "无视月亮与太阳睡大觉吧",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 52.85894,
      "end": 56.15611,
      "japanese": "生まれてきたことの意味なんて",
      "zh-CN": "降生在这个世上的意义什么的",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 56.420364,
      "end": 59.279112,
      "japanese": "知らない分かんないよ",
      "zh-CN": "既不知道也完全搞不懂呀",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 60.101903,
      "end": 64.244886,
      "japanese": "でも そんな風に思えるってこと",
      "zh-CN": "但能够产生这种想法本身",
      "shared_interval": false
    },
    {
      "index": 9,
      "start": 65.386984,
      "end": 71.46783,
      "japanese": "それは 君がもっともっと素敵に なれる力が",
      "zh-CN": "便正是告诉你 你拥有着能够",
      "shared_interval": false
    },
    {
      "index": 10,
      "start": 71.46783,
      "end": 75.901092,
      "japanese": "あるって 教えてるんだよ",
      "zh-CN": "变得越来越棒的力量哦",
      "shared_interval": false
    },
    {
      "index": 11,
      "start": 77.133277,
      "end": 78.086193,
      "japanese": "そうさ",
      "zh-CN": "没错呀",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 78.47857,
      "end": 80.034066,
      "japanese": "神のまにまに",
      "zh-CN": "随神之意随神而行",
      "shared_interval": false
    },
    {
      "index": 13,
      "start": 80.248271,
      "end": 81.681649,
      "japanese": "仰せのままに",
      "zh-CN": "悉听尊便顺其自然",
      "shared_interval": false
    },
    {
      "index": 14,
