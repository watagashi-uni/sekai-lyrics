  "lines": [
    {
      "text": "好きか嫌いかの 二元論",
      "romaji": "suki ka kirai ka no nigenron"
    },
    {
      "text": "どちらかといえば 好きですが",
      "romaji": "dochira ka to ieba suki desu ga"
    },
    {
      "text": "乗りかかった船 止めちゃうほど",
      "romaji": "norikakatta fune tomechau hodo"
    },
    {
      "text": "落ちぶれていないよ わかるでしょ",
      "romaji": "ochiburete inai yo wakaru desho"
    },
    {
      "text": "予想外不安も 結構です",
      "romaji": "yosougai fuan mo kekkou desu"
    },
    {
      "text": "こちらトラブル続き 人生邁進",
      "romaji": "kochira toraburu tsuzuki jinsei maishin"
    },
    {
      "text": "行先なんて 二の次なんです",
      "romaji": "ikisaki nante ni no tsugi nan desu"
    },
    {
      "text": "キラーチューン 聴こえてるでしょ",
      "romaji": "kiraachuun kikoeteru desho"
    },
    {
      "text": "アクセルしか 踏まないよ",
      "romaji": "akuseru shika fumanai yo"
    },
    {
      "text": "止まり方なんて 必要ない ドリフターじゃん",
      "romaji": "tomarikata nante hitsuyou nai dorifutaa jan"
    },
    {
      "text": "涙もエンタメになる カメラとめんなよ",
      "romaji": "namida mo entame ni naru kamera tomenna yo"
    },
    {
      "text": "（ハイチーズ！）",
      "romaji": "(hai chiizu!)"
    },
    {
      "text": "不甲斐ない 私でもずっと",
      "romaji": "fugainai watashi demo zutto"
    },
    {
      "text": "歩いてきた 道がある",
      "romaji": "aruite kita michi ga aru"
    },
    {
      "text": "つまり どうでもいい",
      "romaji": "tsumari dou demo ii"
    },
    {
      "text": "ことなど何も なかったんだよ",
      "romaji": "koto nado nani mo nakatta nda yo"
    },
    {
      "text": "私混乱上々 いつだって",
      "romaji": "watashi konran joujou itsu datte"
    },
    {
      "text": "現場が最前線さ",
      "romaji": "koko ga saizensen sa"
    },
    {
      "text": "最後まで 目を離さないで",
      "romaji": "saigo made me o hanasanaide"
    },
    {
      "text": "最後まで 私 負けないから",
      "romaji": "saigo made watashi makenai kara"
    },
    {
      "text": "出会った日の きらめき",
      "romaji": "deatta hi no kirameki"
    },
    {
      "text": "飾ってた 偽りも",
      "romaji": "kazatteta itsuwari mo"
    },
    {
      "text": "疎まれた あこがれも",
      "romaji": "utomareta akogare mo"
    },
    {
      "text": "カメラ止めるなよ",
      "romaji": "kamera tomeru na yo"
    },
    {
      "text": "（はい！ はい！）",
      "romaji": "(hai! hai!)"
    },
    {
      "text": "から回った エネルギー",
      "romaji": "karamawatta enerugii"
    },
    {
      "text": "輝く このステージで",
      "romaji": "kagayaku kono suteeji de"
    },
    {
      "text": "重なる 物語",
      "romaji": "kasanaru monogatari"
    },
    {
      "text": "瞬きすんなよ",
      "romaji": "mabataki sun na yo"
    },
    {
      "text": "（ワン ツージャンプ！）",
      "romaji": "(wan tsuu janpu!)"
    }
  ]
}
