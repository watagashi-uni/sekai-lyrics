  "lines": [
    {
      "text": "消し忘れのモニター 眩しいよ",
      "romaji": "keshi wasure no monitaa mabushii yo"
    },
    {
      "text": "世界中どこだって 分かるけど",
      "romaji": "sekaijuu doko datte wakaru kedo"
    },
    {
      "text": "スタンス＋算数それでディスタンス",
      "romaji": "sutansu+sansuu sorede disutansu"
    },
    {
      "text": "空を覆うビルが1つ増えても",
      "romaji": "sora o oou biru ga hitotsu fuete mo"
    }
  ]
}
