  "lines": [
    {
      "text": "また作る ちょっと飛ぶ",
      "romaji": "mata tsukuru chotto tobu"
    },
    {
      "text": "それを日々くり返す",
      "romaji": "sore o hibi kurikaesu"
    },
    {
      "text": "それらが売り物になって",
      "romaji": "sorera ga urimono ni natte"
    },
    {
      "text": "いつからか理屈を知って",
      "romaji": "itsukara ka rikutsu o shitte"
    },
    {
      "text": "となりやあちらと比べちゃ",
      "romaji": "tonari ya achira to kurabecha"
    },
    {
      "text": "勝ちか負けだけの日々",
      "romaji": "kachi ka make dake no hibi"
    },
    {
      "text": "どこまでも飛んでゆけるような",
      "romaji": "doko made mo tonde yukeru you na"
    },
    {
      "text": "乗り物作りたかったはずが",
      "romaji": "norimono tsukuritakatta hazu ga"
    },
    {
      "text": "ぎゅうぎゅうぎゅうぎゅうに",
      "romaji": "gyuu gyuu gyuu gyuu ni"
    },
    {
      "text": "詰まったアイデア",
      "romaji": "tsumatta aidea"
    },
    {
      "text": "アンドロメダからは覚えてないや",
      "romaji": "andoromeda kara wa oboetenai ya"
    },
    {
      "text": "あなたに会えるから",
      "romaji": "anata ni aeru kara"
    },
    {
      "text": "飛べる！！",
      "romaji": "toberu!!"
    }
  ]
}
