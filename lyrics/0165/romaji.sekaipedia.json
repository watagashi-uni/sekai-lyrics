  "lines": [
    {
      "text": "分かりみ値が急上昇",
      "romaji": "wakari michi ga kyuujoushou"
    },
    {
      "text": "相乗効果で上がるQOL",
      "romaji": "soujou kouka de agaru QOL"
    },
    {
      "text": "なんて言わないで偉い人",
      "romaji": "nante iwanai de erai hito"
    },
    {
      "text": "世界をお手玉にして遊びたいなあ",
      "romaji": "sekai o otedama ni shite asobitai naa"
    },
    {
      "text": "君と2人で",
      "romaji": "kimi to futari de"
    },
    {
      "text": "きっとまるでユートピア",
      "romaji": "kitto maru de yuutopia"
    },
    {
      "text": "アダムもイブも知らない",
      "romaji": "adamu mo ibu mo shiranai"
    },
    {
      "text": "あ 突然ですがここはインドです",
      "romaji": "a, totsuzen desu ga koko wa indo de~su!"
    },
    {
      "text": "じゃなくて",
      "romaji": "ja nakute!!"
    },
    {
      "text": "そうだったうん そうだった",
      "romaji": "sou datta! un, sou datta!"
    },
    {
      "text": "忘れないようにメモしなきゃ",
      "romaji": "wasurenai you ni memo shinakya!"
    },
    {
      "text": "思いついたことなんだっけ",
      "romaji": "omoi tsuita koto nan dakke..."
    },
    {
      "text": "?をずっと繰り返して",
      "romaji": "hatena o zutto kurikaeshite"
    },
    {
      "text": "言いたいことがあり過ぎて",
      "romaji": "iitai koto ga ari sugite!"
    },
    {
      "text": "で 何から言うか迷ってるの",
      "romaji": "de, nani kara iu ka mayotteru no!"
    },
    {
      "text": "そんなこと言ってるうちに",
      "romaji": "sonna koto itteru uchi ni"
    },
    {
      "text": "もうすぐサビ終わるけど",
      "romaji": "mou sugu sabi owaru kedo"
    },
    {
      "text": "まだ何も言ってない?そうだった",
      "romaji": "mada nani mo itte nai!? sou datta!!"
    },
    {
      "text": "インドやんあれタージ マハルやん",
      "romaji": "indo-yan! are taaji maharu-yan!"
    },
    {
      "text": "このままじゃ意味なさすぎじゃん",
      "romaji": "... kono mama ja imi nasa sugi jan"
    },
    {
      "text": "果たしてこれは「歌」なのか?",
      "romaji": "hatashite kore wa uta na no ka...?"
    },
    {
      "text": "思いついたこと並べてさ",
      "romaji": "omoi tsuita koto narabete sa?"
    },
    {
      "text": "この曲もう終わるけど",
      "romaji": "kono kyoku mou owaru kedo"
    }
  ]
}
