  "lines": [
    {
      "text": "想いが重なって",
      "romaji": "omoi ga kasanatte"
    },
    {
      "text": "遠く遠く彼方まで",
      "romaji": "tooku tooku kanata made"
    },
    {
      "text": "届くよ響くよ",
      "romaji": "todoku yo hibiku yo"
    },
    {
      "text": "踏み出せなかった明日への一歩も",
      "romaji": "fumidasenakatta asu e no ippo mo"
    },
    {
      "text": "その歌声が導いてくれたんだ",
      "romaji": "sono utagoe ga michibiite kuretan da"
    },
    {
      "text": "この瞬間この場所は",
      "romaji": "kono shunkan kono basho wa"
    },
    {
      "text": "もう2度と来ないから",
      "romaji": "mou nidoto konai kara"
    },
    {
      "text": "ココロをひとつに",
      "romaji": "kokoro wo hitotsu ni"
    },
    {
      "text": "未来にまで",
      "romaji": "mirai ni made"
    },
    {
      "text": "僕らが愛した",
      "romaji": "bokura ga aishita"
    },
    {
      "text": "この星はいつまでも",
      "romaji": "kono hoshi wa itsumademo"
    },
    {
      "text": "歌い続ける",
      "romaji": "utai tsuzukeru"
    }
  ]
}
