  "lines": [
    {
      "text": "形のない気持ち忘れないように",
      "romaji": "katachi no nai kimochi wasurenai you ni"
    },
    {
      "text": "決まりきったレイアウトを消した",
      "romaji": "kimarikitta reiauto wo keshita"
    },
    {
      "text": "ふと口ずさんだフレーズを掴まえて",
      "romaji": "futo kuchizusanda fureezu wo tsukamaete"
    },
    {
      "text": "胸に秘めた言葉乗せ空に解き放つの",
      "romaji": "mune ni himeta kotoba nose sora ni tokihanatsu no"
    },
    {
      "text": "君に伝えたいことが",
      "romaji": "kimi ni tsutaetai koto ga"
    },
    {
      "text": "君に届けたいことが",
      "romaji": "kimi ni todoketai koto ga"
    },
    {
      "text": "たくさんの点は線になって",
      "romaji": "takusan no ten wa sen ni natte"
    },
    {
      "text": "君に伝えたい言葉",
      "romaji": "kimi ni tsutaetai kotoba"
    },
    {
      "text": "君に届けたい音が",
      "romaji": "kimi ni todoketai oto ga"
    },
    {
      "text": "君が伝えたいことは",
      "romaji": "kimi ga tsutaetai koto wa"
    },
    {
      "text": "君が届けたいことは",
      "romaji": "kimi ga todoketai koto wa"
    },
    {
      "text": "遠く彼方へと響く",
      "romaji": "tooku kanata e to hibiku"
    },
    {
      "text": "君が伝えたい言葉",
      "romaji": "kimi ga tsutaetai kotoba"
    },
    {
      "text": "君が届けたい音は",
      "romaji": "kimi ga todoketai oto wa"
    }
  ]
}
