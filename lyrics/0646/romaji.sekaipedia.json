  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/Toumei_na_Palette",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "少々妄想気味",
      "romaji": "syousyou mousou gimi"
    },
    {
      "text": "他人はくだらないと言うけれど",
      "romaji": "hito wa kudaranai to iu keredo"
    },
    {
      "text": "胸に秘めた花は咲いたのです",
      "romaji": "mune ni himeta hana wa saita no desu"
    },
    {
      "text": "入手困難だろう　チケット",
      "romaji": "nyuushu konnan darou chiketto"
    },
    {
      "text": "確信ないなんて　トップシークレット",
      "romaji": "kakushin nai nante toppushiikuretto"
    },
    {
      "text": "一進一退。方向音痴な日々だ",
      "romaji": "isshin ittai houkou onchi na hibi da"
    },
    {
      "text": "あー心臓がいたいよ",
      "romaji": "aa shinzou ga itai yo"
    },
    {
      "text": "きみの事想うと",
      "romaji": "kimi no koto omou to"
    },
    {
      "text": "私じゃたりない",
      "romaji": "watashi ja tarinai nanika"
    },
    {
      "text": "何か探してしまう",
      "romaji": "sagashite shimau"
    },
    {
      "text": "強くなりたくて",
      "romaji": "tsuyoku naritakute"
    },
    {
      "text": "誰かの用意したステージじゃ",
      "romaji": "dareka no yoi shita suteeji ja"
    },
    {
      "text": "つまらないでしょう？",
      "romaji": "tsumaranai desho?"
    },
    {
      "text": "生涯最高の日まで",
      "romaji": "shougai saikou no hi made"
    },
    {
      "text": "寄り道をちょっとしてだけ",
      "romaji": "yorimichi o chotto shiteru dake"
    },
    {
      "text": "透明なままのパレット",
      "romaji": "toumei no mama no paretto"
    },
    {
      "text": "これはこれで綺麗だよね",
      "romaji": "kore wa kore de kirei da yo ne"
    },
    {
      "text": "零れ落ちた涙で",
      "romaji": "kobore ochita namida de"
    },
    {
      "text": "水しぶきあげて踊っちゃえ",
      "romaji": "mizushibuki agete odocchae"
    },
    {
      "text": "お祝いの日のアップルパイを",
      "romaji": "oiwai no hi ni appurupai o"
    },
    {
      "text": "焼きたてをたんと召し上がれ",
      "romaji": "yakitate o tanto meshiagare"
    },
    {
      "text": "最高にデザートを",
      "romaji": "saikou no dezaato o"
    }
  ]
}
