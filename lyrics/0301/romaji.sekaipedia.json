  "lines": [
    {
      "text": "地上を融かして君も焦がす",
      "romaji": "chijou o tokashite kimi mo kogase"
    },
    {
      "text": "恋の熱が上がりすぎて",
      "romaji": "koi no netsu ga agarisugite"
    },
    {
      "text": "体温が30000℃になった",
      "romaji": "taion ga sanmando ni natta"
    },
    {
      "text": "足元が全て融解し",
      "romaji": "ashimoto ga subete yuukai shi"
    },
    {
      "text": "地獄の底まで丸見えだ",
      "romaji": "jigoku no soko made marumie da"
    },
    {
      "text": "マイ・ファースト・ラブ",
      "romaji": "mai fasuto rabu"
    },
    {
      "text": "燃えて燃えて業火",
      "romaji": "moete moete gouka"
    },
    {
      "text": "ねえ君に触れたいけど",
      "romaji": "nee kimi ni furetai kedo"
    },
    {
      "text": "燃やしてしまうの",
      "romaji": "moyashite shimau no"
    },
    {
      "text": "ああっ",
      "romaji": "aah!"
    },
    {
      "text": "それでも君を見つめている熱視線",
      "romaji": "soredemo kimi o mitsumete iru netsu shisen"
    },
    {
      "text": "大好きよ",
      "romaji": "daisuki yo"
    },
    {
      "text": "あっ あっっ あーっっっ",
      "romaji": "aa! aa! aaaa!"
    },
    {
      "text": "燃える恋が何もかも曖昧にしてく",
      "romaji": "moeru koi ga nanimokamo aimai ni shiteku"
    },
    {
      "text": "溶けちゃうの",
      "romaji": "tokechau no"
    },
    {
      "text": "あーっつい",
      "romaji": "aattsui!"
    },
    {
      "text": "雨が降った",
      "romaji": "ame ga futta"
    },
    {
      "text": "私の熱で全て蒸発した",
      "romaji": "watashi no netsu de subete jouhatsu shita"
    },
    {
      "text": "熱くなる",
      "romaji": "atsukunaru"
    },
    {
      "text": "絶対に叶わない恋だと知ってるの",
      "romaji": "zettai ni kanawanai koi da to shitteru no"
    },
    {
      "text": "でも好きよ",
      "romaji": "demo suki yo"
    },
    {
      "text": "君に恋してる",
      "romaji": "kimi ni koi shiteru"
    }
  ]
}
