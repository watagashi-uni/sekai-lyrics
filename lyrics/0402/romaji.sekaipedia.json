  "lines": [
    {
      "text": "ジャマママ　マ",
      "romaji": "jamamama ma"
    },
    {
      "text": "タイトロープは崩れる　壊される",
      "romaji": "taitoroopu wa kuzureru kowasareru"
    },
    {
      "text": "とんだレイディ",
      "romaji": "tonda reidi"
    },
    {
      "text": "ライトめがけて無様に　砕かれる",
      "romaji": "raito megakete buzama ni kudakareru"
    },
    {
      "text": "そんな将来",
      "romaji": "sonna shourai"
    },
    {
      "text": "ハイに気ままに　ロンリーロンリー",
      "romaji": "hai ni kimama ni ronrii ronrii"
    },
    {
      "text": "空いた言葉で　弄人　牢人",
      "romaji": "aita kotoba de rounin rounin"
    },
    {
      "text": "愛も変わらず　後悔なんてない",
      "romaji": "ai mo kawarazu koukai nante nai"
    },
    {
      "text": "アンレディ　ディス　ディス　ラヴァ　ベイビー",
      "romaji": "anredi disu disu rava beibii"
    },
    {
      "text": "愛の苑　迫りくる　引く手に",
      "romaji": "ai no sono semari kuru hikute ni"
    },
    {
      "text": "まさに　ディス　ディス　ラヴァ　クレイジー",
      "romaji": "masa ni disu disu rava kureijii"
    },
    {
      "text": "害の苑　人の芽は　ライアイア",
      "romaji": "gai no sono hito no me wa raiaia"
    },
    {
      "text": "嗚呼",
      "romaji": "aa"
    },
    {
      "text": "愛してる　過ぎたことまで",
      "romaji": "aishiteru sugita koto made"
    },
    {
      "text": "好きすぎる　一つ二つで",
      "romaji": "suki sugiru hitotsu futatsu de"
    },
    {
      "text": "ライライラヴィンギュ　そんな言葉で",
      "romaji": "rairai ravingyu sonna kotoba de"
    },
    {
      "text": "そんなことして　ジャマママ　マ",
      "romaji": "sonna koto shite jamamama ma"
    },
    {
      "text": "必中　到来　ラブマニア",
      "romaji": "hicchuu tourai rabumania"
    },
    {
      "text": "全部　泣き言　重ねて",
      "romaji": "zenbu nakigoto kasanete"
    },
    {
      "text": "ハイファイ　恋せよ　ライアイア",
      "romaji": "haifai koiseyo raiaia"
    },
    {
      "text": "演技　真似て　解は隠して",
      "romaji": "engi manete kai wa kakushite"
    },
    {
      "text": "3つ重ねて　ロンリーロンリー",
      "romaji": "mittsu kasanete ronrii ronrii"
    },
    {
      "text": "きっとあなたは　弄人　牢人",
      "romaji": "kitto anata wa rounin rounin"
    },
    {
      "text": "相も変わらず　後悔なんて無い",
      "romaji": "ai mo kawarazu koukai nante nai"
    },
    {
      "text": "そんなことまで　ジャマママ　マ",
      "romaji": "sonna koto made jamamama ma"
    },
    {
      "text": "ディス　ディス　ラヴァ　ベイビー",
      "romaji": "disu disu rava beibii"
    }
  ]
}
