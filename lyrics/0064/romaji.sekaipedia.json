  "lines": [
    {
      "text": "涙が夜に溶けて",
      "romaji": "namida ga yoru ni tokete"
    },
    {
      "text": "空が今日も遠くなる",
      "romaji": "sora ga kyou mo touku naru"
    },
    {
      "text": "未来が閉じたように",
      "romaji": "mirai ga tojita you ni"
    },
    {
      "text": "暗闇が満ちている",
      "romaji": "kurayami ga michiteiru"
    },
    {
      "text": "ああ　みにくい心も",
      "romaji": "aa minikui kokoro mo"
    },
    {
      "text": "かすれそうな言葉も",
      "romaji": "kasure souna kotoba mo"
    },
    {
      "text": "全て見透かしたように",
      "romaji": "subete misukashita you ni"
    },
    {
      "text": "星が輝いていた",
      "romaji": "hoshi ga kagayaiteita"
    },
    {
      "text": "夜鷹のように高く",
      "romaji": "yotaka no you ni takaku"
    },
    {
      "text": "空を駆けてゆけたら",
      "romaji": "sora o kakete yuketara"
    },
    {
      "text": "綺麗だってはやされて",
      "romaji": "kirei datte hayasarete"
    },
    {
      "text": "特別になれたのに",
      "romaji": "tokubetsu ni nareta no ni"
    },
    {
      "text": "そう　俯いた目には",
      "romaji": "sou utsumuita me ni wa"
    },
    {
      "text": "憧れしか映らない",
      "romaji": "akogare shika utsuranai"
    },
    {
      "text": "誰かの描いた地図じゃ",
      "romaji": "dareka no kaita chizu ja"
    },
    {
      "text": "灯る場所は探せない",
      "romaji": "tomoru basho wa sagasenai"
    },
    {
      "text": "ああ　僕らの現状は",
      "romaji": "aa bokura no genjou wa"
    },
    {
      "text": "いじらしくふらっとして",
      "romaji": "ijirashiku furatto shite"
    },
    {
      "text": "気を抜けばあすが",
      "romaji": "ki o nukeba asu ga"
    },
    {
      "text": "昨日になってしまう",
      "romaji": "kinou ni natteshimau"
    },
    {
      "text": "これはそう　今日を諦めなかった",
      "romaji": "kore wa sou kyou o akiramenakatta"
    },
    {
      "text": "故の物語",
      "romaji": "yue no sutoorii"
    },
    {
      "text": "風切羽響かせて 空を目指して",
      "romaji": "kazekiribane hibikasete sora o mezashite"
    },
    {
      "text": "みじめになって　嫌になったって",
      "romaji": "mijime ni natte iya ni nattatte"
    },
    {
      "text": "輝いてる夢を",
      "romaji": "kagayai teru yume o"
    },
    {
      "text": "叶える羽は",
      "romaji": "kanaeru hane wa"
    },
    {
      "text": "とっくのとうに生えていた",
      "romaji": "tokku no touni haete ita"
    },
    {
      "text": "吐き出す息がしらさめて",
      "romaji": "hakidasu iki ga shira samete"
    },
    {
      "text": "声も聞こえなくなって",
      "romaji": "koe mo kikoenaku natte"
    },
    {
      "text": "燃え上がる体温が",
      "romaji": "moeagaru taion ga"
    },
    {
      "text": "夜空を焦がすまで",
      "romaji": "yozora o kogasu made"
    },
    {
      "text": "誰よりもっともっと向こうへ",
      "romaji": "dare yori motto motto mukou e"
    },
    {
      "text": "って羽ばたいた星の一瞬を",
      "romaji": "tte habataita hoshi no isshun o"
    },
    {
      "text": "ああ　夜空はずっと待っている",
      "romaji": "aa, yozora wa zutto matte iru"
    },
    {
      "text": "灯る日を待っている",
      "romaji": "tomoru hi o matte iru"
    }
  ]
}
