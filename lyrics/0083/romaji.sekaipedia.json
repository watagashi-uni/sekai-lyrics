  "lines": [
    {
      "text": "お気に入り　musk と",
      "romaji": "okiniiri musk to"
    },
    {
      "text": "甘々な秘密纏う",
      "romaji": "amaama na himitsu matou"
    },
    {
      "text": "今夜モノになる",
      "romaji": "kon'ya mono ni naru"
    },
    {
      "text": "あたしのなにもかも",
      "romaji": "atashi no nani mo kamo"
    },
    {
      "text": "溢れ出てるlibido",
      "romaji": "afure deteru libido"
    },
    {
      "text": "はあ、好き　その衝動",
      "romaji": "haa, suki sono shoudou"
    },
    {
      "text": "そんなら見ててよ伝家の宝刀　いこう王道",
      "romaji": "sonnara mitete yo denka no houtou ikou oudou"
    },
    {
      "text": "「はあ…ちょっと酔っちゃったかも」",
      "romaji": "\"haa... chotto yocchatta kamo\""
    },
    {
      "text": "すべて見抜いて",
      "romaji": "subete minuite"
    },
    {
      "text": "余裕なんて見せないで",
      "romaji": "yoyuu nante misenaide"
    },
    {
      "text": "すべて見透かして",
      "romaji": "subete misukashite"
    },
    {
      "text": "好きにさせて",
      "romaji": "suki ni sasete"
    },
    {
      "text": "ねえ早く連れていって",
      "romaji": "nee hayaku tsurete itte"
    },
    {
      "text": "まつげすら触れちゃいそうな距離で",
      "romaji": "matsugesura furechaisou na kyori de"
    },
    {
      "text": "思考すら奪って　探り当てて",
      "romaji": "shikou sura ubatte saguriatete"
    },
    {
      "text": "其の場凌ぎ以上の",
      "romaji": "sonobashinogi ijou no"
    },
    {
      "text": "余計なこと言っちゃいそうな",
      "romaji": "yokei na koto icchaisou na"
    },
    {
      "text": "吐息漏れるこの 唇くちを",
      "romaji": "toiki moreru kono kuchi o"
    },
    {
      "text": "kiss で塞いで",
      "romaji": "kiss de fusaide"
    },
    {
      "text": "あざやかに彩って",
      "romaji": "azayaka ni irodotte"
    },
    {
      "text": "この世界を照らすような",
      "romaji": "kono sekai o terasu you na"
    },
    {
      "text": "満たす体温　最後まで",
      "romaji": "mitasu taion saigo made"
    },
    {
      "text": "kiss で塞いで (woo!)",
      "romaji": "kiss de fusaide (woo!)"
    }
  ]
}
