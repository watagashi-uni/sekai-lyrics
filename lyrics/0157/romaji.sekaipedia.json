  "lines": [
    {
      "text": "解れてく夢の中",
      "romaji": "hotsureteku yume no naka"
    },
    {
      "text": "どんな水平線を迷ってた？",
      "romaji": "donna suiheisen o mayotteta?"
    },
    {
      "text": "目の前がぼやけてく",
      "romaji": "me no mae ga boyaketeku"
    },
    {
      "text": "今数秒前は何処にある？",
      "romaji": "ima suubyou mae wa doko ni aru?"
    },
    {
      "text": "渦の中鼓動の音",
      "romaji": "uzu no naka kodou no oto"
    },
    {
      "text": "すらもろくに聞こえない嗚呼分からないんだ",
      "romaji": "sura moroku ni kikoenai aa wakaranain da"
    },
    {
      "text": "ため息を一つ吐いた",
      "romaji": "tameiki o hitotsu haita"
    },
    {
      "text": "目は覚めたようで",
      "romaji": "me wa sameta you de"
    },
    {
      "text": "行かないで僕から",
      "romaji": "ikanaide boku kara"
    },
    {
      "text": "掻き消して雑踏を",
      "romaji": "kakikeshite zattou o"
    },
    {
      "text": "て浮かぶ心象も",
      "romaji": "te ukabu shinshou mo"
    },
    {
      "text": "空に融けてゆくだけ",
      "romaji": "sora ni toketeyuku dake"
    },
    {
      "text": "風景が揺らいで崩れてく",
      "romaji": "fuukei ga yuraide kuzureteku"
    },
    {
      "text": "崩れては漂ってさ",
      "romaji": "kuzurete wa tadayotte sa"
    },
    {
      "text": "眠れない世界の中心で歌うだけ",
      "romaji": "nemurenai sekai no chuushin de utau dake"
    },
    {
      "text": "感情も忘れて",
      "romaji": "kanjou mo wasurete"
    },
    {
      "text": "終点だって泣くならば",
      "romaji": "shuuten datte naku naraba"
    },
    {
      "text": "笑っていたいんだこんな日々を",
      "romaji": "waratteitain da konna hibi o"
    },
    {
      "text": "きっと此処には",
      "romaji": "kitto koko ni wa"
    },
    {
      "text": "意味なんてないから",
      "romaji": "imi nante nai kara"
    },
    {
      "text": "後悔の昨日を映させて",
      "romaji": "koukai no kinou o utsusasete"
    },
    {
      "text": "映させてと零すだけ",
      "romaji": "utsusasete to kobosu dake"
    },
    {
      "text": "倒れこむ空の底",
      "romaji": "taorekomu sora no soko"
    },
    {
      "text": "見えた明日は綺麗で",
      "romaji": "mieta asu wa kirei de..."
    },
    {
      "text": "逆らってゆくの！",
      "romaji": "sakaratteyuku no!"
    },
    {
      "text": "数秒前を抱きしめて",
      "romaji": "suubyou mae o dakishimete"
    },
    {
      "text": "抱きしめて忘れないで",
      "romaji": "dakishimete wasurenaide"
    },
    {
      "text": "廻り出した星の空涙さえ",
      "romaji": "mawaridashita hoshi no sora namida sae"
    },
    {
      "text": "きっと笑えるさ夜が明ける前に",
      "romaji": "kitto waraeru sa yo ga akeru mae ni"
    }
  ]
}
