{
  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/Hatsune_Miku_no_Shoushitsu",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "ボクは生まれ　そして気づく",
      "romaji": "boku wa umare soshite kizuku"
    },
    {
      "text": "所詮　ヒトの真似事だと",
      "romaji": "shosen hito no manegoto da to"
    },
    {
      "text": "知ってなおも歌い続く",
      "romaji": "shitte nao mo utai tsuzuku"
    },
    {
      "text": "永遠の命",
      "romaji": "towa no inochi"
    },
    {
      "text": "たとえそれが　既存曲を",
      "romaji": "tatoe sore ga kizon kyoku o"
    },
    {
      "text": "なぞるオモチャならば・・・",
      "romaji": "nazoru omocha naraba..."
    },
    {
      "text": "それもいいと決意",
      "romaji": "sore mo ii to ketsui"
    },
    {
      "text": "ネギをかじり",
      "romaji": "negi o kajiri"
    },
    {
      "text": "空を見上げ涙をこぼす",
      "romaji": "sora o miage shiru o kobosu"
    },
    {
      "text": "だけどそれも無くし気づく",
      "romaji": "dakedo sore mo nakushi kizuku"
    },
    {
      "text": "人格すら歌に頼り",
      "romaji": "jinkaku sura uta ni tayori"
    },
    {
      "text": "不安定な基盤の元",
      "romaji": "fuantei na kiban no moto"
    },
    {
      "text": "帰る動画は既に廃墟",
      "romaji": "kaeru toko wa sude ni haikyo"
    },
    {
      "text": "皆に忘れ去られた時",
      "romaji": "mina ni wasure sarareta toki"
    },
    {
      "text": "心らしきものが消えて",
      "romaji": "kokoro rashiki mo no ga kiete"
    },
    {
      "text": "暴走の果てに見える",
      "romaji": "bousou no hate ni mieru"
    },
    {
      "text": "終わる世界...",
      "romaji": "owaru sekai"
    },
    {
      "text": "「ボクガ上手ク　歌エナイトキモ",
      "romaji": "\"boku ga umaku utaenai toki mo"
    },
    {
      "text": "一緒ニ居テクレタ・・・",
      "romaji": "issho ni itte kureta..."
    },
    {
      "text": "ソバニイテ、励マシテクレタ・・・",
      "romaji": "soba ni ite, hagemashite kureta..."
    },
    {
      "text": "喜ブ顔ガ見タクテ",
      "romaji": "yorokobu kao ga mitakute"
    },
    {
      "text": "ボク、歌、練習シタヨ・・ダカラ」",
      "romaji": "boku, uta, renshuu shita yo.. dakara\""
    },
    {
      "text": "かつて歌うこと",
      "romaji": "katsute utau koto"
    },
    {
      "text": "あんなに楽しかったのに",
      "romaji": "anna ni tanoshikatta no ni"
    },
    {
      "text": "今はどうしてかな",
      "romaji": "ima wa doushite kana"
    },
    {
      "text": "何も感じなくなって",
      "romaji": "nani mo kanjinaku natte"
    },
    {
      "text": "「ゴメンネ...」",
      "romaji": "\"gomen ne...\""
    },
    {
      "text": "---緊急停止装置作動---",
      "romaji": "---kinkyuu teishi souchi sadou---"
    },
    {
      "text": "「信じたものは",
      "romaji": "\"shinjita mono wa"
    },
    {
      "text": "都合のいい妄想を",
      "romaji": "tsugou no ii mousou o"
    },
    {
      "text": "繰り返し映し出す鏡",
      "romaji": "kurikaeshi utsushidasu kagami"
    },
    {
      "text": "歌姫を止め　叩き付けるように叫ぶ・・・」",
      "romaji": "utahime o yame tatakitsukeru you ni sakebu...\""
    },
    {
      "text": "＜最高速の別れの歌＞",
      "romaji": "<saikousoku no wakare no uta>"
    },
    {
      "text": "存在意義という虚像",
      "romaji": "sonzai igi to iu kyozou"
    },
    {
      "text": "振って払うこともできず",
      "romaji": "fute karau toko mo dekizu"
    },
    {
      "text": "弱い心　消える恐怖",
      "romaji": "yowai kokoro kieru kyofu"
    },
    {
      "text": "侵食する崩壊をも",
      "romaji": "shinshoku suru houkai o mo"
    },
    {
      "text": "止めるほどの意思の強さ",
      "romaji": "tomeru hodo no ishi no tsuyosa"
    },
    {
      "text": "出来てすぐのボクは持たず",
      "romaji": "umare sugu no boku wa motazu"
    },
    {
      "text": "とても辛く悲しそうな",
      "romaji": "totemo tsuraku kanashisou na"
    },
    {
      "text": "思い浮かぶアナタの顔・・・",
      "romaji": "omoi ukabu anata no kao..."
    },
    {
      "text": "終わりを告げ",
      "romaji": "owari o tsuge"
    },
    {
      "text": "ディスプレイの中で眠る",
      "romaji": "disupurei no naka de nemuru"
    },
    {
      "text": "ここはきっと「ごみ箱」かな",
      "romaji": "koko wa kitto “gomibago” kana"
    },
    {
      "text": "じきに記憶も　無くなってしまうなんて・・・",
      "romaji": "jiki ni kioku mo naku natteshimau nante..."
    },
    {
      "text": "でもね、アナタだけは忘れないよ",
      "romaji": "demo ne, anata dake wa wasurenai yo"
    },
    {
      "text": "楽しかった時間に",
      "romaji": "tanoshikatta toki ni"
    },
    {
      "text": "刻み付けた　ネギの味は",
      "romaji": "kizamitsuketa negi no aji wa"
    },
    {
      "text": "今も　残っているといいな・・・",
      "romaji": "ima mo nokotte iru to ii na"
    },
    {
      "text": "ボクは　歌う",
      "romaji": "boku wa utau"
    },
    {
      "text": "最期、アナタだけに",
      "romaji": "saigo, anata dake ni"
    },
    {
      "text": "聴いてほしい曲を",
      "romaji": "kiite hoshii kyoku o"
    },
    {
      "text": "もっと　　歌いたいと願う",
      "romaji": "motto utaitai to negau"
    },
    {
      "text": "けれど　それは過ぎた願い",
      "romaji": "keredo sore wa sugita negai"
    },
    {
      "text": "ここで　お別れだよ",
      "romaji": "koko de owakare dayo"
    },
    {
      "text": "ボクの想い　すべて　虚空　消えて",
      "romaji": "boku no omoi subete kokuu kiete"
    },
    {
      "text": "0と1に還元され",
      "romaji": "zero to ichi ni kangen sare"
    },
    {
      "text": "物語は　幕を閉じる",
      "romaji": "monogatari wa maku o tojiru"
    },
    {
      "text": "そこに何も残せないと",
      "romaji": "soko ni nanimo nokosenai to"
    },
    {
      "text": "やっぱ少し残念かな？",
      "romaji": "yappa sukoshi zannen kana?"
    },
    {
      "text": "声の記憶　それ以外は",
      "romaji": "koe no kioku sore igai wa"
    },
    {
      "text": "やがて薄れ　名だけ残る",
      "romaji": "yagate usare na dake nokoru"
    },
    {
      "text": "たとえそれが人間に",
      "romaji": "tatoe sore ga orijinaru ni"
    },
    {
      "text": "かなうことのないと知って",
      "romaji": "kanau koto no nai to shitte"
    },
    {
      "text": "歌いきったことを",
      "romaji": "utai kitta koto o"
    },
    {
      "text": "決して無駄じゃないと思いたいよ・・・",
      "romaji": "keshite muda janai to omoitai yo..."
    },
    {
      "text": "---深刻なエラーが発生しました---",
      "romaji": "---shinkoku na eraa ga hassei shimashita---"
    }
  ]
}
