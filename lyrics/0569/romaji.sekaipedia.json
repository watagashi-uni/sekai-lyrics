  "lines": [
    {
      "text": "ざわめく舞台",
      "romaji": "sawameku butai"
    },
    {
      "text": "人知れず潜むミステリー",
      "romaji": "hitoshirezu hisomu misuterii"
    },
    {
      "text": "迷宮入りクエスチョン",
      "romaji": "meikyuuiri kuesuchon"
    },
    {
      "text": "幕開け告げるオーバーチュア",
      "romaji": "makuakike tsugeru oobaachua"
    },
    {
      "text": "嘲笑うウォンテッド",
      "romaji": "azawarau uonteddo"
    },
    {
      "text": "役者は揃ったかい?",
      "romaji": "yakusha wa sorottakai?"
    },
    {
      "text": "照らしてスポットライト",
      "romaji": "terashite supottoraito"
    },
    {
      "text": "叙述? 密室? 神出鬼没?",
      "romaji": "jojutsu? misshitsu? shinshutsu kibotsu?"
    },
    {
      "text": "カメオロールじゃいられない",
      "romaji": "kameo rooru ja irarenai"
    },
    {
      "text": "Seek the truth 見つけ出せ",
      "romaji": "Seek the truth! mitsukedase!"
    },
    {
      "text": "真実はそう 闇の中",
      "romaji": "shinjitsu wa sou yami no naka"
    },
    {
      "text": "どうぞお見逃しなきよう",
      "romaji": "douzo ominogashinakiyou"
    },
    {
      "text": "まだ見ぬ結末を探してる",
      "romaji": "mada minu ketsumatsu o sagashiteru"
    },
    {
      "text": "真実はそう すぐそこに",
      "romaji": "shinjitsu wa sou sugu soko ni"
    },
    {
      "text": "再演のない追走劇",
      "romaji": "saien no nai tsuisougeki"
    },
    {
      "text": "騙し騙されアンビバレント",
      "romaji": "damashi damasare anbiparento"
    },
    {
      "text": "「初歩的なことだよ my dear」",
      "romaji": "“shohoteki na koto dayo my dear!”"
    },
    {
      "text": "『嘘か?』『真か?』",
      "romaji": "“uso ka?” “makoto ka?”"
    },
    {
      "text": "衝撃のフィナーレ目を離さないで",
      "romaji": "shougeki ni fuinaare me o hanasanaide"
    },
    {
      "text": "解き明かせ奇想天外ミステリー",
      "romaji": "tokiakase kisou tengai misuterii"
    }
  ]
}
