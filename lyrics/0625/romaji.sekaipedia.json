  "lines": [
    {
      "text": "このふざけた素晴らしき世界",
      "romaji": "kono fuzaketa subarashiki sekai"
    },
    {
      "text": "君に会う為に生きる",
      "romaji": "kimi ni au tame ni ikiru"
    },
    {
      "text": "今宵は夜が明けるまで咲かそう",
      "romaji": "koyoi wa yo ga akeru made sakasou"
    },
    {
      "text": "ぐるぐる目を回して",
      "romaji": "guruguru me o mawashite"
    },
    {
      "text": "このくそったれで美しい世界",
      "romaji": "kono kusottare de utsukushii sekai"
    },
    {
      "text": "真っ直ぐ見て突き進め",
      "romaji": "massugu mite tsuki susume"
    },
    {
      "text": "踊れや踊れアホになりましょう",
      "romaji": "odore ya odore aho ni nari mashou"
    },
    {
      "text": "みんな叫べヤンヤイ",
      "romaji": "minna sakebe yanyai"
    },
    {
      "text": "もう、ダメになりそ",
      "romaji": "mou, dame ni nari so"
    },
    {
      "text": "はいｯ",
      "romaji": "hai↑↑"
    },
    {
      "text": "ヤンヤヤンヤヤイヤ",
      "romaji": "yanyayanyayaiya"
    },
    {
      "text": "嘘つき男の虚言癖",
      "romaji": "usotsuki otoko no kyogen heki"
    },
    {
      "text": "世の中ではそれも正義？",
      "romaji": "yo no naka de wa sore mo seigi?"
    },
    {
      "text": "あれよあれよと今日も終わる",
      "romaji": "areyo areyo to kyou mo owaru"
    },
    {
      "text": "昼はなに食べたっけ･･･",
      "romaji": "hiru wa nani tabeta kke..."
    },
    {
      "text": "犬も猫も木に登る",
      "romaji": "inu mo neko mo ki ni noboru"
    },
    {
      "text": "あくせくしたって何も",
      "romaji": "akuseku shitatte nani mo"
    },
    {
      "text": "始まりはしやせんぜ",
      "romaji": "hajimari wa shiyasen ze"
    },
    {
      "text": "君に会うために生きる",
      "romaji": "kimi ni au tame ni ikiru"
    },
    {
      "text": "愉快にはしゃぐだけです",
      "romaji": "yukai ni hashagu dake desu"
    },
    {
      "text": "他人に言うべきことじゃないが",
      "romaji": "tanin ni iu beki koto...janai ga"
    },
    {
      "text": "お前ら愛してるぜ",
      "romaji": "omae ra, aishiteruze"
    },
    {
      "text": "ハイ⇈",
      "romaji": "hai⇈"
    }
  ]
}
