  "lines": [
    {
      "text": "特別な君と特別な日を",
      "romaji": "tokubetsu na kimi to tokubetsu na hi o"
    },
    {
      "text": "笑い合って バカもしたいな",
      "romaji": "waraiatte baka mo shitai na"
    },
    {
      "text": "溶けちゃう前に",
      "romaji": "tokechau mae ni"
    },
    {
      "text": "不思議な魔法で君に会えたら",
      "romaji": "fushigi na mahou de kimi ni aetara"
    },
    {
      "text": "どこへいこうか 何をしようか",
      "romaji": "doko e ikou ka nani o shiyou ka"
    },
    {
      "text": "「ねえ “お姫様”」",
      "romaji": "'nee \"ohimesama\"'"
    },
    {
      "text": "隣りにいるだけで (OK)",
      "romaji": "tonari ni iru dake de (OK!)"
    },
    {
      "text": "それだけでいい？",
      "romaji": "sore dake de ii?"
    },
    {
      "text": "上手く出来るのかな",
      "romaji": "umaku dekiru no kana"
    },
    {
      "text": "伝えたい",
      "romaji": "tsutaetai"
    },
    {
      "text": "“アイ”を持っていこう",
      "romaji": "\"ai\" o motte ikou"
    },
    {
      "text": "奏でよう",
      "romaji": "kanadeyou"
    },
    {
      "text": "大好きって歌えるかな",
      "romaji": "daisuki tte utaeru kana"
    },
    {
      "text": "変わっていいんだよ",
      "romaji": "kawatte ii nda yo"
    },
    {
      "text": "泣いたっていいじゃんか",
      "romaji": "naita tte ii jan ka"
    },
    {
      "text": "誇っていいんだよ",
      "romaji": "hokotte ii nda yo"
    },
    {
      "text": "なっちゃって？",
      "romaji": "nacchatte?"
    },
    {
      "text": "さあ“アイ”を持っていこう",
      "romaji": "saa \"ai\" o motte ikou"
    },
    {
      "text": "これまでも何度だって救われたの",
      "romaji": "kore made mo nando datte sukuwareta no"
    },
    {
      "text": "光ってるんだよ",
      "romaji": "hikatteru nda yo"
    },
    {
      "text": "ダメ ダメ？ダメじゃないよ",
      "romaji": "dame! dame? dame janai yo"
    },
    {
      "text": "また また？また「ありがとう」",
      "romaji": "mata! mata? mata \"arigatou\""
    }
  ]
}
