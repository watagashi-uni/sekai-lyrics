  "lines": [
    {
      "text": "大人になるほどDeDeDe ",
      "romaji": "otona ni naru hodo DeDeDe"
    },
    {
      "text": "はみ出しものです伽藍堂",
      "romaji": "hamidashi mono desu garandou"
    },
    {
      "text": "人生論者が語った ",
      "romaji": "jinsei ronsha ga katatta"
    },
    {
      "text": "少女は鳥になって",
      "romaji": "shoujo wa tori ni natte"
    },
    {
      "text": "綺麗事だけでPaPaPa ",
      "romaji": "kireigoto dake de PaPaPa"
    },
    {
      "text": "ボロボロの靴を結んで",
      "romaji": "boroboro no kutsu o musunde"
    },
    {
      "text": "デジタル信者が祟った ",
      "romaji": "dejitaru shinja ga tatatta"
    },
    {
      "text": "少年は風になって",
      "romaji": "shounen wa kaze ni natte"
    },
    {
      "text": "ゆらりくらり大往生 ",
      "romaji": "yurari kurari daioujou"
    },
    {
      "text": "お疲れ様ですご臨終",
      "romaji": "otsukaresama desu gorinjuu"
    },
    {
      "text": "テレキャスタービーボーイ 僕に愛情を ",
      "romaji": "terekyasutaa biibooi boku ni aijou o"
    },
    {
      "text": "嘘で固めたウォーアイニー",
      "romaji": "uso de katameta woo ai nii"
    },
    {
      "text": "うざったいんだジーガール",
      "romaji": "uzattai nda jii gaaru"
    },
    {
      "text": "魅惑ハイテンション ",
      "romaji": "miwaku haitenshon"
    },
    {
      "text": "カニバリズム踊れば",
      "romaji": "kanibarizumu odoreba"
    },
    {
      "text": "一つ二つ殺めた手で",
      "romaji": "hitotsu futatsu ayameta te de"
    },
    {
      "text": "何を描いているんだろう",
      "romaji": "nani o egaite iru ndarou"
    },
    {
      "text": "誰か答えてくれないか",
      "romaji": "dareka kotaete kurenai ka"
    },
    {
      "text": "パルラルラ",
      "romaji": "parurarura"
    }
  ]
}
