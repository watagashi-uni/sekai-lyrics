  "lines": [
    {
      "text": "続けて",
      "romaji": "tsuzukete"
    },
    {
      "text": "そう",
      "romaji": "sou"
    },
    {
      "text": "知らない誰かの手も",
      "romaji": "shiranai dareka no te mo"
    },
    {
      "text": "言葉や想い",
      "romaji": "kotoba ya omoi"
    },
    {
      "text": "見えづらいからね",
      "romaji": "miezurai kara ne"
    },
    {
      "text": "明日を",
      "romaji": "ashita o"
    },
    {
      "text": "歌は誰かの手も",
      "romaji": "uta wa dareka no te mo"
    },
    {
      "text": "途切れないで",
      "romaji": "togirenai de"
    },
    {
      "text": "だからね",
      "romaji": "dakara ne"
    },
    {
      "text": "誰かの肩を抱く",
      "romaji": "dareka no kata o daku"
    }
  ]
}
