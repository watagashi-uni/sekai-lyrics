    {
      "text": "形の無い物でしか",
      "romaji": "katachi no nai mono de shika"
    },
    {
      "text": "どうにもならないものでしょう",
      "romaji": "dou ni mo naranai mono deshou"
    },
    {
      "text": "歌に似た \"なにか\" と見くびらないで",
      "romaji": "uta ni nita \"nanika\" to mikubiranaide!"
    }
  ]
}
