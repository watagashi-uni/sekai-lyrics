  "lines": [
    {
      "text": "何かまた思いつきで",
      "romaji": "nanika mata omoitsuki de"
    },
    {
      "text": "宙に浮かんだ言葉",
      "romaji": "chuu ni ukanda kotoba"
    },
    {
      "text": "確かめた矢先に",
      "romaji": "tashikameta yasaki ni"
    },
    {
      "text": "お洒落して出かけましょ",
      "romaji": "oshare shite dekakemasho"
    },
    {
      "text": "振り回されるのも悪くない",
      "romaji": "furimawasareru no mo warukunai"
    },
    {
      "text": "あなたと手を繋ぐきっかけになるから",
      "romaji": "anata to te o tsunagu kikkake ni naru kara"
    },
    {
      "text": "ねえねえねえねえ ちょっと！",
      "romaji": "nee nee nee nee chotto!"
    },
    {
      "text": "こっちもちゃんと見てて",
      "romaji": "kotchi mo chanto mitete"
    },
    {
      "text": "私まだまだ話し足りないよ だから",
      "romaji": "watashi madamada hanashi tarinai yo dakara"
    },
    {
      "text": "次は 映画 買い物 水族館",
      "romaji": "tsugi wa eiga kaimono suizokukan"
    },
    {
      "text": "イタリアンと海と遊園地",
      "romaji": "Itarian to umi to yuenchi"
    },
    {
      "text": "誰かと行きたいところに全部",
      "romaji": "dareka to ikitai tokoro ni zenbu"
    },
    {
      "text": "私はあなたと行ってみたい",
      "romaji": "watashi wa anata to itte mitai"
    },
    {
      "text": "あまねく写真におさめたら",
      "romaji": "amaneku shashin ni osametara"
    },
    {
      "text": "今度はどこに行きましょうね",
      "romaji": "kondo wa doko ni ikimashou ne"
    },
    {
      "text": "来週は 京都 九州 北海道",
      "romaji": "raishuu wa Kyouto Kyuushuu Hokkaidou"
    },
    {
      "text": "ヨーロッパと月と太陽系",
      "romaji": "Yooroppa to tsuki to taiyoukei"
    },
    {
      "text": "いつかは行きたいところに全部",
      "romaji": "itsuka wa ikitaitokoro ni zenbu"
    },
    {
      "text": "あまねく足跡残せたら",
      "romaji": "amaneku ashiato nokosetara"
    }
  ]
}
