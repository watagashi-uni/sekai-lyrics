  "lines": [
    {
      "text": "孤独な科学者に作られたロボット",
      "romaji": "kodoku na kagakusha ni tsukurareta robotto"
    },
    {
      "text": "出来栄えを言うなら \"奇跡\"",
      "romaji": "dekibae o iu nara \"kiseki\""
    },
    {
      "text": "それは「心」と言うプログラム",
      "romaji": "sore wa \"kokoro\" to iu puroguramu"
    },
    {
      "text": "幾百年が過ぎ 独りで残された",
      "romaji": "ikuhyaku toshi ga sugi hitori de nokosareta"
    },
    {
      "text": "奇跡のロボットは願う",
      "romaji": "kiseki no robotto wa negau"
    },
    {
      "text": "私ニ作ッテタ「ココロ」",
      "romaji": "watashi ni tsukutteta \"kokoro\""
    },
    {
      "text": "今動き始めた 加速する奇跡",
      "romaji": "ima ugoki hajimeta kasoku suru kiseki"
    },
    {
      "text": "ナゼかナミダが止まらナい",
      "romaji": "naze ga namida ga tomaranai..."
    },
    {
      "text": "こレが私の望んだ「ココロ」？",
      "romaji": "kore ga watashi no nozonda \"kokoro\"?"
    }
  ]
}
