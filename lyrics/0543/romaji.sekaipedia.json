  "lines": [
    {
      "text": "Oh god 存在してしまった",
      "romaji": "Oh god sonzai shite shimatta!"
    },
    {
      "text": "ものごころと一緒に湧き出したんだ",
      "romaji": "monogokoro to issho ni wakidashita nda"
    },
    {
      "text": "ドクドク脈打つわたしの中の",
      "romaji": "dokudoku myakuutsu watashi no naka no"
    },
    {
      "text": "“シンドロウム”",
      "romaji": "\"shindoroumu\""
    },
    {
      "text": "きれいなきれいなハイ・ロウ",
      "romaji": "kirei na kirei na hai rou"
    },
    {
      "text": "シアワセっていう脳内物質のサージを",
      "romaji": "shiawase tte iu nounaibusshitsu no saaji o"
    },
    {
      "text": "呼吸続く限り 求めて 欲する",
      "romaji": "kokyuu tsuzuku kagiri motomete hossuru"
    },
    {
      "text": "『ハッピィ・ハッピィ・ストーリィ』",
      "romaji": "\"happii happii sutoorii\""
    },
    {
      "text": "付キ纏ウヤウナ 奇跡",
      "romaji": "tsuki matouyauna kiseki"
    },
    {
      "text": "リセットしたい リセットしたい",
      "romaji": "risetto shitai risetto shitai"
    },
    {
      "text": "「ねぇお願いカミサマ」って",
      "romaji": "\"nee, onegai kamisama\" tte"
    },
    {
      "text": "デリートキーに 指をかけた",
      "romaji": "deriitokii ni yubi o kaketa"
    },
    {
      "text": "非存在的特効薬くれますか",
      "romaji": "hi sonzaiteki tokkouyaku kuremasu ka"
    },
    {
      "text": "一生 一緒の",
      "romaji": "isshou issho no"
    },
    {
      "text": "とっくのとうに 諦めたのに",
      "romaji": "tokku no touni akirameta no ni"
    },
    {
      "text": "倫理ってやつが笑ってる",
      "romaji": "rinri tte yatsu ga waratteru"
    },
    {
      "text": "はは はは はぁ滑稽だ",
      "romaji": "ha ha ha ha haa kokkei da"
    },
    {
      "text": "同情すんなら愛をくれ",
      "romaji": "doujou sunnara ai o kure."
    },
    {
      "text": "はは はは おもんねえな",
      "romaji": "ha ha ha ha omonnee na"
    },
    {
      "text": "治してよ こんな希望",
      "romaji": "naoshite yo konna kibou"
    },
    {
      "text": "治してよ こんな絶望",
      "romaji": "naoshite yo konna zetsubou"
    },
    {
      "text": "贖罪 贖罪 赦しを下さい",
      "romaji": "shokuzai shokuzai yurushi o kudasai"
    },
    {
      "text": "（イキタイ イキタイ シアワセニイキタイ）",
      "romaji": "(ikitai ikitai shiawase ni ikitai)"
    },
    {
      "text": "誰だい？ 誰だい？ わたしの神かい",
      "romaji": "daredai? daredai? watashi no kamikai"
    },
    {
      "text": "ララバイ ララバイ 死んでも終わらない",
      "romaji": "rarabai rarabai shindemo owaranai"
    },
    {
      "text": "いらない いらない 輪廻のパラダイス",
      "romaji": "iranai iranai rinne no paradaisu"
    },
    {
      "text": "（いないいない VANISHしたい）",
      "romaji": "(inai inai VANISH shitai)"
    },
    {
      "text": "「普通」って何？もう苦しいんだ",
      "romaji": "\"futsuu\" tte nani? mou kurushii nda"
    },
    {
      "text": "崖っぷちタップダンス",
      "romaji": "gakeppuchi tappudansu"
    },
    {
      "text": "Petrol撒いた 火葬しちゃった",
      "romaji": "Petrol maita kasou shichatta"
    },
    {
      "text": "終わらせてほしいんだ",
      "romaji": "owarasete hoshii nda!"
    },
    {
      "text": "壊したいの 生命性",
      "romaji": "kowashitai no seimeisei"
    },
    {
      "text": "赤ん坊から一生急患ですか",
      "romaji": "akanbou kara isshou kyuukan desu ka"
    },
    {
      "text": "真っ赤に流れる",
      "romaji": "makka ni nagareru"
    },
    {
      "text": "お先真っ暗くらっくらで",
      "romaji": "osaki makkura kurakkura de"
    },
    {
      "text": "笑ってる",
      "romaji": "waratteru"
    },
    {
      "text": "ワタシノナカシンドロウム",
      "romaji": "watashi no naka shindoroumu"
    },
    {
      "text": "生命性",
      "romaji": "seimeisei"
    }
  ]
}
