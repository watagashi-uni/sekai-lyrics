  "lines": [
    {
      "text": "ときめきジェットコースター",
      "romaji": "tokimeki jetto koosutaa"
    },
    {
      "text": "今は急上昇↑",
      "romaji": "ima wa kyuujoushou↑"
    },
    {
      "text": "ロマンチックがちょうどいいんだよ?",
      "romaji": "romanchikku ga choudo ii nda yo?"
    },
    {
      "text": "だからもうちょっとだけ",
      "romaji": "dakara mou chotto dake"
    },
    {
      "text": "そばにいてね",
      "romaji": "soba ni ite ne"
    },
    {
      "text": "星に願った Shining Star",
      "romaji": "hoshi ni negatta Shining Star"
    },
    {
      "text": "もっとギュッてして",
      "romaji": "motto gyutte shite"
    },
    {
      "text": "あー重いかな?やっぱり",
      "romaji": "aa omoi kana? yappari"
    },
    {
      "text": "思い出にぷかり",
      "romaji": "omoide ni pukari"
    },
    {
      "text": "あたしを寂しくさせる君に恋をして",
      "romaji": "atashi o sabishiku saseru kimi ni koi o shite"
    },
    {
      "text": "止めらんない「会いたい」が",
      "romaji": "tomerannai \"aitai\" ga"
    },
    {
      "text": "強制破壊するファインダー",
      "romaji": "kyousei hakai suru faindaa"
    },
    {
      "text": "今は急降下↓",
      "romaji": "ima wa kyuukouka↓"
    },
    {
      "text": "好きなのに！好きなのに！",
      "romaji": "suki nano ni! suki nano ni!"
    },
    {
      "text": "ねぇ だけどもうわかんないよ...",
      "romaji": "nee dakedo mou wakannai yo..."
    },
    {
      "text": "耐えらんないの",
      "romaji": "taerannai no"
    },
    {
      "text": "まだ足りないの",
      "romaji": "mada tarinai no"
    },
    {
      "text": "カラフルな瞬間が",
      "romaji": "karafuru na shunkan ga"
    },
    {
      "text": "まだ続きますように",
      "romaji": "mada tsuzukimasu you ni"
    },
    {
      "text": "もっとギュッとして",
      "romaji": "motto gyutto shite"
    }
  ]
}
