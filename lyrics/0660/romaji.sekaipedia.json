  "lines": [
    {
      "text": "キュークツな　お城の暮らし",
      "romaji": "kyuukutsu na oshiro no kurashi"
    },
    {
      "text": "わんわんわん!",
      "romaji": "wan wan wan!"
    },
    {
      "text": "どっさり　宿題",
      "romaji": "dossari shukudai"
    },
    {
      "text": "お姫様って大～変(涙)",
      "romaji": "ohime-sama tte tai~hen"
    },
    {
      "text": "隠してた　本当の気持ち",
      "romaji": "kakushiteta hontou no kimochi"
    },
    {
      "text": "わがまま放題遊びたい",
      "romaji": "wagamama houdai asobitai"
    },
    {
      "text": "お母様に　内緒の時間",
      "romaji": "okaa-sama ni naisho no jikan"
    },
    {
      "text": "作ってみるのだ！",
      "romaji": "tsukutte miru no da!"
    },
    {
      "text": "（だ！ だ！　だ！）",
      "romaji": "(da! da! da!)"
    },
    {
      "text": "一度きりのチャレンジは　勇気がいるけど",
      "romaji": "ichido kiri no charenji wa yuuki ga iru kedo"
    },
    {
      "text": "いっぱいいっぱい冒険したい",
      "romaji": "ippai ippai bouken shitai"
    },
    {
      "text": "いっぱいいっぱい応援したい",
      "romaji": "ippai ippai ouen shitai"
    },
    {
      "text": "とびだせ～ とびだせ～",
      "romaji": "tobidase~ tobidase~"
    },
    {
      "text": "カラフルセカイに飛び込んじゃえ！",
      "romaji": "karafuru sekai ni tobikonjae!"
    },
    {
      "text": "ガラスの靴は投げ飛ばして",
      "romaji": "gurasu no kutsu wa nage tobashite"
    },
    {
      "text": "コーヒーカップぶん回そうよ",
      "romaji": "koohii kappu bun mawasou yo"
    },
    {
      "text": "かぼちゃの馬車から飛び降りちゃえ！",
      "romaji": "kabocha no basha kara tobiorichae!"
    },
    {
      "text": "今はお姫様やめて",
      "romaji": "ima wa ohime-sama yamete"
    },
    {
      "text": "う～ わんだぴょ～い",
      "romaji": "u~ wandapyo~i"
    },
    {
      "text": "楽しい　時間は",
      "romaji": "tanoshii jikan wa"
    },
    {
      "text": "あっというまに　終わっちゃうけど",
      "romaji": "atto iu ma ni owacchau kedo"
    },
    {
      "text": "忘れられない宝物を",
      "romaji": "wasurerarenai takara mono o"
    },
    {
      "text": "一緒に作ろうよ",
      "romaji": "issho ni tsukurou yo"
    },
    {
      "text": "パレードの主役は キミなのだ！",
      "romaji": "pareedo no shuyaku wa kimi na no da!"
    },
    {
      "text": "どんな未来になっても",
      "romaji": "donna mirai ni natte mo"
    },
    {
      "text": "心だけはわんだ～ぴょ～い",
      "romaji": "kokoro dake wa wanda~pyo~i"
    }
  ]
}
