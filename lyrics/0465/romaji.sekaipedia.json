  "lines": [
    {
      "text": "『咬む咬む 代償は",
      "romaji": "kamu kamu daishou wa"
    },
    {
      "text": "いらない 喰えない your mind 救えない』",
      "romaji": "iranai kuenai your mind sukuenai"
    },
    {
      "text": "憂える瞳 愛憎",
      "romaji": "ureeru hitomi aizou"
    },
    {
      "text": "なんて耽美なんだろう",
      "romaji": "nante tanbi nan darou"
    },
    {
      "text": "呻き声は夜もすがら",
      "romaji": "umekigoe wa yomosugara"
    },
    {
      "text": "散漫の中で痛いだけ",
      "romaji": "sanman no naka de itai dake"
    },
    {
      "text": "感嘆がほしいのなら",
      "romaji": "kantan ga hoshii no nara"
    },
    {
      "text": "さあ情けない声をきかせて",
      "romaji": "saa nasakenai koe o kikasete"
    },
    {
      "text": "『始終が今際 狂うが先か?",
      "romaji": "shijuu ga imawa kuruu ga saki ka?"
    },
    {
      "text": "耳に張りつく 靴底の音が",
      "romaji": "mimi ni haritsuku kutsuzoko no ne ga"
    },
    {
      "text": "ほら 成す術ない』",
      "romaji": "hora nasusube nai!"
    },
    {
      "text": "俯瞰すれば思い知る",
      "romaji": "fukan sureba omoishiru"
    },
    {
      "text": "快感の中に居たいだけ",
      "romaji": "kaikan no naka ni itai dake"
    },
    {
      "text": "思考さえもアラベスク",
      "romaji": "shikou sae mo arabesuku"
    },
    {
      "text": "さあ終わらない夜を捧げて",
      "romaji": "saa owaranai yoru o sasagete"
    },
    {
      "text": "さあさ 誓約を交わしましょう",
      "romaji": "saa sa seiyaku o kawashimashou"
    },
    {
      "text": "錆びついた錠をおろす 擾乱の鳥籠",
      "romaji": "sabitsuita jou o orosu jouran no torikago"
    }
  ]
}
