  "lines": [
    {
      "text": "More More（フッフー）",
      "romaji": "More More (Fuffuu)"
    },
    {
      "text": "Jump!! 限界超え（みのり）",
      "romaji": "Jump!! genkai koe (Minori)"
    },
    {
      "text": "完全無欠スターを目指せ",
      "romaji": "kanzen muketsu sutaa o mezase"
    },
    {
      "text": "Jump!! 元気をシェア（遥）",
      "romaji": "Jump!! genki o shea (Haruka)"
    },
    {
      "text": "負けない者の女神よ",
      "romaji": "makenai mono no megami yo"
    },
    {
      "text": "消せぬ夢で結ばれた（モ・モ・ジャン 命）",
      "romaji": "kesenu yume de musubareta (mo mo jan inochi)"
    },
    {
      "text": "We are アイドル新鋭隊",
      "romaji": "We are aidoru shin'eitai"
    },
    {
      "text": "（ハイ・ハイ・ハイ・ハイ・ハイ・ハイ）",
      "romaji": "(hai hai hai hai hai hai)"
    },
    {
      "text": "ジャジャジャン",
      "romaji": "jajajan"
    },
    {
      "text": "落ち込むなんて日常茶飯事",
      "romaji": "ochikomu nante nichijou sahanji"
    },
    {
      "text": "（ファイト・ファイト みのり）",
      "romaji": "(fuaito fuaito Minori)"
    },
    {
      "text": "けど速攻笑顔取り戻すわ",
      "romaji": "kedo sokkou egao torimodosu wa"
    },
    {
      "text": "（キューティー・スマイル 遥）",
      "romaji": "(kyuuti sumairu Haruka)"
    },
    {
      "text": "一度きりのティーンの儚い花盛り",
      "romaji": "ichido kiri no tiin no hakanai hanazakari"
    },
    {
      "text": "下向いてちゃ人生は損",
      "romaji": "shitamuitecha jinsei wa son"
    },
    {
      "text": "（フレッシュ・アイドル イェーイ）",
      "romaji": "(fureshu aidoru ieei)"
    },
    {
      "text": "事務所の方針なんて無視",
      "romaji": "jimusho no houshin nante mushi"
    },
    {
      "text": "（ツンデレ・ガール 愛莉）",
      "romaji": "(tsundere gaaru Airi)"
    },
    {
      "text": "ビジネスライクで演じるのイヤ",
      "romaji": "bijinesu raiku de enjiru no iya"
    },
    {
      "text": "（G・U・T・S 雫）",
      "romaji": "(G・U・T・S Shizuku)"
    },
    {
      "text": "心に嘘つかず",
      "romaji": "kokoro ni uso tsukazu"
    },
    {
      "text": "spotlight 浴び step 踏めば",
      "romaji": "spotlight abi step fumeba"
    },
    {
      "text": "駆け上がる道照らされるよ",
      "romaji": "kakeagaru michi terasareru yo"
    },
    {
      "text": "（ウー・レッツゴー）",
      "romaji": "(uu retsu goo)"
    },
    {
      "text": "More More Jump!! 限界超え（愛莉）",
      "romaji": "More More Jump!! genkai koe (Airi)"
    },
    {
      "text": "Jump!! 元気をシェア（雫）",
      "romaji": "Jump!! genki o shea (Shizuku)"
    }
  ]
}
