  "lines": [
    {
      "text": "経験なんてなくたってall right all right",
      "romaji": "keiken nantenakutatte all right, all right"
    },
    {
      "text": "公平性はこの通り 神様の言う通り",
      "romaji": "kouheisei wa kono toori kamisama no iu toori"
    },
    {
      "text": "疑わしいならlook on me",
      "romaji": "utagawashii nara look on me"
    },
    {
      "text": "逸らさないで目に焼き付けて",
      "romaji": "sorasanaide me ni yakitsukete"
    },
    {
      "text": "Preflop 配られたtwo cards",
      "romaji": "Preflop kubarareta two cards"
    },
    {
      "text": "ここで止めてしまうなんて早計",
      "romaji": "koko de yamete shimau nante soukei"
    },
    {
      "text": "ショーダウンまで終わんないでよ",
      "romaji": "shoodaun made owannaide yo"
    },
    {
      "text": "どうしたい?",
      "romaji": "doushitai?"
    },
    {
      "text": "黙ってないで声に出してよ",
      "romaji": "damattenaide koe ni dashite yo"
    },
    {
      "text": "潰えないよう",
      "romaji": "tsuienai you"
    },
    {
      "text": "待ってないでもっともっとyour call",
      "romaji": "mattenai de motto motto your call"
    },
    {
      "text": "栄冠はいつも中立",
      "romaji": "eikan wa itsumo chuuritsu"
    },
    {
      "text": "新参もit's not too late",
      "romaji": "shinzan mo it’s not too late!"
    }
  ]
}
