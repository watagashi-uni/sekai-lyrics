  "lines": [
    {
      "text": "恐竜も私も同じ板の上",
      "romaji": "kyouryuu mo watashi mo onaji ita no ue"
    },
    {
      "text": "いつから当然になった？",
      "romaji": "itsukara touzen ni natta?"
    },
    {
      "text": "目に映るものはあんまり見えてない",
      "romaji": "me ni utsuru mono wa anmari mietenai"
    },
    {
      "text": "このままやめちゃおっかな",
      "romaji": "kono mama yamechaokka na"
    },
    {
      "text": "目まぐるしい波に乗る日々も",
      "romaji": "memagurushii nami ni noru hibi mo"
    },
    {
      "text": "答え合わせの向こう側",
      "romaji": "kotae awase no mukougawa"
    },
    {
      "text": "拍子抜けしちゃうような",
      "romaji": "hyoushinuke shichau you na"
    },
    {
      "text": "あっけない結末もいいんじゃない",
      "romaji": "akkenai ketsumatsu mo iin janai"
    },
    {
      "text": "誰も見てないよ　意外と",
      "romaji": "daremo mitenai yo igai to"
    },
    {
      "text": "ハロー、ハロー、ハロー、ハロー",
      "romaji": "haroo, haroo, haroo, haroo"
    },
    {
      "text": "今日も明日には過去になるんだね",
      "romaji": "kyou mo ashita ni wa kako ni narun da ne"
    },
    {
      "text": "でも つづくよ",
      "romaji": "demo tsuzuku yo"
    },
    {
      "text": "踊れないこんな世界を",
      "romaji": "odorenai konna sekai o"
    },
    {
      "text": "笑えないこんな世界を",
      "romaji": "waraenai konna sekai o"
    },
    {
      "text": "地球が回っても",
      "romaji": "chikyuu ga mawattemo"
    },
    {
      "text": "宇宙が膨らんでも",
      "romaji": "uchuu ga fukuran demo"
    },
    {
      "text": "どうせ私大人になれない",
      "romaji": "douse watashi otona ni narenai"
    }
  ]
}
