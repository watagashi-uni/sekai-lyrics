    },
    {
      "text": "憧れや夢には近づけない",
      "romaji": "akogare ya yume ni wa chikazukenai"
    },
    {
      "text": "鳴らすBeatでTalkingしようよ",
      "romaji": "narasu Beat de Talking shiyou yo"
    },
    {
      "text": "馴れ合いはいらない（いらない）",
      "romaji": "nareai wa iranai (iranai)"
    },
    {
      "text": "転がる石のように",
      "romaji": "korogaru ishi no you ni"
    },
    {
      "text": "最後に笑えるように",
      "romaji": "saigo ni waraeru you ni"
    },
    {
      "text": "さあ",
      "romaji": "saa"
    },
    {
      "text": "もう一回Try it Try it",
