  "lines": [
    {
      "text": "行き場無くした心に湧いてくる",
      "romaji": "ikiba naku shita kokoro ni waite kuru"
    },
    {
      "text": "このままじゃ呑み込まれる",
      "romaji": "kono mama ja nomikomareru"
    },
    {
      "text": "囲まれてんだどうしたら良いの",
      "romaji": "kakomarete nda doushitara ii no"
    },
    {
      "text": "逃げ場を無くした部屋の隅っこ",
      "romaji": "nigeba o nakushita heya no sumikko"
    },
    {
      "text": "エンドロールが迫る",
      "romaji": "endorooru ga semaru"
    },
    {
      "text": "そんな時目の前に",
      "romaji": "sonna toki me no mae ni"
    },
    {
      "text": "ひらりと舞い降りた",
      "romaji": "hirari to mai orita"
    },
    {
      "text": "君は僕にとってのヒーロー",
      "romaji": "kimi wa boku ni totte no hiiroo"
    },
    {
      "text": "突然現れた光",
      "romaji": "totsuzen arawareta hikari"
    },
    {
      "text": "駆け付けた途端",
      "romaji": "kaketsuketa totan"
    },
    {
      "text": "飛び出したパンチに目が覚めた",
      "romaji": "tobidashita panchi ni me ga sameta"
    },
    {
      "text": "そんな夜に",
      "romaji": "sonna yoru ni"
    },
    {
      "text": "夢中で書き出した物語",
      "romaji": "muchuu de kakidashita monogatari"
    },
    {
      "text": "僅かに残っていた祈り",
      "romaji": "wazuka ni nokotte ita inori"
    },
    {
      "text": "繋がっていきますように",
      "romaji": "tsunagatte ikimasu you ni"
    },
    {
      "text": "突然現れた未来",
      "romaji": "totsuzen arawareta mirai"
    },
    {
      "text": "夢を見ようか",
      "romaji": "yume o miyou ka"
    },
    {
      "text": "さあ改めてどうぞよろしくね",
      "romaji": "saa aratamete douzo yoroshiku ne"
    },
    {
      "text": "ハッピーバースデー",
      "romaji": "happii baasudee"
    },
    {
      "text": "親愛なるヒーローへ",
      "romaji": "shin'ainaru hiiroo e"
    }
  ]
}
