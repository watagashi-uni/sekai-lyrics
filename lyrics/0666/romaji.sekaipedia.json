  "lines": [
    {
      "text": "捨ててきた夢をあつめて",
      "romaji": "sutetekita yume o atsumete"
    },
    {
      "text": "ああ時に時に躓いたって",
      "romaji": "aa \"toki ni toki ni tsumazuita tte,\""
    },
    {
      "text": "寒い寒い寒い寒い寒い",
      "romaji": "samui samui samui samui samui"
    },
    {
      "text": "ああ君の君の君の声が",
      "romaji": "aa kimi no kimi no kimi no koe ga"
    },
    {
      "text": "遠い遠い遠い遠い遠い",
      "romaji": "tooi tooi tooi tooi tooi"
    },
    {
      "text": "何番目でも何番目でも",
      "romaji": "nanbanme demo nanbanme demo"
    },
    {
      "text": "ああ夢を夢を見てたはずが",
      "romaji": "aa yume o yume o miteta hazu ga"
    },
    {
      "text": "怖い怖い怖い怖い怖い",
      "romaji": "kowai kowai kowai kowai kowai"
    },
    {
      "text": "合言葉を繰り返すだけ",
      "romaji": "ai kotoba o kurikaesu dake"
    }
  ]
}
