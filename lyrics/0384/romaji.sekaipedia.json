  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "この想いもきっと重ねてセカイの中",
      "romaji": "kono omoi mo kitto kasanete sekai no naka"
    },
    {
      "text": "笑って　笑って　笑って",
      "romaji": "waratte waratte waratte"
    },
    {
      "text": "迷ってしまったら此処へおいでよ",
      "romaji": "mayotte shimattara koko e oide yo"
    },
    {
      "text": "帷帳の奥から零れるイメージを辿るの",
      "romaji": "tobari no oku kara koboreru imeeji o tadoru no"
    },
    {
      "text": "不完全なまま持ち寄って",
      "romaji": "fukanzen na mama mochiyotte"
    },
    {
      "text": "不安定なまま寄り添って",
      "romaji": "fuantei na mama yorisotte"
    },
    {
      "text": "まだまだ聴こえないままだな",
      "romaji": "madamada kikoenai mama da na"
    },
    {
      "text": "諦めた鏡の中",
      "romaji": "akirameta kagami no naka"
    },
    {
      "text": "閉じ込めた繭の中",
      "romaji": "tojikometa mayu no naka"
    },
    {
      "text": "「ここにいるよ」",
      "romaji": "\"koko ni iru yo”"
    },
    {
      "text": "今は触れられない　見つからない",
      "romaji": "ima wa furerarenai mitsukaranai"
    },
    {
      "text": "そんな迷いでも　願いでも",
      "romaji": "sonna mayoi demo negai demo"
    },
    {
      "text": "手を伸ばした先に",
      "romaji": "te o nobashita saki"
    },
    {
      "text": "繋がる夜があるから",
      "romaji": "ni tsunagaru yoru ga aru kara"
    },
    {
      "text": "崩れそうな螺旋を",
      "romaji": "kuzuresou na rasen o"
    },
    {
      "text": "踊って踊って",
      "romaji": "odotte odotte"
    },
    {
      "text": "共鳴らして　共鳴らして　共鳴らして",
      "romaji": "narashite narashite narashite"
    },
    {
      "text": "そう歌って　歌って　歌って",
      "romaji": "sou utatte utatte utatte"
    },
    {
      "text": "微かに脈打つ灯",
      "romaji": "kasuka ni myakuutsu akari"
    },
    {
      "text": "今は眺める留まり木",
      "romaji": "ima wa nagameru tomarigi"
    },
    {
      "text": "いつかその実を揺らして",
      "romaji": "itsuka sono mi o yurashite"
    },
    {
      "text": "向き合っていけるのかな",
      "romaji": "mukiatte ikeru no kana"
    },
    {
      "text": "茜さす道の先",
      "romaji": "akane sasu michi no saki"
    },
    {
      "text": "薄明に滲む想いも",
      "romaji": "hakumei ni nijimu omoi mo"
    },
    {
      "text": "共鳴らせるさ帷帳の奥　きっと",
      "romaji": "naraserusa tobari no oku kitto"
    },
    {
      "text": "そう笑って　笑って　笑って",
      "romaji": "sou waratte waratte waratte"
    }
  ]
}
