  "lines": [
    {
      "text": "あぁ　ほら　また間違えた",
      "romaji": "aa hora mata machigaeta"
    },
    {
      "text": "これで何度？　何回目？",
      "romaji": "kore de nando? nankai me?"
    },
    {
      "text": "ねえ　ほら　塞いでたって",
      "romaji": "nee hora fusaide tatte"
    },
    {
      "text": "ぽっかり浮き出る傷跡",
      "romaji": "pokkari ukideru kizuato"
    },
    {
      "text": "あぁ　ほら　また誤魔化した",
      "romaji": "aa hora mata gomakashita"
    },
    {
      "text": "見て見ぬ振り　お上手ね",
      "romaji": "mite minu furi ojouzu ne"
    },
    {
      "text": "もう　ほら　何言われたって",
      "romaji": "mou hora nani iwareta tte"
    },
    {
      "text": "誰もわたしを望まない",
      "romaji": "dare mo watashi o nozomanai"
    },
    {
      "text": "むき出して　痛い痛い",
      "romaji": "mukidashite itai itai"
    },
    {
      "text": "強がって　痛い痛い",
      "romaji": "tsuyogatte itai itai"
    },
    {
      "text": "息詰まって　痛い痛いんだよ",
      "romaji": "ikizumatte itai itain da yo"
    },
    {
      "text": "わたしって失敗作だってさって",
      "romaji": "watashi tte shippai saku dattesatte"
    },
    {
      "text": "いらない子なんだって…",
      "romaji": "iranai ko nandatte..."
    },
    {
      "text": "何やったって　頑張ったって",
      "romaji": "nani yattatte ganbattatte"
    },
    {
      "text": "ダメらしいや",
      "romaji": "damerashii ya"
    },
    {
      "text": "愛愛愛されたくて",
      "romaji": "ai ai aisare takute"
    },
    {
      "text": "偽って",
      "romaji": "itsuwatte"
    },
    {
      "text": "もっともっと笑顔で",
      "romaji": "motto motto egao de"
    },
    {
      "text": "いればいいかな…",
      "romaji": "ireba ii kana..."
    },
    {
      "text": "神様　もしも生まれ変わる",
      "romaji": "kamisama moshimo umarekawaru"
    },
    {
      "text": "ことが出来たら",
      "romaji": "koto ga dekitara"
    },
    {
      "text": "愛される子になれますように",
      "romaji": "aisareru ko ni naremasu you ni"
    },
    {
      "text": "泣き止んだ鼓動を子守歌に",
      "romaji": "naki yanda kodou o komoriuta ni"
    },
    {
      "text": "きっときっと明日は 笑えるよね",
      "romaji": "kitto kitto ashita wa waraeru yo ne"
    },
    {
      "text": "間違いだらけに",
      "romaji": "machigai darake ni"
    },
    {
      "text": "オヤスミナサイ",
      "romaji": "oyasumi nasai"
    }
  ]
}
