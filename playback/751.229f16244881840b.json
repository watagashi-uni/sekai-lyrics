{"musicId":751,"duration":130.0125,"vocalId":2057,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-01","name":"星乃一歌"},{"performerId":"歌唱者-02","name":"天馬咲希"},{"performerId":"歌唱者-03","name":"望月穂波"},{"performerId":"歌唱者-04","name":"日野森志歩"},{"performerId":"歌唱者-23","name":"鏡音レン"}],"lines":[{"start":37.56525,"end":41.89925,"text":"浮かんで　転げ落ちて","translation":"浮现 翻滚坠落","segments":[{"text":"浮かんで　転げ落ちて","performerIds":["歌唱者-23"]}],"performerIds":[]},{"start":37.56525,"end":41.89925,"text":"出会ったエンドロール","translation":"邂逅的散场片尾","segments":[{"text":"出会ったエンドロール","performerIds":["歌唱者-23"]}],"performerIds":[]},{"start":41.89925,"end":46.13425,"text":"歪んで　変わり果てた","translation":"扭曲 彻底变样的","segments":[{"text":"歪んで　変わり果てた","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":41.89925,"end":46.13425,"text":"未来の走馬灯","translation":"未来的走马灯","segments":[{"text":"未来の走馬灯","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":46.13425,"end":51.76925,"text":"もうお終いね","translation":"已经要结束了呢","segments":[{"text":"もうお終いね","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":46.13425,"end":51.76925,"text":"幕の切れてしまった白昼夢は","translation":"帷幕破裂断绝的白日梦境","segments":[{"text":"幕の切れてしまった白昼夢は","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":51.76925,"end":56.25725,"text":"ただただ　虚しさ達を暈してみせた","translation":"仅仅将无尽的空虚逐一晕染展现","segments":[{"text":"ただただ　虚しさ達を暈してみせた","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":56.25725,"end":61.42025,"text":"思い出してしまう","translation":"忍不住回想起来","segments":[{"text":"思い出してしまう","performerIds":["歌唱者-03"]}],"performerIds":[]},{"start":61.42025,"end":66.16025,"text":"夕焼ける空　滲むメロディ","translation":"夕阳晚霞的天空 晕染渗透的旋律","segments":[{"text":"夕焼ける空　滲むメロディ","performerIds":["歌唱者-03"]}],"performerIds":[]},{"start":66.16025,"end":70.80225,"text":"「帰ろう　道を間違わないように」","translation":"「回家吧 为了不走错道路」","segments":[{"text":"「帰ろう　道を間違わないように」","performerIds":["歌唱者-02"]}],"performerIds":[]},{"start":70.80225,"end":76.09625,"text":"臆病になって","translation":"变得胆怯懦弱","segments":[{"text":"臆病になって","performerIds":["歌唱者-02"]}],"performerIds":[]},{"start":70.80225,"end":76.09625,"text":"ギュッと繋いだ手を宙に向けて","translation":"将紧紧相牵的手伸向空中","segments":[{"text":"ギュッと繋いだ手を宙に向けて","performerIds":["歌唱者-02"]}],"performerIds":[]},{"start":76.09625,"end":80.51425,"text":"抱いてしまう　願ってしまう","translation":"怀抱在心 祈求期盼","segments":[{"text":"抱いてしまう　願ってしまう","performerIds":["歌唱者-01","歌唱者-02","歌唱者-04","歌唱者-23"]}],"performerIds":[]},{"start":76.09625,"end":80.51425,"text":"贅沢な走馬灯","translation":"奢侈至极的走马灯","segments":[{"text":"贅沢な走馬灯","performerIds":["歌唱者-01","歌唱者-02","歌唱者-04","歌唱者-23"]}],"performerIds":[]},{"start":80.51425,"end":85.09025,"text":"夕凪の向こうに","translation":"在风平浪静的黄昏彼方","segments":[{"text":"夕凪の向こうに","performerIds":["歌唱者-23"]}],"performerIds":[]},{"start":80.51425,"end":85.09025,"text":"恋を認めて緋を灯す","translation":"承认爱恋点亮绯红","segments":[{"text":"恋を認めて緋を灯す","performerIds":["歌唱者-23"]}],"performerIds":[]},{"start":85.09025,"end":89.93025,"text":"過ぎ去っていく　腐っていく","translation":"匆匆逝去 渐渐腐朽","segments":[{"text":"過ぎ去っていく　腐っていく","performerIds":["歌唱者-01","歌唱者-02","歌唱者-03","歌唱者-23"]}],"performerIds":[]},{"start":85.09025,"end":89.93025,"text":"融かした本音は","translation":"融化消解的真心","segments":[{"text":"融かした本音は","performerIds":["歌唱者-01","歌唱者-02","歌唱者-03","歌唱者-23"]}],"performerIds":[]},{"start":89.93025,"end":95.29825,"text":"存在証明を拒んでしまったストーリー","translation":"沦为抗拒存在证明的故事","segments":[{"text":"存在証明を拒んでしまったストーリー","performerIds":["歌唱者-01","歌唱者-03"]}],"performerIds":[]},{"start":95.29825,"end":99.46025,"text":"「また明日」なんてさ","translation":"所谓「明天见」这种话","segments":[{"text":"「また明日」なんてさ","performerIds":["歌唱者-02"]}],"performerIds":[]},{"start":95.29825,"end":99.46025,"text":"言いたくなかったな","translation":"真不想说出口啊","segments":[{"text":"言いたくなかったな","performerIds":["歌唱者-02"]}],"performerIds":[]},{"start":99.46025,"end":104.76825,"text":"拭えない涙も","translation":"擦不干的眼泪","segments":[{"text":"拭えない涙も","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":99.46025,"end":104.76825,"text":"言葉も　嘘　嘘","translation":"言语也 都是谎言 谎言","segments":[{"text":"言葉も　嘘　嘘","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":104.76825,"end":109.81525,"text":"友達なんかに","translation":"像朋友这种身份","segments":[{"text":"友達なんかに","performerIds":["歌唱者-03"]}],"performerIds":[]},{"start":104.76825,"end":109.81525,"text":"なりたくなかったな","translation":"真不想成为啊","segments":[{"text":"なりたくなかったな","performerIds":["歌唱者-03"]}],"performerIds":[]},{"start":109.81525,"end":126.98387,"text":"きっと届かないよな","translation":"一定无法传达了吧","segments":[{"text":"きっと届かないよな","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":109.81525,"end":126.98387,"text":"ごめんね大好きだよ","translation":"对不起我好喜欢你啊","segments":[{"text":"ごめんね大好きだよ","performerIds":["歌唱者-01"]}],"performerIds":[]}],"credits":{"translation":"雪莹ちゃん"},"sources":[["https://www.sekaipedia.org/wiki/Additional_Memory?oldid=339719","CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}