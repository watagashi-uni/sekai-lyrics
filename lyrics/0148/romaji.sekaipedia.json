  "lines": [
    {
      "text": "お別れしたのはもっと",
      "romaji": "owakare shita no wa motto"
    },
    {
      "text": "前の事だったような",
      "romaji": "mae no koto datta you na"
    },
    {
      "text": "悲しい光は封じ込めて",
      "romaji": "kanashii hikari wa fuuji komete"
    },
    {
      "text": "踵すり減らしたんだ (wo-woah)",
      "romaji": "kakatosuri herashita nda (wo-woah)"
    },
    {
      "text": "君といた時は見えた",
      "romaji": "kimi to ita toki wa mieta"
    },
    {
      "text": "今は見えなくなった",
      "romaji": "ima wa mienaku natta"
    },
    {
      "text": "透明な彗星をぼんやりと",
      "romaji": "toumei na suisei o bonyari to"
    },
    {
      "text": "でもそれだけ探している",
      "romaji": "demo sore dake sagashite iru"
    },
    {
      "text": "しょっちゅう唄を歌ったよ",
      "romaji": "shouchuu uta o utatta yo"
    },
    {
      "text": "その時だけのメロディーを",
      "romaji": "sono toki dake no merodii o"
    },
    {
      "text": "寂しくなんかなかったよ",
      "romaji": "sabishiku nanka nakatta yo"
    },
    {
      "text": "ちゃんと寂しくなれたから (yeah!)",
      "romaji": "chanto sabishiku nareta kara (yeah!)"
    },
    {
      "text": "いつまでどこまでなんて",
      "romaji": "itsu made doko made nante"
    },
    {
      "text": "正常か異常かなんて",
      "romaji": "seijou ka ijou ka nante"
    },
    {
      "text": "考える暇も無い程",
      "romaji": "kangaeru hima mo nai hodo"
    },
    {
      "text": "歩くのは大変だ (ha-haah)",
      "romaji": "aruku no wa taihen da (ha-haah)"
    },
    {
      "text": "楽しい方がずっといいよ",
      "romaji": "tanoshii hou ga zutto ii yo"
    },
    {
      "text": "ごまかして笑っていくよ",
      "romaji": "gomakashite waratte iku yo"
    },
    {
      "text": "大丈夫だ　あの痛みは",
      "romaji": "daijoubu da ano itami wa"
    },
    {
      "text": "忘れたって消えやしない",
      "romaji": "wasureta tte kieyashinai"
    },
    {
      "text": "大丈夫だ　この光の始まりには",
      "romaji": "daijoubu da kono hikari no hajimari ni wa"
    },
    {
      "text": "君がいる",
      "romaji": "kimi ga iru"
    }
  ]
}
