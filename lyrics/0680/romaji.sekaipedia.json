  "lines": [
    {
      "text": "交わした約束の言葉の始末",
      "romaji": "kawashita yakusoku no kotoba no shimatsu"
    },
    {
      "text": "早々に、ね　早々に、ね",
      "romaji": "sousou ni, ne sousou ni, ne"
    },
    {
      "text": "泳いだ目線じゃ神様も嫌う",
      "romaji": "oyoida mesen ja kamisama mo kirau"
    },
    {
      "text": "堂々と、ね　堂々と、ね",
      "romaji": "doudou to, ne doudou to, ne"
    },
    {
      "text": "話せない　何も話せない",
      "romaji": "hanasenai nani mo hanasenai"
    },
    {
      "text": "私は知らない　君も何もしてない",
      "romaji": "watashi wa shiranai kimi mo nani mo shitenai"
    },
    {
      "text": "戻れない　二度と戻れない",
      "romaji": "modorenai nidoto modorenai"
    },
    {
      "text": "誰も悪くない　誰も何もしてない",
      "romaji": "dare mo warukunai dare mo nani mo shitenai"
    },
    {
      "text": "沈む足を見ながら",
      "romaji": "shizumu ashi o mi nagara"
    },
    {
      "text": "燃える部屋を見ながら",
      "romaji": "moeru heya o mi nagara"
    },
    {
      "text": "笑うよ　Lalalalalala",
      "romaji": "warau yo Lalalalalala"
    },
    {
      "text": "また誰かが",
      "romaji": "mata dareka ga"
    },
    {
      "text": "この頭から離れない",
      "romaji": "kono atama kara hanarenai"
    },
    {
      "text": "細胞の　一つ一つが",
      "romaji": "saibou no hitotsu hitotsu ga"
    },
    {
      "text": "今も　あの時の歌",
      "romaji": "ima mo ano toki no uta"
    },
    {
      "text": "歌うよ　Lalalalalala",
      "romaji": "utau yo Lalalalalala"
    },
    {
      "text": "話さない　何も話さない",
      "romaji": "hanasanai nani mo hanasanai"
    },
    {
      "text": "話さない　何も　Lalalalalala",
      "romaji": "hanasanai nani mo Lalalalalala"
    }
  ]
}
