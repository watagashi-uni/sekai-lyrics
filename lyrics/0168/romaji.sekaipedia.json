  "lines": [
    {
      "text": "存在証明　愛だって",
      "romaji": "sonzai shoumei ai datte"
    },
    {
      "text": "愛だって吐いたって",
      "romaji": "ai datte haita tte"
    },
    {
      "text": "嗚呼寝転ンゴロンて嫌ん嫌ん",
      "romaji": "aa nekoron goronte iyan iyan"
    },
    {
      "text": "プリティプリティダイエットDAY",
      "romaji": "puriti puriti daietto DAY"
    },
    {
      "text": "曖昧　一回楽に　",
      "romaji": "aimai ikkai raku ni"
    },
    {
      "text": "アイマイミー快楽に",
      "romaji": "aimai mii kairaku ni"
    },
    {
      "text": "病み悪化してんだって",
      "romaji": "yami akkashiten datte"
    },
    {
      "text": "愛だ　恋だ　何だってんだ",
      "romaji": "ai da koi da nandatten da"
    },
    {
      "text": "生命線は　愛だって",
      "romaji": "seimeisen wa ai datte"
    },
    {
      "text": "愛だ　嘆いたって",
      "romaji": "ai da nage ita tte"
    },
    {
      "text": "ああでもない　こうでもないな　",
      "romaji": "aa demo nai kou demo nai na"
    },
    {
      "text": "寂しい寂しいナンセンスDAY",
      "romaji": "sabishii sabishii nansensu DAY"
    },
    {
      "text": "いっそ密会　ラフに　",
      "romaji": "isso mikkai rafu ni"
    },
    {
      "text": "節操無い解：LOVE ME",
      "romaji": "sessou nai kai: LOVE ME"
    },
    {
      "text": "溺れ奴隷",
      "romaji": "obore dorei"
    },
    {
      "text": "踊れ 踊れ 亡霊だ",
      "romaji": "odore odore bourei da"
    },
    {
      "text": "なにもない　なにもない",
      "romaji": "nanimo nai nanimo nai"
    },
    {
      "text": "私なにもない (ねぇ)",
      "romaji": "watashi nanimo nai nee"
    },
    {
      "text": "変われない　変われない",
      "romaji": "kawarenai kawarenai"
    },
    {
      "text": "私変われない (ねぇ)",
      "romaji": "watashi kawarenai nee"
    },
    {
      "text": "分からない分からない",
      "romaji": "wakaranai wakaranai"
    },
    {
      "text": "「わかる」分からない",
      "romaji": "\"wakaru\" wakaranai"
    },
    {
      "text": "はい目もと以外は隠して　ぱぱ",
      "romaji": "hai me mo to igai wa kakushite papa"
    },
    {
      "text": "駄。",
      "romaji": "da."
    },
    {
      "text": "ダダダダ　ダリダリ　ダーリン 笑 FUNNY",
      "romaji": "dadadada daridari daarin FUNNY"
    },
    {
      "text": "はい冴えない愛情論で　おねだり",
      "romaji": "hai saenai aijouron de onedari"
    },
    {
      "text": "駄。ダダダダ　ダーリン脳裏　DIRTY＆DIRTY",
      "romaji": "da. dadadada daarin nouri DIRTY&DIRTY"
    },
    {
      "text": "会いたい衝動　埋めてよ　ダダダーリン",
      "romaji": "aitai shoudou umete yo da da daarin"
    },
    {
      "text": "無無　無無　無無無 ",
      "romaji": "nana nana na nana"
    },
    {
      "text": "無無無　無無無",
      "romaji": "na nana na nana"
    },
    {
      "text": "無い無い反応　返答を　期待したり",
      "romaji": "nai nai hannou hentou o kitai shitari"
    },
    {
      "text": "無い無い妄想　感傷で",
      "romaji": "nai nai mousou kanshou de"
    },
    {
      "text": "駄　ダダダーリン ",
      "romaji": "da da da daarin"
    },
    {
      "text": "無い無い純情　感傷で",
      "romaji": "nai nai junjou kanshou de"
    },
    {
      "text": "ねえダーリン 　ちゅ。",
      "romaji": "nee daarin chu."
    }
  ]
}
