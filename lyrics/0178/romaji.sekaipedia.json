  "lines": [
    {
      "text": "にっこり調査隊",
      "romaji": "nikkori chousatai"
    },
    {
      "text": "おはこんばんちわ",
      "romaji": "ohakonbanchiwa"
    },
    {
      "text": "今日も今日とて　最高です",
      "romaji": "kyou mo kyou tote saikou desu"
    },
    {
      "text": "おぉ～わんだほーい！",
      "romaji": "oo ~ wandahooi!"
    },
    {
      "text": "探索！コレクション！探求！",
      "romaji": "tansaku! korekushon! tankyuu!"
    },
    {
      "text": "諸君！",
      "romaji": "shokun"
    },
    {
      "text": "はい！",
      "romaji": "hai!"
    },
    {
      "text": "我々は世界の笑顔を調査する！",
      "romaji": "wareware wa sekai no egao o chousa suru!"
    },
    {
      "text": "はい隊長　俺に名案が",
      "romaji": "hai taichou ore ni meian ga"
    },
    {
      "text": "却下",
      "romaji": "kyakka"
    },
    {
      "text": "ってまだなにもいってないんだが？",
      "romaji": "tte mada nani mo itte nai nda ga?"
    },
    {
      "text": "もー　とーにーかーく　あれだほら　カナブンは一見にしかず？",
      "romaji": "mou tooniikaaku are da hora kanabun wa ikken ni shikazu?"
    },
    {
      "text": "あぁ　百聞は一見に如かずだねぇ",
      "romaji": "aa hyakubun wa ikken ni shikazu da nee"
    },
    {
      "text": "つまり虫取り？（恐）",
      "romaji": "tsumari mushitori?"
    },
    {
      "text": "それそれ！",
      "romaji": "sore sore!"
    },
    {
      "text": "違うって",
      "romaji": "chigau tte"
    },
    {
      "text": "隊長！",
      "romaji": "taichou!"
    },
    {
      "text": "なになに～（なんだ？）",
      "romaji": "nani nani~ (nanda?)"
    },
    {
      "text": "提案があります",
      "romaji": "teian ga arimasu"
    },
    {
      "text": "ぜひ聞かせてほしいものだな",
      "romaji": "zehi kikasete hoshii mono da na"
    },
    {
      "text": "とりあえず出発しよう　ノープランで",
      "romaji": "toriaezu shuppatsu shiyou noopuran de"
    },
    {
      "text": "うん！",
      "romaji": "un!"
    },
    {
      "text": "ちょっと待って",
      "romaji": "chotto matte"
    },
    {
      "text": "え？",
      "romaji": "e?"
    },
    {
      "text": "出発進行！",
      "romaji": "shuppatsu shinkou!"
    },
    {
      "text": "ちょっとまってって！旅支度くらいさせろ～！",
      "romaji": "chotto matte tte! tabijitaku kurai sasero~!"
    },
    {
      "text": "数・日・後",
      "romaji": "suu jitsu go"
    },
    {
      "text": "じゃあ持ち物チェックをはじめまーす",
      "romaji": "jaa mochimono chekku o hajimemaasu"
    },
    {
      "text": "まずは基本の！",
      "romaji": "mazu wa kihon no!"
    },
    {
      "text": "ぱ！　ぱぱ　パスポート持った？",
      "romaji": "pa! papa pasupooto motta?"
    },
    {
      "text": "き！きき　着替え　わすれた！",
      "romaji": "ki! kiki kigae wasureta!"
    },
    {
      "text": "え～",
      "romaji": "e~"
    },
    {
      "text": "も！モバイルバッテリー　持った？",
      "romaji": "mo! mobairu batterii motta?"
    },
    {
      "text": "こ！志はもった？",
      "romaji": "ko! kokorozashi wa motta?"
    },
    {
      "text": "もちろん！",
      "romaji": "mochiron!"
    },
    {
      "text": "仲間がいて",
      "romaji": "nakama ga ite"
    },
    {
      "text": "私がいる",
      "romaji": "watashi ga iru"
    },
    {
      "text": "しかもフツーじゃない",
      "romaji": "shikamo futsuu janai"
    },
    {
      "text": "だれのことかな？",
      "romaji": "dare no koto kana?"
    },
    {
      "text": "ぼくらには不可能を可能に変える何かがあるさ",
      "romaji": "bokura ni wa fukanou o kanou ni kaeru nanika ga aru sa"
    },
    {
      "text": "にっこりこりこりこりコリアンダー",
      "romaji": "nikkorikorikorikori koriandaa"
    },
    {
      "text": "あちらもこちらも",
      "romaji": "achira mo kochira mo"
    },
    {
      "text": "千客万来！",
      "romaji": "senkyakubanrai!"
    },
    {
      "text": "君の笑顔もコレクションさせて",
      "romaji": "kimi no egao mo korekushon sasete"
    },
    {
      "text": "いいぇーいいぇいいぇい いぇ～",
      "romaji": "iieeiieiiei ie~"
    },
    {
      "text": "大人も子供も関係ねぇぜ",
      "romaji": "otona mo kodomo mo kankeinee ze"
    },
    {
      "text": "これぞ一流の",
      "romaji": "kore zo ichiryuu no"
    },
    {
      "text": "エンタ～↓テイメ～ン↑",
      "romaji": "enta~↓ teime~n↑"
    },
    {
      "text": "わたしだって　いつか",
      "romaji": "watashi datte itsuka"
    },
    {
      "text": "夢を叶えてやるって（we can do it）",
      "romaji": "yume o kanaete yaru tte (we can do it)"
    },
    {
      "text": "このニッコリに触れて",
      "romaji": "kono nikkori ni furete"
    },
    {
      "text": "もっと胸膨らみましたとさ",
      "romaji": "motto mune fukuramimashita to sa"
    },
    {
      "text": "そのションボリをニッコリに変換",
      "romaji": "sono shonbori o nikkori ni henkan"
    },
    {
      "text": "うちらに任せろ　make your smile（Fu~）",
      "romaji": "uchira ni makasero make your smile (Fu~)"
    },
    {
      "text": "アゲのときだって　サゲのときだって",
      "romaji": "age no toki datte sage no toki datte"
    },
    {
      "text": "かき混ぜちゃって　スパイスだって",
      "romaji": "kakimazechatte supaisu datte"
    },
    {
      "text": "完ペキだ",
      "romaji": "kanpeki da"
    },
    {
      "text": "なにが？",
      "romaji": "nani ga?"
    },
    {
      "text": "にっこりこりこりこりお利口ちゃん",
      "romaji": "nikkorikorikorikori orikou-chan"
    },
    {
      "text": "大人も子供も",
      "romaji": "otona mo kodomo mo"
    },
    {
      "text": "熱烈歓迎！",
      "romaji": "netsuretsu kangei!"
    },
    {
      "text": "もち我々も調査対象だ！",
      "romaji": "mochi wareware mo chousa taishou da!"
    },
    {
      "text": "Run away うぇい　うぇい　うぇ～い",
      "romaji": "Run away uei uei ue~i"
    }
  ]
}
