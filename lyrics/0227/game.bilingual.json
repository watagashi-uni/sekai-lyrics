{
  "music_id": 227,
  "time_origin": "selected_game_recording_start_including_pre_roll",
  "performers": [],
  "lines": [
    {
      "index": 0,
      "start": 13.324,
      "end": 14.144,
      "japanese": "らしくない",
      "zh-CN": "一点都不像自己",
      "shared_interval": false
    },
    {
      "index": 1,
      "start": 14.063227,
      "end": 15.493276,
      "japanese": "隙だらけの心切り裂いて",
      "zh-CN": "撕裂这颗破绽百出的脆弱心灵",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 15.493276,
      "end": 16.329889,
      "japanese": "絡み合って",
      "zh-CN": "紧紧交织纠缠",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 16.329889,
      "end": 19.524231,
      "japanese": "まだ見ぬ世界はいつかの幻だったかな",
      "zh-CN": "尚未谋面的崭新世界难不成是曾经的幻影吗",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 19.648322,
      "end": 21.687817,
      "japanese": "一人きりで謝って泣いて泣いた",
      "zh-CN": "孤身一人不断道歉哭泣哭泣",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 21.687817,
      "end": 22.72958,
      "japanese": "絡繰だって",
      "zh-CN": "纵然机关傀儡机械机关",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 22.72958,
      "end": 25.388529,
      "japanese": "忘れていた正しさに不意をつかれて",
      "zh-CN": "却被早已遗忘的正义突袭杀了个措手不及",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 25.562657,
      "end": 26.238152,
      "japanese": "Yes or No",
      "zh-CN": "Yes or No",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 26.238152,
      "end": 28.365712,
      "japanese": "解答代わりの",
      "zh-CN": "代替回答的",
      "shared_interval": true
    },
    {
      "index": 9,
      "start": 26.238152,
      "end": 28.365712,
      "japanese": "被れた可能性が",
      "zh-CN": "盲从沉溺的可能性",
      "shared_interval": true
    },
    {
      "index": 10,
      "start": 28.496808,
      "end": 31.392931,
      "japanese": "いつまでも片隅にあると囁いてる",
      "zh-CN": "正低声耳语说它永远留存在角落之中",
      "shared_interval": false
    },
    {
      "index": 11,
      "start": 31.706161,
      "end": 32.888027,
      "japanese": "眩暈霞む誰だって",
      "zh-CN": "眼前眩晕模糊无论是谁",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 32.888027,
      "end": 34.593277,
      "japanese": "来世なんて期待してないから",
      "zh-CN": "根本都对来世不抱任何期待",
      "shared_interval": false
    },
    {
      "index": 13,
      "start": 34.628303,
      "end": 37.445368,
      "japanese": "目を醒ましてよ",
      "zh-CN": "快快清醒过来睁开双眼吧",
      "shared_interval": true
    },
    {
      "index": 14,
      "start": 34.628303,
      "end": 37.445368,
      "japanese": "（音に乗せ）",
      "zh-CN": "（乘着音符）",
      "shared_interval": true
    },
    {
      "index": 15,
      "start": 37.445368,
      "end": 42.124798,
      "japanese": "際限ない、優しい言葉なんて",
      "zh-CN": "永无止境的、温柔话语什么的",
      "shared_interval": false
    },
    {
      "index": 16,
      "start": 42.177837,
      "end": 43.324678,
      "japanese": "偽りのまま",
      "zh-CN": "始终不过是虚假的谎言罢了",
      "shared_interval": false
    },
    {
      "index": 17,
      "start": 43.303,
      "end": 48.193,
      "japanese": "まだまだ最高に痛いよ",
      "zh-CN": "依然是撕心裂肺至极的痛楚啊",
      "shared_interval": false
    },
    {
      "index": 18,
      "start": 48.183,
      "end": 50.911,
      "japanese": "指先で撫ぜた世界に",
      "zh-CN": "向着指尖轻抚的世界",
      "shared_interval": false
    },
    {
      "index": 19,
      "start": 50.827177,
      "end": 52.978754,
      "japanese": "吐いた言葉一つだけ",
      "zh-CN": "仅吐露出一句字句",
      "shared_interval": false
    },
    {
      "index": 20,
      "start": 52.978754,
      "end": 55.448565,
      "japanese": "「光あれ」と",
      "zh-CN": "「要有光」",
      "shared_interval": true
    },
    {
      "index": 21,
      "start": 52.978754,
      "end": 55.448565,
      "japanese": "味気ない",
      "zh-CN": "索然无味",
      "shared_interval": true
    },
    {
      "index": 22,
      "start": 55.407,
      "end": 58.475,
      "japanese": "孤独さえも書いた絵空事だよ",
      "zh-CN": "连孤独都不过是亲手写下的痴人说梦空想啊",
      "shared_interval": false
    },
    {
      "index": 23,
      "start": 71.28017,
      "end": 72.665186,
      "japanese": "愛されたいから",
      "zh-CN": "正因渴望被爱",
      "shared_interval": false
    },
    {
      "index": 24,
      "start": 72.665186,
      "end": 74.145271,
      "japanese": "どうしても歌いたい",
      "zh-CN": "无论如何都想要放声歌唱",
      "shared_interval": false
    },
    {
      "index": 25,
      "start": 74.361429,
      "end": 77.122453,
      "japanese": "焦がれて枯れた声をあげたメーデー",
      "zh-CN": "渴求至极嘶哑喊破喉咙的求救信号 求救信号",
      "shared_interval": false
    },
    {
      "index": 26,
      "start": 77.123454,
      "end": 78.593531,
      "japanese": "秒速で過ぎてく急逝",
      "zh-CN": "以秒速飞逝而过的骤然离世",
      "shared_interval": false
    },
    {
      "index": 27,
      "start": 78.542,
      "end": 80.048,
      "japanese": "遍く光の救難信号",
      "zh-CN": "普照一切光芒的紧急求救信号",
      "shared_interval": false
    },
    {
      "index": 28,
      "start": 80.334808,
      "end": 82.331271,
      "japanese": "本当を見つけたい",
      "zh-CN": "好想寻觅到真正的真实",
      "shared_interval": false
    },
    {
      "index": 29,
      "start": 82.626488,
      "end": 85.374502,
      "japanese": "もうわかんない",
      "zh-CN": "已经再也搞不明白了",
      "shared_interval": true
    },
    {
      "index": 30,
      "start": 82.626488,
      "end": 85.374502,
      "japanese": "なぜ？どうして？",
      "zh-CN": "为何？究竟为什么？",
      "shared_interval": true
    },
    {
      "index": 31,
      "start": 85.374502,
      "end": 88.242605,
      "japanese": "ないものねだりで",
      "zh-CN": "贪得无厌强求索取",
      "shared_interval": true
    },
    {
      "index": 32,
      "start": 85.374502,
      "end": 88.242605,
      "japanese": "想いを重ねて",
      "zh-CN": "思绪层层堆叠",
      "shared_interval": true
    },
    {
      "index": 33,
      "start": 88.346681,
      "end": 89.85979,
      "japanese": "崩れてしまう場違いケーション",
      "zh-CN": "彻底崩溃瓦解不合时宜的错乱沟通",
      "shared_interval": false
    },
    {
      "index": 34,
      "start": 89.85979,
      "end": 91.390912,
      "japanese": "膨らみ続ける承認欲求",
      "zh-CN": "不断膨胀扩大的被认可欲求",
      "shared_interval": false
    },
    {
      "index": 35,
      "start": 91.627086,
      "end": 93.884741,
      "japanese": "臨界点を彷徨った",
      "zh-CN": "在临界点的边缘彷徨徘徊",
      "shared_interval": false
    },
    {
      "index": 36,
      "start": 116.84,
      "end": 119.488,
      "japanese": "愛されたいから",
      "zh-CN": "正因渴望被爱",
      "shared_interval": false
    },
    {
