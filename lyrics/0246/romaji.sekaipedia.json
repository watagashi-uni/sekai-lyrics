  "lines": [
    {
      "text": "ゆれる街灯 篠突く雨",
      "romaji": "yureru gaitou shinotsuku ame"
    },
    {
      "text": "振れる感情 感覚のテレパス",
      "romaji": "fureru kanjou kankaku no terepasu"
    },
    {
      "text": "迷子のふたりはコンタクト",
      "romaji": "maigo no futari wa kontakuto"
    },
    {
      "text": "ココロは恋を知りました",
      "romaji": "kokoro wa koi wo shirimashita"
    },
    {
      "text": "タイトロープ ツギハギの制服",
      "romaji": "taitoroopu tsugihagi no seifuku"
    },
    {
      "text": "重度のディスコミュニケーション",
      "romaji": "juudo no discommunication"
    },
    {
      "text": "眼光 赤色にキラキラ",
      "romaji": "gankou sekishoku ni kirakira"
    },
    {
      "text": "ナニカが起こる胸騒ぎ",
      "romaji": "nanika ga okoru munazawagi"
    },
    {
      "text": "エイリアン わたしエイリアン",
      "romaji": "eirian, watashi eirian"
    },
    {
      "text": "あなたの心を惑わせる",
      "romaji": "anata no kokoro wo madowaseru"
    },
    {
      "text": "交ざりあう宇宙の引力で",
      "romaji": "mazariau uchuu no inryoku de"
    },
    {
      "text": "感じてる気持ちは トキメキ",
      "romaji": "kanjiteru kimochi wa tokimeki"
    },
    {
      "text": "エイリアン あなたのエイリアン",
      "romaji": "eirian, anata no eirian"
    },
    {
      "text": "引きあう心は逃れられない",
      "romaji": "hikiau kokoro wa nogarerarenai"
    },
    {
      "text": "あなたに未体験あげる",
      "romaji": "anata ni mitaiken ageru"
    },
    {
      "text": "異世界の果てまで トキメキ スキ",
      "romaji": "isekai no hate made tokimeki suki"
    },
    {
      "text": "点灯と消灯を 繰り返している蛍光灯",
      "romaji": "tentou to shoutou wo kurikaeshite iru keikoutou"
    },
    {
      "text": "超常な混沌が 静かにあなたを蝕んだ",
      "romaji": "choujou na konton ga shizuka ni anata wo mushibanda"
    },
    {
      "text": "並行な信号は 特異点に因り交わった",
      "romaji": "heikou na shingou wa tokuiten ni yori majiwatta"
    },
    {
      "text": "創造現実盲信症 感応性本能",
      "romaji": "souzou genjitsu moushinbyou kannousei honnou"
    },
    {
      "text": "瞳に映らない引力に ",
      "romaji": "hitomi ni utsuranai inryoku ni"
    },
    {
      "text": "気づいてよわたしは",
      "romaji": "kidzuite yo watashi wa"
    },
    {
      "text": "触れあえば傷は二度と消えない",
      "romaji": "fureaeba kizu wa nido to kienai"
    },
    {
      "text": "降りそそぐ無数の隕石も",
      "romaji": "furisosogu musuu no inseki mo"
    },
    {
      "text": "ときめく心には 届かない!",
      "romaji": "tokimeku kokoro ni wa todokanai!"
    },
    {
      "text": "エイリアン ふたりはエイリアン",
      "romaji": "eirian, futari wa eirian"
    },
    {
      "text": "高鳴る気持ちが抑えられない!",
      "romaji": "takanaru kimochi ga osaerarenai!"
    },
    {
      "text": "あなたは未確認生命体",
      "romaji": "anata wa mikakunin seimeitai"
    },
    {
      "text": "異世界の果てまであなたが 好き",
      "romaji": "isekai no hate made anata ga suki"
    }
  ]
}
