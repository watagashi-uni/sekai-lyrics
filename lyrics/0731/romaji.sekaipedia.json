  "lines": [
    {
      "text": "あんたは食ってる",
      "romaji": "anta wa kutteru"
    },
    {
      "text": "昨日のハンバーガーを",
      "romaji": "kinou no hanbaagaa o"
    },
    {
      "text": "（むしゃむしゃ）",
      "romaji": "(mushamusha)"
    },
    {
      "text": "（かちかち）",
      "romaji": "(kachikachi)"
    },
    {
      "text": "真面目に書いてる",
      "romaji": "majime ni kaiteru"
    },
    {
      "text": "ブログが怪文書",
      "romaji": "burogu ga kaibunsho"
    },
    {
      "text": "（がちゃがちゃ）",
      "romaji": "(gachagacha)"
    },
    {
      "text": "（がたがた）",
      "romaji": "(gatagata)"
    },
    {
      "text": "(ららららら)",
      "romaji": "(rarararara)"
    },
    {
      "text": "（ぼこぼこ）",
      "romaji": "(bokoboko)"
    },
    {
      "text": "ふんだりけったり",
      "romaji": "fundari kettari"
    },
    {
      "text": "迷走する",
      "romaji": "meisou suru"
    },
    {
      "text": "不安定な将来",
      "romaji": "fuantei na shourai"
    },
    {
      "text": "また　味方を蹴っちゃった",
      "romaji": "mata mikata o kecchatta"
    },
    {
      "text": "敵を庇っちゃった",
      "romaji": "teki o kabacchatta"
    },
    {
      "text": "自分を撃っちゃった",
      "romaji": "jibun o ucchatta"
    },
    {
      "text": "今日も大失敗",
      "romaji": "kyou mo daishippai"
    },
    {
      "text": "でも やってやんよ絶対",
      "romaji": "demo yatte yan yo zettai"
    },
    {
      "text": "孤独に世界と戦っている",
      "romaji": "kodoku ni sekai to tatakatte iru"
    },
    {
      "text": "センパイ　センパイ",
      "romaji": "senpai senpai"
    },
    {
      "text": "センパイ・センパイ・センパイ",
      "romaji": "senpai senpai senpai"
    },
    {
      "text": "アルティメットセンパイ (アルティメットセンパイ)",
      "romaji": "arutimetto senpai (arutimetto senpai)"
    },
    {
      "text": "この世界の限界 (この世界の限界)",
      "romaji": "kono sekai no genkai (kono sekai no genkai)"
    },
    {
      "text": "また アルティメットセンパイ",
      "romaji": "mata arutimetto senpai"
    },
    {
      "text": "ああ　今日も不安だな",
      "romaji": "aa kyou mo fuan da na"
    },
    {
      "text": "明日も不安だな",
      "romaji": "asu mo fuan da na"
    },
    {
      "text": "どうすりゃ正解か",
      "romaji": "dou surya seikai ka"
    },
    {
      "text": "今は　わかんないや",
      "romaji": "ima wa wakannai ya"
    },
    {
      "text": "ゆっくり　地球は回っている",
      "romaji": "yukkuri chikyuu wa mawatte iru"
    },
    {
      "text": "アル・ティ・メット・アル・ティ・メット",
      "romaji": "aru ti metto aru ti metto"
    },
    {
      "text": "ああ",
      "romaji": "aa"
    }
  ]
}
