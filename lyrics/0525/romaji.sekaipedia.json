  "lines": [
    {
      "text": "毎晩歌って踊って楽しいぜベイベ",
      "romaji": "maiban utatte odotte tanoshii ze beibe"
    },
    {
      "text": "唯一無二的なチャームポイント",
      "romaji": "yuiitsumuniteki na chaamupointo"
    },
    {
      "text": "真似されまくって流行ってて笑う",
      "romaji": "mane sare makutte hayattete warau"
    },
    {
      "text": "ウケんね(笑)",
      "romaji": "uken ne"
    },
    {
      "text": "またイっちゃう感情メーター",
      "romaji": "mata icchau kanjou meetaa"
    },
    {
      "text": "後は任せてくれ",
      "romaji": "ato wa makasete kure!"
    }
  ]
}
