  "lines": [
    {
      "text": "何してるの？ミラーめっこ？",
      "romaji": "nani shiteru no? miraa mekko?"
    },
    {
      "text": "早くしてね　始まっちゃうよ！",
      "romaji": "hayaku shite ne hajimacchau yo!"
    },
    {
      "text": "いつも通り可愛いよ",
      "romaji": "itsu mo doori kawaii yo"
    },
    {
      "text": "ダメダメ！だね",
      "romaji": "damedame! da ne"
    },
    {
      "text": "こんなんじゃ",
      "romaji": "konnan ja"
    },
    {
      "text": "とっておきがいいなら",
      "romaji": "totte oki ga ii nara"
    },
    {
      "text": "皆に魔法かけましょう",
      "romaji": "mina ni mahou kakemashou"
    },
    {
      "text": "嘘みたいなトリックを",
      "romaji": "uso mitai na torikku o"
    },
    {
      "text": "衣装に仕掛けてるの",
      "romaji": "ishou ni shikaketeru no"
    },
    {
      "text": "糸 (糸)一つほどけば",
      "romaji": "ito (ito) hitotsu hodokeba"
    },
    {
      "text": "全身がキラキラ！",
      "romaji": "zenshin ga kirakira!"
    },
    {
      "text": "メイキャップ！ ドレスアップ！",
      "romaji": "meikyappu! doresu appu!"
    },
    {
      "text": "キュートに RE:BORN (bon!)",
      "romaji": "kyuuto ni RE:BORN (bon!)"
    },
    {
      "text": "マジカルトリックで",
      "romaji": "majikaru torikku de"
    },
    {
      "text": "チェインチェイン Change!",
      "romaji": "chein chein Change!"
    },
    {
      "text": "とっておき！さあ今！",
      "romaji": "totte oki! saa ima!"
    },
    {
      "text": "センセーショナルに変身って",
      "romaji": "senseeshonaru ni metamo tte"
    },
    {
      "text": "リリリボーン (bon!)",
      "romaji": "ri-ri-ribon (bon!)"
    },
    {
      "text": "アイデアは繋がって",
      "romaji": "aidea wa tsunagatte"
    },
    {
      "text": "どんな時でも",
      "romaji": "donna toki demo"
    },
    {
      "text": "創りあげるよ！",
      "romaji": "tsukuri ageru yo!"
    },
    {
      "text": "マスターピース！",
      "romaji": "masutaa piisu!"
    },
    {
      "text": "みんな一緒に",
      "romaji": "minna issho ni"
    }
  ]
}
