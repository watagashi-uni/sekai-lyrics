  "lines": [
    {
      "text": "頭の中をぐるぐる巡って",
      "romaji": "atama no naka o guruguru megutte"
    },
    {
      "text": "君と会った日を思い返した",
      "romaji": "kimi to atta hi o omoi kaeshita"
    },
    {
      "text": "何となくだけど胸が",
      "romaji": "nan to naku dakedo mune ga"
    },
    {
      "text": "熱くなってくる",
      "romaji": "atsuku natte kuru"
    },
    {
      "text": "今日も星空はキラキラしてて",
      "romaji": "kyou mo hoshizora wa kirakira shitete"
    },
    {
      "text": "きっと来年もそのまた先も",
      "romaji": "kitto rainen mo sono mata saki mo"
    },
    {
      "text": "思いが詰まったステージ",
      "romaji": "omoi ga tsumatta suteeji"
    },
    {
      "text": "ワンダーランドを夢に",
      "romaji": "wandaarando o yume ni"
    },
    {
      "text": "ずっとみんなで一つだよ",
      "romaji": "zutto minna de hitotsu da yo"
    },
    {
      "text": "約束を交わした",
      "romaji": "yakusoku o kawashita"
    },
    {
      "text": "これから先も",
      "romaji": "kore kara saki mo"
    },
    {
      "text": "いつまでも側にいるよ",
      "romaji": "itsumade mo soba ni iru yo"
    },
    {
      "text": "響いてるポップなメロディ",
      "romaji": "hibiiteru poppu na merodi"
    },
    {
      "text": "流れ星たどってスタートの合図",
      "romaji": "nagareboshi tadotte sutaato no aizu"
    },
    {
      "text": "手を繋いで",
      "romaji": "te o tsunaide"
    },
    {
      "text": "窓の外見上げれば",
      "romaji": "mado no soto miagereba"
    },
    {
      "text": "同じ月見ているの",
      "romaji": "onaji tsukimite iru no"
    },
    {
      "text": "辛い時苦しい時挫け",
      "romaji": "tsurai toki kurushii toki kujike"
    },
    {
      "text": "そうになるけれど",
      "romaji": "sou ni naru keredo"
    },
    {
      "text": "私たちはここだよ",
      "romaji": "watashi-tachi wa koko da yo"
    },
    {
      "text": "ここにずっと居るから",
      "romaji": "koko ni zutto iru kara"
    },
    {
      "text": "君と日々過ごした",
      "romaji": "kimi to hibi sugoshita"
    },
    {
      "text": "時間が宝物だよ",
      "romaji": "jikan ga takaramono da yo"
    },
    {
      "text": "星空のオーケストラ",
      "romaji": "hoshizora no ookesutora"
    },
    {
      "text": "色とりどり煌めいた",
      "romaji": "iro toridori kirame ita"
    },
    {
      "text": "この場所でまた会おうね",
      "romaji": "kono basho de mata aou ne"
    },
    {
      "text": "明日へ踏み出す一歩前に",
      "romaji": "ashita e fumidasu ippo mae ni"
    },
    {
      "text": "歩き出そう",
      "romaji": "aruki dasou"
    }
  ]
}
