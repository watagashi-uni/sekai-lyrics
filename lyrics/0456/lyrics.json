{"musicId":456,"duration":134.004,"vocalId":1467,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-01","name":"星乃一歌"},{"performerId":"歌唱者-02","name":"天馬咲希"},{"performerId":"歌唱者-03","name":"望月穂波"},{"performerId":"歌唱者-04","name":"日野森志歩"},{"performerId":"歌唱者-25","name":"MEIKO"}],"lines":[{"start":22.21025,"end":29.35025,"text":"朔 藍 染めてく この星空に","translation":"朔月 幽蓝 染透这片星空","segments":[{"text":"朔 藍 染めてく この星空に","performerIds":["歌唱者-25"]}],"performerIds":[]},{"start":29.35025,"end":35.94425,"text":"破滅的な暗闇に 私は立ち尽くす","translation":"在毁灭般的黑暗之中 我呆立伫立","segments":[{"text":"破滅的な暗闇に 私は立ち尽くす","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":35.94425,"end":42.84425,"text":"巡り巡るクロニクル この繊月に","translation":"循环往复的编年史 面对这纤细的新月","segments":[{"text":"巡り巡るクロニクル この繊月に","performerIds":["歌唱者-25"]}],"performerIds":[]},{"start":42.84425,"end":47.92125,"text":"アスファルトを踏みしめて 見上げた","translation":"脚踏柏油路面 举目仰望","segments":[{"text":"アスファルトを踏みしめて 見上げた","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":47.92125,"end":50.20225,"text":"宇宙へ高く羽を伸ばすよ","translation":"展翅高飞奔向浩瀚宇宙","segments":[{"text":"宇宙へ高く羽を伸ばすよ","performerIds":["歌唱者-01"]}],"performerIds":[]},{"start":50.20225,"end":56.59725,"text":"大気の底映す オペラグラス覗く","translation":"倒映着大气的底层 透过观剧镜窥视","segments":[{"text":"大気の底映す ","performerIds":["歌唱者-02"]},{"text":"オペラグラス覗く","performerIds":["歌唱者-04"]}],"performerIds":[]},{"start":56.59725,"end":62.56925,"text":"揺蕩う明かりさ","translation":"那是摇曳荡漾的光芒","segments":[{"text":"揺蕩う明かりさ","performerIds":["歌唱者-01","歌唱者-03"]}],"performerIds":[]},{"start":62.56925,"end":66.10225,"text":"三日月の風に乗り 宇宙 飛び回るよ","translation":"乘着新月的微风 在宇宙中翱翔飞舞","segments":[{"text":"三日月の風に乗り 宇宙 ","performerIds":["歌唱者-01"]},{"text":"飛び回るよ","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":66.10225,"end":69.44625,"text":"月明かりを切り取る さあ今","translation":"裁剪定格月光 来吧正是现在","segments":[{"text":"月明かりを切り取る ","performerIds":["歌唱者-25"]},{"text":"さあ今","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":69.44625,"end":72.84725,"text":"一閃の光が 夜 切り裂いてく","translation":"一道闪光 划破漫漫黑夜","segments":[{"text":"一閃の光が 夜 切り","performerIds":["歌唱者-01"]},{"text":"裂いてく","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":72.84725,"end":92.11425,"text":"flying through the night","translation":"flying through the night","segments":[{"text":"flying through the night","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":92.11425,"end":95.74925,"text":"幾望の月に満ち この夜空を抜け","translation":"盈满十四日的几望之月 穿透这片夜空","segments":[{"text":"幾望の月に満ち この","performerIds":["歌唱者-01"]},{"text":"夜空を抜け","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":95.74925,"end":98.95325,"text":"月明かりを切り取る さあ今","translation":"裁剪定格月光 来吧正是现在","segments":[{"text":"月明かりを切り取る ","performerIds":["歌唱者-25"]},{"text":"さあ今","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":98.95325,"end":102.46525,"text":"永久に続く時間が 星空を照らす","translation":"永恒延续的时间 照亮璀璨星空","segments":[{"text":"永久に続く時間が ","performerIds":["歌唱者-01"]},{"text":"星空を照らす","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]},{"start":102.46525,"end":131.8275,"text":"flying through the night","translation":"flying through the night","segments":[{"text":"flying through the night","performerIds":["歌唱者-01","歌唱者-25"]}],"performerIds":[]}],"credits":{"translation":"雪莹ちゃん"},"sources":[["https://www.sekaipedia.org/wiki/Kibou_no_Tsuki?oldid=335366","CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}