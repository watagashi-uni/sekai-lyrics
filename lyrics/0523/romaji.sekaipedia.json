  "lines": [
    {
      "text": "小さな窓の中",
      "romaji": "chiisana mado no naka"
    },
    {
      "text": "流れる光景を",
      "romaji": "nagareru koukei o"
    },
    {
      "text": "ぼんやり眺めてた",
      "romaji": "bon'yari nagameteta"
    },
    {
      "text": "僕には馴染めない",
      "romaji": "boku ni wa najimenai"
    },
    {
      "text": "僕には似合わない",
      "romaji": "boku ni wa niawanai"
    },
    {
      "text": "ただそう思ってたんだ",
      "romaji": "tada sou omotteta nda"
    },
    {
      "text": "出会う前は",
      "romaji": "deau mae wa..."
    },
    {
      "text": "胸おどる姿と",
      "romaji": "mune odoru sugata to"
    },
    {
      "text": "心に染み入るその声",
      "romaji": "kokoro ni shimiiru sono koe"
    },
    {
      "text": "遠く離れていても",
      "romaji": "tooku hanarete ite mo"
    },
    {
      "text": "遮られていても",
      "romaji": "saegirarete ite mo"
    },
    {
      "text": "僕へと届く君のレゾナンス",
      "romaji": "boku e to todoku kimi no rezonansu"
    },
    {
      "text": "明るいときの声も",
      "romaji": "akarui toki no koe mo"
    },
    {
      "text": "暗いときの声も",
      "romaji": "kurai toki no koe mo"
    },
    {
      "text": "何故だろう誰の声より響くんだ",
      "romaji": "naze darou dare no koe yori hibiku nda"
    },
    {
      "text": "不思議だよね",
      "romaji": "fushigi da yo ne"
    },
    {
      "text": "二人の言葉が重なって",
      "romaji": "futari no kotoba ga kasanatte"
    },
    {
      "text": "君の感情と歌声と僕の心ふるわす",
      "romaji": "kimi no kanjou to utagoe to boku no kokoro furuwasu"
    }
  ]
}
