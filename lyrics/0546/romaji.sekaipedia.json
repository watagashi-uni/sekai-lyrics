  "lines": [
    {
      "text": "夕暮れは悲しいまま目を細めたら",
      "romaji": "yuugure wa kanashii mama me o hosometara"
    },
    {
      "text": "すりむいた膝の痛さ慣れた気もした",
      "romaji": "surimuita hiza no itasa nareta ki mo shita"
    },
    {
      "text": "堂々巡りの歌聞いてばかりなんだ",
      "romaji": "doudou meguri no uta kiite bakari nanda"
    },
    {
      "text": "｢なんにもない｣に",
      "romaji": "nani mo nai ni"
    },
    {
      "text": "何か欲しくて六弦揺らせば",
      "romaji": "nanika hoshikute rokugen yuraseba"
    },
    {
      "text": "Gコード､響いた今",
      "romaji": "G-koodo、 hibiita ima"
    },
    {
      "text": "そこがステージなんだろう",
      "romaji": "soko ga suteeji nan darou"
    },
    {
      "text": "ライトに照らされて前は向けそうかい",
      "romaji": "raito ni terasarete mae wa mukesou kai"
    },
    {
      "text": "Yeーah, oh-oh!",
      "romaji": "Yeーah, oh-oh!"
    },
    {
      "text": "｢最低｣ばかりの日々でした",
      "romaji": "saitei bakari no hibi deshita"
    },
    {
      "text": "悲しい気持ち､気持ち",
      "romaji": "kanashii kimochi, kimochi"
    },
    {
      "text": "ディストーションさ",
      "romaji": "disutooshon sa"
    },
    {
      "text": "その音が鳴るのならば",
      "romaji": "sono oto ga naru no naraba"
    },
    {
      "text": "今だけ言える､言える",
      "romaji": "ima dake ieru, ieru"
    },
    {
      "text": "ここに立ってたいんだよ",
      "romaji": "koko ni tatteitai nda yo"
    },
    {
      "text": "Oh, yeーah! Yeah!",
      "romaji": "Oh, yeーah! Yeah!"
    }
  ]
}
