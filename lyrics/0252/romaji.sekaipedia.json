  "lines": [
    {
      "text": "もっと高く高く",
      "romaji": "motto takaku takaku"
    },
    {
      "text": "夢を超えて ねえ",
      "romaji": "yume o koete nee"
    },
    {
      "text": "ずっと　ついてきてね",
      "romaji": "zutto tsuite kite ne"
    },
    {
      "text": "輝き続けたい",
      "romaji": "kagayaki tsuzuketai"
    },
    {
      "text": "Yeah Yeah ねえもっと",
      "romaji": "Yeah Yeah nee motto"
    },
    {
      "text": "沢山の喜びも",
      "romaji": "takusan no yorokobi mo"
    },
    {
      "text": "涙も笑顔も みんなでずっと",
      "romaji": "namida mo egao mo minna de zutto"
    },
    {
      "text": "その色とりどりで",
      "romaji": "sono iro toridori de"
    },
    {
      "text": "未来を照らし続けて",
      "romaji": "mirai o terashi tsuzukete"
    },
    {
      "text": "数知れず散った期待も希望も",
      "romaji": "kazushirezu chitta kitai mo kibou mo"
    },
    {
      "text": "今日は隠し味になってたらいいな",
      "romaji": "kyou wa kakushi aji ni nattetara ii na"
    },
    {
      "text": "伝えたい　うまく伝えられない",
      "romaji": "tsutaetai umaku tsutaerarenai"
    },
    {
      "text": "ねえ　ここから　全部　届けるから",
      "romaji": "nee koko kara zenbu todokeru kara"
    },
    {
      "text": "眩しい光の向こうから",
      "romaji": "mabushii hikari no mukou kara"
    },
    {
      "text": "聞こえるよ　聞こえるよ",
      "romaji": "kikoeru yo kikoeru yo"
    },
    {
      "text": "感じるよみんなの想い",
      "romaji": "kanjiru yo minna no omoi"
    },
    {
      "text": "ずっと夢見てた",
      "romaji": "zutto yume miteta"
    },
    {
      "text": "夢の向こうへ",
      "romaji": "yume no mukou e"
    },
    {
      "text": "輝き続けるよ",
      "romaji": "kagayaki tsuzukeru yo"
    },
    {
      "text": "もっと",
      "romaji": "motto"
    },
    {
      "text": "セカイを照らし続けて",
      "romaji": "sekai o terashi tsuzukete"
    }
  ]
}
