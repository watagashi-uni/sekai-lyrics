  "lines": [
    {
      "text": "（燃えるアヴァンチュール）",
      "romaji": "(moeru avanchuuru)"
    },
    {
      "text": "（密会のアピール）",
      "romaji": "(mikkai no apiiru)"
    },
    {
      "text": "（融けていくルール）",
      "romaji": "(tokete iku ruuru)"
    },
    {
      "text": "清純を装ってる泥棒猫の罠は誘い",
      "romaji": "seijun o yosotteru dorobou neko no wana wa sasoi"
    },
    {
      "text": "甘い甘い捕食的な愛",
      "romaji": "amai amai hoshokuteki na ai"
    },
    {
      "text": "私 欲求のまま狩るだけだから",
      "romaji": "watashi yokkyuu no mama karu dake dakara"
    },
    {
      "text": "二人しか知らないこのロマンス",
      "romaji": "futari shika shiranai kono romansu"
    },
    {
      "text": "罪な味で濡らすこのパラダイス",
      "romaji": "tsumi na aji de nurasu kono paradaisu"
    },
    {
      "text": "麻痺する前に もう点火して",
      "romaji": "mahi suru mae ni mou tenka shite"
    },
    {
      "text": "今宵限りのファンタジア",
      "romaji": "koyoi kagiri no fantajia"
    },
    {
      "text": "待ってないで さあ踊って",
      "romaji": "mattenaide saa odotte"
    },
    {
      "text": "こぼれてる吐息が",
      "romaji": "koboreteru toiki ga"
    },
    {
      "text": "止まない刺激が",
      "romaji": "yamanai shigeki ga"
    },
    {
      "text": "人のモノだろうが",
      "romaji": "hito no mono darou ga"
    },
    {
      "text": "今宵は狩人と獲物",
      "romaji": "koyoi wa kariudo to emono"
    },
    {
      "text": "仕留めて 火を付けて",
      "romaji": "shitomete hi o tsukete"
    },
    {
      "text": "ただ 掠め盗るだけ",
      "romaji": "tada kasumetoru dake"
    }
  ]
}
