  "lines": [
    {
      "text": "この涙が渇くまで",
      "romaji": "kono namida ga kawaku made"
    },
    {
      "text": "無理に笑う必要はないよ",
      "romaji": "muri ni warau hitsuyou wa nai yo"
    },
    {
      "text": "追い続けた夢の途中",
      "romaji": "oitsuzuketa yume no tochuu"
    },
    {
      "text": "時間だけが迫っていく",
      "romaji": "jikan dake ga sematteiku"
    },
    {
      "text": "君の声を聞くことも",
      "romaji": "kimi no koe o kiku koto mo"
    },
    {
      "text": "少なくなるのかな",
      "romaji": "sukunaku naru no kana"
    },
    {
      "text": "今この瞬間を",
      "romaji": "ima kono shunkan o"
    },
    {
      "text": "大切に今日も生きている",
      "romaji": "taisetsu ni kyou mo ikiteiru"
    },
    {
      "text": "不器用だから",
      "romaji": "bukiyou dakara"
    },
    {
      "text": "全てが煌めいていた",
      "romaji": "subete ga kirameiteita"
    },
    {
      "text": "君と居られたら",
      "romaji": "kimi to iraretara"
    },
    {
      "text": "それだけで幸せなんだ",
      "romaji": "soredake de shiawase nanda"
    },
    {
      "text": "星空は今日も照らし続ける",
      "romaji": "hoshizora wa kyou mo terashi tsuzukeru"
    }
  ]
}
