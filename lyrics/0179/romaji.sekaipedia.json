  "lines": [
    {
      "text": "街明かり華やか",
      "romaji": "machi akari hanayaka"
    },
    {
      "text": "エーテル麻酔の冷たさ",
      "romaji": "eeteru masui no tsumetasa"
    },
    {
      "text": "眠れない午前二時",
      "romaji": "nemurenai gozen niji"
    },
    {
      "text": "全てが急速に変わる",
      "romaji": "subete ga kyuusoku ni kawaru"
    },
    {
      "text": "オイル切れのライター",
      "romaji": "oiru kire no raitaa"
    },
    {
      "text": "焼けつくような胃の中",
      "romaji": "yaketsuku you na i no naka"
    },
    {
      "text": "全てがそう嘘なら",
      "romaji": "subete ga sou uso nara"
    },
    {
      "text": "本当によかったのにね",
      "romaji": "hontou ni yokatta no ni ne"
    },
    {
      "text": "君の首を絞める夢を見た",
      "romaji": "kimi no kubi wo shimeru yume wo mita"
    },
    {
      "text": "光の溢れる昼下がり",
      "romaji": "hikari no afureru hirusagari"
    },
    {
      "text": "君の細い喉が跳ねるのを",
      "romaji": "kimi no hosoi nodo ga haneru no wo"
    },
    {
      "text": "泣き出しそうな眼で見ていた",
      "romaji": "nakidashisou na me de miteita"
    },
    {
      "text": "あああああああああああああ！！！！！",
      "romaji": "aaaaaaaaaaaaa!!!!!!"
    },
    {
      "text": "全ての歯車が噛み合った",
      "romaji": "subete no haguruma ga kamiatta"
    },
    {
      "text": "きっとそんな世界だ",
      "romaji": "kitto sonna sekai da"
    }
  ]
}
