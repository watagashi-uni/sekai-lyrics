  "lines": [
    {
      "text": "近づきすぎた",
      "romaji": "chikazukisugita"
    },
    {
      "text": "眩しすぎる太陽を前に",
      "romaji": "mabushi sugiru taiyou o mae ni"
    },
    {
      "text": "それでも止まらない",
      "romaji": "soredemo tomaranai"
    },
    {
      "text": "白く広大な世界の中",
      "romaji": "shiroku koudai na sekai no naka"
    },
    {
      "text": "手探りで鍵を探したんだ",
      "romaji": "tesaguri de kagi o sagashita nda"
    },
    {
      "text": "吐き出した",
      "romaji": "hakidashita"
    },
    {
      "text": "溢れ出す憧れを抱きしめて",
      "romaji": "afuredasu akogare o dakishimete"
    },
    {
      "text": "(高く 高く)",
      "romaji": "(takaku takaku)"
    },
    {
      "text": "境界線を越えて",
      "romaji": "kyoukaisen o koete"
    },
    {
      "text": "今よりも高くその先へ",
      "romaji": "ima yori mo takaku sono saki e"
    },
    {
      "text": "超えて 静寂を",
      "romaji": "koete seijaku o"
    },
    {
      "text": "今 願う 次の景色を",
      "romaji": "ima negau tsugi no keshiki o"
    },
    {
      "text": "限界を超えて何処までも",
      "romaji": "genkai o koete doko made mo"
    },
    {
      "text": "高く高く羽ばたける",
      "romaji": "takaku takaku habatakeru"
    },
    {
      "text": "今 掴め 見知らぬ空",
      "romaji": "ima tsukame mishiranu sora"
    },
    {
      "text": "醒めない熱を謳え",
      "romaji": "samenai netsu o utae"
    }
  ]
}
