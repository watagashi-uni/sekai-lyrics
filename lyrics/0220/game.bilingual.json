      "trailingPerformerIds": [],
      "shared_interval": false
    },
    {
      "index": 19,
      "start": 59.381,
      "end": 64.488,
      "japanese": "あなたが知れば笑うだろうか",
      "zh-CN": "若是被你知道了会笑话我吗",
      "shared_interval": false
    },
    {
      "index": 20,
      "start": 64.502,
      "end": 67.967,
      "japanese": "簡単な感情ばっか数えていたら",
      "zh-CN": "若只是一味数着简单的感情",
      "shared_interval": false
    },
    {
      "index": 21,
      "start": 67.987,
      "end": 72.354,
      "japanese": "あなたがくれた体温まで　忘れてしまった",
      "zh-CN": "就连你曾赋予我的体温　都彻底遗忘干净了",
      "shared_interval": false
    },
    {
      "index": 22,
      "start": 72.348,
      "end": 75.432,
      "japanese": "バイバイもう永遠に会えないね",
      "zh-CN": "拜拜我们再也永远无法相见了呢",
      "shared_interval": false
    },
    {
      "index": 23,
      "start": 76.18,
      "end": 79.76,
      "japanese": "何故かそんな気がするんだ　そう思えてしまったんだ",
      "zh-CN": "不知为何竟有这种预感　不由得产生了这种念头",
      "shared_interval": false
    },
    {
      "index": 24,
      "start": 79.753,
      "end": 82.738,
      "japanese": "上手く笑えないんだ　どうしようもないまんま",
      "zh-CN": "无法好好笑出来啊　只能这样无可奈何地待着",
      "shared_interval": false
    },
    {
