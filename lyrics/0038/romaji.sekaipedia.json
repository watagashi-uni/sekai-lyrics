  "lines": [
    {
      "text": "（ブリキのダンス）",
      "romaji": "(buriki no dansu)"
    },
    {
      "text": "さあ、憐れんで、血統書",
      "romaji": "saa, awarende, kettousho"
    },
    {
      "text": "持ち寄って反教典",
      "romaji": "mochiyotte hankyouten"
    },
    {
      "text": "沈んだ唱導",
      "romaji": "shizunda shoudou"
    },
    {
      "text": "腹這い幻聴",
      "romaji": "harabai genchou"
    },
    {
      "text": "謁見　席巻　妄信症",
      "romaji": "ekken sekken moushin shou"
    },
    {
      "text": "踊れ酔え孕め",
      "romaji": "odore yoe harame"
    },
    {
      "text": "アヴァターラ新大系",
      "romaji": "avataa shintaikei"
    },
    {
      "text": "斜めの幻聴",
      "romaji": "naname no genchou"
    },
    {
      "text": "錻力と宗教",
      "romaji": "buriki to shuukyou"
    },
    {
      "text": "ラル・ラリ・唱えろ生",
      "romaji": "raru rari tonaero sei"
    },
    {
      "text": "まあ、逆らって新王都",
      "romaji": "maa, sakaratte shin'outo"
    },
    {
      "text": "くぐもった脳系統",
      "romaji": "kugumotta noukei tou"
    },
    {
      "text": "墓掘れ説法",
      "romaji": "hakabore seppou"
    },
    {
      "text": "釈迦釈迦善行",
      "romaji": "shaka shaka zenkou"
    },
    {
      "text": "六感・吶喊・竜胆・錠",
      "romaji": "rokkan ・ tokkan ・ rindou ・ jou"
    },
    {
      "text": "どれどれ、震え",
      "romaji": "doredore, furue"
    },
    {
      "text": "蔑んで新体系",
      "romaji": "sagesunde shintaikei"
    },
    {
      "text": "欺瞞の延長",
      "romaji": "giman no enchou"
    },
    {
      "text": "詭弁の劣等",
      "romaji": "kiben no rettou"
    },
    {
      "text": "ドグ・ラグ・叶えろ",
      "romaji": "dogu ・ ragu ・ kanaero"
    },
    {
      "text": "不気味な手、此処に在り",
      "romaji": "(bu-bu-bu) bukimi na te, koko ni ari"
    },
    {
      "text": "理性の目、咽び泣き",
      "romaji": "(ri-ri-ri) risei no me, musebi naki"
    },
    {
      "text": "踵返せ遠くに",
      "romaji": "(ki-ki-ki) kibisu kaese tooku ni"
    },
    {
      "text": "偲ぶ君の瞳を",
      "romaji": "shinobu kimi no hitomi o"
    },
    {
      "text": "さあ、皆舞いな、空洞で",
      "romaji": "saa, mina mai na, kuudou de"
    },
    {
      "text": "サンスクリット求道系",
      "romaji": "sansukuritto kyuudoukei"
    },
    {
      "text": "抉り抜いた鼓動咲かせ咲かせ",
      "romaji": "eguri nuita kodou sakase sakase"
    },
    {
      "text": "さあ、剽悍な双眸を",
      "romaji": "saa, hyoukan na soubou o"
    },
    {
      "text": "エーカム、そうさ。先頭に",
      "romaji": "ekamu, sousa. Sentou ni"
    },
    {
      "text": "真っ赤に濡れた空、踵鳴らせ",
      "romaji": "makka ni nureta sora, kakato narase"
    },
    {
      "text": "嗚呼、漠然と運命星",
      "romaji": "aa, bakuzen to unmeisei"
    },
    {
      "text": "重度に負った喘鳴に",
      "romaji": "juudo ni otta zenmei ni"
    },
    {
      "text": "優劣等無いさ回れ踊れ",
      "romaji": "yuretsu nado nai sa maware odore"
    },
    {
      "text": "もう、漠然と九番目が龍を薙ぐ",
      "romaji": "mou, bakuzen to kyuubanme ga ryuu o nagu"
    },
    {
      "text": "パッパラ・ラル・ラリ、ブリキノダンス",
      "romaji": "pappara raru rari buriki no dansu"
    }
  ]
}
