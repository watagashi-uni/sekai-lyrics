    {
      "index": 4,
      "start": 23.27413,
      "end": 25.502977,
      "japanese": "言葉が見つかんない",
      "zh-CN": "话语也找不到",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 25.703053,
      "end": 27.268647,
      "japanese": "煙を焚いた",
      "zh-CN": "就这样点燃了烟",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 27.468723,
      "end": 30.248779,
