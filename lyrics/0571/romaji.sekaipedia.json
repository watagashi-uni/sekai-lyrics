  "lines": [
    {
      "text": "メーデーメーデー",
      "romaji": "meedee meedee"
    },
    {
      "text": "嫌になるわほんとさ",
      "romaji": "iya ni naru wa honto sa"
    },
    {
      "text": "まだ JUNKIE JUNKIE なままで",
      "romaji": "mada JUNKIE JUNKIE na mama de"
    },
    {
      "text": "あんたにゃ敵わないんだって分かってる",
      "romaji": "anta nya kanawanai nda tte wakatteru"
    },
    {
      "text": "嗚呼  散々転げ回って足掻いてる",
      "romaji": "aa sanzan koroge mawatte agaiteru"
    },
    {
      "text": "ほら やっぱりやっぱり つまんない",
      "romaji": "hora yappari yappari tsumannai"
    },
    {
      "text": "万人執着に寄り添って",
      "romaji": "bannin shuuchaku ni yorisotte"
    },
    {
      "text": "機械みたいに動いている",
      "romaji": "kikai mitai ni ugoite iru"
    },
    {
      "text": "嗚呼知ってる使い倒された言葉使ってみたって",
      "romaji": "aa shitteru tsukai taosareta kotoba tsukatte mita tte"
    },
    {
      "text": "あの人の様にはなれないのです",
      "romaji": "ano hito no you ni wa narenai no desu"
    },
    {
      "text": "戯れ言も",
      "romaji": "zaregoto mo"
    },
    {
      "text": "至極真っ当さ",
      "romaji": "shigoku mattou sa"
    },
    {
      "text": "然れど痛い日々だ",
      "romaji": "saredo itai hibi da"
    },
    {
      "text": "所詮僕は偽物さ",
      "romaji": "shosen boku wa nisemono sa"
    },
    {
      "text": "壊れる前に壊してしまう前に",
      "romaji": "kowareru mae ni kowashite shimau mae ni"
    },
    {
      "text": "(クソが)",
      "romaji": "(kusoga)"
    },
    {
      "text": "またジャンキージャンキーだ",
      "romaji": "mata jankii jankii da"
    },
    {
      "text": "もう飽き飽きなんだ",
      "romaji": "mou akiaki nanda"
    },
    {
      "text": "ゴミ溜まりへ向かう様な",
      "romaji": "gomitamari e mukau you na"
    },
    {
      "text": "ファンキーファンキー（笑）人間なんで",
      "romaji": "fankii fankii ningen nande"
    },
    {
      "text": "誰か助けてくれ",
      "romaji": "dareka tasukete kure"
    },
    {
      "text": "足一つ出せずに",
      "romaji": "ashi hitotsu dasezu ni"
    },
    {
      "text": "自分さえ守れない様な",
      "romaji": "jibun sae mamorenai you na"
    },
    {
      "text": "嗚呼ジャンキー人間なんで",
      "romaji": "aa jankii ningen nande"
    }
  ]
}
