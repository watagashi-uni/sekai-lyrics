  "lines": [
    {
      "text": "最上階に君が一人",
      "romaji": "saijoukai ni kimi ga hitori"
    },
    {
      "text": "揺れる影が　ずっと　ずっと",
      "romaji": "yureru kage ga zutto zutto"
    },
    {
      "text": "「ずっと、僕らの愛は ",
      "romaji": "\"zutto, bokura no ai wa"
    },
    {
      "text": "もう見つかりはしないでしょう」",
      "romaji": "mou mitsukari wa shinai deshou\""
    },
    {
      "text": "言葉を飲み込む音",
      "romaji": "kotoba o nomikomu oto"
    },
    {
      "text": "息を止めた　街中に一人",
      "romaji": "iki o tometa machinaka ni hitori"
    },
    {
      "text": "暮れた夜を混ぜては　喉の奥に",
      "romaji": "kureta yoru o mazete wa nodo no oku ni"
    },
    {
      "text": "今　落としてゆく",
      "romaji": "ima otoshite yuku"
    },
    {
      "text": "昨日の事は忘れました",
      "romaji": "kinou no koto wa wasuremashita"
    },
    {
      "text": "明日の事も ",
      "romaji": "ashita no koto mo"
    },
    {
      "text": "思い？出せ？なくて？",
      "romaji": "omoi? dase? nakute?"
    },
    {
      "text": "あぁ　もう　痛い　痛いなんて",
      "romaji": "aa mou itai itai nante"
    },
    {
      "text": "声は　確かに届いてたんです",
      "romaji": "koe wa tashika ni todoiteta ndesu"
    },
    {
      "text": "君が　「嫌い」 きらい なんて",
      "romaji": "kimi ga \"kirai\" kirai nante"
    },
    {
      "text": "言葉　錆付いて聞こえないや",
      "romaji": "kotoba sabitsuite kikoenai ya"
    },
    {
      "text": "愛？　のない？　痛い容態",
      "romaji": "ai? no nai? itai youdai"
    },
    {
      "text": "唄も色も　まだ六十八夜の",
      "romaji": "uta mo iro mo mada rokujuuhachiya no"
    },
    {
      "text": "僕が　君に　送る",
      "romaji": "boku ga kimi ni okuru"
    },
    {
      "text": "ねぇ",
      "romaji": "nee"
    },
    {
      "text": "あの日願った言葉がもう",
      "romaji": "ano hi negatta kotoba ga mou"
    },
    {
      "text": "耳に染み込んじゃって",
      "romaji": "mimi ni shimikonjatte"
    },
    {
      "text": "気持ちも切って ",
      "romaji": "kimochi mo kitte"
    },
    {
      "text": "「バイバイバイ」 ",
      "romaji": "\"baibaibai\""
    },
    {
      "text": "何を欲しがったんだっけ？",
      "romaji": "nani o hoshigatta nda kke?"
    },
    {
      "text": "塵も積もって　何年間",
      "romaji": "chiri mo tsumotte nannenkan"
    },
    {
      "text": "僕が　君が　僕が捨てちゃったんです ",
      "romaji": "boku ga kimi ga boku ga sutechatta ndesu"
    },
    {
      "text": "まだ　あぁ",
      "romaji": "mada aa"
    },
    {
      "text": "言葉も出ない　出ないような",
      "romaji": "kotoba mo denai denai you na"
    },
    {
      "text": "声が確かに響いてたんです",
      "romaji": "koe ga tashika ni hibiiteta ndesu"
    },
    {
      "text": "今も嫌い　嫌いなんて",
      "romaji": "ima mo kirai kirai nante"
    },
    {
      "text": "言葉近すぎて聞こえないや",
      "romaji": "kotoba chikasugite kikoenai ya"
    },
    {
      "text": "もう痛い　痛い容態",
      "romaji": "mou itai itai youdai"
    },
    {
      "text": "響く夜空に溶ける",
      "romaji": "hibiku yozora ni tokeru"
    },
    {
      "text": "透明哀歌",
      "romaji": "toumei aika"
    }
  ]
}
