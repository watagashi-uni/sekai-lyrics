  "lines": [
    {
      "text": "夢のセカイと セカイを",
      "romaji": "yume no sekai to sekai o"
    },
    {
      "text": "繋ぐProject",
      "romaji": "tsunagu Project"
    },
    {
      "text": "「う～～～～～～～どっかーん！！」",
      "romaji": "\"u~~~~~~~dokkaan!!\""
    },
    {
      "text": "「そんなことより、幻想郷に行こうよ！！」",
      "romaji": "\"sonna koto yori, gensoukyou ni ikou yo!!\""
    },
    {
      "text": "「げ、幻想郷～～～！？」",
      "romaji": "\"ge, gensoukyou~~~!?\""
    },
    {
      "text": "いちにっ！さんしっ！げんそーきょー！",
      "romaji": "ichi ni! san shi! gensookyoo!"
    },
    {
      "text": "さんにっ！さんしっ！ごーごーげんそーきょー！",
      "romaji": "san ni! san shi! goo goo gensookyoo!"
    },
    {
      "text": "「いっくよーーー！！」",
      "romaji": "\"ikku yoooo!!\""
    },
    {
      "text": "ここ掘れワンワン　秘密の発見だ （わっしょい！　わんだっほーい！)",
      "romaji": "koko hore wanwan himitsu no hakken da (wasshoi! wandaahooi!)"
    },
    {
      "text": "おんボロボロ　お賽銭箱",
      "romaji": "on boroboro osaisenbako"
    },
    {
      "text": "開いたらとっかーん！ 　娑婆さらば （ピチューン！)",
      "romaji": "haitara tokkaan! shaba saraba (pichuun!)"
    },
    {
      "text": "「巫女さんが空を飛んでる！？」",
      "romaji": "\"miko-san ga sora o tonderu!?\""
    },
    {
      "text": "「なんだあの極太レーザーは！！」",
      "romaji": "\"nanda ano gokubuto reezaa wa!!\""
    },
    {
      "text": "「メイドがナイフをなげてる…！」",
      "romaji": "\"meido ga naifu o nageteru...!\""
    },
    {
      "text": "「これが、異世界転生か！？」",
      "romaji": "\"kore ga, isekai tensei ka!?\""
    },
    {
      "text": "ド派手な冒険 よっしゃ～！　いくぞ！！",
      "romaji": "dohade na bouken yossha~! iku zo!!"
    },
    {
      "text": "「夕方までには帰るのよ～^^」",
      "romaji": "\"yuugata made ni wa kaeru no yo~^^\""
    },
    {
      "text": "「魔法の森で」 \\わんだほーい！/ 「からの？」",
      "romaji": "\"mahou no mori de\" \\wandahooi!/ \"kara no?\""
    },
    {
      "text": "「妖怪の山で」 \\わんだほーい！/ 「そして？」",
      "romaji": "\"youkai no yama de\" \\wandahooi!/ \"soshite?\""
    },
    {
      "text": "「博麗の巫女と」 \\わんだほーい！/ 「やがて？」",
      "romaji": "\"hakurei no miko to\" \\wandahooi!/ \"yagate?\""
    },
    {
      "text": "「ファイナルマスター」 \\わんだほーい！/ \\いぇ～～～～～～～～！！/",
      "romaji": "\"fainaru masutaa\" \\wandahooi!/ \\ie~~~~~~~~!!/"
    },
    {
      "text": "「みんな、準備OK？」",
      "romaji": "\"minna, junbi OK?\""
    },
    {
      "text": "ワンワンワンダーワンダーランド！",
      "romaji": "wan wan wandaa wandaarando!"
    },
    {
      "text": "笑顔がぱぁっと弾けるよ",
      "romaji": "egao ga paatto hajikeru yo"
    },
    {
      "text": "誰でもGo showtime!!",
      "romaji": "dare demo Go showtime!!"
    },
    {
      "text": "おいでおいでおいで (イェイイェーイ！)",
      "romaji": "oide oide oide (iei ieei!)"
    },
    {
      "text": "必ず君を連れていくんだ",
      "romaji": "kanarazu kimi o tsurete iku nda"
    },
    {
      "text": "いますぐ笑ってさぁ！",
      "romaji": "ima sugu waratte saa!"
    },
    {
      "text": "あのステージへ！",
      "romaji": "ano suteeji e!"
    },
    {
      "text": "僕らの幻想郷",
      "romaji": "bokura no sekai"
    },
    {
      "text": "さんにっ！さんしっ！げんそーきょー！",
      "romaji": "san ni! san shi! gensookyoo!"
    },
    {
      "text": "全力全開 もういっかーい！",
      "romaji": "zenryoku zenkai mou ikkaai!"
    },
    {
      "text": "「まだ会おうね！」",
      "romaji": "\"mada aou ne!\""
    }
  ]
}
