  "lines": [
    {
      "text": "きっと訳もなく出会い僕ら",
      "romaji": "kitto wake mo naku deai bokura"
    },
    {
      "text": "息をして費やした時間が昨日になる",
      "romaji": "iki o shite tsuiyashita jikan ga kinou ni naru"
    },
    {
      "text": "いつか終わる日が来て僕ら",
      "romaji": "itsuka owaru hi ga kite bokura"
    },
    {
      "text": "遠い場所へ旅立つ時まで",
      "romaji": "tooi basho e tabidatsu toki made"
    },
    {
      "text": "その瞬間まで",
      "romaji": "sono shunkan made"
    },
    {
      "text": "名前のない",
      "romaji": "namae no nai"
    },
    {
      "text": "日々を紡ぎ",
      "romaji": "hibi o tsumugi"
    },
    {
      "text": "愛を繋いだら",
      "romaji": "ai o tsunaidara"
    },
    {
      "text": "リボンをかけよう",
      "romaji": "ribon o kakeyou"
    },
    {
      "text": "何一つも同じじゃないさ",
      "romaji": "nani hitotsu mo onaji ja nai sa"
    },
    {
      "text": "まるで違うから惹かれたんだ",
      "romaji": "marude chigau kara hikareta nda"
    },
    {
      "text": "何一つも変わらないさ",
      "romaji": "nani hitotsu mo kawaranai sa"
    },
    {
      "text": "お揃いの命を持つ",
      "romaji": "osoroi no inochi o motsu"
    },
    {
      "text": "答えのない世界で",
      "romaji": "kotae no nai sekai de"
    },
    {
      "text": "ありふれた恋を歌って",
      "romaji": "arifureta koi o utatte"
    },
    {
      "text": "掛け違えたボタンを",
      "romaji": "kakechigaeta botan o"
    },
    {
      "text": "一つずつ外してゆく",
      "romaji": "hitotsuzutsu hazushite yuku"
    }
  ]
}
