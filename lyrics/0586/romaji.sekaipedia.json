  "lines": [
    {
      "text": "きっと未来は報われない",
      "romaji": "kitto mirai wa mukuwarenai"
    },
    {
      "text": "バルブ　蒸気　バット　アンダーグラウンド",
      "romaji": "barubu jouki batto andaaguraundo"
    },
    {
      "text": "牽制食らった　白兵戦だって",
      "romaji": "kensei kuratta hakuheisen datte"
    },
    {
      "text": "声は飲み込まれた",
      "romaji": "koe wa nomikomareta"
    },
    {
      "text": "きっと世界に望みはない",
      "romaji": "kitto sekai ni nozomi wa nai"
    },
    {
      "text": "大人達の凝った理想",
      "romaji": "otonatachi no kotta risou"
    },
    {
      "text": "純粋愚直な拳一つで",
      "romaji": "junsui guchaku na kobushi hitotsu de"
    },
    {
      "text": "嘘を裁いて　殻を割って",
      "romaji": "uso o sabaite kara o watte"
    },
    {
      "text": "絡むナイトライド　勇む若人　",
      "romaji": "karamu naito raido isamu wakoudo"
    },
    {
      "text": "血糊の臨床　リノリウム",
      "romaji": "chinori no rinshou rinoriumu"
    },
    {
      "text": "君にとって　歪んだこの街は",
      "romaji": "kimi ni totte yuganda kono machi wa"
    },
    {
      "text": "狡さに還元される",
      "romaji": "zurusa ni kangen sareru"
    },
    {
      "text": "期待なんてないんだ　荒んだ航路",
      "romaji": "kitai nante nain da susanda kouro"
    },
    {
      "text": "言い訳ばっかり　上手くなる",
      "romaji": "iiwake bakkari umaku naru"
    },
    {
      "text": "鈍感な愛の戦争で",
      "romaji": "donkan na ai no sensou de"
    },
    {
      "text": "毎日、報復しよう。",
      "romaji": "mainichi, houfuku shiyou."
    },
    {
      "text": "何度殴って　殺気立って",
      "romaji": "nando nagutte sakkidatte"
    },
    {
      "text": "「君の正義はなんなの？」って",
      "romaji": "\"kimi no seigi wa nannano?\" tte"
    },
    {
      "text": "声枯らし　吠えてみな",
      "romaji": "koekarashi hoetemina"
    },
    {
      "text": "全部殴って　忘れたって",
      "romaji": "zenbu nagutte wasuretatte"
    },
    {
      "text": "代わりに傷が覚えてるから",
      "romaji": "kawari ni kizu ga oboeteru kara"
    },
    {
      "text": "真っ直ぐ届くだろう",
      "romaji": "massugu todoku darou"
    },
    {
      "text": "寝そべる屋上　",
      "romaji": "nesoberu okujou"
    },
    {
      "text": "涙を拭って隠した",
      "romaji": "namida o nugutte kakushita"
    },
    {
      "text": "素直になれないまま",
      "romaji": "sunao ni narenai mama"
    },
    {
      "text": "誠実なまま",
      "romaji": "seijitsu na mama"
    },
    {
      "text": "誰かと笑っていたい",
      "romaji": "dareka to waratte itai"
    },
    {
      "text": "明日も　明後日も。",
      "romaji": "ashita mo asatte mo."
    },
    {
      "text": "何度殴られ倒れても",
      "romaji": "nando mo nagurare taorete mo"
    },
    {
      "text": "僕は朝日が見たい",
      "romaji": "boku wa asahi ga mitai"
    },
    {
      "text": "自分で背負うから",
      "romaji": "jibun de seou kara"
    },
    {
      "text": "君の未来は汚させない！",
      "romaji": "kimi no mirai wa yogosasenai!"
    }
  ]
}
