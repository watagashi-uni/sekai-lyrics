  "lines": [
    {
      "text": "ハロー、ハロー",
      "romaji": "haroo, haroo"
    },
    {
      "text": "日が昇っている",
      "romaji": "hi ga nobotteiru"
    },
    {
      "text": "どこ、どこ",
      "romaji": "doko, doko"
    },
    {
      "text": "日の光を探している",
      "romaji": "hi no hikari o sagashiteiru"
    },
    {
      "text": "幸せを探している",
      "romaji": "shiawase o sagashiteiru"
    },
    {
      "text": "幸せってなんだろう",
      "romaji": "shiawase tte nan darou"
    },
    {
      "text": "お金があること？",
      "romaji": "okane ga aru koto?"
    },
    {
      "text": "大切な人がいること？",
      "romaji": "taisetsu na hito ga iru koto?"
    },
    {
      "text": "道を逸れてしまって",
      "romaji": "michi o sorete shimatte"
    },
    {
      "text": "自由を手に入れて",
      "romaji": "jiyuu o te ni irete"
    },
    {
      "text": "歩けなくなって",
      "romaji": "arukenakunatte"
    },
    {
      "text": "大切な人はいるけど",
      "romaji": "taisetsu na hito wa iru kedo"
    },
    {
      "text": "僕が駄目みたいで",
      "romaji": "boku ga dame mitaide"
    },
    {
      "text": "お金が足りなくて",
      "romaji": "okane ga tarinakute"
    },
    {
      "text": "どうすればいい？",
      "romaji": "dou sureba ii?"
    }
  ]
}
