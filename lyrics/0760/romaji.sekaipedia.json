  "lines": [
    {
      "text": "聴こえるよ！",
      "romaji": "kikoeru yo!"
    },
    {
      "text": "君の声が今じゃもう",
      "romaji": "kimi no koe ga ima ja mou"
    },
    {
      "text": "呪いに変わっちゃった……？",
      "romaji": "noroi ni kawachatta...?"
    },
    {
      "text": "なんもかんもやってらんないな",
      "romaji": "nan mo kan mo yatte ran nai na"
    },
    {
      "text": "期待など辞退したいのだ",
      "romaji": "kitai nado jitai shitai no da"
    },
    {
      "text": "だって何ひとつ応えられない",
      "romaji": "datte nani hitotsu kotaerarenai"
    },
    {
      "text": "心臓が毒々うるさいな",
      "romaji": "shinzou ga dokudoku urusai na"
    },
    {
      "text": "黙ってくれたっていいのにな",
      "romaji": "damatte kuretatte iinoni na"
    },
    {
      "text": "這いつくばってくたばって",
      "romaji": "haitsuku batte kutabatte"
    },
    {
      "text": "消え去ってしまいたいな",
      "romaji": "kiesatte shimaitai na"
    },
    {
      "text": "それでも　ひとりじゃないさ",
      "romaji": "soredemo hitori janai sa"
    },
    {
      "text": "差し伸べてくれた手を掴んで",
      "romaji": "sashinobete kureta te o tsukande"
    },
    {
      "text": "今までだって ",
      "romaji": "ima made datte"
    },
    {
      "text": "何度だって",
      "romaji": "nando datte"
    },
    {
      "text": "立ち上がってここまで来た",
      "romaji": "tachiagatte koko made kita"
    },
    {
      "text": "な～～～～～～んちって！",
      "romaji": "na~~~~~~nchatte!"
    },
    {
      "text": "心を蝕むバグが",
      "romaji": "kokoro o mushibamu bagu ga"
    },
    {
      "text": "大きく大きく育っちゃった!",
      "romaji": "ookiku ookiku sodacchatta!"
    },
    {
      "text": "踏み外しちゃったたった一歩が",
      "romaji": "fumi hazushichatta tatta ippo ga"
    },
    {
      "text": "消せずに枕に埋まってバタバタ",
      "romaji": "kesezu ni makura ni umatte batabata"
    },
    {
      "text": "恥じらいに塗れて",
      "romaji": "hajirai ni mamirete"
    },
    {
      "text": "もうこりごりだよって泣いて",
      "romaji": "mou korigori da yo tte naite"
    },
    {
      "text": "情けない顔も",
      "romaji": "nasakenai kao mo"
    },
    {
      "text": "僕だ",
      "romaji": "boku da"
    },
    {
      "text": "換えはきくかもしれない",
      "romaji": "kae wa kiku kamoshirenai"
    },
    {
      "text": "でもここにしかいない",
      "romaji": "demo koko ni shikai nai"
    },
    {
      "text": "それならさ",
      "romaji": "sore nara sa"
    },
    {
      "text": "それならば！",
      "romaji": "sore naraba!"
    },
    {
      "text": "すべて抱き締めていこうぜ",
      "romaji": "subete dakishimete ikou ze"
    },
    {
      "text": "希望も絶望も",
      "romaji": "kibou mo zetsubou mo"
    },
    {
      "text": "汚れたままで笑え！",
      "romaji": "yogoreta mama de warae!"
    },
    {
      "text": "はじめまして",
      "romaji": "hajimemashite"
    },
    {
      "text": "オールイン・ワンだ！",
      "romaji": "ooru in wan da!"
    },
    {
      "text": "神様には似てないね",
      "romaji": "kamisama ni wa nite nai ne"
    },
    {
      "text": "傷ついた心",
      "romaji": "kizutsuita kokoro"
    },
    {
      "text": "余計なものも乗せて",
      "romaji": "yokei na mono mo nosete"
    },
    {
      "text": "全ベットでいけ",
      "romaji": "zen betto de ike"
    }
  ]
}
