  "lines": [
    {
      "text": "考える",
      "romaji": "kangaeru"
    },
    {
      "text": "このままいつまで",
      "romaji": "kono mama itsu made"
    },
    {
      "text": "隠しておけるかな",
      "romaji": "kakushite okeru kana"
    },
    {
      "text": "帰りたくなった時",
      "romaji": "kaeritaku natta toki"
    },
    {
      "text": "さよならは言えるかな",
      "romaji": "sayonara wa ieru kana"
    },
    {
      "text": "見落としたあの日のサインが",
      "romaji": "miotoshita ano hi no sain ga"
    },
    {
      "text": "少しずつ溶けても",
      "romaji": "sukoshizutsu tokete mo"
    },
    {
      "text": "きっと大丈夫だよ",
      "romaji": "kitto daijoubu da yo"
    },
    {
      "text": "こうやって僕らまた逢えるから",
      "romaji": "kou yatte bokura mata aeru kara"
    },
    {
      "text": "目を閉じる",
      "romaji": "me o tojiru"
    },
    {
      "text": "小さな祈りは",
      "romaji": "chiisana inori wa"
    },
    {
      "text": "まだ残せるかな",
      "romaji": "mada nokoseru kana"
    },
    {
      "text": "光が戻ったとき",
      "romaji": "hikari ga modotta toki"
    },
    {
      "text": "ただいまは言えるかな",
      "romaji": "tada ima wa ieru kana"
    },
    {
      "text": "行かなくちゃ",
      "romaji": "ikanakucha"
    },
    {
      "text": "世界で一番　綺麗なものなら",
      "romaji": "sekai de ichiban kireina mono nara"
    },
    {
      "text": "今まで奪われてた分は",
      "romaji": "ima made ubawarete tabun wa"
    },
    {
      "text": "取り戻すまでさ！",
      "romaji": "torimodosu made sa!"
    },
    {
      "text": "もっと",
      "romaji": "motto"
    },
    {
      "text": "クラクラクラ　クラクラさせてよ",
      "romaji": "kurakurakura kurakura sasete yo"
    },
    {
      "text": "ユラユラユラ　ゆらぎを見せてよ",
      "romaji": "yurayurayura yuragi o misete yo"
    },
    {
      "text": "キラキラキラ　きらめいていてよ",
      "romaji": "kirakirakira kirameite ite yo"
    },
    {
      "text": "そっと",
      "romaji": "sotto"
    },
    {
      "text": "傷ついた夜を呼び出してみる",
      "romaji": "kizutsuita yoru o yobidashite miru"
    },
    {
      "text": "ささやかな魔法をひとつかける",
      "romaji": "sasayakana mahou o hitotsu kakeru"
    },
    {
      "text": "それだけで僕らは飛べるのさ！",
      "romaji": "sore dake de bokura wa toberu no sa!"
    },
    {
      "text": "離さないでよ！　眼差しを",
      "romaji": "hanasanaide yo! manazashi o"
    },
    {
      "text": "僕達はもう　止まらないよ",
      "romaji": "bokutachi wa mou tomaranai yo"
    },
    {
      "text": "魔法が解ける　それまで",
      "romaji": "mahou ga tokeru sore made"
    },
    {
      "text": "繋いでいてよ　手を",
      "romaji": "tsunaide ite yo te o"
    },
    {
      "text": "手を！",
      "romaji": "te o!"
    }
  ]
}
