  "lines": [
    {
      "text": "この地図の言う通り",
      "romaji": "kono chizu no iu toori"
    },
    {
      "text": "北へ向かっていこう",
      "romaji": "kita e mukatte ikou"
    },
    {
      "text": "大昔の知恵が紐づいた",
      "romaji": "oomukashi no chie ga himozuita"
    },
    {
      "text": "あぁ、地球規模で見れば",
      "romaji": "aa, chikyuukibo de mireba"
    },
    {
      "text": "ちっぽけなのに",
      "romaji": "chippoke na no ni"
    },
    {
      "text": "見つからないものが",
      "romaji": "mitsukaranai mono ga"
    },
    {
      "text": "ずっと眠っていた",
      "romaji": "zutto nemutte ita"
    },
    {
      "text": "誰かに誘われて",
      "romaji": "dareka ni izanawarete"
    },
    {
      "text": "迷い込んだ洞窟を",
      "romaji": "mayoikonda doukutsu o"
    },
    {
      "text": "エクスプロウル",
      "romaji": "ekusupurouru"
    },
    {
      "text": "探し出せ埋もれている筈の",
      "romaji": "sagashidase umorete iru hazu no"
    },
    {
      "text": "宝物の在り処を",
      "romaji": "takaramono no arika o"
    },
    {
      "text": "それは途切れた音を紡ぐ歌姫",
      "romaji": "sore wa togireta oto o tsumugu utahime"
    },
    {
      "text": "壊れかけのメロディーライン",
      "romaji": "kowarekake no merodii rain"
    },
    {
      "text": "空っぽのハーモニー",
      "romaji": "karappo no haamonii"
    },
    {
      "text": "隠れてるのはなぁになぁに",
      "romaji": "kakureteru no wa naani naani"
    }
  ]
}
