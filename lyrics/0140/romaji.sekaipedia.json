  "lines": [
    {
      "text": "いつから満たされない",
      "romaji": "itsukara mitasarenai"
    },
    {
      "text": "こんな日々だから傷ついて",
      "romaji": "konna hibi dakara kizutsuite"
    },
    {
      "text": "すぐに踏み出せない",
      "romaji": "sugu ni fumi dasenai"
    },
    {
      "text": "正体が見えないまま",
      "romaji": "shoutai ga mienai mama"
    },
    {
      "text": "いつかの思い出も",
      "romaji": "itsuka no omoi demo"
    },
    {
      "text": "たかが1000年の物語",
      "romaji": "taka ga sennen no monogatari"
    },
    {
      "text": "深く呼吸して",
      "romaji": "fukaku kokyuu shite"
    },
    {
      "text": "深海に落ちていくの",
      "romaji": "shinkai ni ochiteiku no"
    },
    {
      "text": "曖昧だったシーズンが去って",
      "romaji": "aimai datta shiizun ga satte"
    },
    {
      "text": "僕のとなり",
      "romaji": "boku no tonari"
    },
    {
      "text": "望遠鏡で見せた",
      "romaji": "bouenkyou de miseta"
    },
    {
      "text": "景色見に行かなくちゃ",
      "romaji": "keshiki mi ni ikanakucha"
    },
    {
      "text": "uh-　その声が心ごと潤して",
      "romaji": "uh- sono koe ga kokoro goto uruoshite"
    },
    {
      "text": "絡まりあって惹かれ合って",
      "romaji": "karamari atte hikare atte"
    },
    {
      "text": "また変わらず愛を唄う",
      "romaji": "mata kawarazu ai o utau"
    },
    {
      "text": "you　きみの手を離さないルールとして",
      "romaji": "you kimi no te o hanasanai ruuru toshite"
    },
    {
      "text": "サビついた最後のページを",
      "romaji": "sabitsuita saigo no peeji o"
    },
    {
      "text": "溶かすためのハート",
      "romaji": "tokasu tame no haato"
    },
    {
      "text": "このセカイを回す　唯一の魔法",
      "romaji": "kono sekai o mawasu yuiitsu no mahou"
    }
  ]
}
