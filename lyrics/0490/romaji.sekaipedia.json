  "lines": [
    {
      "text": "だいぶ夢中だね ",
      "romaji": "daibu muchuu da ne"
    },
    {
      "text": "笑えもしない ",
      "romaji": "warae mo shinai"
    },
    {
      "text": "この忌々しさ引き取って頂戴",
      "romaji": "kono imaimashisa hikitotte choudai"
    },
    {
      "text": "そう問題なのは ",
      "romaji": "sou mondai na no wa"
    },
    {
      "text": "魔法みたいにさ ",
      "romaji": "mahou mitai ni sa"
    },
    {
      "text": "リセットされるのが早過ぎる",
      "romaji": "risetto sareru no ga hayasugiru"
    },
    {
      "text": "霞が未だかかってるの",
      "romaji": "kasumi ga imada kakatteru no"
    },
    {
      "text": "それこそメンタルやられるよ",
      "romaji": "sore koso mentaru yarareru yo"
    },
    {
      "text": "ぶら下って切り抜けるなんてどう ",
      "romaji": "burasagatte kirinukeru nante dou"
    },
    {
      "text": "嫌いになれない止めたいよ本当",
      "romaji": "kirai ni narenai yametai yo hontou"
    },
    {
      "text": "どうにも手に負えない...認めるよ",
      "romaji": "dounimo te ni oenai... mitomeru yo"
    },
    {
      "text": "歯痒くなるよ",
      "romaji": "hagayuku naru yo"
    },
    {
      "text": "思惑通りの振る舞いも ",
      "romaji": "omowakudoori no furumai mo"
    },
    {
      "text": "すこぶるクールな your mind",
      "romaji": "sukoburu kuuru na your mind"
    },
    {
      "text": "最高潮のtouch 跳ね上がる heartbeat",
      "romaji": "saikouchou no touch haneagaru heartbeat"
    },
    {
      "text": "溺れてしまう 戻れないくらい",
      "romaji": "oborete shimau modorenai kurai"
    },
    {
      "text": "踏み入れて廻るのさ satellite",
      "romaji": "fumiirete mawaru no sa satellite"
    },
    {
      "text": "始めから分かってる",
      "romaji": "hajime kara wakatteru"
    },
    {
      "text": "隙間を埋めるほど ",
      "romaji": "sukima o umeru hodo"
    },
    {
      "text": "導かれるのさ I'm greedy",
      "romaji": "michibikareru no sa I'm greedy"
    },
    {
      "text": "ほらあの呪いも悪くないだろなんて",
      "romaji": "hora ano majinai mo waruku nai daro nante"
    },
    {
      "text": "丸ごと何処か他所へやって",
      "romaji": "marugoto dokoka yoso e yatte"
    },
    {
      "text": "新しい期待で満たす",
      "romaji": "atarashii kitai de mitasu"
    },
    {
      "text": "いつだって執拗だから",
      "romaji": "itsu datte shitsuyou dakara"
    }
  ]
}
