  "lines": [
    {
      "text": "もっともっとみんなにまで (to you)",
      "romaji": "motto motto minna ni made (to you)"
    },
    {
      "text": "もっともっと届くように",
      "romaji": "motto motto todoku you ni"
    },
    {
      "text": "いいじゃん!!!",
      "romaji": "iijan!!!"
    },
    {
      "text": "これって以上最大級の",
      "romaji": "korette ijou saidai kyuu no"
    },
    {
      "text": "ピンチだって思うじゃん",
      "romaji": "pinchi datte omoujan"
    },
    {
      "text": "それって言わばチャンスでしょ",
      "romaji": "sorette iwaba chansu desho"
    },
    {
      "text": "そうじゃん!!!",
      "romaji": "soujan!!!"
    },
    {
      "text": "転んでまた散々だって",
      "romaji": "koronde mata sanzan datte"
    },
    {
      "text": "いつもだってそうじゃん",
      "romaji": "itsumo datte soujan"
    },
    {
      "text": "Stand Up お茶の子さいさいでしょ",
      "romaji": "Stand Up ochanokosaisai desho"
    },
    {
      "text": "ハイタッチ!!!",
      "romaji": "haitacchi!!!"
    },
    {
      "text": "みんなすごい",
      "romaji": "minna sugoi"
    },
    {
      "text": "圧倒的な魅力ぱっかまって",
      "romaji": "attoutekina miryoku pakkamatte"
    },
    {
      "text": "自分はとか思っちゃうよね",
      "romaji": "jibun wa toka omacchau yo ne"
    },
    {
      "text": "夢中になれば",
      "romaji": "muchuu ni nareba"
    },
    {
      "text": "全然考えないくらいになって",
      "romaji": "zenzen kangaenai kurai ni natte"
    },
    {
      "text": "きっと自分に気付けるから",
      "romaji": "kitto jibun ni kizukeru kara"
    },
    {
      "text": "いつまでだって思いは変わらないって",
      "romaji": "itsumo datte omoi wa kawaranaitte"
    },
    {
      "text": "いつでもキュンってしたい Keep on LOVE",
      "romaji": "itsudemo kyuntte shitai Keep on LOVE"
    },
    {
      "text": "響くよもっと輝き増してくもっと",
      "romaji": "hibiku yo motto kagayaki mashite ku motto"
    },
    {
      "text": "笑顔をもっと起こせ そう MOTTO!!!",
      "romaji": "egao wo motto okose sou MOTTO!!!"
    },
    {
      "text": "一歩一歩進んで行こう (ハイ!)",
      "romaji": "ippoippo susunde ikou (hai!)"
    },
    {
      "text": "何度だって失敗しよう (ハイ!)",
      "romaji": "nando datte shippai shiyou (hai!)"
    },
    {
      "text": "未来 (OK) 前進 (All right)",
      "romaji": "mirai (OK) zenshin (All right)"
    },
    {
      "text": "出来るってなんだって",
      "romaji": "dekirutte nandatte"
    },
    {
      "text": "もっともっとみんなにまで (ハイ!)",
      "romaji": "motto motto minna ni made (hai!)"
    },
    {
      "text": "もっともっと届くように (ハイ!)",
      "romaji": "motto motto todoku you ni (hai!)"
    },
    {
      "text": "More Jump (もっと)",
      "romaji": "More Jump (motto)"
    },
    {
      "text": "進むべき未来",
      "romaji": "susumubeki mirai"
    },
    {
      "text": "心の声、指す方へ",
      "romaji": "kokoro no koe, sasu hou e"
    },
    {
      "text": "進むの",
      "romaji": "susume no"
    }
  ]
}
