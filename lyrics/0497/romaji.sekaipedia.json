  "lines": [
    {
      "text": "眠れない夜を駆け抜けて",
      "romaji": "nemurenai yoru o kakenukete"
    },
    {
      "text": "痛みさえ試されてく",
      "romaji": "itami sae tamesareteku"
    },
    {
      "text": "強がりじゃ何も保てない",
      "romaji": "tsuyogari ja nani mo tamotenai"
    },
    {
      "text": "曖昧な心捨てて",
      "romaji": "aimai na kokoro sutete"
    },
    {
      "text": "揺るぎないもの　何度も信じた",
      "romaji": "yuruginai mono nando mo shinjita"
    },
    {
      "text": "静寂と情熱を心に秘めた",
      "romaji": "seijaku to jounetsu o kokoro ni himeta"
    },
    {
      "text": "照らしてしまう感情もっと　僕の太陽",
      "romaji": "terashite shimau kanjou motto boku no taiyou"
    },
    {
      "text": "世界は未来を映せない",
      "romaji": "sekai wa mirai o utsusenai"
    },
    {
      "text": "聞かせてよ　想いを噓のない感情で",
      "romaji": "kikasete yo omoi o uso no nai kanjou de"
    },
    {
      "text": "その目に焼き付けて",
      "romaji": "sono me ni yakitsukete"
    },
    {
      "text": "(Oh oh oh oh-oh)　止まらないから",
      "romaji": "(Oh oh oh oh-oh) tomaranai kara"
    },
    {
      "text": "(Oh oh oh oh-oh)　忘れないで",
      "romaji": "(Oh oh oh oh-oh) wasurenaide"
    },
    {
      "text": "願いは今でも譲れない",
      "romaji": "negai wa ima demo yuzurenai"
    },
    {
      "text": "熱い心　火をつけて",
      "romaji": "atsui kokoro hi o tsukete"
    },
    {
      "text": "照らしてしまうアンモーメント　夜の太陽",
      "romaji": "terashite shimau anmoomento yoru no taiyou"
    },
    {
      "text": "照らしてしまう",
      "romaji": "terashite shimau"
    },
    {
      "text": "焦がれてしまう",
      "romaji": "kogarete shimau"
    }
  ]
}
