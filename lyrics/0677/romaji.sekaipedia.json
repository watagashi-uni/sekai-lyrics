  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "キミがもう",
      "romaji": "kimi ga mou"
    },
    {
      "text": "忘れてしまった歌を",
      "romaji": "wasurete shimatta uta o"
    },
    {
      "text": "思い出させてあげる",
      "romaji": "omoidasasete ageru."
    },
    {
      "text": "終わらないよ",
      "romaji": "owaranai yo,"
    },
    {
      "text": "覚えていてくれるなら",
      "romaji": "oboete ite kureru nara"
    },
    {
      "text": "だから もういいかい",
      "romaji": "dakara, mou ii kai"
    },
    {
      "text": "描いてみせてあげる",
      "romaji": "egaite misete ageru."
    },
    {
      "text": "輝いた記憶が",
      "romaji": "kagayaita kioku ga"
    },
    {
      "text": "呪いになってしまわぬように",
      "romaji": "noroi ni natte shimawanu you ni"
    },
    {
      "text": "キミのあの時",
      "romaji": "kimi no ano toki"
    },
    {
      "text": "傷ついた心に",
      "romaji": "kizutsuita kokoro ni"
    },
    {
      "text": "水を注いであげる",
      "romaji": "mizu o sosoide ageru."
    },
    {
      "text": "足元に咲いた花を見て",
      "romaji": "ashimoto ni saita hana o mite!"
    },
    {
      "text": "笑えなくなるくらいなら",
      "romaji": "waraenaku naru kurai nara"
    },
    {
      "text": "キミが掬えなかった涙も",
      "romaji": "kimi ga sukuenakatta namida mo"
    },
    {
      "text": "流れ星になるの",
      "romaji": "nagareboshi ni naru no."
    },
    {
      "text": "キミが描いてくれた翼で",
      "romaji": "kimi ga egaite kureta tsubasa de"
    },
    {
      "text": "羽ばたいていけるから",
      "romaji": "habataite ikeru kara!"
    },
    {
      "text": "こんな日でも笑ってみせるから",
      "romaji": "konna hi demo waratte miseru kara"
    },
    {
      "text": "こんな日でも歌うから",
      "romaji": "konna hi demo utau kara"
    },
    {
      "text": "これでいいよって",
      "romaji": "kore de ii yo tte"
    },
    {
      "text": "そんなミライを望んでいれるから",
      "romaji": "sonna mirai o nozonde ireru kara."
    },
    {
      "text": "\"もう一度\"がまだ信じられる",
      "romaji": "\"mou ichido\" ga mada shinjirareru"
    },
    {
      "text": "\"もう一回\"が届いている",
      "romaji": "\"mou ikkai\" ga todoite iru"
    },
    {
      "text": "大丈夫",
      "romaji": "daijoubu!"
    },
    {
      "text": "キミが覚えていてくれるなら",
      "romaji": "kimi ga oboete ite kureru nara."
    },
    {
      "text": "\"もう一度\"",
      "romaji": "\"mou ichido!\""
    },
    {
      "text": "をまた歌うから",
      "romaji": "o mata utau kara"
    },
    {
      "text": "\"もう一回\"が響くなら",
      "romaji": "\"mou ikkai\" ga hibiku nara"
    },
    {
      "text": "キミが連れてきてくれたセカイで",
      "romaji": "kimi ga tsurete kite kureta sekai de"
    },
    {
      "text": "笑っていれるから",
      "romaji": "waratte ireru kara!"
    },
    {
      "text": "大丈夫 をまだ信じられるなら",
      "romaji": "daijoubu, o mata shinjirareru nara"
    },
    {
      "text": "大丈夫 がまだ響くなら",
      "romaji": "daijoubu, ga mada hibiku nara"
    },
    {
      "text": "終わらせないよ",
      "romaji": "owarasenai yo!"
    },
    {
      "text": "そんなミライで待っていれるから",
      "romaji": "sonna mirai de matte ireru kara."
    }
  ]
}
