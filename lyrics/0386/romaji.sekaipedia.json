  "lines": [
    {
      "text": "答えなんてないわ",
      "romaji": "kotae nante naiwa"
    },
    {
      "text": "描くのあなただけの",
      "romaji": "egaku no anata dake no"
    },
    {
      "text": "私だけの",
      "romaji": "watashi dake no"
    },
    {
      "text": "えーっとわーって遊んでほてーって",
      "romaji": "eetto waatte asonde hoteette"
    },
    {
      "text": "食べたららららーって歌いたい！",
      "romaji": "tabetara rararaa tte utaitai!"
    },
    {
      "text": "その心で 心で！",
      "romaji": "sono kokoro de kokoro de!"
    },
    {
      "text": "私ならこうする",
      "romaji": "watashi nara kou suru"
    },
    {
      "text": "雨が降った日には",
      "romaji": "ame ga futta hi ni wa"
    },
    {
      "text": "抜けるような青い 傘をさして",
      "romaji": "nukeru youna aoi kasa o sashite"
    },
    {
      "text": "夏の空にするわ",
      "romaji": "natsu no sora ni sura wa"
    },
    {
      "text": "寒い夜は りんごタルト",
      "romaji": "samui yoru wa ringo taruto"
    },
    {
      "text": "夕焼けほおばったみたいに",
      "romaji": "yuuyake haobatta mitai ni"
    },
    {
      "text": "笑うの",
      "romaji": "warau no"
    },
    {
      "text": "発車ヨーッ (発声ヨーシ)",
      "romaji": "hassha yoshi! (hassei yoshi!)"
    },
    {
      "text": "ヨーソロー！(ヨーソロー！)",
      "romaji": "yoosoroo! (yoosoroo!)"
    },
    {
      "text": "さあ何を描く？『待ってよ～』",
      "romaji": "saa nani o egaku? \"matte yo~\""
    },
    {
      "text": "「けど」 「まだ」 「どうせ」 「なのに」",
      "romaji": "\"kedo\" \"mada\" \"douse\" \"nano ni\""
    },
    {
      "text": "「でも」 「ただ」 「もしも」 「だって」",
      "romaji": "\"demo\" \"tada\" \"moshimo\" \"datte\""
    },
    {
      "text": "アイスのフレーバーではないの",
      "romaji": "aisu no fureebaa de wa nai no"
    },
    {
      "text": "迷ったら『コツはひとつ』",
      "romaji": "mayottara kotsu wa hitosu"
    },
    {
      "text": "き・ら・ぴ・ぴ？",
      "romaji": "kira pi pi?"
    },
    {
      "text": "（チクタクチクタク……）",
      "romaji": "(chikutaku chikutaku......)"
    },
    {
      "text": "キラッと 光って",
      "romaji": "kiratto hikatte"
    },
    {
      "text": "ピピっと きちゃって",
      "romaji": "pipitto kichatte"
    },
    {
      "text": "バケツに乗ったクジラに乗って",
      "romaji": "baketsu ni notta kujira ni notte"
    },
    {
      "text": "いつでもどこでも笑顔を咲かせましょう",
      "romaji": "itsudemo dokodemo egao o sakasemashou"
    },
    {
      "text": "わんだほーい！",
      "romaji": "wandahooi!"
    },
    {
      "text": "いっせーの！キラピピ★（ピ！）キラピカ（カ！）",
      "romaji": "isseeno! kirapipi ★ (pi!) kirapika (ka!)"
    },
    {
      "text": "生まれたての おまじない",
      "romaji": "umaretate no omajinai"
    },
    {
      "text": "あなたが (私が) 描くなら (描くなら)",
      "romaji": "anata ga (watashi ga) egakunara (egakunara)"
    },
    {
      "text": "恋したって 夢見たって",
      "romaji": "koishitatte yume mitatte"
    },
    {
      "text": "転んだって 笑えたって",
      "romaji": "korondatte warattatte"
    },
    {
      "text": "答えなの全部 (全部) ",
      "romaji": "kotae nano zenbu (zenbu)"
    },
    {
      "text": "いつか わかるわ ",
      "romaji": "itsuka wakaru wa"
    },
    {
      "text": "その日まで こうやって",
      "romaji": "sono hi made kouyatte"
    },
    {
      "text": "Sha La La! さあ 描きましょう",
      "romaji": "sha la la! saa egakimashou"
    },
    {
      "text": "キラピピ★キラピカ",
      "romaji": "kirapipi★kirapika"
    },
    {
      "text": "じゃかじゃん",
      "romaji": "jakajan"
    }
  ]
}
