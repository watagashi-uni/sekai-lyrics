  "lines": [
    {
      "text": "得意げに呟いた",
      "romaji": "tokuige ni tsubuyaita"
    },
    {
      "text": "心配ないからと",
      "romaji": "shinpai nai kara to"
    },
    {
      "text": "人の少ないホームで",
      "romaji": "hito no sukunai hoomu de"
    },
    {
      "text": "ヘタクソに強がった",
      "romaji": "hetakuso ni tsuyogatta"
    },
    {
      "text": "唐突に鳴り響く",
      "romaji": "toutotsu ni narihibiku"
    },
    {
      "text": "僕を呼ぶ別れの音",
      "romaji": "boku o yobu wakare no oto"
    },
    {
      "text": "見慣れたその泣き顔も",
      "romaji": "minareta sono nakigao mo"
    },
    {
      "text": "しばらくは見れないね",
      "romaji": "shibaraku wa mirenai ne"
    },
    {
      "text": "ah 声が遮られていく",
      "romaji": "ah koe ga saegirarete iku"
    },
    {
      "text": "身振り手振りで伝える",
      "romaji": "miburiteburi de tsutaeru"
    },
    {
      "text": "「いってらっしゃい」のサイン",
      "romaji": "\"itterasshai\" no sain"
    },
    {
      "text": "少しずつ小さくなってく",
      "romaji": "sukoshi zutsu chiisaku natteku"
    },
    {
      "text": "全部置いたまま",
      "romaji": "zenbu oita mama"
    },
    {
      "text": "悲しくなんかないさと",
      "romaji": "kanashiku nanka nai sa to"
    },
    {
      "text": "イヤホンで閉じ込めたよ",
      "romaji": "iyahon de tojikometa yo"
    }
  ]
}
