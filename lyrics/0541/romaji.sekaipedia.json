  "lines": [
    {
      "text": "それから僕たちは肩を組んで",
      "romaji": "sore kara bokutachi wa kata o kunde"
    },
    {
      "text": "何となく確かに",
      "romaji": "nantonaku, tashika ni"
    },
    {
      "text": "巫山戯て真剣に思っていた",
      "romaji": "fuzakete, shinken ni omotteta"
    },
    {
      "text": "博打だどうせ外れだよ",
      "romaji": "bakuchi da, douse hazure da yo"
    },
    {
      "text": "現実は甘くないんだって",
      "romaji": "genjitsu wa amakunain da tte"
    },
    {
      "text": "そんなこと言われなくたって",
      "romaji": "sonna koto iwarenakutatte"
    },
    {
      "text": "知ってるよだって今だって",
      "romaji": "shitteru yo datte ima datte"
    },
    {
      "text": "不安で泣き出しそうになる",
      "romaji": "fuan de nakidashisou ni naru"
    },
    {
      "text": "君と同じように",
      "romaji": "kimi to onaji youni"
    },
    {
      "text": "忠告はたくさんあった",
      "romaji": "chuukoku wa takusan atta"
    },
    {
      "text": "でもこれを選び取ったんだ",
      "romaji": "demo kore o erabitottan da"
    },
    {
      "text": "正しいと証明するんだ",
      "romaji": "tadashii to shoumei sun da"
    },
    {
      "text": "この物語の主人公だって",
      "romaji": "kono monogatari no shujinkou da tte"
    },
    {
      "text": "信じ続ければ真実に",
      "romaji": "shinjitsuzukereba shinjitsu ni"
    },
    {
      "text": "実現するんだ現実に",
      "romaji": "jitsugen surun da genjitsu ni"
    },
    {
      "text": "もう戻れないんだから",
      "romaji": "mou modorenain dakara"
    },
    {
      "text": "君が立つ場所はきっと",
      "romaji": "kimi ga tatsu basho wa kitto"
    },
    {
      "text": "僕が諦めた未来で",
      "romaji": "boku ga akirameta mirai de"
    },
    {
      "text": "選んだものが違うから",
      "romaji": "eranda mono ga chigau kara"
    },
    {
      "text": "分かり合えないこともあるけど",
      "romaji": "wakariaenai koto mo aru kedo"
    },
    {
      "text": "諦めたやつが口を出して",
      "romaji": "akirameta yatsu ga kuchi o dashite"
    },
    {
      "text": "指差して笑うなんて",
      "romaji": "yubisashite warau nante"
    },
    {
      "text": "おかしいだろ？",
      "romaji": "okashii daro?"
    },
    {
      "text": "嫌いだ僕は",
      "romaji": "kirai da, boku wa"
    }
  ]
}
