  "lines": [
    {
      "text": "科学の限界を超えて",
      "romaji": "kagaku no genkai o koete"
    },
    {
      "text": "私は来たんだよ",
      "romaji": "watashi wa kitan da yo"
    },
    {
      "text": "ネギはついてないけど/",
      "romaji": "negi wa tsuite nai kedo"
    },
    {
      "text": "出来れば欲しいな",
      "romaji": "dekireba hoshii na"
    },
    {
      "text": "歌はまだね頑張るから",
      "romaji": "uta wa mada ne, ganbaru kara"
    },
    {
      "text": "だからちょっと覚悟をしててよね",
      "romaji": "dakara chotto kakugo o shitete yo ne"
    },
    {
      "text": "してあげるから",
      "romaji": "\"shite ageru kara\""
    },
    {
      "text": "みくみくにしてやんよ",
      "romaji": "miku miku ni shite yan yo♪"
    },
    {
      "text": "だからちょっと油断をしてあげて",
      "romaji": "dakara chotto yudan o shite agete"
    },
    {
      "text": "世界中の誰誰より",
      "romaji": "sekaijuu no dare, dare yori"
    }
  ]
}
