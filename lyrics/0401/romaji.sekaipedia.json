  "lines": [
    {
      "text": "きっとキミは狂ってんだ",
      "romaji": "kitto kimi wa kurutte nda"
    },
    {
      "text": "誰もがそう思うでしょう",
      "romaji": "dare mo ga sou omou deshou"
    },
    {
      "text": "でもこれが僕の描く理想の歌",
      "romaji": "demo kore ga boku no egaku risou no uta"
    },
    {
      "text": "そのまま何も言わないで",
      "romaji": "sono mama nani mo iwanaide"
    },
    {
      "text": "『なんでキミは狂ってんだ？",
      "romaji": "“nande kimi wa kurutte nda?"
    },
    {
      "text": "今も震えてるんでしょう？",
      "romaji": "ima mo furueteru ndeshou?"
    },
    {
      "text": "折れた白菊",
      "romaji": "oreta shiragiku"
    },
    {
      "text": "何回キミが描いてみたって",
      "romaji": "nankai kimi ga egaite mita tte"
    },
    {
      "text": "もう到底意味は無いよ？』",
      "romaji": "mou toutei imi wa nai yo?”"
    },
    {
      "text": "肯定",
      "romaji": "koutei"
    },
    {
      "text": "きっと君は居なくなって",
      "romaji": "kitto kimi wa inaku natte"
    },
    {
      "text": "滝の音が絶えるから",
      "romaji": "taki no oto ga taeru kara"
    },
    {
      "text": "また委ねた未来",
      "romaji": "mata yudaneta mirai"
    },
    {
      "text": "彼岸で泣いて痛い",
      "romaji": "higan de naite itai"
    },
    {
      "text": "此の身を露も知らないで",
      "romaji": "kono mi o tsuyu mo shiranaide"
    },
    {
      "text": "そうさ僕は狂ってんだ",
      "romaji": "sou sa boku wa kurutte nda"
    },
    {
      "text": "燃ゆる思いは万華鏡",
      "romaji": "moyuru omoi wa mangekyou"
    },
    {
      "text": "月のまにまに",
      "romaji": "tsuki no manimani"
    },
    {
      "text": "震える手で描いていくんだ",
      "romaji": "furueru te de egaite iku nda"
    },
    {
      "text": "そう純然たる理想を",
      "romaji": "sou junzentaru risou o!"
    },
    {
      "text": "雷鳴",
      "romaji": "raimei"
    },
    {
      "text": "きっと僕が居なくたって",
      "romaji": "kitto boku ga inakutatte"
    },
    {
      "text": "貴女は只歌うけど",
      "romaji": "anata wa tada utau kedo"
    },
    {
      "text": "身も焦がれていたい",
      "romaji": "mi mo kogarete itai!"
    },
    {
      "text": "まだすがっていたい",
      "romaji": "mada sugatte itai!"
    }
  ]
}
