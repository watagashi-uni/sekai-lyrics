  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/Seibai_ItaAAAAAsu%21",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "いざ開幕！",
      "romaji": "iza kaimaku!"
    },
    {
      "text": "はっはっはっはっ",
      "romaji": "hahhahhahha"
    },
    {
      "text": "はっはっはっ",
      "romaji": "hahhahha"
    },
    {
      "text": "天誅！天誅！",
      "romaji": "tenchuu! tenchuu!"
    },
    {
      "text": "口上いくぞ！",
      "romaji": "koujou iku zo!"
    },
    {
      "text": "ひとつ ひたむきに",
      "romaji": "hitotsu hitamuki ni"
    },
    {
      "text": "ふたつ ふ？え...まって",
      "romaji": "futatsu fu? e... matte"
    },
    {
      "text": "みっつ あ！みたらしだんご　たべた〜い！",
      "romaji": "mittsu a! mitarashi dango tabeta~i!"
    },
    {
      "text": "おい まて",
      "romaji": "oi mate"
    },
    {
      "text": "よっつ いつつくださいな みたらし",
      "romaji": "yottsu itsutsu kudasai na mitarashi"
    },
    {
      "text": "まじめにやれ〜い",
      "romaji": "majime ni yare~i"
    },
    {
      "text": "はい はい はい は〜い",
      "romaji": "hai hai hai ha~i"
    },
    {
      "text": "花鳥風月　風林火山",
      "romaji": "kachoufuugetsu fuurinkazan"
    },
    {
      "text": "それだ〜！（おぉ〜）",
      "romaji": "sore da~! (oo~)"
    },
    {
      "text": "ドレッシング　パスタにハンバーグ",
      "romaji": "doresshingu pasuta ni hanbaagu"
    },
    {
      "text": "な、なんだと（わっふう～！）（うぅ～）（ふふっ）",
      "romaji": "na, nanda to (waffuu~!) (uu~) (fufu)"
    },
    {
      "text": "おなかすいた〜 拙者も〜",
      "romaji": "onaka suita~ sessha mo~"
    },
    {
      "text": "甘味処みっけ",
      "romaji": "kanmidokoro mikke"
    },
    {
      "text": "ほぉ〜うまそうだな...",
      "romaji": "hoo~ umasou da na..."
    },
    {
      "text": "じゃね〜わ！",
      "romaji": "jane~wa!"
    },
    {
      "text": "と、申されますと？",
      "romaji": "to, mousaremasu to?"
    },
    {
      "text": "モウサレマスト？",
      "romaji": "mousaremasu to?"
    },
    {
      "text": "...え？",
      "romaji": "...e?"
    },
    {
      "text": "こ～んこ～ん　こんがらって",
      "romaji": "ko~n ko~n kongaratte"
    },
    {
      "text": "こんがらがって候！",
      "romaji": "kongaragatte sourou!"
    },
    {
      "text": "ら～ん　ら～ん　お目目も乱痴気騒ぎ！（ぱっ）",
      "romaji": "ra~n ra~n omeme mo ranchikisawagi! (pa)"
    },
    {
      "text": "ちゃーんちゃーん",
      "romaji": "chaan chaan"
    },
    {
      "text": "ちゃんばらイズジャパニーズヒーロー",
      "romaji": "chanbara izu japaniizu hiiroo"
    },
    {
      "text": "くせものじゃ〜 何奴だ！",
      "romaji": "kuse mono ja~ nani yatsu da~"
    },
    {
      "text": "世直しじゃ～！",
      "romaji": "yonaoshi ja~!"
    },
    {
      "text": "少年少女の夢、一つ",
      "romaji": "shounen shoujo no yume, hitotsu"
    },
    {
      "text": "翔んで　笑って　唄って　誇れ！",
      "romaji": "tonde waratte utatte hokore!"
    },
    {
      "text": "世直しの音頭でおどりゃんせ",
      "romaji": "yonaoshi no ondo de odoryanse"
    },
    {
      "text": "不届きものちゃんはひかえおろ〜",
      "romaji": "futodokimono-chan wa hikaoro~"
    },
    {
      "text": "はっはぁ～",
      "romaji": "hahhaa~"
    },
    {
      "text": "泣けど笑えど　この世は情け　夢路は",
      "romaji": "nakedo waraedo kono yo wa nasake yumeji wa"
    },
    {
      "text": "みちづれじゃ～",
      "romaji": "michuzure ja~"
    },
    {
      "text": "はなびら舞う 舞う 想い焦がれて",
      "romaji": "hanabira mau mau omoi kogarete"
    },
    {
      "text": "夢の続きを",
      "romaji": "yume no tsuzuki o"
    },
    {
      "text": "僕らの願いを 守るため",
      "romaji": "bokura no negai o mamoru tame"
    },
    {
      "text": "邪魔者は成敗いたAAAAAす！",
      "romaji": "jamamono wa seibai itaAAAAAsu!"
    },
    {
      "text": "くるしゅうない　狂乱しちゃって",
      "romaji": "kurushuu nai kyouran shichatte"
    },
    {
      "text": "我らちょっと　和風に酔いしれちゃって",
      "romaji": "warera chotto wafuu ni yoishirechatte"
    },
    {
      "text": "簡単にいうとお腹いっぱい（ふ〜）",
      "romaji": "kantan ni iu to onaka ippai (fu~)"
    },
    {
      "text": "まさに天下泰平　この世は極楽浄土",
      "romaji": "masa ni tenka taihei kono yo wa gokurakujoudo"
    },
    {
      "text": "お　お　お　おどらにゃ（Hey yo ちぇき）",
      "romaji": "o o o odoranya (Hey yo cheki)"
    },
    {
      "text": "そーんそーん",
      "romaji": "soon soon"
    },
    {
      "text": "そうなの？",
      "romaji": "sou nano?"
    },
    {
      "text": "...わからんっ！",
      "romaji": "...wakaran!"
    },
    {
      "text": "翔んで　笑って　唄って（よ〜）誇れ！",
      "romaji": "tonde waratte utatte (yo~) hokore!"
    },
    {
      "text": "なにがしそれがしの大団円",
      "romaji": "nanigashi soregashi no daidanen"
    },
    {
      "text": "手を取り合わなくば",
      "romaji": "te o toriawanakuba"
    },
    {
      "text": "お仕置きじゃ（ははぁ～）",
      "romaji": "oshioki ja (hahaa~)"
    },
    {
      "text": "邪魔者は成敗いたAAAAAAす！",
      "romaji": "jamamono wa seibai itaAAAAAAsu!"
    }
  ]
}
