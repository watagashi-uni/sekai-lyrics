  "lines": [
    {
      "text": "ボビデバビデンベッデボン",
      "romaji": "bobidebabidenbeddebon?"
    },
    {
      "text": "明日って何度言う? ",
      "romaji": "Ashita tte nando iu?"
    },
    {
      "text": "洗剤食らって睫毛乾く? NoでNoでNo",
      "romaji": "Senzai kuratte matsuge kawaku? NO de NO de NO"
    },
    {
      "text": "思い出して何、泣いてんだ 今 ",
      "romaji": "Omoidashite nani, naite nda ima"
    },
    {
      "text": "さよならに慣れてしまってんだ",
      "romaji": "Sayonara ni narete shimatte nda"
    },
    {
      "text": "これでいいのか? なんて浪々々",
      "romaji": "Kore de ii no ka? nante rourourou"
    },
    {
      "text": "Lonely? 浪人? Morning? Sorry?",
      "romaji": "Lonely? Ronin? Morning? Sorry?"
    },
    {
      "text": "苦労人？ 病人？ 考えたって今は",
      "romaji": "Kurounin? byounin? kangaeta tte ima"
    },
    {
      "text": "(Oh Oh) 思い出して魚の眼",
      "romaji": "(Oh Oh) Omoidashite sakana no me"
    },
    {
      "text": "(Oh Oh) それとなくキルミーして!",
      "romaji": "(Oh Oh) Sore to naku kiru mii shite!"
    },
    {
      "text": "夜でも",
      "romaji": "Yoru demo"
    }
  ]
}
