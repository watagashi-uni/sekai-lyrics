  "lines": [
    {
      "text": "誰もが突然に始まった",
      "romaji": "dare mo ga totsuzen ni hajimatta"
    },
    {
      "text": "デタラメなシナリオの上で",
      "romaji": "detarame na shinario no ue de"
    },
    {
      "text": "それは映画のような",
      "romaji": "sore wa eiga no you na"
    },
    {
      "text": "まるで映画のような",
      "romaji": "marude eiga no you na"
    },
    {
      "text": "どこにでもあるストーリー",
      "romaji": "doko ni demo aru sutoorii"
    },
    {
      "text": "間違いだらけの道のりだ",
      "romaji": "machigai darake no michinori da"
    },
    {
      "text": "丸付けられるのは幾つだ",
      "romaji": "marutsukerareru no wa ikutsu da"
    },
    {
      "text": "何が良くないのか",
      "romaji": "nani ga yokunai no ka"
    },
    {
      "text": "何処が良くないのか",
      "romaji": "doko ga yokunai no ka"
    },
    {
      "text": "そこまで教えてくれよ",
      "romaji": "soko made oshiete kure yo"
    },
    {
      "text": "明け方の妄想",
      "romaji": "akegata no mousou"
    },
    {
      "text": "貴重な逃避行と",
      "romaji": "kichou na touhikou to"
    },
    {
      "text": "勘違いの英雄ごっこ",
      "romaji": "kanchigai no eiyuugokko"
    },
    {
      "text": "もう渋滞してんだ",
      "romaji": "mou juutai shite nda"
    },
    {
      "text": "どうしようもこうしようもないよな",
      "romaji": "doushiyou mo koushiyou mo nai yo na"
    },
    {
      "text": "こんなはずじゃなかったよなって",
      "romaji": "konna hazu ja nakatta yo natte"
    },
    {
      "text": "どんなはずだったんだよなって",
      "romaji": "donna hazu datta nda yo natte"
    },
    {
      "text": "思えば思うほど",
      "romaji": "omoeba omou hodo"
    },
    {
      "text": "まだここじゃないない",
      "romaji": "mada koko janai nai"
    },
    {
      "text": "終わりじゃないから",
      "romaji": "owari janai kara"
    },
    {
      "text": "向いてないない",
      "romaji": "muite nai nai"
    },
    {
      "text": "なら書き変えてしまえよ",
      "romaji": "nara kakikaete shimae yo"
    },
    {
      "text": "ほら大体",
      "romaji": "hora daitai"
    },
    {
      "text": "いつもいつでもきっと",
      "romaji": "itsumo itsu demo kitto"
    },
    {
      "text": "主役は僕だけだろ",
      "romaji": "shuyaku wa boku dake daro"
    },
    {
      "text": "いつの日かバイバイ",
      "romaji": "itsu no hi ka baibai"
    },
    {
      "text": "終わりはくるから",
      "romaji": "owari wa kuru kara"
    },
    {
      "text": "拍手喝采",
      "romaji": "hakushukassai"
    },
    {
      "text": "笑顔でカーテンコール",
      "romaji": "egao de kaatenkooru"
    },
    {
      "text": "変えたい未来はここにあった",
      "romaji": "kaetai mirai wa koko ni atta"
    },
    {
      "text": "思うままに好きなように",
      "romaji": "omou mama ni suki na you ni"
    },
    {
      "text": "これはそうだ",
      "romaji": "kore wa sou da"
    },
    {
      "text": "最底辺から駆け上がった",
      "romaji": "saiteihen kara kakeagatta"
    },
    {
      "text": "映画のようなストーリー",
      "romaji": "eiga no you na sutoorii"
    }
  ]
}
