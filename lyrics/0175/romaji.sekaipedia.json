  "lines": [
    {
      "text": "「どうもこんにちは",
      "romaji": "doumo konnichiwa"
    },
    {
      "text": "何の冗談か目を擦ってみる",
      "romaji": "nan no joudan ka me o kosutte miru"
    },
    {
      "text": "過程はいいから結果を下さい",
      "romaji": "katei wa ii kara kekka o kudasai"
    },
    {
      "text": "無意味で無意義な代償",
      "romaji": "muimi de muigi na daishou"
    },
    {
      "text": "ねえ　こんな事より",
      "romaji": "nee konna koto yori"
    },
    {
      "text": "大事なことがあるんだよ",
      "romaji": "daiji na koto ga arun da yo"
    },
    {
      "text": "いいだろ",
      "romaji": "ii daro"
    },
    {
      "text": "「ええやりますやります",
      "romaji": "“ee yarimasu yarimasu"
    },
    {
      "text": "何でもやります",
      "romaji": "nandemo yarimasu"
    },
    {
      "text": "僕は君の分身です」",
      "romaji": "boku wa kimi no bunshin desu”"
    },
    {
      "text": "拝啓ドッペルゲンガー",
      "romaji": "haikei dopperugengaa"
    },
    {
      "text": "ねえ有りもしない0と1",
      "romaji": "nee ari mo shinai zero to ichi"
    },
    {
      "text": "証明の根拠なんて何処にも",
      "romaji": "shoumei no konkyo nante dokonimo"
    },
    {
      "text": "奇跡の輪廻が",
      "romaji": "kiseki no rinne ga"
    },
    {
      "text": "ルンパッパ",
      "romaji": "runpappa"
    },
    {
      "text": "委ねあって",
      "romaji": "yudane atte"
    },
    {
      "text": "冀望また愛も",
      "romaji": "kibou mata ai mo"
    },
    {
      "text": "イニシエイション",
      "romaji": "inishieishon"
    },
    {
      "text": "どうか誰か僕に奇跡をくれよ",
      "romaji": "douka dareka boku ni kiseki o kure yo"
    },
    {
      "text": "もう止まらない戻れない",
      "romaji": "mou tomaranai modorenai"
    },
    {
      "text": "それはそれは僕",
      "romaji": "sore wa sore wa boku"
    },
    {
      "text": "蝕まれた存在に",
      "romaji": "mushibamareta sonzai ni"
    },
    {
      "text": "世界が気付こうが",
      "romaji": "sekai ga kizukou ga"
    },
    {
      "text": "狂った正解を染め上げるさ",
      "romaji": "kurutta seikai o someageru sa"
    }
  ]
}
