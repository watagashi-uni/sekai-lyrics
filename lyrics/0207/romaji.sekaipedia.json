    },
    {
      "text": "振り切ってPeaky Peaky",
      "romaji": "furikitte Peaky Peaky"
    },
    {
      "text": "わかりあえなくたっていい",
      "romaji": "wakariae nakutatte ii"
    },
    {
      "text": "悲しみのリズムも",
