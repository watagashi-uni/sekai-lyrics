  "lines": [
    {
      "text": "ロンリーガールはいつまでも",
      "romaji": "ronrii gaaru wa itsumademo"
    },
    {
      "text": "届かない夢見て",
      "romaji": "todokanai yume mite"
    },
    {
      "text": "問題ないと呟いて",
      "romaji": "\"mondai nai.\" to tsubuyaite,"
    },
    {
      "text": "言葉は失われた",
      "romaji": "kotoba wa ushinawareta?"
    },
    {
      "text": "もう失敗もう失敗",
      "romaji": "mou shippai, mou shippai."
    },
    {
      "text": "間違い探しに終われば",
      "romaji": "machigai sagashi ni owareba"
    },
    {
      "text": "また回るの",
      "romaji": "mata, mawaru no!"
    },
    {
      "text": "もう一回もう一回",
      "romaji": "mou ikkai, mou ikkai."
    },
    {
      "text": "少女は言う少女は言う",
      "romaji": "shoujo wa iu, shoujo wa iu"
    },
    {
      "text": "言葉に意味を奏でながら",
      "romaji": "kotoba ni imi o kanadenagara!"
    },
    {
      "text": "もう良いかい",
      "romaji": "\"mou ii kai?\""
    },
    {
      "text": "まだですよ",
      "romaji": "\"mada desu yo,"
    },
    {
      "text": "まだまだ先は見えないので",
      "romaji": "mada mada saki wa mienai no de."
    },
    {
      "text": "言葉に笑みを奏でながら",
      "romaji": "kotoba ni emi o kanadenagara!"
    },
    {
      "text": "もう良いかいもう良いよ",
      "romaji": "\"mou ii kai? mou ii yo."
    },
    {
      "text": "そろそろ君も疲れたろうね",
      "romaji": "sorosoro kimi mo tsukaretarou, ne.\""
    }
  ]
}
