  "lines": [
    {
      "text": "手を合わせてみよう",
      "romaji": "te o awasete miyou"
    },
    {
      "text": "あぁ このまま私も連れてって",
      "romaji": "aa! kono mama watashi mo tsuretette"
    },
    {
      "text": "1億歳くらいかもね",
      "romaji": "ichi oku sai kurai kamo ne"
    },
    {
      "text": "ちょっとだけ待って",
      "romaji": "chotto dake matte!"
    },
    {
      "text": "時間が過ぎていく",
      "romaji": "jikan ga sugite iku"
    },
    {
      "text": "私は邪魔みたい",
      "romaji": "watashi wa jama mitai"
    },
    {
      "text": "今日をぎゅっと抱いて",
      "romaji": "kyou o gyutto daite"
    },
    {
      "text": "星に願ってんの",
      "romaji": "hoshi ni negatten no!"
    },
    {
      "text": "そっとぎゅっと抱いて",
      "romaji": "sotto gyutto daite!"
    },
    {
      "text": "これからも生きる",
      "romaji": "kore kara mo ikiru"
    }
  ]
}
