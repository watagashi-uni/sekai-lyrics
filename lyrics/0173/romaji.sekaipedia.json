  "lines": [
    {
      "text": "あの日と同じ ",
      "romaji": "ano hi to onaji"
    },
    {
      "text": "星を僕ら",
      "romaji": "hoshi o bokura"
    },
    {
      "text": "目印にして 声を重ねた",
      "romaji": "mejirushi ni shite koe o kasaneta"
    },
    {
      "text": "浮かび上がった憧憬",
      "romaji": "ukabiagatta shoukei"
    },
    {
      "text": "濃く滲んでいた後悔も",
      "romaji": "koku nijindeita koukai mo"
    },
    {
      "text": "自分らしく話せたのなら",
      "romaji": "jibunrashiku hanaseta no nara"
    },
    {
      "text": "どんなに楽だろう",
      "romaji": "donna ni raku darou"
    },
    {
      "text": "ねぇどんな音で",
      "romaji": "nee donna oto de"
    },
    {
      "text": "夢を鳴らしたらいい？",
      "romaji": "yume wo narashitara ii?"
    },
    {
      "text": "分かっていたんだ",
      "romaji": "wakatteitanda"
    },
    {
      "text": "立ち止まっていたのは僕の方だろう",
      "romaji": "tachidomatteita no wa boku no hou darou"
    },
    {
      "text": "零れ落ちた何気ない言葉たち",
      "romaji": "koboreochita nanigenai kotobatachi"
    },
    {
      "text": "大事にしてあげられなかった",
      "romaji": "daiji ni shite agerarenakatta"
    },
    {
      "text": "見て見ぬフリしたって",
      "romaji": "mite minu furi shitatte"
    },
    {
      "text": "ここにいるんだよってまだ",
      "romaji": "koko ni irunda yo tte mada"
    },
    {
      "text": "叫んでる ねえ",
      "romaji": "sakenderu nee"
    },
    {
      "text": "なんで笑ってるんだろう 何一つ",
      "romaji": "inande waratteru ndarou nani hitotsu"
    },
    {
      "text": "言いたい想いも 書き出せないくせに",
      "romaji": "iitai omoi mo kakidasenai kuse ni"
    },
    {
      "text": "（変わりたい 進みたい）",
      "romaji": "(kawaritai susumitai)"
    },
    {
      "text": "気付けたんだ",
      "romaji": "kizuketanda"
    },
    {
      "text": "音にのせて",
      "romaji": "oto ni nosete"
    },
    {
      "text": "流れてく一筋の光に",
      "romaji": "nagareteku hitosuji no hikari ni"
    },
    {
      "text": "僕らもなれるから",
      "romaji": "bokura mo nareru kara"
    },
    {
      "text": "（かまわない 進もう）",
      "romaji": "(kamawanai susumou)"
    },
    {
      "text": "伝えるんだ 今",
      "romaji": "tsutaerunda ima"
    },
    {
      "text": "聞こえている？ この声が",
      "romaji": "kikoeteiru? kono koe ga"
    }
  ]
}
