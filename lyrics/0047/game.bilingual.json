    {
      "index": 16,
      "start": 142.911116,
      "end": 146.851093,
      "japanese": "メルト　駅に着いてしまう…",
      "zh-CN": "融化了 马上就要到达车站了……",
      "shared_interval": false
    },
    {
      "index": 17,
      "start": 147.417953,
      "end": 154.180213,
      "japanese": "もう会えない　近くて　遠いよ　だから",
      "zh-CN": "就要分开了 明明近在咫尺 却又如此遥远 所以",
      "shared_interval": false
    },
    {
      "index": 18,
      "start": 154.180213,
      "end": 158.373575,
      "japanese": "メルト　手をつないで　歩きたい！",
      "zh-CN": "融化了 好想牵着你的手 一起漫步！",
      "shared_interval": false
    },
    {
      "index": 19,
      "start": 158.810238,
      "end": 164.442783,
      "japanese": "もうバイバイしなくちゃいけないの？",
      "zh-CN": "难道已经不得不说拜拜了吗？",
      "shared_interval": false
    },
    {
      "index": 20,
      "start": 165.195926,
      "end": 169.824949,
      "japanese": "今すぐ　わたしを　抱きしめて！",
      "zh-CN": "现在立刻 紧紧拥抱我吧！",
