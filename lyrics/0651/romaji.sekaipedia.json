  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "ちょ待って、それって扇情？",
      "romaji": "cho matte, sore tte senjou?"
    },
    {
      "text": "じゃないよ、これって洗脳",
      "romaji": "janai yo, kore tte sennou"
    },
    {
      "text": "歪んだ期待と判断違い、心躍れ！",
      "romaji": "yuganda kitai to handanchigai, kokoro odore!"
    },
    {
      "text": "ねーねー聞いて、これって重症？",
      "romaji": "nee nee kiite, kore tte juushou?"
    },
    {
      "text": "決定打食らった急所",
      "romaji": "ketteida kuratta kyuusho"
    },
    {
      "text": "クラっと来てもう、倒れたい。",
      "romaji": "kuratto kite mou, taoretai."
    },
    {
      "text": "（え？）",
      "romaji": "(e?)"
    },
    {
      "text": "世界は素敵、なんて騙るなら",
      "romaji": "sekai wa suteki, nante kataru nara"
    },
    {
      "text": "その理由を書き出して",
      "romaji": "sono riyuu o kakidashite"
    },
    {
      "text": "それ大体嘘なんだって分かるから",
      "romaji": "sore daitai uso na nda tte wakaru kara"
    },
    {
      "text": "肉の塊になって。",
      "romaji": "niku no katamari ni natte."
    },
    {
      "text": "解り合ってみない？",
      "romaji": "wakariatte minai?"
    },
    {
      "text": "関わり合ってみない？",
      "romaji": "kakawariatte minai?"
    },
    {
      "text": "死んだプライド、思考回路",
      "romaji": "shinda puraido, shikoukairo"
    },
    {
      "text": "混ざり合ってみない？",
      "romaji": "mazariatte minai?"
    },
    {
      "text": "交わり合ってみない？",
      "romaji": "majiwariatte minai?"
    },
    {
      "text": "相次ぐ凶暴化",
      "romaji": "aitsugu kyoubouka"
    },
    {
      "text": "愛する共謀者",
      "romaji": "aisuru kyoubousha"
    },
    {
      "text": "命は尊くて",
      "romaji": "inochi wa toutokute"
    },
    {
      "text": "重い、とかいう常識は",
      "romaji": "omoi, toka iu joushiki wa"
    },
    {
      "text": "だれのため",
      "romaji": "dare no tame"
    },
    {
      "text": "きみのため",
      "romaji": "kimi no tame"
    },
    {
      "text": "最高に勝手気ままな妄想",
      "romaji": "saikou ni katte kimama na mousou"
    },
    {
      "text": "奪いに来て、",
      "romaji": "ubai ni kite,"
    },
    {
      "text": "恥ずかしがらないで",
      "romaji": "hazukashigaranaide"
    },
    {
      "text": "一直線に迎えに来て！",
      "romaji": "icchokusen ni mukae ni kite!"
    },
    {
      "text": "迎えに来て、いますぐにさあ？",
      "romaji": "mukae ni kite, ima sugu ni saa?"
    },
    {
      "text": "いっそのこと夢の中へ",
      "romaji": "isso no koto yume no naka e"
    },
    {
      "text": "夢の中へ、",
      "romaji": "yume no naka e,"
    },
    {
      "text": "蹴落として、墜として",
      "romaji": "keotoshite, otoshite"
    },
    {
      "text": "一方向にまくし立てて！",
      "romaji": "ippoukou ni makushitatete!"
    },
    {
      "text": "まくし立てて、意地悪にさあ",
      "romaji": "makushitatete, ijiwaru ni saa"
    },
    {
      "text": "後悔をぼくにも植え付けて。",
      "romaji": "koukai o boku ni mo uetsukete."
    },
    {
      "text": "（そんなことしていいの？）",
      "romaji": "(sonna koto shite ii no?)"
    },
    {
      "text": "いっそのこと頭の中",
      "romaji": "isso no koto atama no naka"
    },
    {
      "text": "頭の中、",
      "romaji": "atama no naka,"
    },
    {
      "text": "狂わしてしまって",
      "romaji": "kuruwashite shimatte"
    },
    {
      "text": "一辺倒にもてあそんで！",
      "romaji": "ippentou ni moteasonde!"
    },
    {
      "text": "もてあそんで、今すぐにさあ",
      "romaji": "moteasonde, ima sugu ni saa!"
    },
    {
      "text": "愛なんて、壊れてしまえばいいんだ。",
      "romaji": "ai nante, kowarete shimaeba ii nda."
    }
  ]
}
