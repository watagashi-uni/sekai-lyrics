  "lines": [
    {
      "text": "キラリ光る白い雪が",
      "romaji": "kirari hikaru shiroi yuki ga"
    },
    {
      "text": "少しずつ街を染めてゆく",
      "romaji": "sukoshizutsu machi o somete yuku"
    },
    {
      "text": "探しに出かけよう",
      "romaji": "sagashi ni dekakeyou"
    },
    {
      "text": "この冬最後の雪が",
      "romaji": "kono fuyu saigo no yuki ga"
    },
    {
      "text": "僕らの街に舞い降りた",
      "romaji": "bokura no machi ni maiorita"
    },
    {
      "text": "二人が歩いた道の",
      "romaji": "futari ga aruita michi no"
    },
    {
      "text": "足跡は消えてしまう",
      "romaji": "ashiato wa kiete shimau"
    },
    {
      "text": "冷たい空気吸い込んで",
      "romaji": "tsumetai kuuki suikonde"
    },
    {
      "text": "泣き出しそうな空を見た",
      "romaji": "nakidashisou na sora o mita"
    },
    {
      "text": "明日の朝には二人",
      "romaji": "ashita no asa ni wa futari"
    },
    {
      "text": "別々の場所へ歩き出す",
      "romaji": "betsubetsu no basho e arukidasu"
    },
    {
      "text": "臆病すぎた僕は",
      "romaji": "okubyou sugita boku wa"
    },
    {
      "text": "大事なことも言えず",
      "romaji": "daiji na koto mo iezu"
    },
    {
      "text": "震える君のその手を",
      "romaji": "furueru kimi no sono te o"
    },
    {
      "text": "握ることさえも",
      "romaji": "nigiru koto sae mo..."
    },
    {
      "text": "少しずつ空へ溶けてゆく",
      "romaji": "sukoshizutsu sora e tokete yuku"
    },
    {
      "text": "忘れはしないよ",
      "romaji": "wasure wa shinai yo"
    },
    {
      "text": "長い夢が覚める頃に",
      "romaji": "nagai yume ga sameru koro ni"
    },
    {
      "text": "君はもう消えてしまうけど",
      "romaji": "kimi wa mou kiete shimau kedo"
    },
    {
      "text": "きっと また懐かしい歌声が",
      "romaji": "kitto, mata natsukashii utagoe ga"
    },
    {
      "text": "新しい未来で光り輝く雪になって",
      "romaji": "atarashii mirai de hikari kagayaku yuki ni natte"
    },
    {
      "text": "この空に舞い降りる",
      "romaji": "kono sora ni maioriru"
    },
    {
      "text": "やがて目の前に舞い降りる",
      "romaji": "yagate me no mae ni maioriru"
    }
  ]
}
