  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/Nounai_Kakumei_Girl",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "言い訳、始まりました、",
      "romaji": "iiwake, hajimarimashita,"
    },
    {
      "text": "また始まりました。　はぁ？",
      "romaji": "mata hajimarimashita. haa?"
    },
    {
      "text": "それはさあ･･･それはさあ、それがさあ！",
      "romaji": "sore wa saa... sore wa saa, sore ga saa!"
    },
    {
      "text": "逃げ切ったつもりなの？",
      "romaji": "nigekitta tsumori na no?"
    },
    {
      "text": "見下し、在り在りですか、",
      "romaji": "mikudashi, ariari desu ka,"
    },
    {
      "text": "物足りないですか。　ねぇ？",
      "romaji": "mono tarinai desu ka. nee?"
    },
    {
      "text": "これがさ･･･これがさ、これがさ！",
      "romaji": "kore ga sa... kore ga sa, kore ga sa!"
    },
    {
      "text": "「タカラモノ」ってどーゆーことさ･･･？",
      "romaji": "\"takaramono\" tte dou yuu koto sa...?"
    },
    {
      "text": "止まった針に目を瞑って。",
      "romaji": "tomatta hari ni me wo tsumutte."
    },
    {
      "text": "散々つまらない夢をみて。",
      "romaji": "sanzan tsumaranai yume wo mite."
    },
    {
      "text": "あー、ニンゲンじゃないみたいだ、",
      "romaji": "aa, ningen janai mitai da,"
    },
    {
      "text": "素顔隠して。",
      "romaji": "sugao kakushite."
    },
    {
      "text": "空振りの理想論、",
      "romaji": "karaburi no risouron,"
    },
    {
      "text": "騒ぎ立てる名無しさん。",
      "romaji": "sawagitateru nanashi-san."
    },
    {
      "text": "感じとれないみたいだ、",
      "romaji": "kanjitorenai mitai da,"
    },
    {
      "text": "キミの音は。",
      "romaji": "kimi no oto wa."
    },
    {
      "text": "一粒の期待なんて",
      "romaji": "hitotsubu no kitai nante"
    },
    {
      "text": "泣き濡れて染みになって、",
      "romaji": "nakinurete shimi ni natte,"
    },
    {
      "text": "ありふれた唄になっていった。",
      "romaji": "arifureta uta ni natte itta."
    },
    {
      "text": "失敗したみたいだ、",
      "romaji": "shippai shita mitai da,"
    },
    {
      "text": "いつでもそう。",
      "romaji": "itsudemo sou."
    },
    {
      "text": "抜かりない机上論。",
      "romaji": "nukarinai kijouron."
    },
    {
      "text": "即敗れたり！",
      "romaji": "soku yaburetari!"
    },
    {
      "text": "でたらめな期待だ、",
      "romaji": "detarame na kitai da,"
    },
    {
      "text": "未だにそう。",
      "romaji": "imada ni sou."
    },
    {
      "text": "素直になりたいだけだ、",
      "romaji": "sunao ni naritai dake da,"
    },
    {
      "text": "素直になりたいんだけど、",
      "romaji": "sunao ni naritain dakedo,"
    },
    {
      "text": "ニンゲンじゃないみたいだ、",
      "romaji": "ningen janai mitai da,"
    },
    {
      "text": "息を殺して。",
      "romaji": "iki wo koroshite."
    },
    {
      "text": "なけなしの理想論、",
      "romaji": "nakenashi no risouron,"
    },
    {
      "text": "可哀想な名無しさん。",
      "romaji": "kawaisou na nanashi-san"
    },
    {
      "text": "言い負かしたつもりなの？",
      "romaji": "iimakashita tsumori na no?"
    },
    {
      "text": "いい加減、諦めました。",
      "romaji": "iikagen, akiramemashita."
    },
    {
      "text": "さらば未来。明日。　ねぇ？",
      "romaji": "saraba mirai. ashita. nee?"
    },
    {
      "text": "これがさ･･･あれがさ、それがさ！",
      "romaji": "kore ga sa... are ga sa, sore ga sa!"
    }
  ]
}
