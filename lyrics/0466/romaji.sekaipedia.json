  "lines": [
    {
      "text": "青く澄んだ雨の病",
      "romaji": "aoku sunda ame no yamai"
    },
    {
      "text": "一人きりの呼吸は徒然",
      "romaji": "hitorikiri no kokyuu wa tsurezure"
    },
    {
      "text": "痛む心に滲む鋼鉄の愛があった",
      "romaji": "itamu kokoro ni nijimu koutetsu no ai ga atta"
    },
    {
      "text": "触れたならば消えてしまう",
      "romaji": "fureta naraba kiete shimau"
    },
    {
      "text": "微かに灯る炎のように",
      "romaji": "kasuka ni tomoru honoo no you ni"
    },
    {
      "text": "瞳は僕を捉え",
      "romaji": "hitomi wa boku o torae"
    },
    {
      "text": "確かにそこにいるのに",
      "romaji": "tashika ni soko ni iru no ni"
    },
    {
      "text": "映すのに",
      "romaji": "utsusu no ni"
    },
    {
      "text": "どこか虚ろに空を見る",
      "romaji": "dokoka utsuro ni kuu o miru"
    },
    {
      "text": "伝えたい言葉は鋭利",
      "romaji": "tsutaetai kotoba wa eiri"
    },
    {
      "text": "証明をここに残す",
      "romaji": "shoumei o koko ni nokosu"
    },
    {
      "text": "「愛している 君だけを」",
      "romaji": "\"aishite iru, kimi dake o.\""
    },
    {
      "text": "深い眠りの奥いつか",
      "romaji": "fukai nemuri no oku itsuka"
    },
    {
      "text": "鼓動を確かめて",
      "romaji": "kodou o tashikamete"
    },
    {
      "text": "全て夢だった",
      "romaji": "subete yume datta"
    },
    {
      "text": "そして混沌は",
      "romaji": "soshite konton wa"
    },
    {
      "text": "また花開くと歩き出す",
      "romaji": "mata hanahiraku, to arukidasu"
    },
    {
      "text": "眩んだ視界の先十のうち",
      "romaji": "kuranda shikai no saki too no uchi"
    },
    {
      "text": "君はもう遠く",
      "romaji": "kimi wa mou tooku"
    },
    {
      "text": "薄い透明のベールをひらり纏い",
      "romaji": "usui toumei no beeru o hirari matoi"
    },
    {
      "text": "闇を飾っていく",
      "romaji": "yami o kazatte iku"
    }
  ]
}
