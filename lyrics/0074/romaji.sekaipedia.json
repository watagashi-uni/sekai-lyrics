  "lines": [
    {
      "text": "悪戯は知らん顔で",
      "romaji": "itazura wa shiran kao de"
    },
    {
      "text": "言い訳は涙を使って",
      "romaji": "iiwake wa namida wo tsukatte"
    },
    {
      "text": "寂しいな遊びたいな",
      "romaji": "sabishii na asobitai na"
    },
    {
      "text": "蜂蜜みたいにどろどろ",
      "romaji": "hachimitsu mitai ni doro doro"
    },
    {
      "text": "あなたにも あなたにも",
      "romaji": "anata ni mo anata ni mo"
    },
    {
      "text": "私はさ 必要ないでしょ",
      "romaji": "watashi wa sa hitsuyou nai desho"
    },
    {
      "text": "世の中に けんもほろろ",
      "romaji": "yo no naka ni ken mo hororo"
    },
    {
      "text": "楽しそうな お祭りね",
      "romaji": "tanoshisou na omatsuri ne"
    },
    {
      "text": "さあ",
      "romaji": "saa"
    },
    {
      "text": "あんよ あんよ こっちおいで",
      "romaji": "an'yo an'yo kocchi oide"
    },
    {
      "text": "手を叩いて 歩け らったった",
      "romaji": "te wo tataite aruke rattatta"
    },
    {
      "text": "嫌んよ 嫌んよ そっぽ向いて",
      "romaji": "yan yo yan yo soppo muite"
    },
    {
      "text": "今日も私は悪い子 要らん子",
      "romaji": "kyou mo watashi wa warui ko iran ko"
    }
  ]
}
