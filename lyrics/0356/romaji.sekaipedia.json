  "lines": [
    {
      "text": "迷い間違い 進めない日々",
      "romaji": "mayoi machigai susumenai hibi"
    },
    {
      "text": "分かっていたつもりだった",
      "romaji": "wakatte ita tsumori datta"
    },
    {
      "text": "まだ足りない 対峙 またMISTAKE",
      "romaji": "mada tarinai taiji mata MISTAKE"
    },
    {
      "text": "感じたままでいい 歩き出して",
      "romaji": "kanjita mama de ii arukidashite"
    },
    {
      "text": "少しずつ形にして",
      "romaji": "sukoshizutsu katachi ni shite"
    },
    {
      "text": "さあいくよ 調子はどうだい？",
      "romaji": "saa iku yo choushi wa dou dai?"
    },
    {
      "text": "CLAP！反響して響く超低音",
      "romaji": "CLAP! hankyou shite hibiku chou teion"
    },
    {
      "text": "揺るがぬ想い 重ね合わせて",
      "romaji": "yuruganu omoi kasaneawasete"
    },
    {
      "text": "襲うプレッシャーと壁押し退け",
      "romaji": "osou puresshaa to kabe oshinoke"
    },
    {
      "text": "光追いかけた",
      "romaji": "hikari oikaketa"
    },
    {
      "text": "届かないような 未来だって",
      "romaji": "todokanai you na mirai datte"
    },
    {
      "text": "何度でも手を伸ばそう",
      "romaji": "nando demo te o nobasou"
    },
    {
      "text": "憧ればかりじゃ終われないから (ないから)",
      "romaji": "akogare bakari ja owarenai kara (nai kara)"
    },
    {
      "text": "悔しい気持ち 忘れないで",
      "romaji": "kuyashii kimochi wasurenaide"
    },
    {
      "text": "前を向いたら",
      "romaji": "mae o muitara"
    },
    {
      "text": "奇跡を塗り替える",
      "romaji": "kiseki o nurikaeru"
    },
    {
      "text": "鮮やかなセカイを 描いていくんだ",
      "romaji": "azayaka na sekai o egaite iku nda"
    }
  ]
}
