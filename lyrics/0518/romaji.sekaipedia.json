  "lines": [
    {
      "text": "孤独なら傍にいて",
      "romaji": "kodoku nara soba ni ite"
    },
    {
      "text": "涙なら抱きしめて",
      "romaji": "namida nara dakishimete"
    },
    {
      "text": "凍てつく悲しみは",
      "romaji": "itetsuku kanashimi wa"
    },
    {
      "text": "力に変え乗り越えて",
      "romaji": "chikara ni kae norikoete"
    },
    {
      "text": "明空に消えゆく最後の光",
      "romaji": "akisora ni kieyuku saigo no hikari"
    },
    {
      "text": "知っているなら",
      "romaji": "shitte iru nara"
    },
    {
      "text": "教えてくれないか \"I\"の意味",
      "romaji": "oshiete kurenai ka “I” no imi"
    },
    {
      "text": "見上げれば今も",
      "romaji": "miagereba ima mo"
    },
    {
      "text": "貴方の色がまだ見える",
      "romaji": "anata no iro ga mada mieru"
    },
    {
      "text": "地に堕ちても構わない",
      "romaji": "chi ni ochite mo kamawanai"
    },
    {
      "text": "穢れなきしるべは",
      "romaji": "kegare naki shirube wa"
    },
    {
      "text": "夕空に消えゆく最後の光",
      "romaji": "yuuzora ni kieyuku saigo no hikari"
    },
    {
      "text": "僕らを繋ぐ太古の光",
      "romaji": "bokura o tsunagu taiko no hikari"
    }
  ]
}
