  "lines": [
    {
      "text": "終夜ノ摩天楼は",
      "romaji": "shuuya no matenrou wa"
    },
    {
      "text": "月の裏の鴻鵠模様",
      "romaji": "tsuki no ura no koukoku moyou"
    },
    {
      "text": "解 = 闘争？ 逃走？",
      "romaji": "kai = tousou? tousou?"
    },
    {
      "text": "奈落を絡で移動",
      "romaji": "naraku o raku de idou"
    },
    {
      "text": "勢い侭、走り抜けよ。",
      "romaji": "ikioi mama, hashirinuke yo."
    },
    {
      "text": "青ノ印を結う時は",
      "romaji": "ao no shirushi o yuu toki wa"
    },
    {
      "text": "呼吸を深く、両の眼は閉じて。",
      "romaji": "kokyuu o fukaku, ryou no me wa tojite."
    },
    {
      "text": "強制≠共生",
      "romaji": "kyousei ≠ kyousei"
    },
    {
      "text": "堕落を搾で試行 ",
      "romaji": "daraku o saku de shikou"
    },
    {
      "text": "勢い侭、斬り捨てていけよ。",
      "romaji": "ikioi mama, kirisutete ike yo."
    },
    {
      "text": "祈って 只待って居れば ",
      "romaji": "inotte tada matte ireba"
    },
    {
      "text": "何か変わるか？ 救われた気にでもなるか？",
      "romaji": "nanika kawaru ka? sukuwareta ki ni demo naru ka?"
    },
    {
      "text": "依然 「労いは糧になる」と",
      "romaji": "izen \"negirai wa kate ni naru\" to"
    },
    {
      "text": "吐き捨てて言った。",
      "romaji": "hakisutete itta."
    },
    {
      "text": "刃、風を斬る様。",
      "romaji": "yaiba, kaze o kiru you."
    },
    {
      "text": "泡沫に酔う音の渦を。",
      "romaji": "utakata ni you oto no uzu o."
    },
    {
      "text": "明鏡振るう因果をも「陶然」と",
      "romaji": "meikyou furuu inga o mo \"touzen\" to"
    },
    {
      "text": "見切って逸そ、逃げてしまえたら。",
      "romaji": "mikitte isso, nigete shimaetara."
    },
    {
      "text": "花霞と刹那の街",
      "romaji": "hanagasumi to setsuna no machi"
    },
    {
      "text": "—さあ、峡谷ノ都市へと急ごう！",
      "romaji": "—saa, kyoukoku no toshi e to isogou!"
    },
    {
      "text": "数は約二百京里",
      "romaji": "kazu wa yaku nihyakkeiri"
    },
    {
      "text": "—足は、動く。",
      "romaji": "—ashi wa, ugoku."
    },
    {
      "text": "雨音、十六夜の月",
      "romaji": "amaoto, izayoi no tsuki"
    },
    {
      "text": "—不途 此の時を待ち侘びていた",
      "romaji": "—zutto kono toki o machiwabite ita"
    },
    {
      "text": "余す事無く願いは",
      "romaji": "amasu koto naku negai wa"
    },
    {
      "text": "—叶う、今。",
      "romaji": "—kanau, ima."
    }
  ]
}
