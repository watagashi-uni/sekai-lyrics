  "lines": [
    {
      "text": "泣いたような声でさ",
      "romaji": "naita you na koe de sa"
    },
    {
      "text": "静かに笑うんだ",
      "romaji": "shizuka ni waraunda"
    },
    {
      "text": "想像を写した",
      "romaji": "souzou o utsushita"
    },
    {
      "text": "彩のパレット",
      "romaji": "irodori no paretto"
    },
    {
      "text": "溢れ出す色を",
      "romaji": "afuredasu iro o"
    },
    {
      "text": "だれか　止めてよ",
      "romaji": "dareka tomete yo"
    },
    {
      "text": "消えちゃう",
      "romaji": "kiechau"
    },
    {
      "text": "ありがとう を浮かべた赤に　やさしいうたを",
      "romaji": "arigatou o ukabeta aka ni yasashii uta o"
    },
    {
      "text": "ありがとう を溢した白に　やさしいキスを",
      "romaji": "arigatou o koboshita shiro ni yasashii kisu o"
    }
  ]
}
