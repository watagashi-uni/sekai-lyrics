  "lines": [
    {
      "text": "甲高い声が部屋を埋めるよ",
      "romaji": "kandakai koe ga heya o umeru yo"
    },
    {
      "text": "最低な意味を渦巻いて",
      "romaji": "saitei na imi o uzumaite"
    },
    {
      "text": "当然 良いこともないし",
      "romaji": "touzen ii koto mo nai shi"
    },
    {
      "text": "さあ 思い切り吐き出そうか",
      "romaji": "saa omoikiri hakidasou ka"
    },
    {
      "text": "そんなの どうせ つまらないわ」",
      "romaji": "sonna no douse tsumaranai wa!\""
    },
    {
      "text": "ホップ・ステップで踊ろうか",
      "romaji": "hoppu suteppu de odorou ka"
    },
    {
      "text": "世界の隅っこでワン・ツー",
      "romaji": "sekai no sumikko de wan tsuu"
    }
  ]
}
