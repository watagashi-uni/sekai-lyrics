  "lines": [
    {
      "text": "巻かれた螺子と振り子時計が",
      "romaji": "makareta neji to furikodokei ga"
    },
    {
      "text": "目を覚ましたら",
      "romaji": "me o samashitara"
    },
    {
      "text": "赤と青の薔薇が蔓延ばし",
      "romaji": "aka to ao no bara ga tsuru nobashi"
    },
    {
      "text": "一頁めを飾るの",
      "romaji": "ichipeeji me o kazaru no"
    },
    {
      "text": "チョコレート＆バター　溶かし合わせて",
      "romaji": "chokoreeto & bataa tokashi awasete"
    },
    {
      "text": "卵に砂糖を　ちょこっと混ぜる",
      "romaji": "tamago ni satou o chokotto mazeru"
    },
    {
      "text": "小麦粉　振るう隣で",
      "romaji": "komugiko furuu tonari de"
    },
    {
      "text": "メレンゲ、膨らませて",
      "romaji": "merenge, fukuramasete"
    },
    {
      "text": "ペンローズの階段駆け抜け",
      "romaji": "penroozu no kaidan kakenuke"
    },
    {
      "text": "インスリン足りなくなる様な",
      "romaji": "insurin tarinaku naru you na"
    },
    {
      "text": "ハートの錠前を探してる",
      "romaji": "haato no joumae o sagashiteru"
    },
    {
      "text": "鍵の無い牢獄から",
      "romaji": "kagi no nai rougoku kara"
    },
    {
      "text": "冷やし固まった時も忘れて",
      "romaji": "hiyashi katamatta toki mo wasurete"
    },
    {
      "text": "穴だらけのレシピ口ずさみ",
      "romaji": "ana darake no reshipi kuchizusami"
    },
    {
      "text": "幾つものメビウス辿っても",
      "romaji": "ikutsumo no mebiusu tadotte mo"
    },
    {
      "text": "いつかダ・カーポの先へ",
      "romaji": "itsu ka da kaapo no saki e"
    },
    {
      "text": "空にヒビWhat follows the tall tale?",
      "romaji": "sora ni hibi What follows the tall tale?"
    },
    {
      "text": "ここでまた無敵に成れそうな",
      "romaji": "koko de mata muteki ni naresou na"
    },
    {
      "text": "終わりない魔法でとかしていく",
      "romaji": "owarinai mahou de tokashite iku"
    },
    {
      "text": "誰かが焼いたお菓子を",
      "romaji": "dareka ga yaita okashi o"
    },
    {
      "text": "静寂のリズム刻むタクト",
      "romaji": "seijaku no rizumu kizamu takuto"
    },
    {
      "text": "黒塗りの楽譜を詠むヴィオラ",
      "romaji": "kuronuri no gakufu o yomu viora"
    },
    {
      "text": "歯抜けのメロディが繋がって",
      "romaji": "hanuke no merodi ga tsunagatte"
    },
    {
      "text": "幕を下ろそうパレードへ",
      "romaji": "maku o orosou pareedo e"
    }
  ]
}
