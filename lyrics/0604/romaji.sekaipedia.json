  "lines": [
    {
      "text": "この世界のメロディー",
      "romaji": "kono sekai no merodii"
    },
    {
      "text": "わたしの歌声",
      "romaji": "watashi no utagoe"
    },
    {
      "text": "届いているかな",
      "romaji": "todoite iru ka na"
    },
    {
      "text": "響いているかな",
      "romaji": "hibiite iru ka na"
    },
    {
      "text": "手のひらから 零れ落ちた",
      "romaji": "tenohira kara koboreochita"
    },
    {
      "text": "音の粒を 探してるの",
      "romaji": "oto no tsubu o sagashiteru no"
    },
    {
      "text": "Packageに詰めた この想いを",
      "romaji": "Package ni tsumeta kono omoi o"
    },
    {
      "text": "伝えたいの あなたにだけ",
      "romaji": "tsutaetai no anata ni dake"
    },
    {
      "text": "うまく歌えるといいな",
      "romaji": "umaku utaeru to ii na"
    },
    {
      "text": "ちゃんとできるようにがんばるよ！",
      "romaji": "chanto dekiru you ni ganbaru yo!"
    },
    {
      "text": "この世界に笑顔を",
      "romaji": "kono sekai ni egao o"
    },
    {
      "text": "わたしとあなたで",
      "romaji": "watashi to anata de"
    },
    {
      "text": "届いているでしょ",
      "romaji": "todoite iru desho"
    },
    {
      "text": "響いているよね",
      "romaji": "hibiite iru yo ne"
    }
  ]
}
