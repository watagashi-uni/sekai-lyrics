  "lines": [
    {
      "text": "途方もない時間だけ",
      "romaji": "tohou mo nai jikan dake"
    },
    {
      "text": "また過ぎていく",
      "romaji": "mata sugiteyuku"
    },
    {
      "text": "此処は理想郷では無い",
      "romaji": "koko wa risoukyou de wa nai"
    },
    {
      "text": "ましてや描いた未来じゃ無い",
      "romaji": "mashite ya egaita mirai janai"
    },
    {
      "text": "終わりのない未来など",
      "romaji": "owari no nai mirai nado"
    },
    {
      "text": "なんて下らない",
      "romaji": "nante kudaranai"
    },
    {
      "text": "夢の隙間に問う",
      "romaji": "yume no sukima ni tou"
    },
    {
      "text": "私は何処へと行くの",
      "romaji": "watashi wa doko e to yuku no"
    },
    {
      "text": "遠い遠い先の方へ",
      "romaji": "tooi tooi saki no hou e"
    },
    {
      "text": "痛みと歩いていた",
      "romaji": "itami to aruiteita"
    },
    {
      "text": "騒がしい街の声が",
      "romaji": "sawagashii machi no koe ga"
    },
    {
      "text": "頭に響く",
      "romaji": "atama ni hibiku"
    },
    {
      "text": "夢の底でもがくのなら",
      "romaji": "yume no soko de mo gaku mo nara"
    },
    {
      "text": "この夜をいっそ喰らってしまいたい",
      "romaji": "kono yoru o isso kuratte shimaitai"
    },
    {
      "text": "呆れる程に傍にいて",
      "romaji": "akireru hodo ni soba ni ite"
    },
    {
      "text": "愚かでいい　二度と無い",
      "romaji": "orokade ii nidoto nai"
    },
    {
      "text": "今を生きていたいだけ",
      "romaji": "ima o ikiteitai dake"
    },
    {
      "text": "それだけだ",
      "romaji": "sore dake da"
    }
  ]
}
