  "lines": [
    {
      "text": "ありえない幻想",
      "romaji": "arienai gensou"
    },
    {
      "text": "あふれだす妄想",
      "romaji": "afuredasu mousou"
    },
    {
      "text": "君以外全部いらないわ",
      "romaji": "kimi igai zenbu iranai wa"
    },
    {
      "text": "息をするように嘘ついて",
      "romaji": "iki o suru you ni usotsuite"
    },
    {
      "text": "もうあたしやっぱいらない子？",
      "romaji": "mou atashi yappa iranai ko?"
    },
    {
      "text": "こぼれ出しちゃった承認欲求",
      "romaji": "koboredashichatta shounin yokkyuu"
    },
    {
      "text": "もっとココロ満たしてよ",
      "romaji": "motto kokoro mitashite yo"
    },
    {
      "text": "アスパルテーム　甘い夢",
      "romaji": "asuparuteemu amai yume"
    },
    {
      "text": "あたしだけに愛をください",
      "romaji": "atashi dake ni ai o kudasai"
    },
    {
      "text": "あ゛～もうムリ まじムリ",
      "romaji": "aa~ mou muri maji muri"
    },
    {
      "text": "恋して 愛して 救済執行BAN⭐︎",
      "romaji": "koishite aishite kyuusaishikkou BAN⭐︎"
    },
    {
      "text": "ねー好きって言ってよ？",
      "romaji": "nee suki tte itte yo?"
    },
    {
      "text": "とまんない つまんない",
      "romaji": "tomannai tsumannai"
    },
    {
      "text": "欲が散らばって",
      "romaji": "yoku ga chirabatte"
    },
    {
      "text": "求めてる愛情",
      "romaji": "motometeru aijou"
    },
    {
      "text": "隠してる劣情",
      "romaji": "kakushiteru retsujou"
    },
    {
      "text": "誰のこと見てんの？",
      "romaji": "dare no koto miten no?"
    },
    {
      "text": "こういうの好きなの？",
      "romaji": "kou iu no suki nano?"
    },
    {
      "text": "ねーDDとかガチでやめてください",
      "romaji": "nee DD toka gachi de yamete kudasai"
    },
    {
      "text": "独占させてよ",
      "romaji": "dokusen sasete yo"
    },
    {
      "text": "本命なんでしょ",
      "romaji": "honmei nan desho"
    },
    {
      "text": "もっともっとガチで推してください",
      "romaji": "motto motto gachi de oshite kudasai"
    },
    {
      "text": "飲み過ぎ注意 オーバードーズ",
      "romaji": "nomisugi chuui oobaadoozu"
    },
    {
      "text": "クラクラさせて いつだって",
      "romaji": "kurakura sasete itsu date"
    },
    {
      "text": "アガって サガって 救済執行BAN⭐︎",
      "romaji": "agatte sagatte kyuusai shikkou BAN⭐︎"
    },
    {
      "text": "ねー好きって言わせて？",
      "romaji": "nee suki tte iwasete?"
    },
    {
      "text": "噛みついた衝動",
      "romaji": "kamitsuita shoudou"
    },
    {
      "text": "戻れない焦燥",
      "romaji": "modorenai shousou"
    },
    {
      "text": "たまんない ミッドナイト",
      "romaji": "tamannai middonaito"
    },
    {
      "text": "指が絡まって",
      "romaji": "yubi ga karamatte"
    },
    {
      "text": "ときめいた表情",
      "romaji": "tokimeita hyoujou"
    },
    {
      "text": "何も言わないで",
      "romaji": "nani mo iwanaide"
    },
    {
      "text": "君だけがきっと王子様",
      "romaji": "kimi dake ga kitto oujisama"
    },
    {
      "text": "あたしだけずっと追いかけて！",
      "romaji": "atashi dake zutto oikakete!"
    },
    {
      "text": "ねーもう待てないの",
      "romaji": "nee mou matenai no"
    }
  ]
}
