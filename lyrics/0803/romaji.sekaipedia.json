  "lines": [
    {
      "text": "「頑張れ」　でも　「大丈夫」　でもない",
      "romaji": "\"ganbare\" demo \"daijoubu\" demo nai"
    },
    {
      "text": "「君ならできる」　でもない",
      "romaji": "\"kimi nara dekiru\" demo nai"
    },
    {
      "text": "あの日僕が言われたかった",
      "romaji": "ano hi boku ga iwaretakatta"
    },
    {
      "text": "言葉をずっと探してる",
      "romaji": "kotoba o zutto sagashiteru"
    },
    {
      "text": "雨にも負けて　風にも負けて",
      "romaji": "ame ni mo makete kaze ni mo makete"
    },
    {
      "text": "丈夫な心も無いが",
      "romaji": "joubu na kokoro mo nai ga"
    },
    {
      "text": "ふと見上げた曇り空が",
      "romaji": "futo miageta kumorizora ga"
    },
    {
      "text": "優しく笑って見えた",
      "romaji": "yasashiku waratte mieta"
    },
    {
      "text": "生きる意味なんて　理由なんて",
      "romaji": "ikiru imi nante riyuu nante"
    },
    {
      "text": "わからなくて当たり前だよ",
      "romaji": "wakaranakute atarimae da yo"
    },
    {
      "text": "空に免じて今日は生きよう",
      "romaji": "sora ni menjite kyou wa ikiyou"
    },
    {
      "text": "空に免じて今日は帰ろう",
      "romaji": "sora ni menjite kyou wa kaerou"
    },
    {
      "text": "ひび割れた心　繋ぎ止める",
      "romaji": "hibiwareta kokoro tsunagitomeru"
    },
    {
      "text": "空に免じて僕を許そう",
      "romaji": "sora ni menjite boku o yurusou"
    }
  ]
}
