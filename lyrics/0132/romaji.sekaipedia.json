  "lines": [
    {
      "text": "すぐそこに手を伸ばせば掴めそうな",
      "romaji": "sugu soko ni te o nobaseba tsukamesou na"
    },
    {
      "text": "幻をただ眺めては",
      "romaji": "maboroshi o tada nagamete wa"
    },
    {
      "text": "違う色で転がる二欠片の",
      "romaji": "chigau iro de korogaru futakakera no"
    },
    {
      "text": "答えをまだ知らないから",
      "romaji": "kotae o mada shiranai kara"
    },
    {
      "text": "道標がそこに無くても",
      "romaji": "michishirube ga soko ni nakute mo"
    },
    {
      "text": "遠回りだったとしても",
      "romaji": "toomawari datta to shite mo"
    },
    {
      "text": "泣かない様に笑ったって",
      "romaji": "nakanai you ni waratta tte"
    },
    {
      "text": "転ばない様に歩いたって",
      "romaji": "korobanai you ni aruita tte"
    },
    {
      "text": "隠した言葉は伝わらないから",
      "romaji": "kakushita kotoba wa tsutawaranai kara"
    },
    {
      "text": "僕らが描く未来は",
      "romaji": "bokura ga egaku mirai wa"
    },
    {
      "text": "ただ一つしかないから",
      "romaji": "tada hitotsu shika nai kara"
    },
    {
      "text": "この目で確かめようか",
      "romaji": "kono me de tashikameyou ka"
    },
    {
      "text": "見た事のない世界へ",
      "romaji": "mita koto no nai sekai e"
    }
  ]
}
