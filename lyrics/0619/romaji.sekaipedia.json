  "lines": [
    {
      "text": "君に逢いたい",
      "romaji": "kimi ni aitai"
    },
    {
      "text": "歌うこと教えてくれた君に",
      "romaji": "utau koto oshiete kureta kimi ni"
    },
    {
      "text": "誰かが零すメロディーを",
      "romaji": "dareka ga kobosu merodii o"
    },
    {
      "text": "誰かが拾って",
      "romaji": "dareka ga hirotte"
    },
    {
      "text": "また誰かが運んでく",
      "romaji": "mata dareka ga hakondeku"
    },
    {
      "text": "名前も顔も分からない",
      "romaji": "namae mo kao mo wakaranai"
    },
    {
      "text": "繋がる奇跡が",
      "romaji": "tsunagaru kiseki ga"
    },
    {
      "text": "誰かを幸せにする",
      "romaji": "dareka o shiawase ni suru"
    },
    {
      "text": "画面越しただ眺め羨んでばかりいた",
      "romaji": "gamen goshi tada nagame urayande bakari ita"
    },
    {
      "text": "今までは",
      "romaji": "ima made wa"
    },
    {
      "text": "君と歌えば",
      "romaji": "kimi to utaeba"
    },
    {
      "text": "時間を忘れ夢中になれたんだ",
      "romaji": "jikan o wasure muchuu ni nareta nda"
    },
    {
      "text": "たったひとつの",
      "romaji": "tatta hitotsu no"
    },
    {
      "text": "神様に与えられた才能",
      "romaji": "kami-sama ni ataerareta okurimono"
    },
    {
      "text": "一緒に歌おう",
      "romaji": "issho ni utaou"
    },
    {
      "text": "何もないけど君への言葉",
      "romaji": "nani mo nai kedo kimi e no okurimono"
    }
  ]
}
