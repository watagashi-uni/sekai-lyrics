  "lines": [
    {
      "text": "らしくない",
      "romaji": "rashikunai"
    },
    {
      "text": "隙だらけの心切り裂いて",
      "romaji": "suki darake no kokoro kirisaite"
    },
    {
      "text": "絡み合って",
      "romaji": "karamiatte"
    },
    {
      "text": "まだ見ぬ世界はいつかの幻だったかな",
      "romaji": "mada minu sekai wa itsuka no maboroshi datta kana"
    },
    {
      "text": "一人きりで謝って泣いて泣いた",
      "romaji": "hitorikiri de ayamatte naite naita"
    },
    {
      "text": "「絡繰だって」",
      "romaji": "\"karakuri datte\""
    },
    {
      "text": "忘れていた正しさに不意をつかれて",
      "romaji": "wasurete ita tadashisa ni fui o tsukarete"
    },
    {
      "text": "いつまでも片隅にあると囁いてる",
      "romaji": "itsu made mo katasumi ni aru to sasayaiteru"
    },
    {
      "text": "眩暈霞む誰だって",
      "romaji": "memai kasumu dare datte"
    },
    {
      "text": "来世なんて期待してないから",
      "romaji": "raise nante kitai shitenai kara"
    },
    {
      "text": "際限ない優しい言葉なんて",
      "romaji": "saigennai, yasashii kotoba nante"
    },
    {
      "text": "偽りのまま",
      "romaji": "itsuwari no mama"
    },
    {
      "text": "まだまだ最高に痛いよ",
      "romaji": "madamada saikou ni itai yo"
    },
    {
      "text": "指先で撫ぜた世界に",
      "romaji": "yubisaki de nazeta sekai ni"
    },
    {
      "text": "吐いた言葉一つだけ",
      "romaji": "haita kotoba hitotsu dake"
    },
    {
      "text": "孤独さえも書いた絵空事だよ",
      "romaji": "kodoku sae mo kaita esoragoto da yo"
    },
    {
      "text": "愛されたいから",
      "romaji": "aisaretai kara"
    },
    {
      "text": "どうしても歌いたい",
      "romaji": "doushite mo utaitai"
    },
    {
      "text": "焦がれて枯れた声をあげたメーデー",
      "romaji": "kogarete kareta koe o ageta meedee"
    },
    {
      "text": "秒速で過ぎてく急逝",
      "romaji": "byousoku de sugiteku kyuusei"
    },
    {
      "text": "遍く光の救難信号",
      "romaji": "amaneku hitomi no kyuunan shingou"
    },
    {
      "text": "本当を見つけたい",
      "romaji": "hontou o mitsuketai"
    },
    {
      "text": "焦がれて枯れた声をあげた生命",
      "romaji": "kogarete kareta koe o ageta seimei"
    },
    {
      "text": "遍く瞳の救援信号",
      "romaji": "amaneku hitomi no kyuuen shingou"
    }
  ]
}
