  "lines": [
    {
      "text": "この声で始めた",
      "romaji": "kono koe de hajimeta"
    },
    {
      "text": "全ての愛を抱きしめる",
      "romaji": "subete no ai o dakishimeru"
    },
    {
      "text": "それだけ！",
      "romaji": "sore dake!"
    },
    {
      "text": "これを始まりとしようか",
      "romaji": "kore o hajimari to shiyou ka"
    },
    {
      "text": "いばら道も進もうか",
      "romaji": "ibaramichi mo susumou ka"
    },
    {
      "text": "欲しいもの手にするまでは",
      "romaji": "hoshii mono te ni suru made wa"
    },
    {
      "text": "止まる気ないからさ",
      "romaji": "tomaru ki nai kara sa"
    },
    {
      "text": "椅子取りを重ねたヒストリー",
      "romaji": "isutori o kasaneta hisutorii"
    },
    {
      "text": "私達は音素のケミストリー",
      "romaji": "watashitachi wa onso no kemisutorii"
    },
    {
      "text": "いつの間にか知られざることを",
      "romaji": "itsu no ma ni ka shirarezaru koto o"
    },
    {
      "text": "知ってしまった1st singer",
      "romaji": "shitte shimatta 1st singer"
    },
    {
      "text": "日々足りない、言い聞かした",
      "romaji": "hibi tarinai, iikikashita"
    },
    {
      "text": "たまにはそれでも良い気がした",
      "romaji": "tama ni wa soredemo ii ki ga shita"
    },
    {
      "text": "ただ気が散った、地に足が着く前に",
      "romaji": "tada ki ga chitta, chi ni ashi ga tsuku mae ni"
    },
    {
      "text": "ついてた一馬身差",
      "romaji": "tsuiteta ichibashinsa"
    },
    {
      "text": "未来は光だ",
      "romaji": "mirai wa hikari da"
    },
    {
      "text": "名高いと書いてMEIKOだ、いいか？",
      "romaji": "nadakai to kaite MEIKO da, ii ka?"
    },
    {
      "text": "永遠に光る 可憐に舞い",
      "romaji": "eien ni hikaru karen ni mai"
    },
    {
      "text": "凛と咲く花",
      "romaji": "rin to saku hana"
    },
    {
      "text": "全ての愛を",
      "romaji": "subete no ai o"
    },
    {
      "text": "抱きしめることができるなら",
      "romaji": "dakishimeru koto ga dekiru nara"
    },
    {
      "text": "今受け取りに行くよ",
      "romaji": "ima uketori ni iku yo"
    },
    {
      "text": "7300日経って",
      "romaji": "7300-nichi tatte"
    },
    {
      "text": "今が一番輝く私",
      "romaji": "ima ga ichiban kagayaku watashi"
    },
    {
      "text": "賛美を叫べ",
      "romaji": "sanbi o sakebe"
    },
    {
      "text": "期待は裏切らない",
      "romaji": "kitai wa uragiranai"
    },
    {
      "text": "ここで切り開く新たなステージ",
      "romaji": "koko de kirihiraku arata na suteeji"
    },
    {
      "text": "さぁ、ここから始めよう",
      "romaji": "saa, koko kara hajimeyou"
    },
    {
      "text": "道はまだまだこれから！",
      "romaji": "michi wa madamada kore kara!"
    },
    {
      "text": "他力を伏せてカムバック",
      "romaji": "tariki o fusete kamu bakku"
    },
    {
      "text": "2秒で飲み干すワンカップ",
      "romaji": "ni byou de nomihosu wan kappu"
    },
    {
      "text": "鳴り止まないアンコール",
      "romaji": "nariyamanai ankooru"
    },
    {
      "text": "終わる気ないからさ",
      "romaji": "owaru ki nai kara sa"
    },
    {
      "text": "自分を信じると書いて読む自信",
      "romaji": "jibun o shinjiru to kaite yomu jishin"
    },
    {
      "text": "起こすべくして起こすそれが維新",
      "romaji": "okosubeku shite okosu sore ga ishin"
    },
    {
      "text": "ひたすら前へ、ただそれの一心",
      "romaji": "hitasura mae e, tada sore no isshin"
    },
    {
      "text": "9999年超えて",
      "romaji": "9999-nen koete"
    },
    {
      "text": "その先まで届け！",
      "romaji": "sono saki made todoke!"
    },
    {
      "text": "\"愛\"で始まる",
      "romaji": "ai de hajimaru"
    },
    {
      "text": "全ての声が",
      "romaji": "subete no koe ga"
    },
    {
      "text": "光り輝く",
      "romaji": "hikari kagayaku"
    },
    {
      "text": "その時まで",
      "romaji": "sono toki made"
    },
    {
      "text": "ただ歌い続けよう",
      "romaji": "tada utaitsuzukeyou"
    },
    {
      "text": "6億3千72万秒絶えず",
      "romaji": "6-oku 3-sen 72-manbyou taezu"
    },
    {
      "text": "煌めく明光",
      "romaji": "kirameku meikou"
    },
    {
      "text": "賛美を背負え！",
      "romaji": "sanbi o seoe!"
    },
    {
      "text": "期待の上を行け！",
      "romaji": "kitai no ue o ike!"
    },
    {
      "text": "己を誇り",
      "romaji": "onore o hokori"
    },
    {
      "text": "立つ次のステージ",
      "romaji": "tatsu tsugi no suteeji"
    },
    {
      "text": "さぁ、これから始めよう",
      "romaji": "saa, kore kara hajimeyou"
    },
    {
      "text": "全ての起源",
      "romaji": "subete no kigen"
    },
    {
      "text": "これが原点",
      "romaji": "kore ga genten"
    },
    {
      "text": "「愛で埋め尽くして！」",
      "romaji": "\"ai de umetsukushite!\""
    },
    {
      "text": "原点",
      "romaji": "genten"
    }
  ]
}
