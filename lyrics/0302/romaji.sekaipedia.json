  "lines": [
    {
      "text": "生まれた時はみんな",
      "romaji": "umareta toki wa minna"
    },
    {
      "text": "同じスタート地点にいた",
      "romaji": "onaji sutaato chiten ni ita"
    },
    {
      "text": "だのになのに君ときたら",
      "romaji": "danoni nanoni kimi to kitara"
    },
    {
      "text": "落ちこぼれて",
      "romaji": "ochi koborete"
    },
    {
      "text": "ギフトまで錆びつかせ",
      "romaji": "gifuto made sabitsukase"
    },
    {
      "text": "周りとの差開く一方で",
      "romaji": "mawari to no sahiraku ippou de"
    },
    {
      "text": "ふてくされて沈んでた",
      "romaji": "futeku sarete shizundeta"
    },
    {
      "text": "君に星が　笑った",
      "romaji": "kimi ni hoshi ga waratta"
    },
    {
      "text": "恐れるな",
      "romaji": "osoreru na"
    },
    {
      "text": "上昇気流に乗って",
      "romaji": "joushou kiryuu ni notte"
    },
    {
      "text": "メインベルト突き抜けて",
      "romaji": "mein beruto tsukinukete"
    },
    {
      "text": "青を掴み取れ",
      "romaji": "ao o tsukami tore"
    },
    {
      "text": "「応援届いたかな？」",
      "romaji": "\"ouen todoita ka na?\""
    },
    {
      "text": "フレー未完成",
      "romaji": "furee mikansei"
    },
    {
      "text": "遅すぎるなんて辞書にはない",
      "romaji": "ososugiru nante jisho ni wa nai"
    },
    {
      "text": "フレー原石",
      "romaji": "furee genseki"
    },
    {
      "text": "勇敢なる青掲げろ",
      "romaji": "yuukan naru ao kakagero"
    },
    {
      "text": "君は君だよ",
      "romaji": "kimi wa kimi da yo"
    },
    {
      "text": "不器用に描こう",
      "romaji": "bukiyou ni egakou"
    },
    {
      "text": "幼い頃に憧れた",
      "romaji": "osanai koro ni akogareta"
    },
    {
      "text": "ヒーローみたいになれるなくて",
      "romaji": "hiiroo mitai ni nareru nakute"
    },
    {
      "text": "それなりなんて都合よく",
      "romaji": "sore nari nante tsugou yoku"
    },
    {
      "text": "濁しながら逃げて逃げて ah",
      "romaji": "nigoshi nagara nigete nigete ah"
    },
    {
      "text": "フラフラ進もう",
      "romaji": "furafura susumou"
    },
    {
      "text": "青いまま進めばいい",
      "romaji": "aoi mama susumeba ii"
    }
  ]
}
