  "lines": [
    {
      "text": "いますぐ輪廻 今回も結ばれないね",
      "romaji": "ima sugu rinne konkai mo musubarenai ne"
    },
    {
      "text": "嘘ついたら針千本 誓って",
      "romaji": "uso tsuitara harisenbon chikatte"
    },
    {
      "text": "ぜったい来世でまた会お？",
      "romaji": "zettai raise de mata ao?"
    },
    {
      "text": "全て捨てて ぽいっ",
      "romaji": "subete sutete poi'"
    },
    {
      "text": "さらば 生まれ変わる",
      "romaji": "saraba umarekawaru"
    },
    {
      "text": "あまりに人生が憂い",
      "romaji": "amari ni jinsei ga ui"
    },
    {
      "text": "君の指輪も白紙になって",
      "romaji": "kimi no yubiwa mo hakushi ni natte!"
    },
    {
      "text": "どうせ生まれ変わって",
      "romaji": "douse umarekawatte"
    },
    {
      "text": "巡って 出会って",
      "romaji": "megutte deatte"
    },
    {
      "text": "宇宙が爆ぜてしまうまで",
      "romaji": "uchuu ga hazete shimau made"
    },
    {
      "text": "何回も大好きになって",
      "romaji": "nankai mo daisuki ni natte"
    },
    {
      "text": "毎回繰り返す身勝手",
      "romaji": "maikai kurikaesu migatte"
    },
    {
      "text": "ごめんね",
      "romaji": "gomen ne"
    },
    {
      "text": "『メタモルフォーゼ』",
      "romaji": "\"metamorufooze\""
    },
    {
      "text": "だから 生まれ変われ",
      "romaji": "dakara umarekaware"
    },
    {
      "text": "間違った人生は憂い",
      "romaji": "machigatta jinsei wa ui"
    },
    {
      "text": "君の隣は私になって？",
      "romaji": "kimi no tonari wa watashi ni natte?"
    },
    {
      "text": "運命よ 跪け",
      "romaji": "unmei yo, hizamazuke"
    },
    {
      "text": "いますぐ輪廻 今回は報われないね",
      "romaji": "ima sugu rinne konkai wa mukuwarenai ne"
    },
    {
      "text": "全て捨てて",
      "romaji": "subete sutete"
    },
    {
      "text": "いますぐしんで",
      "romaji": "ima sugu shinde!"
    },
    {
      "text": "ファンファーレが鳴って",
      "romaji": "fanfaare ga natte"
    },
    {
      "text": "大正解 おめでとう",
      "romaji": "daiseikai, omedetou!"
    },
    {
      "text": "ようやく君は救われる",
      "romaji": "youyaku kimi wa sukuwareru"
    },
    {
      "text": "来世でまた会おう",
      "romaji": "raise de mata aou"
    },
    {
      "text": "いますぐ輪廻 ちょっと苦しんで",
      "romaji": "ima sugu rinne chotto kurushinde"
    },
    {
      "text": "ツインレイなんだよ？",
      "romaji": "tsuinrei nanda yo?"
    },
    {
      "text": "早く",
      "romaji": "hayaku..."
    },
    {
      "text": "ねぇ 私と一つになろう",
      "romaji": "nee, watashi to hitotsu ni narou"
    },
    {
      "text": "さぁ魂の浄化 死への調和",
      "romaji": "saa tamashii no jouka shi e no chouwa"
    },
    {
      "text": "どうか光になって",
      "romaji": "dou ka hikari ni natte"
    }
  ]
}
