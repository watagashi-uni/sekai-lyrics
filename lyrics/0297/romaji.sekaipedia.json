  "lines": [
    {
      "text": "心臓に傷を負った",
      "romaji": "shinzou ni kizu o otta."
    },
    {
      "text": "癒えない言えない黒い傷",
      "romaji": "ienai ienai kuroi kizu."
    },
    {
      "text": "泪が溢れ出して止まらない",
      "romaji": "namida ga afure dashite tomaranai."
    },
    {
      "text": "早く止血剤をくれ",
      "romaji": "hayaku shiketsuzai o kure!"
    },
    {
      "text": "無意味な液体を流し込む",
      "romaji": "muimi na ekitai o nagashi komu."
    },
    {
      "text": "化学反応で発作が起こって",
      "romaji": "kagaku hannou de hossa ga okotte,"
    },
    {
      "text": "あいつの身体は重傷になって",
      "romaji": "aitsu no karada wa juushou ni natte,"
    },
    {
      "text": "どうやら手遅れのようだ",
      "romaji": "douyara teokure no you da."
    },
    {
      "text": "幸福に浸って帰らぬ医療廃棄物となった",
      "romaji": "koufuku ni hitatte kaeranu iryou haikibutsu to natta."
    },
    {
      "text": "注射器にキスをした",
      "romaji": "chuusaki ni kisu o shita."
    },
    {
      "text": "冥界は冷静に笑った",
      "romaji": "meikai wa reisei ni waratta."
    },
    {
      "text": "体内は空",
      "romaji": "tainai wa kuu."
    },
    {
      "text": "絶望は幸福になって",
      "romaji": "zetsubou wa koufuku ni natte,"
    },
    {
      "text": "空想は実在になって",
      "romaji": "kuusou wa jitsuzai ni natte,"
    },
    {
      "text": "錆切った感覚は中和している",
      "romaji": "sabi kitta kankaku wa chuuwa shite iru."
    },
    {
      "text": "生活は残骸になって",
      "romaji": "seikatsu wa zangai ni natte,"
    },
    {
      "text": "正常は感冒になって",
      "romaji": "seijou wa kanbou ni natte,"
    },
    {
      "text": "腐り尽くした吐瀉物で乾杯をした",
      "romaji": "kusari tsukushita toshabutsu de kanpai o shita."
    }
  ]
}
