  "lines": [
    {
      "text": "ああすれば良かった",
      "romaji": "aa sureba yokatta"
    },
    {
      "text": "こう言えば良かった",
      "romaji": "kou ieba yokatta"
    },
    {
      "text": "良かったかなんて別に ",
      "romaji": "yokatta ka nante betsuni"
    },
    {
      "text": "わからないけど",
      "romaji": "wakaranai kedo"
    },
    {
      "text": "後悔なんてしたくない",
      "romaji": "koukai nante shitakunai"
    },
    {
      "text": "でもどうでもよくもしたくない",
      "romaji": "demo dou demo yoku mo shitakunai"
    },
    {
      "text": "ちょうどいいところ",
      "romaji": "choudo ii tokoro"
    },
    {
      "text": "こころ収まらなくて",
      "romaji": "kokoro osamaranakute"
    },
    {
      "text": "答え合わせをさせてよ",
      "romaji": "kotaeawase o sasete yo"
    },
    {
      "text": "何がいけなかったですか",
      "romaji": "nani ga ikenakatta desu ka"
    },
    {
      "text": "試すようなこと したくないのに",
      "romaji": "tamesu you na koto shitakunai noni"
    },
    {
      "text": "確かめたくなっちゃって",
      "romaji": "tashikametaku nacchatte"
    },
    {
      "text": "僕たちは どうして",
      "romaji": "bokutachi wa doushite"
    },
    {
      "text": "すぐ間違えて しまうんだろう",
      "romaji": "sugu machigaete shimau ndarou"
    },
    {
      "text": "大切の優先順位",
      "romaji": "taisetsu no yuusen juni"
    },
    {
      "text": "わかんなくなる",
      "romaji": "wakannaku naru"
    },
    {
      "text": "涙を拭いて 歩いた",
      "romaji": "namida wo fuite aruita"
    },
    {
      "text": "あのときの 選択を",
      "romaji": "ano toki no sentaku wo"
    },
    {
      "text": "疑いたくなんてなかった",
      "romaji": "utagaitaku nante nakatta"
    },
    {
      "text": "何してんだろう",
      "romaji": "nani shite ndarou"
    },
    {
      "text": "とらわれてさ",
      "romaji": "torawarete sa"
    },
    {
      "text": "バカみたいだなぁ",
      "romaji": "baka mitai da naa"
    }
  ]
}
