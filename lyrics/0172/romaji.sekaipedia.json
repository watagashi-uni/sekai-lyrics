  "lines": [
    {
      "text": "ねえ　もう暗くなりそうだから",
      "romaji": "nee mou kuraku narisou dakara"
    },
    {
      "text": "デちゃってもい い かしら？",
      "romaji": "dechatte mo ii kashira?"
    },
    {
      "text": "ちょっとね　魔法にかけられた",
      "romaji": "chotto ne mahou ni kakerareta"
    },
    {
      "text": "キミのお菓子から食べちゃうぞ",
      "romaji": "kimi no okashi kara tabechau zo"
    },
    {
      "text": "きっと　もう霧が濃くなるから",
      "romaji": "kitto mou kiri ga koku naru kara"
    },
    {
      "text": "ミンナ　集まるかな？",
      "romaji": "minna atsumaru kana?"
    },
    {
      "text": "じっと待って　アマイモノ我慢した",
      "romaji": "jitto matte amaimono gaman shita"
    },
    {
      "text": "ご褒美を　ほら",
      "romaji": "gohoubi o hora"
    },
    {
      "text": "ひとつ　ふたつ　鐘の音",
      "romaji": "hitotsu futatsu kane no ne"
    },
    {
      "text": "騒ぎ出す　小さいオバケたち",
      "romaji": "sawagidasu chiisai obaketachi"
    },
    {
      "text": "今日は許してくれるの",
      "romaji": "kyou wa yurushite kureru no"
    },
    {
      "text": "さあ　街に行こう",
      "romaji": "saa machi ni ikou"
    },
    {
      "text": "だって Happy Halloween",
      "romaji": "datte happy halloween"
    },
    {
      "text": "悪戯しちゃうぞ ding-dong-dang",
      "romaji": "itazura shichau zo ding-dong-dang"
    },
    {
      "text": "あっちもこっちも trick or treat",
      "romaji": "acchi mo kocchi mo trick or treat"
    },
    {
      "text": "キャンディーはくれないの？",
      "romaji": "kyandii wa kurenai no?"
    },
    {
      "text": "幼気なランタンパンプキン",
      "romaji": "itaike na rantan panpunkin"
    },
    {
      "text": "疲れたジャックも踊るよ　朝まで",
      "romaji": "tsukareta jakku mo odoru yo asa made"
    },
    {
      "text": "オバケのカブだってラララ",
      "romaji": "obake no kabu datte la la la"
    },
    {
      "text": "今日は街中 trick or treat",
      "romaji": "kyou wa machijuu trick or treat"
    },
    {
      "text": "チョコも頂戴よ",
      "romaji": "choko mo choudai yo"
    },
    {
      "text": "不思議な世界へようこそ",
      "romaji": "fushiga na sekai e youkoso"
    },
    {
      "text": "疲れたジャックも歌うよ",
      "romaji": "tsukareta jakku mo utau yo"
    },
    {
      "text": "今日は Happy Halloween",
      "romaji": "kyou wa happy halloween"
    },
    {
      "text": "さぁ Let's trick or treat",
      "romaji": "saa, let's trick or treat"
    },
    {
      "text": "赤いキャンディー　コロがして",
      "romaji": "akai kyandii koro ga shite"
    },
    {
      "text": "朝まで寝たくない",
      "romaji": "asa made netakunai"
    }
  ]
}
