  "lines": [
    {
      "text": "「オーホッホッホッホ。さあ、ひざまずきなさい！」",
      "romaji": "\"oohohohoho. saa, hizamazukinasai!\""
    },
    {
      "text": "むかしむかしあるところに",
      "romaji": "mukashi mukashi aru tokoro ni"
    },
    {
      "text": "悪逆非道の王国の",
      "romaji": "akugyaku hidou no oukoku no"
    },
    {
      "text": "頂点に君臨するは",
      "romaji": "chouten ni kunrin suru wa"
    },
    {
      "text": "齢十四の王女様",
      "romaji": "yowai juu yon no oujo sama"
    },
    {
      "text": "絢爛豪華な調度品",
      "romaji": "kenran gouka na choudo hin"
    },
    {
      "text": "愛馬の名前はジョセフィーヌ",
      "romaji": "aiba no namae wa josefiinu"
    },
    {
      "text": "全てが全て彼女のもの",
      "romaji": "subete ga subete kanojo no mono"
    },
    {
      "text": "お金が足りなくなったなら",
      "romaji": "okane ga tarinaku natta nara"
    },
    {
      "text": "愚民どもから搾りとれ",
      "romaji": "gumin domo kara shibori tore"
    },
    {
      "text": "私に逆らう者たちは",
      "romaji": "watashi ni sakarau mono tachi wa"
    },
    {
      "text": "粛清してしまえ",
      "romaji": "shukusei shite shimae"
    },
    {
      "text": "さあ、ひざまずきなさい",
      "romaji": "\"saa, hizamazukinasai!\""
    },
    {
      "text": "悪の華 可憐に咲く",
      "romaji": "aku no hana karen ni saku"
    },
    {
      "text": "鮮やかな彩りで",
      "romaji": "azayaka na irodori de"
    },
    {
      "text": "周りの哀れな雑草は",
      "romaji": "mawari no aware na zassou wa"
    },
    {
      "text": "嗚呼 養分となり朽ちていく",
      "romaji": "aa youbun to nari kuchite iku"
    }
  ]
}
