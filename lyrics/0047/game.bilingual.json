    {
      "index": 1,
      "start": 32.928251,
      "end": 34.992382,
      "japanese": "朝　目が覚めて",
      "zh-CN": "清晨 睁开双眼",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 34.992382,
      "end": 42.725114,
      "japanese": "真っ先に思い浮かぶ　君のこと",
      "zh-CN": "最先浮现在脑海之中的 便是关于你的一切",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 44.232401,
      "end": 48.422759,
      "japanese": "思い切って　前髪を切った",
      "zh-CN": "下定决心 剪短了刘海",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 48.422759,
      "end": 54.688265,
      "japanese": "「どうしたの？」って　聞かれたくて",
      "zh-CN": "只是想听你问一句“怎么啦？”",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 54.688265,
      "end": 60.466031,
      "japanese": "ピンクのスカート　お花の髪飾り",
      "zh-CN": "粉红色的短裙 花朵的发饰",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 60.466031,
      "end": 63.346401,
      "japanese": "さして　出かけるの",
      "zh-CN": "别好之后 便出门去啦",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 63.346401,
      "end": 69.149205,
      "japanese": "今日の私は かわいいのよ！",
      "zh-CN": "今天的我 可是非常可爱哦！",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 69.399585,
      "end": 73.843327,
      "japanese": "メルト　溶けてしまいそう",
      "zh-CN": "快要融化了 感觉整个人快要融化了",
      "shared_interval": false
    },
    {
      "index": 9,
      "start": 73.843327,
      "end": 85.171514,
      "japanese": "好きだなんて　絶対にいえない…",
      "zh-CN": "喜欢你什么的 绝对说不出口……",
      "shared_interval": true
    },
    {
      "index": 10,
      "start": 73.843327,
      "end": 85.171514,
      "japanese": "だけど　メルト　目も合わせられない",
      "zh-CN": "可是 融化了 甚至连眼神都无法对视",
      "shared_interval": true
    },
    {
      "index": 11,
      "start": 85.171514,
      "end": 91.180631,
      "japanese": "恋に恋なんてしないわ　わたし",
      "zh-CN": "我可不是沉溺于恋爱本身哦",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 91.180631,
      "end": 97.001462,
      "japanese": "だって　君のことが (…好きなの)",
      "zh-CN": "因为我真正喜欢的是你（……喜欢你）",
      "shared_interval": false
    },
    {
      "id": "full-000014",
      "order": 13,
      "index": 13,
      "start": 97.241,
      "end": 103.29,
      "japanese": "お願い　時間をとめて　泣きそうなの",
      "zh-CN": "求求你 让时间停下吧 我快要哭出来了",
