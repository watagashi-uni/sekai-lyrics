  "lines": [
    {
      "text": "触れて 深くヒリついた",
      "romaji": "furete fukaku hiritsuita"
    },
    {
      "text": "窓に映った世界 赤く染まる",
      "romaji": "mado ni utsutta sekai, akaku somaru"
    },
    {
      "text": "きっとずっと愛と為る未来だ",
      "romaji": "kitto zutto ai to naru mirai da"
    },
    {
      "text": "ケセラセラ 明日に寄せては返す",
      "romaji": "kesera sera ashita ni yosete wa kaesu"
    },
    {
      "text": "機能性重視のミドルスター",
      "romaji": "kinousei juushi no midorusutaa"
    },
    {
      "text": "紙に書いた小説の一節かい？",
      "romaji": "kami ni kaita shousetsu no issetsu kai?"
    },
    {
      "text": "Adjust 突き抜けた行動見出した",
      "romaji": "Adjust tsukinuketa koudou miidashita"
    },
    {
      "text": "いくつかの光",
      "romaji": "ikutsuka no hikari"
    },
    {
      "text": "救命 キミの気持ち苦しい",
      "romaji": "kyuumei kimi no kimochi kurushii"
    },
    {
      "text": "飛び出した",
      "romaji": "tobidashita"
    },
    {
      "text": "ありきたりご高説 動悸的な何か",
      "romaji": "arikitari gokousetsu doukitekina nanika"
    },
    {
      "text": "気にしないでなんて無責任なフリ",
      "romaji": "kinishinaide nante musekinin na furi"
    },
    {
      "text": "激しく揺さぶる甲状腺ブレスト",
      "romaji": "hageshiku yusaburu koujousen buresuto"
    },
    {
      "text": "振り乱した感情切り裂いて",
      "romaji": "furimidashita kanjou kirisaite"
    },
    {
      "text": "潤んだ瞳噛み締めてまた消失",
      "romaji": "urunda hitomi kamishimete mata shoushitsu"
    },
    {
      "text": "利便性休止の気取るスタンス",
      "romaji": "ribensei kyuushi no kidoru sutansu"
    },
    {
      "text": "闇を割いた良識と気色奇怪",
      "romaji": "yami o saita ryoushiki to kishoku kikai"
    },
    {
      "text": "クラスタの気持ちを乱して",
      "romaji": "kurasuta no kimochi o ran shite"
    },
    {
      "text": "飽きもせずダイス",
      "romaji": "aki mo sezu daisu"
    }
  ]
}
