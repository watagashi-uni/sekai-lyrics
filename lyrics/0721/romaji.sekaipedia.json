  "lines": [
    {
      "text": "絡めた鼓動 捧げたもの",
      "romaji": "karameta kodou sasageta mono"
    },
    {
      "text": "忘れないよ あの記憶も",
      "romaji": "wasurenai yo ano kioku mo"
    },
    {
      "text": "もっと もっと",
      "romaji": "motto motto"
    },
    {
      "text": "終わってしまう前に 終わらせよう",
      "romaji": "owatte shimau mae ni owaraseyou"
    },
    {
      "text": "乾ききった おままごと",
      "romaji": "kawakikitta omamagoto"
    },
    {
      "text": "こうしてやる 裏切り者は",
      "romaji": "koushite yaru, uragirimono wa."
    },
    {
      "text": "返してくれ 私の想いを",
      "romaji": "kaeshite kure watashi no omoi o."
    },
    {
      "text": "ずっと",
      "romaji": "zutto...."
    },
    {
      "text": "愛していたのに)",
      "romaji": "aishite ita no ni)"
    },
    {
      "text": "入ってきて 私の内側",
      "romaji": "haitte kite, watashi no uchigawa!"
    }
  ]
}
