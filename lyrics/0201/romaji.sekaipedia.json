  "lines": [
    {
      "text": "思い通りにいかないことだらけ",
      "romaji": "omoi doori ni ikanai koto darake"
    },
    {
      "text": "どうしようもなく自己嫌悪",
      "romaji": "doushiyou mo naku jiko ken'o"
    },
    {
      "text": "八百万の痛みや悲しみから",
      "romaji": "yaoyorozu no itamiya kanashimi kara"
    },
    {
      "text": "逃げ込める場所を探してる",
      "romaji": "nigekomeru basho o sagashiteru"
    },
    {
      "text": "いっそ 岩の隙間に引きこもって",
      "romaji": "isso iwa no sukima ni hiki komotte"
    },
    {
      "text": "月も太陽も無視して眠ろう",
      "romaji": "tsuki mo taiyou mo mushi shite nemurou"
    },
    {
      "text": "生まれてきたことの意味なんて",
      "romaji": "umaretekita koto no imi nante"
    },
    {
      "text": "知らない分かんないよ",
      "romaji": "shiranai wakannai yo"
    },
    {
      "text": "でもそんな風に思えるってこと",
      "romaji": "demo sonna fuu ni omoerutte koto"
    },
    {
      "text": "誰だって地球を愛してる",
      "romaji": "dare datte chikyuu o aishiteru"
    },
    {
      "text": "たまにゃそんなのもいいね",
      "romaji": "tamanya sonna no mo ii ne"
    },
    {
      "text": "なんだかんだ地球を愛してる",
      "romaji": "nanda kanda chikyuu o aishiteru"
    },
    {
      "text": "まだまだ先は長いさ",
      "romaji": "madamada saki wa nagai sa"
    },
    {
      "text": "みんなありがとう",
      "romaji": "minna arigatou"
    },
    {
      "text": "やっぱり地球を愛してる",
      "romaji": "yappari chikyuu o aishiteru"
    },
    {
      "text": "花を咲かそう",
      "romaji": "hana o sakasou"
    }
  ]
}
