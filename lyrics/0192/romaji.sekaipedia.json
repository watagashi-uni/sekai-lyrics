  "lines": [
    {
      "text": "今宵は祝いの宴",
      "romaji": "koyoi wa iwai no utage"
    },
    {
      "text": "王も諸侯も無礼講",
      "romaji": "ou mo shokou mo bureikou"
    },
    {
      "text": "そばかす少女の歌に合わせ",
      "romaji": "sobakasu shoujo no uta ni awase"
    },
    {
      "text": "去り人達が踊りだす",
      "romaji": "saribitotachi ga odoridasu"
    },
    {
      "text": "貴族が仕立て屋を誘い",
      "romaji": "kizoku ga shitateya o sasoi"
    },
    {
      "text": "今は全ての罪忘れ",
      "romaji": "ima wa subete no tsumi wasure"
    },
    {
      "text": "共にワルツを踊りましょう",
      "romaji": "tomo ni warutsu o odorimashou"
    },
    {
      "text": "夜空の満月",
      "romaji": "yozora no mangetsu"
    },
    {
      "text": "もはや欠けることもない",
      "romaji": "mohaya kakeru koto mo nai"
    },
    {
      "text": "悪の華舞い踊る",
      "romaji": "aku no hana mai odoru"
    },
    {
      "text": "罪深き彩りで",
      "romaji": "tsumi bukaki irodori de"
    },
    {
      "text": "そのナイフを仕舞いなさい",
      "romaji": "sono naifu o shimai nasai"
    },
    {
      "text": "誰の命も奪えない",
      "romaji": "dare no inochi mo ubaenai"
    }
  ]
}
