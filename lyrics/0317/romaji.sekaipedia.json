  "lines": [
    {
      "text": "1・2・3で世界変える",
      "romaji": "1, 2, 3 de sekai kaeru"
    },
    {
      "text": "魔法みたいなミュージック",
      "romaji": "mahou mitai na myuujikku"
    },
    {
      "text": "届けてあげるよ",
      "romaji": "todokete ageru yo"
    },
    {
      "text": "満ち足りた毎日でも",
      "romaji": "michitarita mainichi demo"
    },
    {
      "text": "スリルが欲しくなったり",
      "romaji": "suriru ga hoshiku nattari"
    },
    {
      "text": "心はワガママのミルフィーユ",
      "romaji": "kokoro wa wagamama no mirufiiyu"
    },
    {
      "text": "そんな退屈してるなら",
      "romaji": "sonna taikutsu shiteru nara"
    },
    {
      "text": "ちょっと耳貸してよ",
      "romaji": "chotto mimi kashite yo"
    },
    {
      "text": "イヤフォンで味わう",
      "romaji": "iyafon de ajiwau"
    },
    {
      "text": "ストーリーあげるから",
      "romaji": "sutoorii ageru kara"
    },
    {
      "text": "旋律のファウンテン",
      "romaji": "senritsu no faunten"
    },
    {
      "text": "潜って虹かけて",
      "romaji": "kugutte niji kakete"
    },
    {
      "text": "色んな姿に形を変える",
      "romaji": "iron na sugata ni katachi o kaeru"
    },
    {
      "text": "いつまでもずっと",
      "romaji": "itsumade mo zutto"
    },
    {
      "text": "鮮やかでいたいなら",
      "romaji": "azayaka de itai nara"
    },
    {
      "text": "何度だって冒険しようよ",
      "romaji": "nando datte bouken shiyou yo"
    },
    {
      "text": "はじめまして",
      "romaji": "hajimemashite"
    },
    {
      "text": "この歌を届けるから",
      "romaji": "kono uta o todokeru kara"
    },
    {
      "text": "心の耳すまして",
      "romaji": "kokoro o mimi sumashite"
    },
    {
      "text": "また新しいページに",
      "romaji": "mata atarashii peeji ni"
    },
    {
      "text": "この想い繋いで",
      "romaji": "kono omoi tsunai de"
    },
    {
      "text": "まだ見ぬストーリーを",
      "romaji": "mada minu sutoorii o"
    },
    {
      "text": "ねえねえこの歌知ってる？",
      "romaji": "nee nee kono uta shitteru?"
    },
    {
      "text": "もう怖がらなくていいよ",
      "romaji": "mou kowagara nakute ii yo"
    },
    {
      "text": "さあさあまだまだ行けるよね",
      "romaji": "saa saa madamada ikeru yo ne"
    },
    {
      "text": "終わりなんてないんだ",
      "romaji": "owari nante nai nda"
    },
    {
      "text": "新しい自分は",
      "romaji": "atarashii jibun wa"
    },
    {
      "text": "めくるページの先に",
      "romaji": "mekuru peeji no saki ni"
    },
    {
      "text": "いつでもここにある",
      "romaji": "itsudemo koko ni aru"
    },
    {
      "text": "大冒険の扉さ",
      "romaji": "daibouken no tobira sa"
    }
  ]
}
