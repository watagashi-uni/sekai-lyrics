  "lines": [
    {
      "text": "想いをのせて紡ぎたい",
      "romaji": "omoi o nosete tsumugitai"
    },
    {
      "text": "ありのままのストーリーを",
      "romaji": "ari no mama no sutoorii o"
    },
    {
      "text": "(ハイ！）",
      "romaji": "(hai!)"
    },
    {
      "text": "ずっと叶えたい未来のために Ah",
      "romaji": "zutto kanaetai asu no tame ni Ah"
    },
    {
      "text": "僕になにができるのかな",
      "romaji": "boku ni nani ga dekiru no ka na"
    },
    {
      "text": "もっと届けたい遥か遠く Ah",
      "romaji": "motto todoketai haruka tooku Ah"
    },
    {
      "text": "誰かの笑み咲かせたいから",
      "romaji": "dareka no emi sakasetai kara"
    },
    {
      "text": "惑わす影を踏みしめて",
      "romaji": "madowasu kage o fumishimete"
    },
    {
      "text": "心繋いだら Ah",
      "romaji": "kokoro tsunaidara Ah"
    },
    {
      "text": "もう怖くない 迷いもしない",
      "romaji": "mou kowakunai mayoi mo shinai"
    },
    {
      "text": "君とならどこまでだっ",
      "romaji": "kimi to nara dokomade datte"
    },
    {
      "text": "飛べるから",
      "romaji": "toberu kara"
    },
    {
      "text": "ドキドキしよう きらめく夜に",
      "romaji": "dokidoki shiyou kirameku yoru ni"
    },
    {
      "text": "不器用な ままでいい",
      "romaji": "bukiyou na mama de ii"
    },
    {
      "text": "一緒に 踊りましょう",
      "romaji": "issho ni odorimashou"
    },
    {
      "text": "僕らの声が響くセカイで",
      "romaji": "bokura no koe ga hibiku sekai de"
    }
  ]
}
