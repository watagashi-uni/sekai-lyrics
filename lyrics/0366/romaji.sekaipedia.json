  "lines": [
    {
      "text": "不完全な 僕を",
      "romaji": "fukanzen na boku o"
    },
    {
      "text": "生き写したような 音色",
      "romaji": "ikiutsushita you na neiro"
    },
    {
      "text": "いつか 途絶えてしまった",
      "romaji": "itsuka todaite shimatta"
    },
    {
      "text": "歌えなくなっていった",
      "romaji": "utaenaku natte itta"
    },
    {
      "text": "不恰好な 声の",
      "romaji": "bukakkou na koe no"
    },
    {
      "text": "みんな、無視していた曲を",
      "romaji": "minna, mushi shiteita kyoku o"
    },
    {
      "text": "今も覚えているはずさ",
      "romaji": "ima mo oboete iru hazu sa"
    },
    {
      "text": "あれを「ラブソング」って言うんだ",
      "romaji": "are o \"rabu songu\" tte iu nda"
    },
    {
      "text": "ああ 時代がワープして",
      "romaji": "aa jidai ga waapu shite"
    },
    {
      "text": "君が置いてかれるから",
      "romaji": "kimi ga oite kareru kara"
    },
    {
      "text": "そんな涙 誰にも気づかれる訳ないだろ",
      "romaji": "sonna namida dare ni mo kizukareru wake nai daro"
    },
    {
      "text": "だったら 泣き喚こうぜ",
      "romaji": "dattara nakiwamekou ze"
    },
    {
      "text": "マイクロフォンを ひっさげて",
      "romaji": "maikurofon o hissagete"
    },
    {
      "text": "もう一回",
      "romaji": "mou ikkai"
    },
    {
      "text": "強がって 吐き出して",
      "romaji": "tsuyogatte hakidashite"
    },
    {
      "text": "胸を焦がして",
      "romaji": "mune o kogashite"
    },
    {
      "text": "限界に気がついたって 足掻いて",
      "romaji": "genkai ni ki ga tsuita tte agaite"
    },
    {
      "text": "バカな君は歌う",
      "romaji": "baka na kimi wa utau"
    },
    {
      "text": "何万回",
      "romaji": "nanmankai"
    },
    {
      "text": "消えたって 消えないで",
      "romaji": "kieta tte kienai de"
    },
    {
      "text": "響いた あの曲は",
      "romaji": "hibiita ano kyoku wa"
    },
    {
      "text": "そうやって 唄うんだよ",
      "romaji": "sou yatte utau nda yo"
    },
    {
      "text": "気づいたかい NEO",
      "romaji": "kizuita kai NEO"
    },
    {
      "text": "「初めまして」は 済ませたかい NEO",
      "romaji": "\"hajimemashite\" wa sumaseta kai NEO"
    },
    {
      "text": "こんな 四小節に願って",
      "romaji": "konna yonshousetsu ni negatte"
    },
    {
      "text": "夢を託して",
      "romaji": "yume o takushite"
    },
    {
      "text": "「当然」に 抗って 逆らって",
      "romaji": "\"touzen\" ni aragatte sakaratte"
    },
    {
      "text": "忘れられたって 死なないで",
      "romaji": "wasurerareta tte shinanai de"
    },
    {
      "text": "響いた その曲は",
      "romaji": "hibiita sono kyoku wa"
    },
    {
      "text": "「希望」って言うんだよ",
      "romaji": "\"kibou\" tte iun da yo"
    },
    {
      "text": "やっと",
      "romaji": "yatto"
    },
    {
      "text": "気がついて 高鳴った",
      "romaji": "ki ga tsuite takanatta"
    },
    {
      "text": "僕と君は歌う",
      "romaji": "boku to kimi wa utau"
    },
    {
      "text": "響いた この曲は",
      "romaji": "hibiita kono kyoku wa"
    },
    {
      "text": "こうやって 唄うんだろ",
      "romaji": "kou yatte utau ndaro"
    },
    {
      "text": "そうだろ NEO",
      "romaji": "sou daro NEO"
    },
    {
      "text": "「初めまして」は 届いたかい NEO",
      "romaji": "\"hajimemashite\" wa todoita kai NEO"
    }
  ]
}
