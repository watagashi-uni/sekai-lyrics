  "lines": [
    {
      "text": "君の自由を奪ってく",
      "romaji": "kimi no jiyuu o ubatteku!"
    },
    {
      "text": "だから",
      "romaji": "dakara"
    },
    {
      "text": "トラッシュトラッシュ何もかも",
      "romaji": "torasshu torasshu nani mo ka mo"
    },
    {
      "text": "何もかも捨てちまえ",
      "romaji": "nani mo ka mo sutechimae!"
    },
    {
      "text": "トラッシュトラッシュ断捨離は",
      "romaji": "torasshu torasshu danshari wa"
    },
    {
      "text": "思い出つまった宝物?",
      "romaji": "omoide tsumatta takara mono"
    },
    {
      "text": "そうやって否定ばっかしてる奴",
      "romaji": "sou yatte hitei bakka shiteru yatsu"
    },
    {
      "text": "僕だってゴミになる",
      "romaji": "boku datte gomi ni naru"
    },
    {
      "text": "トラッシュ トラッシュいらないや",
      "romaji": "torasshu torasshu iranai ya"
    },
    {
      "text": "やなとこばっかりさ",
      "romaji": "ya na toko bakkari sa"
    },
    {
      "text": "直す気ないから捨てましょねー",
      "romaji": "naosuki nai kara sute masho nee"
    },
    {
      "text": "愛される要素あるわけないから",
      "romaji": "aisareru youso aru wakenai kara"
    },
    {
      "text": "トラッシュトラッシュさようなら",
      "romaji": "torasshu torasshu sayounara"
    },
    {
      "text": "さようならはい さようなら",
      "romaji": "sayounara hai sayounara"
    },
    {
      "text": "動けないんです",
      "romaji": "ugokenai ndesu"
    },
    {
      "text": "仕方がないよね?さようなら",
      "romaji": "shikata ga nai yo ne sayounara"
    },
    {
      "text": "いらない",
      "romaji": "iranai!"
    }
  ]
}
