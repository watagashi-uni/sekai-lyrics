  "lines": [
    {
      "text": "Catch the wave 君と",
      "romaji": "Catch the wave kimi to"
    },
    {
      "text": "掴む音で",
      "romaji": "tsukamu oto de"
    },
    {
      "text": "まだまだ歌おう",
      "romaji": "madamada utaou"
    },
    {
      "text": "もっと",
      "romaji": "motto"
    },
    {
      "text": "僕らの未来 震わせよう",
      "romaji": "bokura no mirai furuwaseyou"
    },
    {
      "text": "楽しいこと 続くように",
      "romaji": "tanoshii koto tsuzuku you ni"
    },
    {
      "text": "掬い上げた 無数の音は",
      "romaji": "sukuiageta musuu no oto wa"
    },
    {
      "text": "どれだけ 時が経っても",
      "romaji": "dore dake toki ga tatte mo"
    },
    {
      "text": "形を変えて 踊るよ",
      "romaji": "katachi o kaete odoru yo"
    },
    {
      "text": "いつかの 君があげた",
      "romaji": "itsuka no kimi ga ageta"
    },
    {
      "text": "プレゼントは 今へのしるし",
      "romaji": "purezento wa ima e no shirushi"
    },
    {
      "text": "自由に もっと気ままに",
      "romaji": "jiyuu ni motto kimama ni"
    },
    {
      "text": "さんざめいてこう",
      "romaji": "sanzameite kou"
    },
    {
      "text": "まだまだ踊ろう",
      "romaji": "madamada odorou"
    },
    {
      "text": "きっと",
      "romaji": "kitto"
    },
    {
      "text": "このビートが また紡いでく",
      "romaji": "sono biito ga mata tsumuideku"
    },
    {
      "text": "Catch the wave 僕と",
      "romaji": "Catch the wave boku to"
    },
    {
      "text": "ただただ歌おう",
      "romaji": "tadatada utaou"
    }
  ]
}
