  "lines": [
    {
      "text": "忘れられぬものだけが",
      "romaji": "wasurerarenu mono dake ga"
    },
    {
      "text": "美しくはないのでしょう",
      "romaji": "utsukushiku wa nai no deshou"
    },
    {
      "text": "忘れることばかりが",
      "romaji": "wasureru koto bakari ga"
    },
    {
      "text": "美しくはないでしょう",
      "romaji": "utsukushiku wa nai deshou"
    },
    {
      "text": "悲しいことばかりが",
      "romaji": "kanashii koto bakari ga"
    },
    {
      "text": "人生ではないのでしょう",
      "romaji": "jinsei de wa nai no deshou"
    },
    {
      "text": "さりとて喜びとは",
      "romaji": "saritote yorokobi to wa"
    },
    {
      "text": "比べ往くでしょう",
      "romaji": "kurabe yuku deshou"
    },
    {
      "text": "船よ　船よ　荒波の中で",
      "romaji": "fune yo fune yo aranami no naka de"
    },
    {
      "text": "流されずいられたでしょう",
      "romaji": "nagasarezu irareta deshou"
    },
    {
      "text": "水底に根差す　あなたと穿った少女時代",
      "romaji": "minasoko ni nezasu anata to ugatta shoujo jidai"
    },
    {
      "text": "さよならする頃",
      "romaji": "sayonara suru koro"
    },
    {
      "text": "強いられるのは抜錨",
      "romaji": "shiirareru no wa batsubyou"
    },
    {
      "text": "傷の数を数えて",
      "romaji": "kizu no kazu o kazoete"
    },
    {
      "text": "痛みの数　指を折る",
      "romaji": "itami no kazu yubi o oru"
    },
    {
      "text": "一つあまり　小指は",
      "romaji": "hitotsu amari koyubi wa"
    },
    {
      "text": "愛しさのぶんね",
      "romaji": "itoshisa no bun ne"
    },
    {
      "text": "辛いこともありましょう",
      "romaji": "tsurai koto mo arimashou"
    },
    {
      "text": "あなたの所為もありましょう",
      "romaji": "anata no sei mo arimashou"
    },
    {
      "text": "それでも赤い糸",
      "romaji": "soredemo akai ito"
    },
    {
      "text": "結えているのでしょう",
      "romaji": "yuwaete iru no deshou"
    },
    {
      "text": "羽よ　花よ",
      "romaji": "hane yo hana yo"
    },
    {
      "text": "水面に散って",
      "romaji": "minamo ni chitte"
    },
    {
      "text": "悔やむこともありましょう",
      "romaji": "kuyamu koto mo arimashou"
    },
    {
      "text": "わたしの所為もありましょう",
      "romaji": "watashi no sei mo arimashou"
    },
    {
      "text": "いつかは赤い糸",
      "romaji": "itsuka wa akai ito"
    },
    {
      "text": "断ち切るのでしょう",
      "romaji": "tachikiru no deshou"
    },
    {
      "text": "花びらにささやきを",
      "romaji": "hanabira ni sasayaki o"
    },
    {
      "text": "哀れみから口づけを",
      "romaji": "awaremi kara kuchizuke o"
    },
    {
      "text": "懐かしんではじめて",
      "romaji": "natsukashinde hajimete"
    },
    {
      "text": "過ぎ行くのでしょう",
      "romaji": "sugiyuku no deshou"
    },
    {
      "text": "惑うこともありましょう",
      "romaji": "madou koto mo arimashou"
    },
    {
      "text": "誰かの所為じゃないでしょう",
      "romaji": "dareka no sei ja nai deshou"
    },
    {
      "text": "難しいものですね",
      "romaji": "muzukashii mono desu ne"
    },
    {
      "text": "愛するということは",
      "romaji": "aisuru to iu koto wa"
    }
  ]
}
