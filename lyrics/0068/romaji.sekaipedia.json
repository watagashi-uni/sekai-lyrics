  "lines": [
    {
      "text": "DANCE! 自在のステップトゥステップだって",
      "romaji": "DANCE! jizai no suteppu tuu suteppu datte"
    },
    {
      "text": "プログラムの範疇さ",
      "romaji": "puroguramu no hanchuu sa"
    },
    {
      "text": "YOU! 呼吸を乱している？",
      "romaji": "YOU! kokyuu o midashite iru?"
    },
    {
      "text": "なんて非効率的でしょう",
      "romaji": "nante hi kouritsuteki deshou"
    },
    {
      "text": "ロボットダンス",
      "romaji": "robotto dansu"
    },
    {
      "text": "LOCK! 交わしてアイトゥアイ",
      "romaji": "LOCK! kawashite aituai"
    },
    {
      "text": "すでに次元も超えた戦場だ",
      "romaji": "sude ni jigen mo koeta senjou da"
    },
    {
      "text": "アイ 思考を乱している",
      "romaji": "ai shikou o midashite iru"
    },
    {
      "text": "胸が高鳴っていく",
      "romaji": "mune ga takanatte iku"
    },
    {
      "text": "インプット",
      "romaji": "inputto"
    },
    {
      "text": "ときめく心のモーションが",
      "romaji": "tokimeku kokoro no mooshon ga"
    },
    {
      "text": "あなたに共鳴して止まないの！",
      "romaji": "anata ni kyoumei shite yamanai no!"
    },
    {
      "text": "合理とは真逆のプログラム",
      "romaji": "gouri to wa magyaku no puroguramu"
    },
    {
      "text": "知りたい 知りたい",
      "romaji": "shiritai shiritai"
    },
    {
      "text": "ねえもっと 付きあって！",
      "romaji": "nee motto tsukiatte!"
    },
    {
      "text": "ダンスロボットダンス",
      "romaji": "dansu robotto dansu"
    },
    {
      "text": "もーいいかい？",
      "romaji": "moo ii kai?"
    },
    {
      "text": "まーだだよ",
      "romaji": "maada da yo"
    },
    {
      "text": "もーいいよ！",
      "romaji": "moo ii yo!"
    }
  ]
}
