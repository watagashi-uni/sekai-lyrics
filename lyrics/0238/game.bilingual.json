      "japanese": "ブラックロックシューター",
      "zh-CN": "黑岩射手",
      "shared_interval": false
    },
    {
      "index": 1,
      "start": 18.184584,
      "end": 21.656368,
      "japanese": "何処へ行ったの？",
      "zh-CN": "究竟去往了何方？",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 21.656368,
      "end": 27.977515,
      "japanese": "聞こえますか？",
      "zh-CN": "能够听得见吗？",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 40.261139,
      "end": 46.078752,
      "japanese": "あとどれだけ叫べばいいのだろう",
      "zh-CN": "究竟还要放声呐喊多少次才行呢",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 46.078752,
      "end": 51.6416,
      "japanese": "あとどれだけ泣けばいいのだろう",
      "zh-CN": "究竟还要痛哭流涕多少次才行呢",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 51.6416,
      "end": 57.880822,
      "japanese": "もうやめて　わたしはもう走れない",
      "zh-CN": "快住手吧　我已经再也跑不动了",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 57.880822,
      "end": 63.170923,
      "japanese": "いつか夢見た世界が閉じる",
      "zh-CN": "曾经梦想过的世界正在缓缓闭合",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 63.170923,
      "end": 74.600339,
      "japanese": "真っ暗で明かりもない　崩れかけたこの道で",
      "zh-CN": "漆黑一片毫无光亮　在这条几近崩塌的小道上",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 74.600339,
      "end": 85.27845,
      "japanese": "あるはずもないあの時の 希望が見えた気がした",
      "zh-CN": "隐约觉得看见了本不可能存在的 那时的希望",
      "shared_interval": false
    },
    {
      "index": 9,
      "start": 85.27845,
      "end": 86.285518,
      "japanese": "どうして",
      "zh-CN": "究竟是为什么",
      "shared_interval": false
    },
    {
      "index": 10,
      "start": 86.285518,
      "end": 92.000226,
      "japanese": "ブラックロックシューター　懐かしい記憶",
      "zh-CN": "黑岩射手　令人怀念的记忆",
      "shared_interval": false
    },
    {
      "index": 11,
      "start": 92.000226,
      "end": 98.05362,
      "japanese": "ただ楽しかったあの頃を",
      "zh-CN": "唯独那单纯快乐的往昔岁月",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 98.06,
      "end": 103.847,
      "japanese": "ブラックロックシューター　でも動けないよ",
      "zh-CN": "黑岩射手　但我却动弹不得啊",
      "shared_interval": false
    },
    {
      "index": 13,
      "start": 103.44,
