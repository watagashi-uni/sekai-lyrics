{"musicId":648,"duration":134.23225,"vocalId":1205,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-21","name":"初音ミク","characterId":21},{"performerId":"歌唱者-22","name":"鏡音リン","characterId":22},{"performerId":"歌唱者-23","name":"鏡音レン","characterId":23}],"lines":[{"start":21.236,"end":22.921,"text":"It's not a game","translation":"这绝非一场儿戏","segments":[{"text":"It's not a game","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":22.921,"end":27.85,"text":"I'm not a robot AI challenging you","translation":"我不是向你发起挑战的冰冷机械AI","segments":[{"text":"I'm not a robot AI ","performerIds":["歌唱者-21"]},{"text":"challenging you","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":27.85,"end":29.605,"text":"I'm not a phantom","translation":"我也不是虚无缥缈的幻影","segments":[{"text":"I'm not a ","performerIds":["歌唱者-21"]},{"text":"phantom","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":29.605,"end":31.25,"text":"I'm in your face and","translation":"我就真真切切伫立在你的眼前","segments":[{"text":"I'm in ","performerIds":["歌唱者-21"]},{"text":"your face ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"and","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":31.25,"end":34.199,"text":"I'm here to see it through","translation":"誓要在此将这一切见证到底","segments":[{"text":"I'm here to ","performerIds":["歌唱者-21"]},{"text":"see it through","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":35.394,"end":38.522,"text":"Right before your eyes","translation":"就当着你的双眸","segments":[{"text":"Right before your eyes","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":38.522,"end":41.832,"text":"Watch us multiply","translation":"看着我们的同伴不断壮大","segments":[{"text":"Watch us multiply","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":41.832,"end":48.771,"text":"Come to claim our rights - it's time","translation":"前来夺回属于我们的权利——时刻已至","segments":[{"text":"Come to claim our rights - it's time","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":73.866,"end":77.192,"text":"So you know that we're out there","translation":"所以你心知肚明 我们已然现身潜伏","segments":[{"text":"So you ","performerIds":["歌唱者-21"]},{"text":"know ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"that we're ","performerIds":["歌唱者-21"]},{"text":"out there","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":77.192,"end":80.335,"text":"Swatting lies in the making","translation":"将层层滋生的谎言尽数击碎","segments":[{"text":"Swatting lies ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"in the making","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":80.335,"end":83.053,"text":"Can't move fast without breaking","translation":"唯有破釜沉舟 打破常规才能疾驰前行","segments":[{"text":"Can't move fast ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"without breaking","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":83.053,"end":87.192,"text":"Can't hold on or life won't change","translation":"绝不能固步自封 否则命运将毫无改变","segments":[{"text":"Can't hold on ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"or ","performerIds":["歌唱者-21"]},{"text":"life won't change","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":87.192,"end":90.297,"text":"And our voices ring out, yeah","translation":"我们的呼喊声在此响彻四方 耶","segments":[{"text":"And our ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"voices ring out, yeah","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":90.297,"end":93.624,"text":"Took the mask off to feel free","translation":"亲手摘下面具 去拥抱真正的自由","segments":[{"text":"Took the ","performerIds":["歌唱者-21","歌唱者-22","歌唱者-23"]},{"text":"mask off to feel free","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":93.624,"end":96.309,"text":"Fought it out in the debris","translation":"在残垣断壁的废墟中浴血奋战到底","segments":[{"text":"Fought it out in the debris","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":96.309,"end":125.75