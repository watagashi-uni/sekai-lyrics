  "lines": [
    {
      "text": "つまんないよ ドクソウじゃ",
      "romaji": "tsumannai yo dokusou ja"
    },
    {
      "text": "駆け引きはもう降参？",
      "romaji": "kakehiki wa mou kousan?"
    },
    {
      "text": "キミにはついてこれそうかい？",
      "romaji": "kimi ni wa tsuite kore sou kai?"
    },
    {
      "text": "焦げそうな競争心に",
      "romaji": "kogesou na kyousoushin ni"
    },
    {
      "text": "鼓膜揺らした",
      "romaji": "komaku yurashita"
    },
    {
      "text": "(Feel the heat go) 音速を超えた",
      "romaji": "(Feel the heat, go!) onsoku o koeta"
    },
    {
      "text": "(Feel the speed go) どうだ 見えそうかい",
      "romaji": "(Feel the speed, go!) dou da miesou kai"
    },
    {
      "text": "交差する進化",
      "romaji": "kousa suru shinka"
    },
    {
      "text": "あぁ まだ諦めてないんだね",
      "romaji": "aa mada akirametenain da ne"
    },
    {
      "text": "（穿った カウントダウン）",
      "romaji": "(ugatta, kauntodaun)"
    },
    {
      "text": "（イナヅマ 点火）",
      "romaji": "(inazuma, tenka)"
    },
    {
      "text": "（3 2 1 デンコウセッカ）",
      "romaji": "(3-2-1 denkou sekka)"
    }
  ]
}
