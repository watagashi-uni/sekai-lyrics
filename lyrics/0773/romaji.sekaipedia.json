  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "魔法みたいな　夢みたいな",
      "romaji": "mahou mitai na yume mitai na"
    },
    {
      "text": "ファンタジックな物語が",
      "romaji": "fantajikku na monogatari ga"
    },
    {
      "text": "世界に感染",
      "romaji": "sekai ni kansen"
    },
    {
      "text": "愉快に蔓延",
      "romaji": "yukai ni manen"
    },
    {
      "text": "待って、そんなの聞いてないってば！",
      "romaji": "matte, sonna no kiitenai tteba!"
    },
    {
      "text": "根本的に　痛い異常行動",
      "romaji": "konponteki ni itai ijou koudou"
    },
    {
      "text": "支える　枯れない妄想量",
      "romaji": "sasaeru karenai mousouryou"
    },
    {
      "text": "本能的に　深い破壊衝動",
      "romaji": "honnouteki ni fukai hakai shoudou"
    },
    {
      "text": "照らす確かな解像度",
      "romaji": "terasu tashika na kaizoudo"
    },
    {
      "text": "恋の導火線、",
      "romaji": "koi no doukasen,"
    },
    {
      "text": "いざ　火をともし",
      "romaji": "iza hi o tomoshi"
    },
    {
      "text": "ひとつ、ここらで本調子",
      "romaji": "hitotsu, kokora de honchoushi"
    },
    {
      "text": "脳細胞に",
      "romaji": "nousaibou ni"
    },
    {
      "text": "今、",
      "romaji": "ima,"
    },
    {
      "text": "叩き込め",
      "romaji": "tatakikome"
    },
    {
      "text": "\"わからないことだらけ\"を",
      "romaji": "\"wakaranai koto darake\" o"
    },
    {
      "text": "あざとい、きわどい",
      "romaji": "azatoi, kiwadoi"
    },
    {
      "text": "笑わないで。",
      "romaji": "warawanaide."
    },
    {
      "text": "言えない　消えない思い込め",
      "romaji": "ienai kienai omoikome"
    },
    {
      "text": "\"愛の強制ミューティレーション！\"",
      "romaji": "\"ai no kyousei myuutireeshon!\""
    },
    {
      "text": "世界に感染！不快に蔓延！",
      "romaji": "sekai ni kansen! fukai ni manen!"
    },
    {
      "text": "待って、こんなの聞いてないって、ダーリン？",
      "romaji": "matte, konna no kiitenai tte, daarin?"
    },
    {
      "text": "ベターな恋愛　エラーな展開",
      "romaji": "betaa na ren'ai eraa na tenkai"
    },
    {
      "text": "だって、それじゃあつまらないでしょ…",
      "romaji": "datte, sore jaa tsumaranai desho..."
    },
    {
      "text": "切り抜けて",
      "romaji": "kirinukete"
    },
    {
      "text": "惹きつけて",
      "romaji": "hikitsukete"
    },
    {
      "text": "\"愛の顔面ストレート！\"",
      "romaji": "\"ai no ganmen sutoreeto!\""
    },
    {
      "text": "手を繋いで 場を繋いで",
      "romaji": "te o tsunaide ba o tsunaide"
    },
    {
      "text": "ファンタジックなすったもんだが",
      "romaji": "fantajikku na suttamonda ga"
    },
    {
      "text": "頭脳に感染！ 危険に発展！",
      "romaji": "zunou ni kansen! kiken ni hatten!"
    },
    {
      "text": "踏みつけて 焼き付けて",
      "romaji": "fumitsukete yakitsukete"
    },
    {
      "text": "崩れそうな 情を前に、",
      "romaji": "kuzuresou na jou o mae ni,"
    },
    {
      "text": "\"愛の脳内レボリューション！\"",
      "romaji": "\"ai no nounai reboryuushon!\""
    }
  ]
}
