  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "「もう、どうやったって無駄かもな」",
      "romaji": "\"mou, douyattatte muda kamo na\""
    },
    {
      "text": "泣きそうな顔　見ていた",
      "romaji": "nakisou na kao mite ita"
    },
    {
      "text": "「諦めないでよ」みたいな",
      "romaji": "\"akiramenaide yo\" mitai na"
    },
    {
      "text": "言葉じゃ　全然足りない！",
      "romaji": "kotoba ja zenzen tarinai!"
    },
    {
      "text": "「そしたらもっと元気を出さなきゃ、",
      "romaji": "\"soshitara motto genki o dasanakya,"
    },
    {
      "text": "明日も眩んじゃう！」って",
      "romaji": "ashita mo kuranjau!\" tte"
    },
    {
      "text": "君を連れ出していく",
      "romaji": "kimi o tsuredashiteku"
    },
    {
      "text": "無理やりかなぁ",
      "romaji": "muriyari kanaa"
    },
    {
      "text": "日差しにブルーになる",
      "romaji": "hizashi ni buruu ni naru"
    },
    {
      "text": "君のこと　やっぱ正直心配だ",
      "romaji": "kimi no koto yappa shoujiki shinpai da"
    },
    {
      "text": "瞳が潤んでいく",
      "romaji": "hitomi ga urunde iku"
    },
    {
      "text": "「弱虫な僕には、（僕には）ダメだよきっと・・・」",
      "romaji": "\"yowamushi na boku ni wa, (boku ni wa) dame da yo kitto...\""
    },
    {
      "text": "だけど信じる、君だから。",
      "romaji": "dakedo shinjiru, kimi dakara."
    },
    {
      "text": "真っすぐ前を向いて？",
      "romaji": "massugu mae o muite?"
    },
    {
      "text": "ホントにダメな時は、",
      "romaji": "honto ni dame na toki wa,"
    },
    {
      "text": "君の心を支えてあげる。",
      "romaji": "kimi no kokoro wo sasaete ageru."
    },
    {
      "text": "「いっそ」なんて諦めちゃ",
      "romaji": "\"isso\" nante akiramecha"
    },
    {
      "text": "絶対ダメだから",
      "romaji": "zettai dame dakara"
    },
    {
      "text": "ねぇ、一緒に進もう？",
      "romaji": "nee, issho ni susumou?"
    },
    {
      "text": "「独りぼっち」を壊しちゃおう、ほら！",
      "romaji": "\"hitoribotchi\" to kowashichaou, hora!"
    },
    {
      "text": "「信じる、君だから。」",
      "romaji": "\"shinjiru, kimi dakara.\""
    },
    {
      "text": "本気の声出して",
      "romaji": "honki no koe dashite"
    },
    {
      "text": "「絶対ダメなんかじゃない！」",
      "romaji": "\"zettai dame nanka ja nai!\""
    },
    {
      "text": "君が望めば、また出会える！」",
      "romaji": "\"kimi ga nozomeba, mata deaeru!\""
    },
    {
      "text": "大きな深呼吸で",
      "romaji": "ookina shinkokyuu de"
    },
    {
      "text": "遠くのお月様に　弱気な君が",
      "romaji": "tooku no otsukisama ni yowaki na kimi ga"
    },
    {
      "text": "「やってやるさ！」と",
      "romaji": "\"yatte yaru sa!\" to"
    },
    {
      "text": "叫んでいた",
      "romaji": "sakendeta"
    },
    {
      "text": "・・・少しかっこいいかな。まぁ。",
      "romaji": "...sukoshi kakkoii kana. Maa."
    }
  ]
}
