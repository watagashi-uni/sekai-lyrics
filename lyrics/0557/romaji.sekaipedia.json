  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "泣いては咲いて 泡になって",
      "romaji": "naite wa saite awa ni natte"
    },
    {
      "text": "溺れてしまえたらさよなら",
      "romaji": "oborete shimaetara sayonara"
    },
    {
      "text": "はらりひらりと落ちては夢を見て",
      "romaji": "harari hirari to ochite wa yume o mite"
    },
    {
      "text": "わたしは花溺れ",
      "romaji": "watashi wa hana obore"
    },
    {
      "text": "気付かぬうちに眠りについた",
      "romaji": "kizukanu uchi ni nemuri ni tsuita"
    },
    {
      "text": "ソファの心地よさだけが",
      "romaji": "sofa no kokochiyosa dake ga"
    },
    {
      "text": "ちょっと懐かしく思えてさ",
      "romaji": "chotto natsukashiku omoete sa"
    },
    {
      "text": "どうにも離れられないまま",
      "romaji": "dounimo hanarerarenai mama"
    },
    {
      "text": "ローファイな毎日で",
      "romaji": "roofai na mainichi de"
    },
    {
      "text": "たまに遅刻して",
      "romaji": "tama ni chikoku shite"
    },
    {
      "text": "リピートして",
      "romaji": "ripiito shite"
    },
    {
      "text": "リピートするだけ",
      "romaji": "ripiito suru dake"
    },
    {
      "text": "針を落とす",
      "romaji": "hari o otosu"
    },
    {
      "text": "落とす",
      "romaji": "otosu"
    },
    {
      "text": "落とすだけ",
      "romaji": "otosu dake"
    },
    {
      "text": "遊び尽くしたいから",
      "romaji": "asobitsukushitai kara"
    },
    {
      "text": "いっせーの",
      "romaji": "isseeno"
    },
    {
      "text": "せーの",
      "romaji": "seeno"
    },
    {
      "text": "せーで",
      "romaji": "seede"
    },
    {
      "text": "誤魔化して 大人になれないまま",
      "romaji": "gomakashite otona ni narenai mama"
    },
    {
      "text": "花が泣いては咲いて 泡になって",
      "romaji": "hana ga naite wa saite awa ni natte"
    },
    {
      "text": "仮初のブルーミー",
      "romaji": "karisome no buruumii"
    },
    {
      "text": "さよなら夜明けに夢を見て",
      "romaji": "sayonara yoake ni yume o mite"
    },
    {
      "text": "騒ぎあって なんつ～か",
      "romaji": "sawagiatte nantsu~ka"
    },
    {
      "text": "忙しない世知辛い現実に貫通！",
      "romaji": "sewashinai sechigarai genjitsu ni kantsuu!"
    },
    {
      "text": "肥大してフワフワっフワ～！なナンバーに",
      "romaji": "hidai shite fuwafuwa fuwa~! na nanbaa ni"
    },
    {
      "text": "酔っぱらってまあいっか（笑）って",
      "romaji": "yopparatte maa ikka (wara) tte"
    },
    {
      "text": "洒落あってみてDON'T STOP ME！",
      "romaji": "shareatte mite DON'T STOP ME!"
    },
    {
      "text": "見違えるような大層な何か成し遂げたいんだ",
      "romaji": "michigaeru you na taisou na nanika nashitogetai nda"
    },
    {
      "text": "花が咲くなら",
      "romaji": "hana ga saku nara"
    },
    {
      "text": "花開いては咲いて星になって",
      "romaji": "hana hiraite wa saite hoshi ni natte"
    },
    {
      "text": "仮初めの本当の",
      "romaji": "karisome no hontou no"
    },
    {
      "text": "自分が分かるまで",
      "romaji": "jibun ga wakaru made"
    }
  ]
}
