  "lines": [
    {
      "text": "レイヤーノート",
      "romaji": "reiyaa nooto"
    },
    {
      "text": "意味を重ねて重ねて",
      "romaji": "imi o kasanete kasanete"
    },
    {
      "text": "夜が更けてく",
      "romaji": "yoru ga fuketeku"
    },
    {
      "text": "夜更かし普通になった",
      "romaji": "yofukashi futsuu ni natta"
    },
    {
      "text": "そう思ってたんだ",
      "romaji": "sou omotteta nda"
    },
    {
      "text": "思い違ってたな",
      "romaji": "omoi chigatteta na"
    },
    {
      "text": "湯上がり思考火照った",
      "romaji": "yuagari shikou hotetta"
    },
    {
      "text": "ほおをつねった",
      "romaji": "hou o tsunetta"
    },
    {
      "text": "ボリューム上げてつづった",
      "romaji": "boryuumu agete tsuzutta"
    },
    {
      "text": "(溶けるリズム感)",
      "romaji": "(tokeru rizumukan)"
    },
    {
      "text": "ハッとしたら既に0時",
      "romaji": "hatto shitara sude ni reiji"
    },
    {
      "text": "体感時間は早回し",
      "romaji": "taikan jikan wa hayamawashi"
    },
    {
      "text": "ねぇ待って行かないで単調な夜",
      "romaji": "nee matte ikanaide tanchou na yoru"
    },
    {
      "text": "めくる日々はあっという間なんだ",
      "romaji": "mekuru hibi wa attoiuma nanda"
    },
    {
      "text": "去って終わってく感情何個？",
      "romaji": "satte owatteku kanjou nango?"
    },
    {
      "text": "なんて大切かのよなフリをして",
      "romaji": "nante taisetsu ka no yo na furi o shite"
    },
    {
      "text": "待って行かないで単調な夜",
      "romaji": "matte ikanaide tanchou na yoru"
    },
    {
      "text": "(ただ私望むから)",
      "romaji": "(tada watashi nozomu kara)"
    },
    {
      "text": "書いて日またいで感情迷子",
      "romaji": "kaite hi mataide kanjou maigo"
    },
    {
      "text": "(でもそれは望むだけ)",
      "romaji": "(demo sore wa nozomu dake)"
    },
    {
      "text": "０時言わないで正論はもう",
      "romaji": "reiji iwanaide seiron wa mou"
    },
    {
      "text": "(だから日記に残すの)",
      "romaji": "(dakara nikki ni nokosu no)"
    },
    {
      "text": "去って終わってく感情何度も",
      "romaji": "satte owatteku kanjou nando mo"
    },
    {
      "text": "(消える前に綴るエゴ)",
      "romaji": "(kieru mae ni tsuzuru ego)"
    },
    {
      "text": "愛しくないけど去るのは痛いの",
      "romaji": "itoshikunai kedo saru no wa itai no"
    },
    {
      "text": "(過ぎれば忘れててくの？)",
      "romaji": "(yogireba wasureteteku no?)"
    },
    {
      "text": "(夜に書く私の歌)",
      "romaji": "(yoru ni kaku watashi no uta)"
    }
  ]
}
