  "lines": [
    {
      "text": "ウィーアーピコピコハンマー",
      "romaji": "uii aa pikopiko hanmaa"
    },
    {
      "text": "振り回して振り抜いて！",
      "romaji": "furimawashite furinuite!"
    },
    {
      "text": "サイキョーね！",
      "romaji": "saikyoo ne!"
    },
    {
      "text": "せーので世界中が",
      "romaji": "see no de sekaijuu ga"
    },
    {
      "text": "私たちについてきてよね！",
      "romaji": "watashitachi ni tsuite kite yo ne!"
    },
    {
      "text": "今度の週末どこ行こっか？",
      "romaji": "kondo no shuumatsu doko ikokka?"
    },
    {
      "text": "みんなでパーッと騒ごうよ",
      "romaji": "minna de paatto sawagou yo!"
    },
    {
      "text": "行きたいとこいっぱいあるの",
      "romaji": "ikitai toko ippai aru no!"
    },
    {
      "text": "やりたいこと全部やっちゃおう",
      "romaji": "yaritai koto zenbu yacchaou!"
    },
    {
      "text": "ソニック テイルス ナックルズ",
      "romaji": "sonikku! teirusu! nakkuruzu!"
    },
    {
      "text": "今日は私たちに付き合ってもらうからね",
      "romaji": "kyou wa watashitachi ni tsukiatte morau kara ne!"
    },
    {
      "text": "遊園地はどう？ショッピングはどう？",
      "romaji": "yuuenchi wa dou? shoppingu wa dou?"
    },
    {
      "text": "今から楽しみね",
      "romaji": "ima kara tanoshimi ne!"
    },
    {
      "text": "まばたきした瞬間もう",
      "romaji": "mabataki shita shunkan mou"
    },
    {
      "text": "どっかにいっちゃうからね",
      "romaji": "dokka ni icchau kara ne"
    },
    {
      "text": "だから退屈させないでよね",
      "romaji": "dakara taikutsu sasenaide you ne"
    },
    {
      "text": "私たちのヒロインライフ",
      "romaji": "watashitachi no hiroin raifu"
    },
    {
      "text": "パーフェクトピコピコハンマー",
      "romaji": "paafekuto pikopiko hanmaa"
    },
    {
      "text": "私たちのカラーで染める",
      "romaji": "watashitachi no karaa de someru"
    },
    {
      "text": "よそ見しちゃダメだからね",
      "romaji": "yoso mishicha dame da kara ne!"
    }
  ]
}
