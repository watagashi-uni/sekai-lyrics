  "lines": [
    {
      "text": "みんなどっか行っちゃったよ",
      "romaji": "minna dokka icchatta yo"
    },
    {
      "text": "零になっちゃってざまぁないね",
      "romaji": "zero ni nacchatte zamaa nai ne"
    },
    {
      "text": "信じてたいから声に出すのはやめた",
      "romaji": "shinjitetai kara koe ni dasu no hayameta"
    },
    {
      "text": "愛されたいのはどうして?",
      "romaji": "aisaretai no wa doushite?"
    },
    {
      "text": "愛してたいのはどうして?",
      "romaji": "aishitetai no wa doushite?"
    },
    {
      "text": "飾りあって分かちあっていた",
      "romaji": "kazariatte wakachi atteita"
    },
    {
      "text": "私",
      "romaji": "watashi"
    },
    {
      "text": "曖昧さ故にシンパシー",
      "romaji": "aimai sa yue ni shinpashii"
    },
    {
      "text": "大胆不適なセンソリー",
      "romaji": "daitan futeki na sensorii"
    },
    {
      "text": "どんまいどんまい大丈夫",
      "romaji": "donmai donmai daijoubu"
    },
    {
      "text": "笑わせてあげるから",
      "romaji": "warawasete ageru kara"
    },
    {
      "text": "だから与え与えられて",
      "romaji": "dakara atae atae rarete"
    },
    {
      "text": "消えないように此処に居なよ",
      "romaji": "kienai you ni koko ni ina yo"
    },
    {
      "text": "そしたら",
      "romaji": "soshitara"
    },
    {
      "text": "「僕にもお返事くださいね」",
      "romaji": "\"boku ni mo ohenji kudasai ne\""
    },
    {
      "text": "貴方に捧げた心臓",
      "romaji": "anata ni sasageta shinzou"
    },
    {
      "text": "いつか返して優しくしてね",
      "romaji": "itsuka kaeshite yasashiku shite ne"
    },
    {
      "text": "本当は戻りたいんだ",
      "romaji": "hontou wa modoritai nda"
    },
    {
      "text": "今からでいいから",
      "romaji": "ima kara de ii kara"
    },
    {
      "text": "僕ら",
      "romaji": "bokura"
    },
    {
      "text": "どんまいどんまい",
      "romaji": "donmai donmai"
    },
    {
      "text": "二人には素晴らしい結末さ",
      "romaji": "futari ni wa subarashii ketsumatsu sa"
    },
    {
      "text": "言葉を探すことはなくて",
      "romaji": "kotoba o sagasu koto wa nakute"
    },
    {
      "text": "それでも貴方から言って欲しかった",
      "romaji": "sore demo anata kara itte hoshikatta"
    },
    {
      "text": "それでも　それでも　それでも",
      "romaji": "sore demo sore demo sore demo"
    },
    {
      "text": "「貴方から言ってくださいね」",
      "romaji": "\"anata kara itte kudasai ne\""
    }
  ]
}
