  "lines": [
    {
      "text": "「はじめまして」とか 何回言ったっけ",
      "romaji": "\"hajimemashite\" toka nankai ittakke"
    },
    {
      "text": "アタシ ホントは人見知りで",
      "romaji": "atashi, honto wa hitomishiri de"
    },
    {
      "text": "ドキドキしてるよ 実は今だって",
      "romaji": "dokidoki shiteru yo jitsu wa ima datte"
    },
    {
      "text": "それでも伝えたい",
      "romaji": "soredemo tsutaetai"
    },
    {
      "text": "だからきっと頑張れるんだって",
      "romaji": "dakara kitto ganbarerun datte"
    },
    {
      "text": "逃げないんだ",
      "romaji": "nigenai nda"
    },
    {
      "text": "君に出会って みんな出会って",
      "romaji": "kimi ni deatte minna deatte"
    },
    {
      "text": "何回言ったって足りないよ",
      "romaji": "nankai ittatte tarinai yo"
    },
    {
      "text": "声に出して39",
      "romaji": "koe ni dashite 39 (sankyuu)"
    },
    {
      "text": "今日もありがとう",
      "romaji": "kyou mo arigatou"
    },
    {
      "text": "受け取ってもらえなきゃ困る",
      "romaji": "uketotte morae nakya komaru"
    },
    {
      "text": "この歌を",
      "romaji": "kono uta o"
    },
    {
      "text": "今日もそして",
      "romaji": "kyou mo, soshite"
    },
    {
      "text": "明日だって この先だって",
      "romaji": "ashita datte kono saki datte"
    },
    {
      "text": "「はじめまして」も はたまた",
      "romaji": "\"hajimemashite\" mo hatamata"
    },
    {
      "text": "「久しぶり」も みんなありがとう",
      "romaji": "\"hisashiburi\" mo minna arigatou"
    }
  ]
}
