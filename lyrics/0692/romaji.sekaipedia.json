  "lines": [
    {
      "text": "さぁさぁやって参りました",
      "romaji": "saa saa yattemairimashita"
    },
    {
      "text": "悪い仔粛清のお時間",
      "romaji": "warui ko shukusei no ojikan"
    },
    {
      "text": "代替　宛の無い機械",
      "romaji": "daitai ate no nai kikai"
    },
    {
      "text": "彩れませんでした",
      "romaji": "irodoremasen deshita"
    },
    {
      "text": "クラクラ果実　散弾銃",
      "romaji": "kurakura kajitsu sandan juu"
    },
    {
      "text": "微二倍苦い終末",
      "romaji": "horonibai nigai shuumatsu"
    },
    {
      "text": "大体正の関連性",
      "romaji": "daitai sei no kanrensei"
    },
    {
      "text": "次の方はどうぞ",
      "romaji": "tsugi no kata wa douzo"
    },
    {
      "text": "錆びた刃　褐色のエーアイ",
      "romaji": "sabita yaiba kasshoku no eeai"
    },
    {
      "text": "逃走　感情　コメントアウト",
      "romaji": "tousou kanjou komentoauto"
    },
    {
      "text": "ざんざん　ぎゃりぎゃり",
      "romaji": "zanzan gyarigyari"
    },
    {
      "text": "ばるばるーらる",
      "romaji": "baru baruuraru"
    },
    {
      "text": "だんだん　ばばば",
      "romaji": "dandan bababa"
    },
    {
      "text": "いたい　いたい",
      "romaji": "itai itai"
    },
    {
      "text": "あははは",
      "romaji": "ahahaha"
    },
    {
      "text": "あつい　あついだろ",
      "romaji": "atsui atsui daro"
    },
    {
      "text": "かいたい　かいたい",
      "romaji": "kaitai kaitai"
    },
    {
      "text": "ゆめのせかいへ！",
      "romaji": "yume no sekai e!"
    },
    {
      "text": "三秒　完答　死闘の口角",
      "romaji": "sanbyou kantou shitou no koukaku"
    },
    {
      "text": "段々幅は迫りくんだ",
      "romaji": "dandan haba wa semari kunda"
    },
    {
      "text": "幻煙黙々　古代の勢力",
      "romaji": "gen'en mokumoku kodai no seiryoku"
    },
    {
      "text": "段々逃げる道も無いんだ",
      "romaji": "dandan nigeru michi mo nain da"
    },
    {
      "text": "生存思考の再戦",
      "romaji": "seizon shikou no saisen"
    },
    {
      "text": "電源なんて在りません",
      "romaji": "dengen nante arimasen"
    },
    {
      "text": "只唱う已です",
      "romaji": "tada utau nomi desu"
    },
    {
      "text": "フラフラ果実　三連勝",
      "romaji": "furafura kajitsu san renshou"
    },
    {
      "text": "微四倍　苦い終末",
      "romaji": "hono yon bai nigai shuumatsu"
    },
    {
      "text": "ゲージは残り僅かです",
      "romaji": "geeji wa nokori wazuka desu"
    },
    {
      "text": "怪物達は祈りました",
      "romaji": "kaibutsutachi wa inorimashita"
    },
    {
      "text": "哀れな惨状の聖杯",
      "romaji": "awarena sanjou no seihai"
    },
    {
      "text": "真っ赤に成った黒歴史",
      "romaji": "makka ni natta kuro rekishi"
    },
    {
      "text": "焼き憑いたが最期の再葬",
      "romaji": "yaki tsuitaga saigo no saisou"
    },
    {
      "text": "来襲　愛終　無限　無気力",
      "romaji": "raishuu ai shuu mugen mukiryoku"
    },
    {
      "text": "楽観　達観　偽善　センシズム",
      "romaji": "rakkan takkan gizen senshizumu"
    },
    {
      "text": "案外　感慨深い",
      "romaji": "angai kangaibukai"
    },
    {
      "text": "そんなコロシアム",
      "romaji": "sonna koroshiamu"
    },
    {
      "text": "ばんばん　ががが",
      "romaji": "banban ga ga ga"
    },
    {
      "text": "いえいいえいだ　ぱーりー",
      "romaji": "iei iei da paarii"
    },
    {
      "text": "あわれだ",
      "romaji": "awareda"
    },
    {
      "text": "にがい　にがいから",
      "romaji": "nigai nigai kara"
    },
    {
      "text": "さいしゅーへーきで",
      "romaji": "saishuu heeki de"
    },
    {
      "text": "あこがれのちへ！",
      "romaji": "akogare no chi e!"
    },
    {
      "text": "さんざん　ぎゃくさん",
      "romaji": "sanzan gyaku san"
    },
    {
      "text": "こたえ　さがせよ",
      "romaji": "kotae sagase yo"
    },
    {
      "text": "かんたん　ぼくが",
      "romaji": "kantan boku ga"
    },
    {
      "text": "うぃんうぃんだ　ぱーりー",
      "romaji": "winwinda paarii"
    },
    {
      "text": "きたい　きたい",
      "romaji": "kitai kitai"
    },
    {
      "text": "はるかな",
      "romaji": "harukana"
    },
    {
      "text": "みらい　みらいから",
      "romaji": "mirai mirai kara"
    },
    {
      "text": "さいかい　さいかい",
      "romaji": "saikai saikai"
    },
    {
      "text": "あのかたのちへ！",
      "romaji": "ano kata no chi e!"
    }
  ]
}
