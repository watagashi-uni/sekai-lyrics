    {
      "text": "■の盃を呷ったほうがマシだね",
      "romaji": "■ no sakazuki o aotta hou ga mashi da ne"
    },
    {
      "text": "■■切れなかった夜をくべる",
      "romaji": "■■ kirenakatta yoru o kuberu"
    },
    {
      "text": "液化したピアノと夜を明かす",
      "romaji": "ekika shita piano to yoru o akasu"
    },
    {
      "text": "■ぬも■むも■■いも■くも愛す",
      "romaji": "■nu mo ■mu mo ■■i mo ■ku mo aisu"
    },
    {
      "text": "■■に■き■■され■った言葉を",
      "romaji": "■■ ni ■ki ■■sare■tta kotoba o"
    },
    {
      "text": "■■った■れ者が■■してく",
      "romaji": "■■tta ■remono ga ■■shiteku"
    },
    {
      "text": "■■以外■んで■■った■■溜めで",
      "romaji": "■■ igai ■nde■■tta ■■ tame de"
    },
    {
      "text": "■■も■■も■■も伝えられなきゃ",
      "romaji": "■■ mo ■■ mo ■■ mo tsutaerarenakya"
    },
    {
      "text": "■んでも■んでも■■切れないから",
      "romaji": "■ndemo ■ndemo ■■ kirenai kara"
    },
    {
      "text": "世界に送る黒塗りのラブレター",
      "romaji": "sekai ni okuru kuronuri no rabu retaa"
    }
  ]
}
