  "lines": [
    {
      "text": "不意に過ぎる　ハシャギ声",
      "romaji": "fui ni yogiru hashagigoe"
    },
    {
      "text": "\"0\"と\"1\"で残された　Passed days",
      "romaji": "\"zero\" to \"ichi\" de nokosareta Passed days"
    },
    {
      "text": "胸を衝く　痛みの理由は",
      "romaji": "mune o tsuku itami no wake wa"
    },
    {
      "text": "諦め？　それとも　Nostalogic…?",
      "romaji": "akirame? soretomo Nostalogic...?"
    },
    {
      "text": "瞬く　光に誘われ",
      "romaji": "matataku hikari ni sasoware"
    },
    {
      "text": "過去を　辿り・巡り・我に返り",
      "romaji": "kako o tadori/meguri/ware ni kaeri"
    },
    {
      "text": "目の前に　広がる景色は",
      "romaji": "me no mae ni hirogaru keshiki wa"
    },
    {
      "text": "君と観た　未来と同じ",
      "romaji": "kimi to mita mirai to onaji"
    },
    {
      "text": "遠くに消えた　落描きの唄きっと",
      "romaji": "tooku ni kieta rakugaki no uta kitto"
    },
    {
      "text": "色褪せないで",
      "romaji": "iroasenai de"
    },
    {
      "text": "今も　僕に　聴こえてる",
      "romaji": "ima mo boku ni kikoeteru"
    },
    {
      "text": "遠く目指した　約束の場所ずっと",
      "romaji": "tooku mezashita yakusoku no basho zutto"
    },
    {
      "text": "息　弾ませて",
      "romaji": "iki hazumasete"
    },
    {
      "text": "今も　僕は　目指してる",
      "romaji": "ima mo boku wa mezashiteru"
    },
    {
      "text": "今も　君は　目指してる…？",
      "romaji": "ima mo kimi wa mezashiteru...?"
    }
  ]
}
