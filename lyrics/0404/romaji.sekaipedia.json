  "lines": [
    {
      "text": "長い夜の果てに",
      "romaji": "nagai yoru no hate ni"
    },
    {
      "text": "浮かぶ街の中で",
      "romaji": "ukabu machi no naka de"
    },
    {
      "text": "無邪気過ぎた夢に",
      "romaji": "mujaki sugita yume ni"
    },
    {
      "text": "取り残されていた",
      "romaji": "torinokosarete ita"
    },
    {
      "text": "暗闇に飲まれそうでも",
      "romaji": "kurayami ni nomaresou demo"
    },
    {
      "text": "朝の日が遠ざかっても",
      "romaji": "asa no hi ga toozakatte mo"
    },
    {
      "text": "僕たちのあの日の願いは",
      "romaji": "bokutachi no ano hi no negai wa"
    },
    {
      "text": "消えないまま",
      "romaji": "kienai mama"
    },
    {
      "text": "部屋の窓に映る",
      "romaji": "heya no mado ni utsuru"
    },
    {
      "text": "(ぼやけた)",
      "romaji": "(boyaketa)"
    },
    {
      "text": "青い街は",
      "romaji": "aoi machi wa"
    },
    {
      "text": "(寂しく)",
      "romaji": "(sabishiku)"
    },
    {
      "text": "まるで氷の砂漠のように",
      "romaji": "marude koori no sabaku no you ni"
    },
    {
      "text": "冷たいまま",
      "romaji": "tsumetai mama"
    },
    {
      "text": "浮かばない言葉と",
      "romaji": "ukabanai kotoba to"
    },
    {
      "text": "(歌と)",
      "romaji": "(uta to)"
    },
    {
      "text": "破り捨てた",
      "romaji": "yaburisuteta"
    },
    {
      "text": "譜面の数だけ",
      "romaji": "fumen no kazu dake"
    },
    {
      "text": "もどかしい時間をただ",
      "romaji": "modokashii jikan o tada"
    },
    {
      "text": "過ごしていた",
      "romaji": "sugoshite ita"
    },
    {
      "text": "いつのまに忘れてしまってた",
      "romaji": "itsu no mani wasurete shimatteta"
    },
    {
      "text": "憧れだったあなたの背中",
      "romaji": "akogare datta anata no senaka"
    },
    {
      "text": "逃げたままじゃいけないことは",
      "romaji": "nigeta mama ja ikenai koto wa"
    },
    {
      "text": "気づいてた",
      "romaji": "kizuiteta"
    },
    {
      "text": "ひたすらに記憶を辿っては",
      "romaji": "hitasura ni kioku o tadotte wa"
    },
    {
      "text": "あのときの言葉の意味を知る",
      "romaji": "ano toki no kotoba no imi o shiru"
    },
    {
      "text": "たった今これまでのことが",
      "romaji": "tatta ima kore made no koto ga"
    },
    {
      "text": "混ざりあって",
      "romaji": "mazariatte"
    },
    {
      "text": "そして奏でだした",
      "romaji": "soshite kanade dashita"
    },
    {
      "text": "回る世界に響くような",
      "romaji": "mawaru sekai ni hibiku you na"
    },
    {
      "text": "心が躍るメロディー",
      "romaji": "kokoro ga odoru merodii"
    },
    {
      "text": "君のそばに寄り添うような",
      "romaji": "kimi no soba ni yorisou you na"
    },
    {
      "text": "この歌を",
      "romaji": "kono uta o"
    },
    {
      "text": "僕らはまた一つに",
      "romaji": "bokura wa mata hitotsu ni"
    },
    {
      "text": "歌う声を重ねて",
      "romaji": "utau koe o kasanete"
    },
    {
      "text": "怖がらずに信じてさ",
      "romaji": "kowagarazu ni shinjite sa"
    },
    {
      "text": "共に行こう",
      "romaji": "tomo ni ikou"
    },
    {
      "text": "あの日の願いさえ",
      "romaji": "ano hi no negai sae"
    },
    {
      "text": "超えて行ける",
      "romaji": "koete ikeru"
    },
    {
      "text": "まだ見ぬ景色の先",
      "romaji": "mada minu keshiki no saki"
    },
    {
      "text": "ひとりじゃないから",
      "romaji": "hitori janai kara"
    },
    {
      "text": "新しい世界の朝",
      "romaji": "atarashii sekai no asa"
    },
    {
      "text": "淡い記憶を",
      "romaji": "awai kioku o"
    },
    {
      "text": "光が包んだ",
      "romaji": "hikari ga tsutsunda"
    },
    {
      "text": "過去と現在を",
      "romaji": "kako to ima o"
    },
    {
      "text": "希望と未来を",
      "romaji": "kibou to mirai o"
    },
    {
      "text": "繋ぐblender",
      "romaji": "tsunagu blender"
    }
  ]
}
