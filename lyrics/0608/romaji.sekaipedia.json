  "lines": [
    {
      "text": "あなたと夢の続きを",
      "romaji": "anata to yume no tsuzuki o"
    },
    {
      "text": "このまま流星のように",
      "romaji": "kono mama ryuusei no you ni"
    },
    {
      "text": "声がまた届くまで",
      "romaji": "koe ga mata todoku made"
    },
    {
      "text": "ふたつの月廻る星",
      "romaji": "futatsu no tsuki mawaru hoshi"
    },
    {
      "text": "指先で描く空に",
      "romaji": "yubisaki de egaku sora ni"
    },
    {
      "text": "放物線宇宙なぞるように",
      "romaji": "parabola uchuu nazoru you ni"
    },
    {
      "text": "ふたり歩く帰り道",
      "romaji": "futari aruku kaerimichi"
    },
    {
      "text": "昼と夜が交わるように",
      "romaji": "hiru to yoru ga majiwaru you ni"
    },
    {
      "text": "奇跡たどる",
      "romaji": "kiseki tadoru"
    },
    {
      "text": "取り残された僕らは",
      "romaji": "torinokosareta bokura wa"
    },
    {
      "text": "佇むだけ",
      "romaji": "tatazumu dake"
    },
    {
      "text": "目と目流星のように",
      "romaji": "eyes ryuusei no you ni"
    },
    {
      "text": "落ちてムーンライト",
      "romaji": "ochite muunraito"
    },
    {
      "text": "ローリン　ロンリー　Fallin’",
      "romaji": "roorin ronrii Fallin'"
    },
    {
      "text": "Like a 衛星のように　回れ",
      "romaji": "Like a eisei no you ni maware"
    },
    {
      "text": "微かな　声がまた　届くまで",
      "romaji": "kasuka na koe ga mata todoku made"
    },
    {
      "text": "時を飛び越えていくように",
      "romaji": "toki o tobikoete iku you ni"
    }
  ]
}
