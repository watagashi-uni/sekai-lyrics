  "lines": [
    {
      "text": "寂しくて眠れぬ日々も",
      "romaji": "samishikute nemurenu hibi mo"
    },
    {
      "text": "今夜辺り、さよなら出来る気がする",
      "romaji": "konya atari, sayonara dekiru ki ga suru"
    },
    {
      "text": "胸の高鳴り",
      "romaji": "mune no takanari"
    },
    {
      "text": "見透かされた行方知れずの",
      "romaji": "misukasareta yukue shirezu no"
    },
    {
      "text": "気持ち隠しても既に遅いわ",
      "romaji": "kimochi kakushitemo sude ni osoi wa"
    },
    {
      "text": "世の常",
      "romaji": "yo no tsune"
    },
    {
      "text": "今から全てで飛ばしてあげる",
      "romaji": "ima kara subete de tobashite ageru"
    },
    {
      "text": "センセーション　愛想ぶらずに",
      "romaji": "senseeshon aiso burazu ni"
    },
    {
      "text": "センセーション　巻き起こすのよ",
      "romaji": "senseeshon maki okosu no yo"
    },
    {
      "text": "センセーション　どこ吹く風も",
      "romaji": "senseeshon doko fuku kaze mo"
    },
    {
      "text": "理解を通り越して",
      "romaji": "rikai wo toori koshite"
    },
    {
      "text": "センセーション　なんて素敵な",
      "romaji": "senseeshon nante suteki na"
    },
    {
      "text": "絶頂感　満ち溢れてく",
      "romaji": "zecchoukan michi afureteku"
    },
    {
      "text": "私が何者かも",
      "romaji": "watashi ga nanimono ka mo"
    },
    {
      "text": "どうでも良いからほら",
      "romaji": "dou demo ii kara hora"
    },
    {
      "text": "誤魔化さなくても愛しているわ",
      "romaji": "gomakasa nakutemo aishiteiru wa"
    },
    {
      "text": "その手で深くへ",
      "romaji": "sono te de fukaku e"
    },
    {
      "text": "余す事も無く",
      "romaji": "amasu koto mo naku"
    }
  ]
}
