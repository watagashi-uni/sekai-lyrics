{"musicId":278,"duration":127.074875,"vocalId":695,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"外部歌唱者-01","name":"GUMI"},{"performerId":"外部歌唱者-06","name":"Kamui Gakupo"},{"performerId":"歌唱者-21","name":"初音ミク"},{"performerId":"歌唱者-22","name":"鏡音リン"},{"performerId":"歌唱者-23","name":"鏡音レン"},{"performerId":"歌唱者-24","name":"巡音ルカ"},{"performerId":"歌唱者-25","name":"MEIKO"},{"performerId":"歌唱者-26","name":"KAITO"}],"lines":[{"start":9.26075,"end":16.58075,"text":"深い深い森の奥に　迷い込んだ村の娘","translation":"迷失在幽深幽深森林深处的村姑","segments":[{"text":"深い深い森の奥に　迷い込んだ村の娘","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":16.58075,"end":53.71075,"text":"色あせた手紙を持って　夜の館に辿り着く…","translation":"手握褪色的信件 终于抵达了夜色中的宅邸……","segments":[{"text":"色あせた手紙を持って　夜の館に辿り着く…","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":53.71075,"end":58.42075,"text":"不気味な洋館の　壊れた扉を叩く","translation":"敲响诡异洋房那破损的大门","segments":[{"text":"不気味な洋館の　壊れた扉を叩く","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":58.42075,"end":60.50075,"text":"「誰かいませんか」","translation":"「请问有人在吗」","segments":[{"text":"「誰かいませんか」","performerIds":["歌唱者-21"]}],"performerIds":[]},{"start":60.50075,"end":63.43075,"text":"「おやおや、お困りですか?」","translation":"「哎呀呀，遇到困扰了吗？」","segments":[{"text":"「おやおや、お困りですか?」","performerIds":["外部歌唱者-06"]}],"performerIds":[]},{"start":63.43075,"end":65.81075,"text":"「ヨウコソ…」　「不思議ノ館ヘ…」","translation":"「欢迎光临……」「来到不可思议的洋馆……」","segments":[{"text":"「ヨウコソ…」　","performerIds":["歌唱者-22"]},{"text":"「不思議ノ館ヘ…」","performerIds":["歌唱者-23"]}],"performerIds":[]},{"start":65.81075,"end":67.60075,"text":"「お茶を召し上がれ」","translation":"「请用茶吧」","segments":[{"text":"「お茶を召し上がれ」","performerIds":["外部歌唱者-01"]}],"performerIds":[]},{"start":67.60075,"end":72.33075,"text":"皆々集まって","translation":"众人齐聚一堂","segments":[{"text":"皆々","performerIds":["歌唱者-21"]},{"text":"集まって","performerIds":["歌唱者-24"]}],"performerIds":[]},{"start":67.60075,"end":72.33075,"text":"客人は「値踏み」をされる","translation":"对客人进行着「评头论足」","segments":[{"text":"客人は","performerIds":["歌唱者-21"]},{"text":"「値踏み」をされる","performerIds":["歌唱者-25"]}],"performerIds":[]},{"start":72.33075,"end":74.71075,"text":"「でも、こうして会うのも何かの縁」","translation":"「不过，能够相遇也是某种缘分」","segments":[{"text":"「でも、こうして会うのも何かの縁」","performerIds":["歌唱者-26"]}],"performerIds":[]},{"start":74.71075,"end":76.07075,"text":"「ナラ、パーティー、パーティー!!」","translation":"「既然如此，派对、派对！！」","segments":[{"text":"「ナラ、パーティー、パーティー!!」","performerIds":["歌唱者-22","歌唱者-23"]}],"performerIds":[]},{"start":76.07075,"end":77.59075,"text":"「「歓迎しよう!」」","translation":"「「来热烈欢迎吧！」」","segments":[{"text":"「「歓迎しよう!」」","performerIds":["歌唱者-25","歌唱者-26","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":77.59075,"end":79.64075,"text":"「Hurry、HurrY!!」　「ワインをついで」","translation":"「Hurry、HurrY！！」「倒上红酒」","segments":[{"text":"「Hurry、HurrY!!」　","performerIds":["歌唱者-23"]},{"text":"「ワインをついで」","performerIds":["外部歌唱者-06"]}],"performerIds":[]},{"start":79.64075,"end":81.95075,"text":"「どんちゃん　どんちゃん♪」　「乾杯しましょう」","translation":"「热闹非凡 欢天喜地♪」「来干杯吧」","segments":[{"text":"「どんちゃん　どんちゃん♪」　","performerIds":["外部歌唱者-01"]},{"text":"「乾杯しましょう」","performerIds":["歌唱者-24"]}],"performerIds":[]},{"start":81.95075,"end":83.95075,"text":"「Are you readY??」　「準備はいい?」","translation":"「Are you readY？？」「准备好了吗？」","segments":[{"text":"「Are you readY??」　","performerIds":["歌唱者-22"]},{"text":"「準備はいい?」","performerIds":["歌唱者-25"]}],"performerIds":[]},{"start":83.95075,"end":86.33075,"text":"「「さあ、始めよう」」","translation":"「「来吧，这就开始吧」」","segments":[{"text":"「「さあ、始めよう」」","performerIds":["歌唱者-21","歌唱者-23","外部歌唱者-01"]}],"performerIds":[]},{"start":86.33075,"end":90.99075,"text":"君が主役の Crazy nighT","translation":"你是主角的 Crazy nighT","segments":[{"text":"君が主役の Crazy nighT","performerIds":["歌唱者-22","歌唱者-25","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":86.33075,"end":90.99075,"text":"ワイン片手に洒落込んで","translation":"单手举着红酒打扮时髦","segments":[{"text":"ワイン片手に洒落込んで","performerIds":["歌唱者-21","歌唱者-23","歌唱者-24","歌唱者-26"]}],"performerIds":[]},{"start":90.99075,"end":95.79075,"text":"ほどよく酔いが回ったら","translation":"微醺的醉意恰到好处之时","segments":[{"text":"ほどよく酔いが回ったら","performerIds":["歌唱者-22","歌唱者-25","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":90.99075,"end":95.79075,"text":"楽しくなってきちゃった?","translation":"是不是开始变得开心起来了？","segments":[{"text":"楽しくなってきちゃった?","performerIds":["歌唱者-21","歌唱者-23","歌唱者-24","歌唱者-26"]}],"performerIds":[]},{"start":95.79075,"end":100.49075,"text":"歌え　踊れ　騒ごうぜ","translation":"歌唱吧 起舞吧 尽情喧闹狂欢吧","segments":[{"text":"歌え　踊れ　騒ごうぜ","performerIds":["歌唱者-22","歌唱者-25","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":95.79075,"end":100.49075,"text":"酸いも甘いも忘れてさ","translation":"将人生的酸甜苦辣通通抛诸脑后","segments":[{"text":"酸いも甘いも忘れてさ","performerIds":["歌唱者-21","歌唱者-23","歌唱者-24","歌唱者-26"]}],"performerIds":[]},{"start":100.49075,"end":104.72988,"text":"気が狂っちゃうほどに","translation":"疯狂痴迷到令人发狂","segments":[{"text":"気が狂っちゃうほどに","performerIds":["歌唱者-22","歌唱者-25","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":100.49075,"end":104.72988,"text":"楽しんじゃえ Happy☆nighT","translation":"尽情享受吧 Happy☆nighT","segments":[{"text":"楽しんじゃえ Happy☆nighT","performerIds":["歌唱者-21","歌唱者-23","歌唱者-24","歌唱者-26"]}],"performerIds":[]},{"start":105.109,"end":109.859,"text":"君が主役の Crazy nighT","translation":"你是主角的 Crazy nighT","segments":[{"text":"君が主役の Crazy nighT","performerIds":["歌唱者-22","歌唱者-25","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":105.109,"end":109.859,"text":"キャストも舞台も無くなって","translation":"演员与舞台都荡然无存","segments":[{"text":"キャストも舞台も無くなって","performerIds":["歌唱者-21","歌唱者-23","歌唱者-24","歌唱者-26"]}],"performerIds":[]},{"start":109.859,"end":114.609,"text":"物語が終わったら","translation":"等故事落幕之后","segments":[{"text":"物語が終わったら","performerIds":["歌唱者-22","歌唱者-25","外部歌唱者-01","外部歌唱者-06"]}],"performerIds":[]},{"start":109.859,"end":114.609,"text":"さあ、みんなで帰りましょうか","translation":"来吧，大家一起回去吧","segments":[{"text":"さあ、みんなで帰りましょうか","performerIds":["歌唱者-21","歌唱者-23","歌唱者-24","歌唱者-26"]}],"performerIds":[]},{"start":114.38,"end":114.94,"text":"「ドコニー?」","translation":"「回哪去～？」","segments":[{"text":