  "lines": [
    {
      "text": "虚無っぽいなんかもうだめみたい",
      "romaji": "kyomuppoi nanka mou dame mitai"
    },
    {
      "text": "もうバラバラです",
      "romaji": "mou bara bara desu"
    },
    {
      "text": "空です",
      "romaji": "kara kara desu"
    },
    {
      "text": "くだんない本当もう馬鹿みたい",
      "romaji": "kudannai hontou mou bakamitai"
    },
    {
      "text": "もう虜みたい静かな世界",
      "romaji": "mou toriko mitai shizuka na sekai"
    },
    {
      "text": "君の期待応えたいし",
      "romaji": "kimi no kitai kotaetai shi"
    },
    {
      "text": "心次第に枯れちゃうし",
      "romaji": "kokoro shitaini karechau shi"
    },
    {
      "text": "きりない焦燥と",
      "romaji": "kirinai shousou to"
    },
    {
      "text": "期待で痛くなる未来",
      "romaji": "kitai de itaku naru mirai"
    },
    {
      "text": "孤独に囚われちゃうし",
      "romaji": "kodoku ni torawarechau shi"
    },
    {
      "text": "トラウマが腦支配しちゃうし",
      "romaji": "torauma ga nou shihaishichou shi"
    },
    {
      "text": "最低な日々だ",
      "romaji": "saitai na hibi da"
    },
    {
      "text": "痛い",
      "romaji": "itai"
    },
    {
      "text": "バイオレンス　バイオレンス",
      "romaji": "baiorensu baiorensu"
    },
    {
      "text": "何も 分かんない　分かんないよ",
      "romaji": "nan mo wakannai wakannai yo"
    },
    {
      "text": "難解愛をロスト　愛をロスト",
      "romaji": "nankai ai o rosuto ai o rosuto"
    },
    {
      "text": "愛して 愛して",
      "romaji": "aishite aishite"
    },
    {
      "text": "アイロニー　アイロニー",
      "romaji": "aironii aironii"
    },
    {
      "text": "クラクラする毎日だ",
      "romaji": "kurakura suru mainichi da"
    },
    {
      "text": "脳内エンドレス　エンドレス",
      "romaji": "nounai endoresu endoresu"
    },
    {
      "text": "討論やめてくれよもう",
      "romaji": "touron yamete kureyo mou"
    }
  ]
}
