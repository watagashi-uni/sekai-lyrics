  "lines": [
    {
      "text": "もっと声きかせて",
      "romaji": "motto koe kikasete"
    },
    {
      "text": "(いっせーのーで",
      "romaji": "(isse no de)"
    },
    {
      "text": "ハイ)",
      "romaji": "(hai!)"
    },
    {
      "text": "未知に満ち足りなくなっても",
      "romaji": "michi ni michi tarinaku natte mo"
    },
    {
      "text": "今鳴ったハートのビートが",
      "romaji": "ima natta haato no biito ga"
    },
    {
      "text": "もっと(もっと)アイをしたいから",
      "romaji": "motto (motto!) ai o shitai kara"
    },
    {
      "text": "もっと(もっと)愛をちょーだい",
      "romaji": "motto (motto!) ai o choudai"
    },
    {
      "text": "(モア＆モア)声をもっと",
      "romaji": "(moa & moa!) koe o motto!"
    },
    {
      "text": "(ジャンプ＆ジャンプ)高く高く",
      "romaji": "(janpu & janpu) takaku takaku!"
    },
    {
      "text": "(モア＆モア)愛をもっと",
      "romaji": "(moa & moa!) ai o motto!"
    },
    {
      "text": "もうちょっと足りなくても",
      "romaji": "mou chotto tarinaku temo"
    },
    {
      "text": "進みだした夢は",
      "romaji": "susumi dashita yume wa"
    },
    {
      "text": "あきらめない やめたくない",
      "romaji": "akiramenai! yametakunai!"
    }
  ]
}
