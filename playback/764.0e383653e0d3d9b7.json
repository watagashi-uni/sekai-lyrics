{"musicId":764,"duration":134.998375,"vocalId":2058,"assetbundle":null,"format":"bilingual_json","performers":[{"performerId":"歌唱者-05","name":"花里みのり"},{"performerId":"歌唱者-06","name":"桐谷遥"},{"performerId":"歌唱者-07","name":"桃井愛莉"},{"performerId":"歌唱者-08","name":"日野森雫"},{"performerId":"歌唱者-22","name":"鏡音リン"}],"lines":[{"start":28.91,"end":31.782,"text":"「もう、どうやったって無駄かもな」","translation":"「不管怎样努力 或许都是徒劳无功吧」","segments":[{"text":"「もう、どうやったって無駄かもな」","performerIds":["歌唱者-06"]}],"performerIds":[]},{"start":31.782,"end":33.865,"text":"泣きそうな顔　見ていた","translation":"凝视着那副 快要哭出来的脸庞","segments":[{"text":"泣きそうな顔　見ていた","performerIds":["歌唱者-06"]}],"performerIds":[]},{"start":33.865,"end":36.268,"text":"「諦めないでよ」みたいな","translation":"仅仅说「不要放弃嘛」这类","segments":[{"text":"「諦めないでよ」みたいな","performerIds":["歌唱者-07"]}],"performerIds":[]},{"start":36.268,"end":39.045,"text":"言葉じゃ　全然足りない！","translation":"言语 根本远远不够！","segments":[{"text":"言葉じゃ　全然足りない！","performerIds":["歌唱者-07"]}],"performerIds":[]},{"start":39.045,"end":42.034,"text":"「そしたらもっと元気を出さなきゃ、","translation":"「既然如此不多打起精神可不行，","segments":[{"text":"「そしたらもっと元気を出さなきゃ、","performerIds":["歌唱者-05"]}],"performerIds":[]},{"start":42.034,"end":44.144,"text":"明日も眩んじゃう！」って","translation":"连明天也会变得昏暗哦！」","segments":[{"text":"明日も眩んじゃう！」って","performerIds":["歌唱者-05"]}],"performerIds":[]},{"start":44.144,"end":45.735,"text":"君を連れ出していく","translation":"一把拉着你奔出门去","segments":[{"text":"君を連れ出していく","performerIds":["歌唱者-08"]}],"performerIds":[]},{"start":45.735,"end":49.428,"text":"無理やりかなぁ","translation":"会不会太勉强了呢","segments":[{"text":"無理やりかなぁ","performerIds":["歌唱者-08"]}],"performerIds":[]},{"start":49.428,"end":51.668,"text":"日差しにブルーになる","translation":"在阳光下变得心情低落","segments":[{"text":"日差しにブルーになる","performerIds":["歌唱者-22"]}],"performerIds":[]},{"start":51.668,"end":54.389,"text":"君のこと　やっぱ正直心配だ","translation":"看着你的模样 说实话果然还是好担心","segments":[{"text":"君のこと　やっぱ正直心配だ","performerIds":["歌唱者-06","歌唱者-07"]}],"performerIds":[]},{"start":54.389,"end":56.679,"text":"瞳が潤んでいく","translation":"双眼逐渐噙满泪水","segments":[{"text":"瞳が潤んでいく","performerIds":["歌唱者-22"]}],"performerIds":[]},{"start":56.679,"end":62.149,"text":"「弱虫な僕には、（僕には）ダメだよきっと・・・」","translation":"「懦弱胆小的我、（像我这样）一定不行的吧……」","segments":[{"text":"「弱虫な僕には、","performerIds":["歌唱者-05","歌唱者-08"]},{"text":"（僕には）","performerIds":["歌唱者-22"]},{"text":"ダメだよきっと・・・」","performerIds":["歌唱者-05","歌唱者-08"]}],"performerIds":[]},{"start":62.149,"end":65.008,"text":"だけど信じる、君だから。","translation":"但我深信着你，正因为是你。","segments":[{"text":"だけど信じる、君だから。","performerIds":["歌唱者-06","歌唱者-22"]}],"performerIds":[]},{"start":65.008,"end":67.59,"text":"真っすぐ前を向いて？","translation":"笔直地望向前方好吗？","segments":[{"text":"真っすぐ前を向いて？","performerIds":["歌唱者-06","歌唱者-22"]}],"performerIds":[]},{"start":67.59,"end":69.715,"text":"ホントにダメな時は、","translation":"真的撑不下去的时候，","segments":[{"text":"ホントにダメな時は、","performerIds":["歌唱者-07","歌唱者-22"]}],"performerIds":[]},{"start":69.715,"end":72.613,"text":"君の心を支えてあげる。","translation":"我会来支撑起你的心灵。","segments":[{"text":"君の心を支えてあげる。","performerIds":["歌唱者-07","歌唱者-22"]}],"performerIds":[]},{"start":72.613,"end":75.16,"text":"「いっそ」なんて諦めちゃ","translation":"说着「干脆」就此放弃","segments":[{"text":"「いっそ」なんて諦めちゃ","performerIds":["歌唱者-08","歌唱者-22"]}],"performerIds":[]},{"start":75.16,"end":77.813,"text":"絶対ダメだから","translation":"绝对绝对不可以哦","segments":[{"text":"絶対ダメだから","performerIds":["歌唱者-08","歌唱者-22"]}],"performerIds":[]},{"start":77.813,"end":79.872,"text":"ねぇ、一緒に進もう？","translation":"呐，一起并肩前行吧？","segments":[{"text":"ねぇ、一緒に進もう？","performerIds":["歌唱者-05","歌唱者-22"]}],"performerIds":[]},{"start":79.872,"end":93.044,"text":"「独りぼっち」を壊しちゃおう、ほら！","translation":"把「孤单一人」彻底打破吧，瞧啊！","segments":[{"text":"「独りぼっち」を壊しちゃおう、ほら！","performerIds":["歌唱者-05","歌唱者-22"]}],"performerIds":[]},{"start":93.044,"end":95.552,"text":"「信じる、君だから。」","translation":"「深信着你，正因为是你。」","segments":[{"text":"「信じる、君だから。」","performerIds":["歌唱者-06","歌唱者-22"]}],"performerIds":[]},{"start":95.552,"end":98.084,"text":"本気の声出して","translation":"发出动真格的声音","segments":[{"text":"本気の声出して","performerIds":["歌唱者-06","歌唱者-22"]}],"performerIds":[]},{"start":98.084,"end":100.153,"text":"「絶対ダメなんかじゃない！」","translation":"「绝对不是不可挽回！」","segments":[{"text":"「絶対ダメなんかじゃない！」","performerIds":["歌唱者-05","歌唱者-22"]}],"performerIds":[]},{"start":100.153,"end":102.969,"text":"君が望めば、また出会える！」","translation":"只要你期盼，就一定能再度相逢！」","segments":[{"text":"君が望めば、また出会える！」","performerIds":["歌唱者-05","歌唱者-22"]}],"performerIds":[]},{"start":102.969,"end":105.7,"text":"大きな深呼吸で","translation":"大大地深吸了一口气","segments":[{"text":"大きな深呼吸で","performerIds":["歌唱者-08","歌唱者-22"]}],"performerIds":[]},{"start":105.7,"end":110.273,"text":"遠くのお月様に　弱気な君が","translation":"对着遥远明亮的月亮 胆怯懦弱的你","segments":[{"text":"遠くのお月様に　弱気な君が","performerIds":["歌唱者-08","歌唱者-22"]}],"performerIds":[]},{"start":110.273,"end":113.159,"text":"「やってやるさ！」と","translation":"高喊着「我一定能做到！」","segments":[{"text":"「やってやるさ！」と","performerIds":["歌唱者-07","歌唱者-22"]}],"performerIds":[]},{"start":110.273,"end":113.159,"text":"叫んでいた","translation":"放声呐喊","segments":[{"text":"叫んでいた","performerIds":["歌唱者-07","歌唱者-22"]}],"performerIds":[]},{"start":113.159,"end":130.595,"text":"・・・少しかっこいいかな。まぁ。","translation":"……稍微有点帅气了呢。嘛。","segments":[{"text":"・・・少しかっこいいかな。","performerIds":["歌唱者-07","歌唱者-22"]},{"text":"まぁ。","performerIds":["歌唱者-05","歌唱者-22"]}],"performerIds":[]}],"credits":{"translation":"雪莹ちゃん"},"sources":[["https://www.sekaipedia.org/wiki/Otsukimi_Recital?oldid=339679","CC BY-SA 4.0","https://creativecommons.org/licenses/by-sa/4.0/"]]}