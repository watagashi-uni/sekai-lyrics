  "lines": [
    {
      "text": "ユ！",
      "romaji": "yu!"
    },
    {
      "text": "ドクター・キドリです",
      "romaji": "dokutaa kidori desu"
    },
    {
      "text": "愛・爆破ッテロ",
      "romaji": "ai bakuha ttero"
    },
    {
      "text": "簡単になれば",
      "romaji": "kantan ni nareba"
    },
    {
      "text": "愛想良いかも",
      "romaji": "aiso ii kamo"
    },
    {
      "text": "何処にも無いから寝ていたら",
      "romaji": "doko ni mo nai kara nete itara"
    },
    {
      "text": "壊れて泣いてるユメを診たんだよ",
      "romaji": "kowarete naiteru yume o mita nda yo"
    },
    {
      "text": "偽が→権利を取ったんだ",
      "romaji": "nise ga → kenri o totta nda"
    },
    {
      "text": "無くなってほしい煩悩が",
      "romaji": "nakunatte hoshii bonnou ga"
    },
    {
      "text": "生き延びてしまったんだ",
      "romaji": "ikinobite shimatta nda!!"
    },
    {
      "text": "足が→タガメになっちゃうヨ",
      "romaji": "ashi ga → tagame ni nacchau yo"
    },
    {
      "text": "嘘が→動機になったんだ",
      "romaji": "uso ga → douki ni natta nda"
    },
    {
      "text": "疑ってほしい本能を",
      "romaji": "utagatte hoshii honnou o"
    },
    {
      "text": "本心だと思ったんだ",
      "romaji": "honshin da to omotta nda!!"
    },
    {
      "text": "クチョォ",
      "romaji": "kuchoo"
    },
    {
      "text": "全部辞めろよ",
      "romaji": "enbu yamero yo"
    },
    {
      "text": "アティチュードが",
      "romaji": "atichuudo ga"
    },
    {
      "text": "感動物に届く猛毒",
      "romaji": "kandoumon ni todoku moudoku"
    },
    {
      "text": "損得の得の方ダケ",
      "romaji": "sontoku no toku no hou dake"
    },
    {
      "text": "音が→機能になってしまう",
      "romaji": "oto ga → kinou ni natte shimau"
    },
    {
      "text": "人が→偽りに集まる",
      "romaji": "hito ga → itsuwari ni atsumaru"
    },
    {
      "text": "塞がってしまえよ耳",
      "romaji": "fusagatte shimae yo mimi"
    }
  ]
}
