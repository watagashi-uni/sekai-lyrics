  "provider": "Sekaipedia",
  "url": "https://www.sekaipedia.org/wiki/Cat_Loving",
  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "痛いことは嫌いですが",
      "romaji": "itai koto wa kirai desu ga"
    },
    {
      "text": "君の手の平は嫌いじゃない",
      "romaji": "kimi no tenohira wa kirai ja nai"
    },
    {
      "text": "言葉は飴玉みたいに",
      "romaji": "kotoba wa amedama mitai ni"
    },
    {
      "text": "甘く広がってココロ満たす",
      "romaji": "amaku hirogatte kokoro mitasu"
    },
    {
      "text": "嗚呼全然分かってない",
      "romaji": "aa zenzen wakattenai"
    },
    {
      "text": "永遠に言う通り",
      "romaji": "eien ni iudoori"
    },
    {
      "text": "完全にフェアじゃない",
      "romaji": "kanzen ni fea ja nai"
    },
    {
      "text": "(どこにいても)",
      "romaji": "(doko ni ite mo)"
    },
    {
      "text": "嗚呼「何で？」は効いてない",
      "romaji": "aa \"nande?\" wa kiitenai"
    },
    {
      "text": "もっともっとあの子みたいに",
      "romaji": "motto motto ano ko mitai ni"
    },
    {
      "text": "可愛くならなくちゃ",
      "romaji": "kawaiku nara nakucha"
    },
    {
      "text": "愛情は聡明に",
      "romaji": "aijou wa soumei ni"
    },
    {
      "text": "傷痕はHow many?",
      "romaji": "shoukon wa How many?"
    },
    {
      "text": "もう体　堕　痛いのだって",
      "romaji": "mou tai da itai no datte"
    },
    {
      "text": "分かんなくなる",
      "romaji": "wakannaku naru"
    },
    {
      "text": "延命マタタビ",
      "romaji": "enmei matatabi"
    },
    {
      "text": "週二ご褒美",
      "romaji": "shuuni gohoubi"
    },
    {
      "text": "「もう嫌んなった」って",
      "romaji": "mou iyan natta tte"
    },
    {
      "text": "離されないように",
      "romaji": "hanasarenai you ni"
    },
    {
      "text": "今日だってちゃんと",
      "romaji": "kyou datte chanto"
    },
    {
      "text": "内緒の毛づくろい",
      "romaji": "naisho no kedzukuroi"
    },
    {
      "text": "にゃんって良い子にするから",
      "romaji": "nyan tte ii ko ni suru kara"
    },
    {
      "text": "愛して",
      "romaji": "aishite"
    },
    {
      "text": "会いたいを間違いなんて皆は言う",
      "romaji": "aitai o machigai nante minna wa iu"
    },
    {
      "text": "取り憑かれているって",
      "romaji": "tori tsukarete iru tte"
    },
    {
      "text": "ならこの胸で疼く",
      "romaji": "nara kono mune de uzuku"
    },
    {
      "text": "締め付けるような切なさは何なの？",
      "romaji": "shime tsukeru you na setsuna sa wa nan nano?"
    },
    {
      "text": "選ぶ言葉",
      "romaji": "erabu kotoba"
    },
    {
      "text": "戸惑う指先",
      "romaji": "tomadou yubisaki"
    },
    {
      "text": "端正な横顔",
      "romaji": "tansei na yokogao"
    },
    {
      "text": "（私しか知らない）",
      "romaji": "(watashi shika shiranai)"
    },
    {
      "text": "嗚呼ランダムご機嫌",
      "romaji": "aa randamu gokigen"
    },
    {
      "text": "もしかして今日は",
      "romaji": "moshikashite kyou wa"
    },
    {
      "text": "優しく撫でてくれるのかな？",
      "romaji": "yasashiku nadete kureru no kana?"
    },
    {
      "text": "君のソレが",
      "romaji": "kimi no sore ga"
    },
    {
      "text": "耐えられるの",
      "romaji": "taerareru no"
    },
    {
      "text": "生涯で私だけなんだよね",
      "romaji": "shuugai de watashi dake nanda yo ne"
    },
    {
      "text": "あからさまに",
      "romaji": "akarasama ni"
    },
    {
      "text": "カラダまさに",
      "romaji": "karada masa ni"
    },
    {
      "text": "「もう嫌だ」って離れられないよね",
      "romaji": "mou iya da tte hanarerarenai yo ne"
    },
    {
      "text": "そうだよね？",
      "romaji": "sou da yo ne?"
    },
    {
      "text": "感情は上々に",
      "romaji": "kanjou wa joujou ni"
    },
    {
      "text": "訴えは少々に",
      "romaji": "uttae wa shoushou ni"
    },
    {
      "text": "もうLieも賽のように",
      "romaji": "mou Lie mo sai no you ni"
    },
    {
      "text": "転がせば良い",
      "romaji": "korogaseba ii"
    },
    {
      "text": "柑橘の匂い",
      "romaji": "kankitsu no nioi"
    },
    {
      "text": "だって凌ぐのだ",
      "romaji": "datte shinogu no da"
    },
    {
      "text": "もう噛んだって叱られるだけだし",
      "romaji": "mou kandatte shikarareru dake dashi"
    },
    {
      "text": "今日だってちゃんとお膝で",
      "romaji": "kyou datte chanto ohiza de"
    },
    {
      "text": "大人しく",
      "romaji": "otonashiku"
    },
    {
      "text": "にゃんってお好きなように",
      "romaji": "nyan tte osuki na you ni"
    },
    {
      "text": "完全淘汰して",
      "romaji": "kanzen touta shite"
    }
  ]
}
