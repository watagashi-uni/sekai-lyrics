  "lines": [
    {
      "text": "今日のランチは何にしようかな",
      "romaji": "kyou no ranchi wa nani ni shiyou kana"
    },
    {
      "text": "やけにお腹がぐぅ",
      "romaji": "yake ni onaka ga guu..."
    },
    {
      "text": "そうだ今日は何でも食べていい日にしよう",
      "romaji": "sou da kyou wa nan demo tabete ii hi ni shiyou"
    },
    {
      "text": "お腹の調子はグー",
      "romaji": "onaka no choushi wa guu!"
    },
    {
      "text": "スープカレーお寿司ラーメン",
      "romaji": "suupu karee osushi raamen"
    },
    {
      "text": "ザンギとんかつしゃぶしゃぶ生姜焼き",
      "romaji": "zangi tonkatsu shabushabu shougayaki"
    },
    {
      "text": "豚丼カニ鍋エビフライジンギスカン",
      "romaji": "butadon kani nabe ebifurai jingisukan"
    },
    {
      "text": "今日のディナーは何にしようかな",
      "romaji": "kyou no dinaa wa nani ni shiyou kana"
    },
    {
      "text": "ますますお腹がぐぅ",
      "romaji": "masumasu onaka ga guu..."
    },
    {
      "text": "ビーフステーキ 天ぷら うなぎ",
      "romaji": "biifusuteeki tenpura unagi"
    }
  ]
}
