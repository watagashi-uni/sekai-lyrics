  "lines": [
    {
      "text": "流れ落ちた涙でもっと強くなるから",
      "romaji": "nagareochita namida de motto tsuyoku naru kara"
    },
    {
      "text": "この四角い弱みすら守りたい",
      "romaji": "kono shikakui yowami sura mamoritai"
    },
    {
      "text": "悲しい程に",
      "romaji": "kanashii hodo ni"
    },
    {
      "text": "上々気分笑い合って",
      "romaji": "joujou kibun waraiatte"
    },
    {
      "text": "割と満たされてはいたけど",
      "romaji": "wari to mitasarete wa ita kedo"
    },
    {
      "text": "いつの間にやら",
      "romaji": "itsu no ma ni yara"
    },
    {
      "text": "随分とこの街も変わったもんだ",
      "romaji": "zuibun to kono machi mo kawatta mon da"
    },
    {
      "text": "嘗て誰もが夢見た",
      "romaji": "katsute daremo ga yumemita"
    },
    {
      "text": "ニヒリスト達が産んだ果物",
      "romaji": "nihirisuto-tachi ga unda kudamono"
    },
    {
      "text": "歪な形も咀嚼しよう",
      "romaji": "ibutsu na katachi mo soshaku shiyou"
    },
    {
      "text": "サヨナラの代わりとなって",
      "romaji": "sayonara no kawari to natte"
    },
    {
      "text": "私はね もうすでに貴方と違って",
      "romaji": "watashi wa ne mou sude ni anata to chigatte"
    },
    {
      "text": "帰る場所なんてない",
      "romaji": "kaeru basho nante nai"
    },
    {
      "text": "負けるのがただ怖い",
      "romaji": "makeru no ga tada kowai"
    },
    {
      "text": "離れ離れ",
      "romaji": "hanarebanare"
    },
    {
      "text": "サイレンが街を包み込んだら",
      "romaji": "sairen ga machi o tsutsumikondara"
    },
    {
      "text": "また終わらぬ小競り合い続けよう",
      "romaji": "mata owaranu kogeriai tsudzukeyou"
    },
    {
      "text": "今日も明日も",
      "romaji": "kyou mo ashita mo"
    },
    {
      "text": "その傷一つで何もかも",
      "romaji": "sono kizu hitotsu de nanimokamo"
    },
    {
      "text": "楽になるなら儲けもん",
      "romaji": "raku ni naru nara moukemon"
    },
    {
      "text": "して生きているというなら",
      "romaji": "shite ikite iru to iu nara"
    },
    {
      "text": "文句ねぇだろ",
      "romaji": "monku nee daro"
    },
    {
      "text": "だから幾千眩ゆい愚図どもへ",
      "romaji": "dakara ikusen mabayui guzu domo e"
    },
    {
      "text": "愛を込めて歌うよ",
      "romaji": "ai o komete utau yo"
    },
    {
      "text": "その場所が輝く未来に",
      "romaji": "sono basho ga kagayaku mirai ni"
    },
    {
      "text": "私も居れる様に",
      "romaji": "watashi mo ireru you ni"
    },
    {
      "text": "アレは悪魔か天使か",
      "romaji": "are wa akuma ka tenshi ka"
    },
    {
      "text": "はたまた亡霊か",
      "romaji": "hatamata bourei ka"
    },
    {
      "text": "天国か地獄なのか",
      "romaji": "tengoku ka jigoku na no ka"
    },
    {
      "text": "教えてくれ",
      "romaji": "oshiete kure"
    }
  ]
}
