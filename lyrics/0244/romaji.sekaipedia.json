  "lines": [
    {
      "text": "君が悪い訳じゃない",
      "romaji": "kimi ga warui wake janai"
    },
    {
      "text": "夢の花が溢れ出す",
      "romaji": "yume no hana ga afuredasu"
    },
    {
      "text": "傍にいると忘れないでね",
      "romaji": "soba ni iru to wasurenai de ne"
    },
    {
      "text": "ただ素直に椅子を近付けて",
      "romaji": "tada sunao ni isu o chikazukete"
    },
    {
      "text": "指を結びたいと踏み出した",
      "romaji": "yubi o musubitai to fumidashita"
    },
    {
      "text": "歩幅の差を気にも留めないまま",
      "romaji": "hohaba no sa o ki ni mo tomodemenai mama"
    },
    {
      "text": "歌っても良いかい？",
      "romaji": "utatte mo iikai?"
    },
    {
      "text": "憧れでは終わらない",
      "romaji": "akogare de wa owaranai"
    }
  ]
}
