  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "か　か　か　神田は神保町の横丁",
      "romaji": "ka ka ka kanda wa jinbouchou no yokochou"
    },
    {
      "text": "駆け出しセドリ師",
      "romaji": "kakedashi sedori shi"
    },
    {
      "text": "し　し　し　紙魚喰い　書店員に蔵書印",
      "romaji": "shi shi shi shimikui shoten'in ni zoushoin"
    },
    {
      "text": "門前払いの書生さん",
      "romaji": "monzenbarai no shosei-san"
    },
    {
      "text": "あ　あ　あ　愛憎渦巻く愛蔵版の",
      "romaji": "a a a aizou uzumaku aizouban no"
    },
    {
      "text": "旧家は代々収集癖だ",
      "romaji": "kyuuka wa daidai shuushuuheki da"
    },
    {
      "text": "貧乏作家　坂　逆様　落花生",
      "romaji": "binbou sakka saka sakasama rakkasei"
    },
    {
      "text": "お家断絶　捜せ遺書　おいで名探偵",
      "romaji": "oie danzetsu sagase isho oide meitantei"
    },
    {
      "text": "奇々怪々　密室ごっこ",
      "romaji": "kikikaikai misshitsugokko"
    },
    {
      "text": "「袋小路を袋とじ！」",
      "romaji": "\"fukurokouji o fukurotoji!\""
    },
    {
      "text": "アリバイあり得ない犯行",
      "romaji": "aribai arienai hankou"
    },
    {
      "text": "「あいつかあの子かフーダニット？」",
      "romaji": "\"aitsu ka ano ko ka fuudanitto?\""
    },
    {
      "text": "憐れ囚われ愛しの稀覯本を",
      "romaji": "aware toraware itoshi no anata o"
    },
    {
      "text": "迎えにゆこう",
      "romaji": "mukae ni yukou"
    },
    {
      "text": "どの本か決めかねるなら　阿弥陀",
      "romaji": "dono ko ka kimekaneru nara amida"
    },
    {
      "text": "凛とした背表紙",
      "romaji": "rintoshita sebyoushi"
    },
    {
      "text": "ヤダヤダ遊びましょ　『しょっ』",
      "romaji": "yadayada asobimasho “sho”"
    },
    {
      "text": "禮　『lie』　こんがらがった",
      "romaji": "rai “lie” kongaragatta"
    },
    {
      "text": "はやく助けて",
      "romaji": "hayaku tasukete"
    },
    {
      "text": "『おひとつ下げて』",
      "romaji": "“ohitotsu sagete”"
    },
    {
      "text": "誰？　誰？　誰が悪い？　神楽舞",
      "romaji": "dare? dare? dare ga warui? kaguramai"
    },
    {
      "text": "花咲き手拍子",
      "romaji": "hanasaki tebyoushi"
    },
    {
      "text": "夜な夜なあいこでしょ　『しょ』",
      "romaji": "yonayona aiko desho “sho”"
    },
    {
      "text": "嗚呼！　『うわん』　とっちらかった",
      "romaji": "aa! “uwan” tocchirakatta"
    },
    {
      "text": "トリック分かんない",
      "romaji": "torikku wakannai"
    },
    {
      "text": "『もひとつ上げて』",
      "romaji": "“mo hitotsu agete”"
    },
    {
      "text": "ダメダメいけませんわと涙",
      "romaji": "damedame ikemasen wa to namida"
    },
    {
      "text": "輪廻の根　黄表紙",
      "romaji": "rinne no ne kibyoushi"
    },
    {
      "text": "とうとう最終章　『しょっ』",
      "romaji": "toutou saishuushou “sho”"
    },
    {
      "text": "懊　『悩』　あいどんのお",
      "romaji": "ou “nou ” ai don noo"
    },
    {
      "text": "犯人教えて作者",
      "romaji": "kotae oshiete sensei"
    },
    {
      "text": "嗚呼！　先生！",
      "romaji": "aa! sensei!"
    }
  ]
}
