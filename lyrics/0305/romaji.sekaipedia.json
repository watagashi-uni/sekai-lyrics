  "lines": [
    {
      "text": "まだ気づかないのかな？",
      "romaji": "\"mada kizukanai no ka na?"
    },
    {
      "text": "そうだ。",
      "romaji": "sou da."
    },
    {
      "text": "分かっていたのさ。",
      "romaji": "wakatteita no sa."
    },
    {
      "text": "僕はこのままさ。",
      "romaji": "boku wa kono mama sa."
    },
    {
      "text": "歩き出してみようかな？",
      "romaji": "aruki dashite miyou ka na?"
    },
    {
      "text": "遠い あのとき",
      "romaji": "tooi ano toki"
    },
    {
      "text": "誰かが生きてく一秒ずつ",
      "romaji": "dare ka ga ikiteku ichibyou zutsu"
    },
    {
      "text": "言葉にできたならば",
      "romaji": "kotoba ni dekita naraba"
    },
    {
      "text": "僕は生きてく気がするのさ。",
      "romaji": "bokura wa ikiteku ki ga suru no sa."
    },
    {
      "text": "言葉をばらまくように",
      "romaji": "kotoba o baramaku you ni"
    },
    {
      "text": "僕が旅立ち、居なくなるとき",
      "romaji": "boku ga tabidachi, todoka naku naru toki"
    },
    {
      "text": "言葉にできなくとも",
      "romaji": "kotoba ni deki naku tomo"
    },
    {
      "text": "あなたが笑っていられるように",
      "romaji": "anata ga egao de irareru you ni"
    }
  ]
}
