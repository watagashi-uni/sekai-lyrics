  "lines": [
    {
      "text": "絶対の高く高くまで",
      "romaji": "zettai no takaku takaku made"
    },
    {
      "text": "万全万来なら",
      "romaji": "banzen manrai nara"
    },
    {
      "text": "黒の大前提は覆せないもの",
      "romaji": "kuro no daizentei wa kutsugaesenai mono"
    },
    {
      "text": "無駄な白明を消して",
      "romaji": "muda na hakumei o keshite"
    },
    {
      "text": "邪魔な極彩を塗り潰して",
      "romaji": "jama na goku sai o nuri tsubushite"
    },
    {
      "text": "常に焚き付けた有り体",
      "romaji": "tsuneni taki tsuketa aritei"
    },
    {
      "text": "愚問と",
      "romaji": "gumon to"
    },
    {
      "text": "灯せば強く残影は走る",
      "romaji": "tomoseba tsuyoku zan ei wa hashiru"
    },
    {
      "text": "追いかけるほど冥暗に溶けていく",
      "romaji": "oikakeru hodo meian ni toketeiku"
    },
    {
      "text": "成したいじゃなく完遂してると",
      "romaji": "nashitai janaku kansui shiteru to"
    },
    {
      "text": "容赦なく",
      "romaji": "youshanaku"
    },
    {
      "text": "低迷に泣いてどうした",
      "romaji": "teimei ni naite dou shita"
    },
    {
      "text": "覚悟さえ見せず死ぬか",
      "romaji": "kakugo sae misezu shinu ka"
    },
    {
      "text": "果てるか",
      "romaji": "hateru ka"
    },
    {
      "text": "夜を鳴らす遠くまで",
      "romaji": "yoru o narasu tooku made"
    },
    {
      "text": "向き合うは自分",
      "romaji": "mukiau wa jibun"
    },
    {
      "text": "走るのは渇望",
      "romaji": "hashiru no wa katsubou"
    },
    {
      "text": "無慈悲に見下ろすだけ",
      "romaji": "mujihi ni miorosu dake"
    },
    {
      "text": "徹底に隙間なく",
      "romaji": "tettei ni sukimanaku"
    },
    {
      "text": "泰然でも染まれ 端然でも貫け",
      "romaji": "taizen demo somare tanzen demo tsuranuke"
    }
  ]
}
