  "via": "https://github.com/shinonomeenana/sekai_lyrics",
  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "ぱっぱっぱらっぱらっぱっぱ",
      "romaji": "pappapparapparappappa"
    },
    {
      "text": "甘くて幸せなこと",
      "romaji": "amakute shiawase na koto"
    },
    {
      "text": "隠し味何にしよう",
      "romaji": "kakushi aji nani ni shiyou"
    },
    {
      "text": "純粋な乙女心",
      "romaji": "junsui na otome gokoro"
    },
    {
      "text": "甘い恋も絡めなくちゃ",
      "romaji": "amai koi mo karame nakucha"
    },
    {
      "text": "切なさ重ねてミルフィーユ",
      "romaji": "setsuna sa kasanete mirufiiyu"
    },
    {
      "text": "酸味も積み上げタルト",
      "romaji": "sanmi mo tsumiage taruto"
    },
    {
      "text": "苦味もチョコレートケーキ？",
      "romaji": "nigami mo chokoreeto keeki?"
    },
    {
      "text": "魔法かけた甘い奇跡",
      "romaji": "mahou kaketa amai kiseki"
    },
    {
      "text": "甘さを抑えてビターとか",
      "romaji": "amasa wo osaete bitaa toka"
    },
    {
      "text": "ミルクなしのコーヒーとか",
      "romaji": "miruku nashi no koohii toka"
    },
    {
      "text": "甘いだけじゃ大人になれないの？",
      "romaji": "amai dakeja otona ni narenai no?"
    },
    {
      "text": "そんなの絶対に絶対やだやだやだ",
      "romaji": "sonna no zettai ni zettai yada yada yada"
    },
    {
      "text": "ねぇ （はい！） あげようか （はい！） 甘い罠 （はい！） ",
      "romaji": "nee (hai!) ageyou ka (hai!) amai wana (hai!)"
    },
    {
      "text": "ほら虜にしてあげる （はい！） ",
      "romaji": "hora toriko ni shite ageru (hai!)"
    },
    {
      "text": "そんな魔法 （はい！） かけるから （はい！） ",
      "romaji": "sonna mahou (hai!) kakeru kara (hai!)"
    },
    {
      "text": "ちょっとだけ待たせたげるわ",
      "romaji": "chotto dake matase tageru wa"
    },
    {
      "text": "ねぇ、気づいてるんでしょ？",
      "romaji": "nee, kizuiterun desho?"
    },
    {
      "text": "わかってるんでしょ？",
      "romaji": "wakatterun desho?"
    },
    {
      "text": "隠し味の恋心 （はい！） ",
      "romaji": "kakushi aji no koi gokoro (hai!)"
    },
    {
      "text": "苦みとか （はい！） 酸味とか （はい！） ",
      "romaji": "nigami toka (hai!) sanmi to ka (hai!)"
    },
    {
      "text": "そういうのもたまにはいいわ （はい！） ",
      "romaji": "souiu no mo tama ni wa ii wa (hai!)"
    },
    {
      "text": "意地っ張りで （はい！） ワガママな （はい！） ",
      "romaji": "ijippari de (hai!) wagamama na (hai!)"
    },
    {
      "text": "そんな「甘い魔法」使い",
      "romaji": "sonna \"amai mahou\" tsukai"
    }
  ]
}
