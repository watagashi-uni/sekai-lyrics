  "lines": [
    {
      "text": "君と笑ってたこと",
      "romaji": "kimi to waratteta koto"
    },
    {
      "text": "独り思い出した",
      "romaji": "hitori omoi dashita"
    },
    {
      "text": "何故か感情がただ",
      "romaji": "naze ka kokoro ga tada"
    },
    {
      "text": "騒ぎ続けていた",
      "romaji": "sawagi tsuzuketeita"
    },
    {
      "text": "これでよかったのか？",
      "romaji": "kore de yokatta no ka?"
    },
    {
      "text": "どこで間違えた？",
      "romaji": "doko de machigaeta?"
    },
    {
      "text": "この胸の熱が",
      "romaji": "kono mune no netsu ga"
    },
    {
      "text": "冷めないのは何故？",
      "romaji": "samenai no wa naze?"
    },
    {
      "text": "浅い悪夢なら",
      "romaji": "asai asai yume nara"
    },
    {
      "text": "全て許せたのに",
      "romaji": "subete yuruseta no ni"
    },
    {
      "text": "さらりさらり落ちてく",
      "romaji": "sarari sarari ochiteku"
    },
    {
      "text": "何もかもが全て",
      "romaji": "nani mo kamo ga subete"
    },
    {
      "text": "何故か寂しくなる",
      "romaji": "naze ka sabishiku naru"
    }
  ]
}
