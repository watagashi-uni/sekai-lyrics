  "revision": "9c7d8dc9b519d2b3b6fcdb8f512b759dcd65a01b",
  "license": "CC BY-SA 4.0",
  "lines": [
    {
      "text": "きっとどこかで　気づいてたんだ",
      "romaji": "kitto dokoka de kizuitetan da"
    },
    {
      "text": "これは　子供騙しだ",
      "romaji": "kore wa kodomodamashi da"
    },
    {
      "text": "LALALA LALA　キラリキラリ",
      "romaji": "lalala lala kirari kirari"
    },
    {
      "text": "君は笑うんだ",
      "romaji": "kimi wa waraun da"
    },
    {
      "text": "期待されてた",
      "romaji": "kitaisareteta"
    },
    {
      "text": "めげないピエロだ",
      "romaji": "megenai piero da"
    },
    {
      "text": "そうさ　遠慮はしないさ",
      "romaji": "sou sa enryo wa shinai sa"
    },
    {
      "text": "LALALA LALA　ケロリケロリ",
      "romaji": "lalala lala kerori kerori"
    },
    {
      "text": "僕も笑うんだ",
      "romaji": "boku mo waraun da"
    },
    {
      "text": "かき鳴らす度",
      "romaji": "kakinarasu tabi"
    },
    {
      "text": "心が呼びかけてくる",
      "romaji": "kokoro ga yobikakete kuru"
    },
    {
      "text": "セカイの一瞬の　熱狂が　弾ける",
      "romaji": "sekai no isshun no nekkyou ga hajikeru"
    },
    {
      "text": "馬鹿になって　飛んでいって",
      "romaji": "baka ni natte tonde itte"
    },
    {
      "text": "時折ほんのちょっと　思い出せばいい",
      "romaji": "tokiori honno chotto omoi daseba ii"
    },
    {
      "text": "やむを得ずも　空回り？",
      "romaji": "yamu o ezu mo karamawari?"
    },
    {
      "text": "土壇場ドタバタ　滑り込めばいい",
      "romaji": "dotanba dotabata suberikomeba ii"
    },
    {
      "text": "きっとそうだ　そんなもんだ",
      "romaji": "kitto sou da sonna monda"
    },
    {
      "text": "夢も希望も　欲張っちゃえばいい",
      "romaji": "yume mo kibou mo yokubacchaeba ii"
    },
    {
      "text": "待ってました　お出ましだ",
      "romaji": "matte mashita odemashi da"
    },
    {
      "text": "88個のスター　駆け上がれ！",
      "romaji": "hachijuuhachiko no sutaa kakeagare!"
    },
    {
      "text": "なんだかんだ　ワンダーワンダー",
      "romaji": "nanda kanda wandaa wandaa"
    },
    {
      "text": "抱きしめて　おやすみ",
      "romaji": "dakishimete oyasumi"
    },
    {
      "text": "まだまだ　物足りない？",
      "romaji": "mada mada mono tarinai?"
    },
    {
      "text": "そんなもんじゃない？",
      "romaji": "sonna mon janai?"
    },
    {
      "text": "もっと行けるんじゃない！",
      "romaji": "motto ikerun janai!"
    },
    {
      "text": "朝になって　息を吐いて",
      "romaji": "asa ni natte iki o haite"
    },
    {
      "text": "それから今日を　彩っていけばいい",
      "romaji": "sore kara kyou o irodotte ikeba ii"
    },
    {
      "text": "酸いも甘いも　何もないの？",
      "romaji": "sui mo amai mo nan mo nai no?"
    },
    {
      "text": "そんな君に　幸せが降るといい",
      "romaji": "sonna kimi ni shiawase ga furu to ii"
    },
    {
      "text": "調子乗って　飛んでいって",
      "romaji": "choushi notte tonde itte"
    },
    {
      "text": "時折ほんのちょっと　座っちゃえばいい",
      "romaji": "tokiori honno chotto suwacchaeba ii"
    },
    {
      "text": "どたんばたん　楽しんじゃえばいい",
      "romaji": "dotanbatan tanoshinjaeba ii"
    }
  ]
}
