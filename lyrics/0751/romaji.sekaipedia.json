  "lines": [
    {
      "text": "浮かんで　転げ落ちて",
      "romaji": "ukande korogeochite"
    },
    {
      "text": "出会ったエンドロール",
      "romaji": "deatta endorooru"
    },
    {
      "text": "歪んで　変わり果てた",
      "romaji": "yugande kawarihateta"
    },
    {
      "text": "未来の走馬灯",
      "romaji": "mirai no soumatou"
    },
    {
      "text": "もうお終いね",
      "romaji": "mou oshimai ne"
    },
    {
      "text": "幕の切れてしまった白昼夢は",
      "romaji": "maku no kirete shimatta hakuchuumu wa"
    },
    {
      "text": "ただただ　虚しさ達を暈してみせた",
      "romaji": "tadatada munashisatachi o bokashite miseta"
    },
    {
      "text": "思い出してしまう",
      "romaji": "omoidashite shimau"
    },
    {
      "text": "夕焼ける空　滲むメロディ",
      "romaji": "yuuyakeru sora nijimu merodi"
    },
    {
      "text": "「帰ろう　道を間違わないように」",
      "romaji": "\"kaerou michi o machigawanai you ni\""
    },
    {
      "text": "臆病になって",
      "romaji": "okubyou ni natte"
    },
    {
      "text": "ギュッと繋いだ手を宙に向けて",
      "romaji": "gyutto tsunaida te o chuu ni mukete"
    },
    {
      "text": "抱いてしまう　願ってしまう",
      "romaji": "daite shimau negatte shimau"
    },
    {
      "text": "贅沢な走馬灯",
      "romaji": "zeitaku na soumatou"
    },
    {
      "text": "夕凪の向こうに",
      "romaji": "yuunagi no mukou ni"
    },
    {
      "text": "恋を認めて緋を灯す",
      "romaji": "koi o shitatame te hi o tomosu"
    },
    {
      "text": "過ぎ去っていく　腐っていく",
      "romaji": "sugisatte iku kusatte iku"
    },
    {
      "text": "融かした本音は",
      "romaji": "tokashita honne wa"
    },
    {
      "text": "存在証明を拒んでしまったストーリー",
      "romaji": "sonzai shoumei o kobande shimatta sutoorii"
    },
    {
      "text": "「また明日」なんてさ",
      "romaji": "\"mata ashita\" nante sa"
    },
    {
      "text": "言いたくなかったな",
      "romaji": "iitaku nakatta na"
    },
    {
      "text": "拭えない涙も",
      "romaji": "nuguenai namida mo"
    },
    {
      "text": "言葉も　嘘　嘘",
      "romaji": "kotoba mo uso uso"
    },
    {
      "text": "友達なんかに",
      "romaji": "tomodachi nanka ni"
    },
    {
      "text": "なりたくなかったな",
      "romaji": "naritaku nakatta na"
    },
    {
      "text": "きっと届かないよな",
      "romaji": "kitto todokanai yo na"
    },
    {
      "text": "ごめんね大好きだよ",
      "romaji": "gomen ne daisuki da yo"
    }
  ]
}
