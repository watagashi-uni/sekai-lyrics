      "japanese": "友達は気づいたら",
      "zh-CN": "等回过神来的时候",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 20.806193,
      "end": 22.945005,
      "japanese": "いないね",
      "zh-CN": "朋友们都不见了",
