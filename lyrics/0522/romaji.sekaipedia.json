  "lines": [
    {
      "text": "間違えて宇宙終わって",
      "romaji": "machigaete uchuu owatte"
    },
    {
      "text": "青信号はいつも通り",
      "romaji": "ao shingou wa itsumo doori"
    },
    {
      "text": "飛んでまた止まって",
      "romaji": "tonde mata tomatte"
    },
    {
      "text": "また飛びそうだ",
      "romaji": "mata tobisou da"
    },
    {
      "text": "ココロコネクト",
      "romaji": "kokoro konekuto"
    },
    {
      "text": "古代人と恋した",
      "romaji": "kodaijin to koi shita"
    },
    {
      "text": "妄想コレクト",
      "romaji": "mousou korekuto"
    },
    {
      "text": "化石的なロマンス",
      "romaji": "kasekiteki na romansu"
    },
    {
      "text": "はぁ…夢に踊るの ♫",
      "romaji": "haa... yume ni odoru no ♫"
    },
    {
      "text": "月の明かりが",
      "romaji": "tsuki no akari ga"
    },
    {
      "text": "僕を包んで",
      "romaji": "boku o tsutsunde"
    },
    {
      "text": "鳴り響く音カラダを",
      "romaji": "narihibiku oto karada o"
    },
    {
      "text": "飲み込んでいく",
      "romaji": "nomikonde iku"
    },
    {
      "text": "もう恐れることを",
      "romaji": "mou osoreru koto o"
    },
    {
      "text": "感じないくらいの",
      "romaji": "kanjinai kurai no"
    },
    {
      "text": "眩しさに今ココロを",
      "romaji": "mabushisa ni ima kokoro o"
    },
    {
      "text": "狙われているの",
      "romaji": "nerawarete iru no"
    },
    {
      "text": "回る 回る 世界は",
      "romaji": "mawaru mawaru sekai wa"
    },
    {
      "text": "はぁ～ん",
      "romaji": "haa~n"
    },
    {
      "text": "夢に踊るのーーー ♫",
      "romaji": "yume ni odoru noーーー ♫"
    },
    {
      "text": "明日の声が",
      "romaji": "ashita no koe ga"
    },
    {
      "text": "僕を誘って",
      "romaji": "boku o sasotte"
    },
    {
      "text": "鳴り響く音 ミライを",
      "romaji": "narihibiku oto mirai o"
    },
    {
      "text": "塗り替えていく",
      "romaji": "nurikaete iku"
    },
    {
      "text": "もう留まることを",
      "romaji": "mou todomaru koto o"
    },
    {
      "text": "許さないくらいの",
      "romaji": "yurusanai kurai no"
    },
    {
      "text": "回る 回る 世界から",
      "romaji": "mawaru mawaru sekai kara"
    },
    {
      "text": "見える 見える 未来",
      "romaji": "mieru mieru mirai"
    }
  ]
}
