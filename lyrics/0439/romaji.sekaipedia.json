  "lines": [
    {
      "text": "「どこへ行こう」と話しかける",
      "romaji": "\"doko e ikou\" to hanashikakeru"
    },
    {
      "text": "窓の中じきに春",
      "romaji": "mado no naka jiki ni haru"
    },
    {
      "text": "「そこへ行こう」と思いふける",
      "romaji": "\"soko e ikou\" to omoi fukeru"
    },
    {
      "text": "白紙の地図さえも持たずに",
      "romaji": "hakushi no chizu sae mo motazu ni"
    },
    {
      "text": "かわいいわがままを言って",
      "romaji": "kawaii wagamama o itte"
    },
    {
      "text": "その隣で歩きたいな",
      "romaji": "sono tonari de arukitai na"
    },
    {
      "text": "かっこいいことを言って",
      "romaji": "kakkoii koto o itte"
    },
    {
      "text": "振り返って笑えるかな",
      "romaji": "furikaette waraeru kana"
    },
    {
      "text": "退屈の土にまいた種が",
      "romaji": "taikutsu no tsuchi ni maita tane ga"
    },
    {
      "text": "押し流されるような日々が",
      "romaji": "oshinagasareru you na hibi ga"
    },
    {
      "text": "ぬかるむ道を進みながら",
      "romaji": "nukarumu michi o susumi nagara"
    },
    {
      "text": "霧を晴らしながら",
      "romaji": "kiri o harashi nagara"
    },
    {
      "text": "一千光年先へ",
      "romaji": "issen kounen saki e"
    },
    {
      "text": "途切れない音でおしえて",
      "romaji": "togirenai oto de oshiete"
    },
    {
      "text": "その髪に光を編んでいたい",
      "romaji": "sono kami ni hikari o ande itai"
    },
    {
      "text": "恋焦がれても 触れられるのは",
      "romaji": "koikogarete mo furerareru no wa"
    },
    {
      "text": "夢の中だけ",
      "romaji": "yume no naka dake"
    },
    {
      "text": "大事なことは忘れないのが",
      "romaji": "daiji na koto wa wasurenai no ga"
    }
  ]
}
