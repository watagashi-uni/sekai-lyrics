  "lines": [
    {
      "text": "ダメダメよ☆ (woo!)",
      "romaji": "dame dame yo☆ (woo!)"
    },
    {
      "text": "右から左へと言葉が流れる",
      "romaji": "migi kara hidari e to kotoba ga nagareru"
    },
    {
      "text": "君のこと誰よりも分かってる",
      "romaji": "kimi no koto dare yori mo wakatteru"
    },
    {
      "text": "だから私に任せて",
      "romaji": "dakara watashi ni makasete"
    },
    {
      "text": "はじけるリズムに合わせて",
      "romaji": "hajikeru rizumu ni awasete"
    },
    {
      "text": "嫌なこと何もかも全部忘れて",
      "romaji": "iya na koto nani mo ka mo zenbu wasurete"
    },
    {
      "text": "私はここに居るから",
      "romaji": "watashi wa koko ni iru kara"
    },
    {
      "text": "だから全てを晒して",
      "romaji": "dakara subete o sarashite"
    }
  ]
}
