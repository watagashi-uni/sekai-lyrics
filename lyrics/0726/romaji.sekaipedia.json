  "lines": [
    {
      "text": "ココロぽつり",
      "romaji": "kokoro potsuri"
    },
    {
      "text": "張り詰め　プツリ",
      "romaji": "haritsume putsuri"
    },
    {
      "text": "四六時　背伸び",
      "romaji": "shirokuji senobi"
    },
    {
      "text": "ココロ肯定",
      "romaji": "kokoro koutei"
    },
    {
      "text": "出来ず　擦りキズ",
      "romaji": "dekizu suri kizu"
    },
    {
      "text": "しのぐコノ毒",
      "romaji": "shinogu kono doku"
    },
    {
      "text": "至らず孤独",
      "romaji": "itarazu kodoku"
    },
    {
      "text": "無個性　劣等生　聞きたくないよ",
      "romaji": "mukosei rettousei kikitakunai yo"
    },
    {
      "text": "ドロリ泥マミレ　存在の意義を知りたくて",
      "romaji": "dorori doro mamire sonzai no igi o shiritakute"
    },
    {
      "text": "ありのままの自分で",
      "romaji": "arinomama no jibun de"
    }
  ]
}
