  "lines": [
    {
      "text": "転がった 空っぽの箱庭",
      "romaji": "korogatta karappo no kontena"
    },
    {
      "text": "切り取った ボクらを陳列棚へ",
      "romaji": "kiritotta bokura o chinretsudana e"
    },
    {
      "text": "雑然としている",
      "romaji": "zatsuzen to shite iru"
    },
    {
      "text": "ただキミを待ってる",
      "romaji": "tada kimi o matteru"
    },
    {
      "text": "この先はボクじゃないのに",
      "romaji": "kono saki wa boku janai noni!"
    },
    {
      "text": "そうやって今では",
      "romaji": "sou yatte ima de wa"
    },
    {
      "text": "あ イデアなんて要らないの",
      "romaji": "a, idea nante iranai no?"
    },
    {
      "text": "ボクが見たいのはさ",
      "romaji": "boku ga mitai no wa sa"
    },
    {
      "text": "MODE モドキじゃない",
      "romaji": "“MODE:modoki” janai"
    },
    {
      "text": "我儘で居たいよ",
      "romaji": "wagamama de itai yo!"
    },
    {
      "text": "今だけは",
      "romaji": "ima dake wa"
    },
    {
      "text": "ちょっとだけここに居ない",
      "romaji": "chotto dake koko ni inai?"
    },
    {
      "text": "ちょっとでもキミが見たい",
      "romaji": "chotto demo kimi ga mitai!"
    },
    {
      "text": "バーコードだけ読み取って",
      "romaji": "baakoodo dake yomitotte"
    },
    {
      "text": "もーいーよ",
      "romaji": "moo ii yo!"
    },
    {
      "text": "キミだってほら",
      "romaji": "kimi datte hora"
    },
    {
      "text": "ソウゾウリョクが勝ってる",
      "romaji": "souzouryoku ga katteru!"
    },
    {
      "text": "世界だってキミを待ってる",
      "romaji": "sekai datte kimi o matteru!"
    },
    {
      "text": "恋をしてしまったんだ",
      "romaji": "koi o shite shimatta nda"
    },
    {
      "text": "キミがくれたひとつのあいに",
      "romaji": "kimi ga kureta hitotsu no ai ni,"
    },
    {
      "text": "キミの脳内からほとばしった",
      "romaji": "kimi no nounai kara hotobashitta!"
    },
    {
      "text": "ボクを",
      "romaji": "boku o"
    },
    {
      "text": "はなさないんだ",
      "romaji": "hanasanai nda."
    },
    {
      "text": "つかの間のコード",
      "romaji": "tsukanoma no koodo"
    }
  ]
}
