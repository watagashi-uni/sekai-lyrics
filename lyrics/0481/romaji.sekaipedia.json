  "lines": [
    {
      "text": "思い残したこともなくただ僕は",
      "romaji": "omoinokoshita koto mo naku tada boku wa"
    },
    {
      "text": "流されていく　この手に結んだ喪失と",
      "romaji": "nagasarete iku ko no te ni musunda soushitsu to"
    },
    {
      "text": "思い起こした　あの日々にただ僕は",
      "romaji": "omoiokoshita ano hibi ni tada boku wa"
    },
    {
      "text": "立ち尽くす甘い記憶",
      "romaji": "tachitsukusu amai kioku"
    },
    {
      "text": "ただ胸が痛むだけ",
      "romaji": "tada mune ga itamu dake"
    },
    {
      "text": "ああ今愛されて",
      "romaji": "aa ima aisarete"
    },
    {
      "text": "さあ今裏切られて",
      "romaji": "saa ima uragirarete"
    },
    {
      "text": "許すことのない",
      "romaji": "yurusu koto no nai"
    },
    {
      "text": "藍に満ちていく",
      "romaji": "ai ni michite iku"
    },
    {
      "text": "君のことを想うことを",
      "romaji": "kimi no koto o omou koto o"
    },
    {
      "text": "忘れてく弱さを日々嘆いて",
      "romaji": "wasureteku yowasa o hibi nageite"
    },
    {
      "text": "病める時も富める時も",
      "romaji": "yameru toki mo tomeru toki mo"
    },
    {
      "text": "私ただ貴方と手を繋いで",
      "romaji": "watashi tada anata to te o tsunaide"
    },
    {
      "text": "解けていく魔法　横目流す",
      "romaji": "tokete iku mahou yokome nagasu"
    },
    {
      "text": "君を愛していた",
      "romaji": "kimi o aishite ita"
    },
    {
      "text": "ああ痛いからさ",
      "romaji": "aa itai kara sa"
    },
    {
      "text": "君を忘れていくのね",
      "romaji": "kimi o wasurete iku no ne"
    },
    {
      "text": "でもそれでいいの",
      "romaji": "demo sore de ii no"
    },
    {
      "text": "悴んだ声も",
      "romaji": "kajikanda koe mo"
    },
    {
      "text": "逸る鼓動も",
      "romaji": "hayaru kodou mo"
    },
    {
      "text": "この傷が覚えているから",
      "romaji": "kono kizu ga oboete iru kara"
    },
    {
      "text": "どんな将来も",
      "romaji": "donna shourai mo"
    },
    {
      "text": "あなたと行きたい",
      "romaji": "anata to ikitai"
    }
  ]
}
