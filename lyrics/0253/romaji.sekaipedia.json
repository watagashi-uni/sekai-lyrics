  "lines": [
    {
      "text": "「眠れないんだ」",
      "romaji": "\"nemurenai nda\""
    },
    {
      "text": "風もなく茹だりそうな夜に",
      "romaji": "kaze mo naku udari sou na yoru ni"
    },
    {
      "text": "君の声が耳元で揺らいだ",
      "romaji": "kimi no koe ga mimimoto de yurai da"
    },
    {
      "text": "何も変わらない",
      "romaji": "nani mo kawaranai"
    },
    {
      "text": "笑えない日々を",
      "romaji": "waraenai hibi o"
    },
    {
      "text": "感傷に浸ってばっか",
      "romaji": "kanshou ni hitatte bakka"
    },
    {
      "text": "抜け出そうぜ",
      "romaji": "nuke dasou ze"
    },
    {
      "text": "君を連れ飛び出した",
      "romaji": "kimi o tsure tobi dashita"
    },
    {
      "text": "風が通り過ぎた",
      "romaji": "kaze ga toori sugita"
    },
    {
      "text": "闇と混ざり合った",
      "romaji": "yami to mazari atta"
    },
    {
      "text": "小さく藍の空に響いて",
      "romaji": "chiisaku ai no sora ni hibiite"
    },
    {
      "text": "君の笑い声が",
      "romaji": "kimi no warai koe ga"
    },
    {
      "text": "もう戻れないぜ？",
      "romaji": "mou modorenai ze?"
    },
    {
      "text": "そんなんで生きていけんのか",
      "romaji": "sonna nde ikiteiken no ka"
    },
    {
      "text": "なんて揺らぎそうな想いは",
      "romaji": "nante yuragi sou na omoi wa"
    },
    {
      "text": "アクセルへ",
      "romaji": "akuseru e"
    },
    {
      "text": "追い越してやるんだ",
      "romaji": "oikoshite yaru nda"
    },
    {
      "text": "このまま地平線を",
      "romaji": "kono mama chiheisen o"
    },
    {
      "text": "最前線飛ばせ僕たちは",
      "romaji": "saizensen tobase bokutachi wa"
    },
    {
      "text": "星もない夜",
      "romaji": "hoshi mo nai yoru"
    },
    {
      "text": "ただ東を目指して行く",
      "romaji": "tada higashi o mezashite yuku"
    },
    {
      "text": "13秒先もわかんなくたって",
      "romaji": "juu-san-byou saki mo wakannaku tatte"
    },
    {
      "text": "精一杯僕を生きていく",
      "romaji": "sei ippai boku o ikite iku"
    },
    {
      "text": "前を向け",
      "romaji": "mae o muke"
    },
    {
      "text": "何も後悔なんてないさ",
      "romaji": "nani mo koukai nante nai sa"
    },
    {
      "text": "止まらないさ",
      "romaji": "tomaranai sa"
    },
    {
      "text": "きっと光の待つ方へ",
      "romaji": "kitto hikari no matsu hou e"
    },
    {
      "text": "白みだした星空",
      "romaji": "shirami dashita hoshizora"
    },
    {
      "text": "胸を鳴らしている",
      "romaji": "mune o narashite iru"
    },
    {
      "text": "眠らないよう",
      "romaji": "nemuranai you"
    },
    {
      "text": "上がるミュージックと",
      "romaji": "agaru myuujikku to"
    },
    {
      "text": "ぬるくなった水だけ持っていく",
      "romaji": "nuruku natta mizu dake motte iku"
    },
    {
      "text": "無駄なものは何もないさ",
      "romaji": "muda na mono wa nani mo nai sa"
    },
    {
      "text": "その方がきっと笑えるさって",
      "romaji": "sono hou ga kitto waraeru satte"
    },
    {
      "text": "昇る太陽",
      "romaji": "noboru taiyou"
    },
    {
      "text": "その光を目指していく",
      "romaji": "sono hikari o mezashite yuku"
    },
    {
      "text": "幸せって今はわかんなくたって",
      "romaji": "shiawasette ima wa wakannaku tatte"
    },
    {
      "text": "終わらないさ",
      "romaji": "owaranai sa"
    },
    {
      "text": "一生僕らは生きて征け",
      "romaji": "isshou bokura wa ikite yuke"
    }
  ]
}
