  "lines": [
    {
      "index": 0,
      "start": 10.541,
      "end": 15.47,
      "japanese": "もう、止められないんだろうか",
      "zh-CN": "已经，无法阻止停下了吗",
      "shared_interval": false
    },
    {
      "index": 1,
      "start": 15.45,
      "end": 20.06,
      "japanese": "この曲が終わってしまったら",
      "zh-CN": "一旦这首曲子走向终结",
      "shared_interval": false
    },
    {
      "index": 2,
      "start": 20.481,
      "end": 25.14,
      "japanese": "きみはまた心を閉じて",
      "zh-CN": "你又会再次紧闭心扉",
      "shared_interval": false
    },
    {
      "index": 3,
      "start": 25.38,
      "end": 31.02,
      "japanese": "「いつかまた話せるかな」って",
      "zh-CN": "心想着「不知何时才能再次交谈呢」",
      "shared_interval": false
    },
    {
      "index": 4,
      "start": 30.953,
      "end": 36.12,
      "japanese": "鼓動、止められないんだろうか",
      "zh-CN": "心跳，无法平复下来了吗",
      "shared_interval": false
    },
    {
      "index": 5,
      "start": 37.668,
      "end": 40.873,
      "japanese": "この音が終わってしまうなら",
      "zh-CN": "倘若这乐音即将迎来终结",
      "shared_interval": false
    },
    {
      "index": 6,
      "start": 40.72,
      "end": 45.967,
      "japanese": "ぼくは、きっと逃げてばかりいて",
      "zh-CN": "我一定，只是一味地在逃避",
      "shared_interval": false
    },
    {
      "index": 7,
      "start": 45.967,
      "end": 51.494,
      "japanese": "本当はずっと 「思い出」って伝うのに",
      "zh-CN": "明明一直想传达「回忆」",
      "shared_interval": false
    },
    {
      "index": 8,
      "start": 51.067,
      "end": 56.033,
      "japanese": "なんにも踏み出せない",
      "zh-CN": "却无法迈出任何一步",
      "shared_interval": false
    },
    {
      "index": 9,
      "start": 56.029,
      "end": 61.178,
      "japanese": "おわりにしよって書いて一体どうしよう",
      "zh-CN": "写下「做个了结吧」到底该如何是好",
      "shared_interval": false
    },
    {
      "index": 10,
      "start": 61.324,
      "end": 66.028,
      "japanese": "願いとか 未来とか 巻き戻せないんだね",
      "zh-CN": "心愿也好 未来也罢 都是无法倒带重来的呢",
      "shared_interval": false
    },
    {
      "index": 11,
      "start": 66.048,
      "end": 68.431,
      "japanese": "目眩んで 立ち止まる",
      "zh-CN": "眼前眩晕 止步不前",
      "shared_interval": false
    },
    {
      "index": 12,
      "start": 68.431,
      "end": 77.018,
      "japanese": "また歩き出すように",
      "zh-CN": "为了能再次迈步前行",
      "shared_interval": false
    },
    {
      "index": 13,
